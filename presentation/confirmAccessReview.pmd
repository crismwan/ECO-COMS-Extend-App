{
  "id": "confirmAccessReview",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "postReview",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "/comsAuditLogs",
        "httpMethod": "POST",
        "authType": "sso",
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ],
        "values": [
          {
            "outboundPath": "timestamp",
            "value": "<% date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\") %>"
          },
          {
            "outboundPath": "objectType",
            "value": "Role Assignment"
          },
          {
            "outboundPath": "action",
            "value": "REVIEW"
          },
          {
            "outboundPath": "coReferenceId",
            "value": "<% queryParams.posWid ?? '' %>"
          },
          {
            "outboundPath": "coName",
            "value": "<% queryParams.org ?? '' %>"
          },
          {
            "outboundPath": "roleName",
            "value": "<% queryParams.role ?? '' %>"
          },
          {
            "outboundPath": "roleWid",
            "value": "<% queryParams.roleWid ?? '' %>"
          },
          {
            "outboundPath": "orgWid",
            "value": "<% queryParams.orgWid ?? '' %>"
          },
          {
            "outboundPath": "positionName",
            "value": "<% queryParams.pos ?? '' %>"
          },
          {
            "outboundPath": "positionWid",
            "value": "<% queryParams.posWid ?? '' %>"
          },
          {
            "outboundPath": "effectiveDate",
            "value": "<% date:now().format('yyyy-MM-dd') %>"
          },
          {
            "outboundPath": "triggeredBy",
            "value": "<% selectedWorker.descriptor ?? '' %>"
          },
          {
            "outboundPath": "changedByWid",
            "value": "<% selectedWorker.id ?? '' %>"
          },
          {
            "outboundPath": "details",
            "value": "<% 'Access review: ' + (queryParams.pos ?? '') + ' still needs ' + (queryParams.role ?? '') + ' on ' + (queryParams.org ?? '') %>"
          }
        ]
      }
    ]
  },
  "onSubmit": "<%\n  stillNeededCheckBox.clearError();\n  let valid = true;\n  if (stillNeededCheckBox.value != true) {\n    stillNeededCheckBox.setError('Tick the box to confirm this position still needs the role.');\n    valid = false;\n  }\n  valid;\n%>",
  "presentation": {
    "pageType": "EDIT",
    "headerSize": "HIDDEN",
    "cancelOverride": {
      "taskId": "accessReview"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "confirmAccessReviewForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "titleBannerSection",
          "children": [
            {
              "type": "richText",
              "id": "titleBannerRichText",
              "enabled": false,
              "value": "<span style=\"color:#0055B3;font-size:24px\"><b>ECO-COMS: Confirm Access</b></span>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "title": "About This Page",
              "children": [
                {
                  "type": "richText",
                  "id": "aboutRichText",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Confirm that this position still needs this role. Clicking <b>OK</b> records your review in the Audit Log; nothing changes in Workday. To take the role away instead, click <b>Cancel</b> and use <b>Manage</b> on the Access Review.</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "confirmSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "confirmFieldSet",
              "title": "Role Assignment",
              "children": [
                {
                  "type": "text",
                  "id": "roleText",
                  "label": "Role",
                  "enabled": false,
                  "value": "<% queryParams.role ?? '' %>"
                },
                {
                  "type": "text",
                  "id": "orgText",
                  "label": "Organization",
                  "enabled": false,
                  "value": "<% queryParams.org ?? '' %>"
                },
                {
                  "type": "text",
                  "id": "positionText",
                  "label": "Position",
                  "enabled": false,
                  "value": "<% queryParams.pos ?? '' %>"
                },
                {
                  "type": "checkBox",
                  "id": "stillNeededCheckBox",
                  "label": "This position still needs this role",
                  "value": "<% false %>",
                  "onChange": "<% self.clearError() %>"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}
