{
  "id": "fuhLandingPage",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "endPoints": [],
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "Functional Unit Hierarchy Administration",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "fuhLandingPageForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK",
              "suppressDiscardDialog": true
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "overviewSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "overviewFieldSet",
              "title": "About FUH Administration",
              "children": [
                {
                  "type": "richText",
                  "id": "overviewDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#374151;font-size:13px\">FUH are Custom Organizations of type <b>Functional Unit Hierarchy</b> and are used specifically for UBC academic or administrative units.</span>"
                }
              ],
              "_layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              }
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "view"
  }
}
