{
  "id": "comsInsights",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "include": [
    "comsRequestStats.script",
    "comsAuditFilters.script",
    "comsInsights.script"
  ],
  "endPoints": [
    {
      "name": "requestCount",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAssignableRoles?limit=1",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "requestPage0",
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "url": "/comsAssignableRoles?limit=100&offset=0"
    },
    {
      "name": "requestPage1",
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "url": "/comsAssignableRoles?limit=100&offset=100"
    },
    {
      "name": "requestPage2",
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "url": "/comsAssignableRoles?limit=100&offset=200"
    },
    {
      "name": "allShellOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellOrgs"
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications?limit=100",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ]
    },
    {
      "name": "auditLogCount",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAuditLogs?limit=1",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "auditPage0",
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "url": "<% let t = auditLogCount.total ?? 0; let start = (t - 100) < 0 ? 0 : (t - 100); let cnt = t - 0 - start; '/comsAuditLogs?limit=' + (cnt > 0 ? cnt : 1) + '&offset=' + (cnt > 0 ? start : t) %>"
    },
    {
      "name": "auditPage1",
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "url": "<% let t = auditLogCount.total ?? 0; let start = (t - 200) < 0 ? 0 : (t - 200); let cnt = t - 100 - start; '/comsAuditLogs?limit=' + (cnt > 0 ? cnt : 1) + '&offset=' + (cnt > 0 ? start : t) %>"
    },
    {
      "name": "auditPage2",
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "url": "<% let t = auditLogCount.total ?? 0; let start = (t - 300) < 0 ? 0 : (t - 300); let cnt = t - 200 - start; '/comsAuditLogs?limit=' + (cnt > 0 ? cnt : 1) + '&offset=' + (cnt > 0 ? start : t) %>"
    },
    {
      "name": "bulkRunCount",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsBulkRuns?limit=1",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "bulkRunPage0",
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "url": "<% let t = bulkRunCount.total ?? 0; let start = (t - 100) < 0 ? 0 : (t - 100); let cnt = t - start; '/comsBulkRuns?limit=' + (cnt > 0 ? cnt : 1) + '&offset=' + (cnt > 0 ? start : t) %>"
    }
  ],
  "presentation": {
    "title": {
      "type": "title",
      "label": "ECO-COMS: Insights"
    },
    "pageType": "VIEW",
    "body": {
      "type": "basicFormLayout",
      "id": "comsInsightsForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK",
              "suppressDiscardDialog": true
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "title": "About This Page",
              "children": [
                {
                  "type": "richText",
                  "id": "aboutDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">One view across ECO-COMS: role requests, shell organizations and patterns, the audit log and bulk runs. Counts read up to 300 role requests, the newest 300 audit records and the newest 100 bulk runs. Select an <b>Application ID</b> to open it in Shell Org Manager. For Workday custom reports use the ECO-COMS report data sources (Role Requests, Audit Trail, Bulk Runs, Applications).</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "kpiSection",
          "children": [
            {
              "type": "cardContainer",
              "id": "kpiCardContainer",
              "layout": "masonry",
              "cards": [
                {
                  "type": "card",
                  "cardId": "CountCard",
                  "parameters": "<% { 'title': 'ISC Turnaround', 'countText': comsInsights.turnaroundText(list:flatten([requestPage0.data ?? [], requestPage1.data ?? [], requestPage2.data ?? []])), 'subtitle': 'Request to approval, last 90 days' } %>"
                },
                {
                  "type": "card",
                  "cardId": "CountCard",
                  "parameters": "<% { 'title': 'Pending ISC Review', 'countText': '' + comsRequestStats.countPending(list:flatten([requestPage0.data ?? [], requestPage1.data ?? [], requestPage2.data ?? []])) + ' pending · ' + comsRequestStats.countOverdue(list:flatten([requestPage0.data ?? [], requestPage1.data ?? [], requestPage2.data ?? []])) + ' overdue', 'subtitle': 'Overdue after 3 business days' } %>"
                },
                {
                  "type": "card",
                  "cardId": "CountCard",
                  "parameters": "<% { 'title': 'Approved, Last 30 Days', 'countText': '' + list:flatten([requestPage0.data ?? [], requestPage1.data ?? [], requestPage2.data ?? []]).filter(r => { r.status == 'Approved' && comsInsights.inDays(r.approvedDate, comsInsights.lastDays(30)) }).size() + ' approved', 'subtitle': 'Role requests, by approval date' } %>"
                },
                {
                  "type": "card",
                  "cardId": "CountCard",
                  "parameters": "<% { 'title': 'Changes, Last 30 Days', 'countText': '' + comsInsights.countInDays(list:flatten([auditPage0.data ?? [], auditPage1.data ?? [], auditPage2.data ?? []]), 'timestamp', comsInsights.lastDays(30)) + ' audit records', 'subtitle': 'Newest 300 audit records' } %>"
                },
                {
                  "type": "card",
                  "cardId": "CountCard",
                  "parameters": "<% let runs = (bulkRunPage0.data ?? []).filter(r => { comsInsights.inDays(r.uploadedAt, comsInsights.lastDays(30)) }); { 'title': 'Bulk Runs, Last 30 Days', 'countText': '' + size(runs) + ' runs · ' + runs.filter(r => { ('' + (r.status ?? '')).upperCase().contains('FAIL') }).size() + ' failed', 'subtitle': 'Uploads and grid edits' } %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "chartsSection",
          "children": [
            {
              "type": "cardContainer",
              "id": "chartsCardContainer",
              "layout": "masonry",
              "cards": [
                {
                  "type": "card",
                  "cardId": "BreakdownChart",
                  "parameters": "<% { 'title': 'Role Requests by Status', 'subtitle': '' + size(list:flatten([requestPage0.data ?? [], requestPage1.data ?? [], requestPage2.data ?? []])) + ' requests', 'slices': comsInsights.statusSlices(list:flatten([requestPage0.data ?? [], requestPage1.data ?? [], requestPage2.data ?? []])) } %>"
                },
                {
                  "type": "card",
                  "cardId": "BreakdownChart",
                  "parameters": "<% { 'title': 'Role Requests by Application', 'subtitle': 'Top applications', 'slices': comsInsights.appSlices(list:flatten([requestPage0.data ?? [], requestPage1.data ?? [], requestPage2.data ?? []]), comsApplications.data ?? []) } %>"
                },
                {
                  "type": "card",
                  "cardId": "ShellOrgStatusChart",
                  "parameters": "<% { 'activeCount': size((allShellOrgs.data ?? []).filter(o => { (o.code ?? '').startsWith('X:') && !(o.code ?? '').contains(':PATTERN') && o.cf_active1 == true })), 'inactiveCount': size((allShellOrgs.data ?? []).filter(o => { (o.code ?? '').startsWith('X:') && !(o.code ?? '').contains(':PATTERN') && o.cf_active1 != true })) } %>"
                },
                {
                  "type": "card",
                  "cardId": "AuditActionChart",
                  "parameters": "<% let f = comsAuditFilters.filterLogs(list:flatten([auditPage0.data ?? [], auditPage1.data ?? [], auditPage2.data ?? []]), '30d', ''); { 'addCount': comsAuditFilters.countAction(f, 'ADD'), 'inactivateCount': comsAuditFilters.countAction(f, 'INACTIVATE'), 'reactivateCount': comsAuditFilters.countAction(f, 'REACTIVATE'), 'assignCount': comsAuditFilters.countAction(f, 'ASSIGN POSITION'), 'removeCount': comsAuditFilters.countAction(f, 'REMOVE POSITION'), 'requestCount': comsAuditFilters.countAction(f, 'REQUEST'), 'approveCount': comsAuditFilters.countAction(f, 'APPROVE'), 'denyCount': comsAuditFilters.countAction(f, 'DENY'), 'deleteCount': comsAuditFilters.countAction(f, 'DELETE'), 'totalText': '' + size(f) + ' records, last 30 days' } %>"
                },
                {
                  "type": "card",
                  "cardId": "BreakdownChart",
                  "parameters": "<% { 'title': 'Bulk Runs by Status', 'subtitle': '' + size((bulkRunPage0.data ?? [])) + ' runs', 'slices': comsInsights.bulkSlices((bulkRunPage0.data ?? [])) } %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "appsSection",
          "children": [
            {
              "type": "grid",
              "id": "appInsightsGrid",
              "label": "Applications at a Glance",
              "readOnly": true,
              "rows": "<% comsInsights.appRows(list:flatten([requestPage0.data ?? [], requestPage1.data ?? [], requestPage2.data ?? []]), (allShellOrgs.data ?? []), comsApplications.data ?? []) %>",
              "rowVariableName": "appRow",
              "columns": [
                {
                  "type": "column",
                  "columnId": "appCodeColumn",
                  "label": "Application ID",
                  "cellTemplate": {
                    "type": "button",
                    "id": "appCodeButton",
                    "action": "LINK",
                    "label": "<% appRow.code %>",
                    "taskReference": {
                      "taskId": "shellOrgManager",
                      "parameterBindings": {
                        "appCode": "<% appRow.code %>",
                        "appName": "<% appRow.name %>"
                      }
                    }
                  }
                },
                {
                  "type": "column",
                  "columnId": "appNameColumn",
                  "label": "Name",
                  "cellTemplate": {
                    "type": "text",
                    "id": "appNameText",
                    "value": "<% appRow.name %>",
                    "enabled": false
                  }
                },
                {
                  "type": "column",
                  "columnId": "shellActiveColumn",
                  "label": "Active Shell Orgs",
                  "cellTemplate": {
                    "type": "number",
                    "id": "shellActiveNumber",
                    "value": "<% appRow.shellActive %>",
                    "enabled": false
                  }
                },
                {
                  "type": "column",
                  "columnId": "shellInactiveColumn",
                  "label": "Inactive Shell Orgs",
                  "cellTemplate": {
                    "type": "number",
                    "id": "shellInactiveNumber",
                    "value": "<% appRow.shellInactive %>",
                    "enabled": false
                  }
                },
                {
                  "type": "column",
                  "columnId": "patternsColumn",
                  "label": "Patterns",
                  "cellTemplate": {
                    "type": "number",
                    "id": "patternsNumber",
                    "value": "<% appRow.patterns %>",
                    "enabled": false
                  }
                },
                {
                  "type": "column",
                  "columnId": "pendingColumn",
                  "label": "Pending Requests",
                  "cellTemplate": {
                    "type": "number",
                    "id": "pendingNumber",
                    "value": "<% appRow.pending %>",
                    "enabled": false
                  }
                },
                {
                  "type": "column",
                  "columnId": "approvedColumn",
                  "label": "Approved",
                  "cellTemplate": {
                    "type": "number",
                    "id": "approvedNumber",
                    "value": "<% appRow.approved %>",
                    "enabled": false
                  }
                },
                {
                  "type": "column",
                  "columnId": "deniedColumn",
                  "label": "Denied",
                  "cellTemplate": {
                    "type": "number",
                    "id": "deniedNumber",
                    "value": "<% appRow.denied %>",
                    "enabled": false
                  }
                },
                {
                  "type": "column",
                  "columnId": "lastRequestColumn",
                  "label": "Last Request",
                  "cellTemplate": {
                    "type": "text",
                    "id": "lastRequestText",
                    "value": "<% appRow.lastRequest %>",
                    "enabled": false
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "pendingSection",
          "children": [
            {
              "type": "grid",
              "id": "oldestPendingGrid",
              "label": "Oldest Pending Requests",
              "readOnly": true,
              "rows": "<% comsInsights.oldestPending(list:flatten([requestPage0.data ?? [], requestPage1.data ?? [], requestPage2.data ?? []]), 10) %>",
              "rowVariableName": "pendingRow",
              "columns": [
                {
                  "type": "column",
                  "columnId": "requestedColumn",
                  "label": "Requested",
                  "cellTemplate": {
                    "type": "text",
                    "id": "requestedText",
                    "value": "<% ('' + (pendingRow.requestedDate ?? '')).substring(0, 10) %>",
                    "enabled": false
                  }
                },
                {
                  "type": "column",
                  "columnId": "roleColumn",
                  "label": "Role",
                  "cellTemplate": {
                    "type": "text",
                    "id": "roleText",
                    "value": "<% pendingRow.roleName ?? '' %>",
                    "enabled": false
                  }
                },
                {
                  "type": "column",
                  "columnId": "applicationColumn",
                  "label": "Application",
                  "cellTemplate": {
                    "type": "text",
                    "id": "applicationText",
                    "value": "<% comsInsights.appOfIn(pendingRow, comsApplications.data ?? []) %>",
                    "enabled": false
                  }
                },
                {
                  "type": "column",
                  "columnId": "requestedByColumn",
                  "label": "Requested By",
                  "cellTemplate": {
                    "type": "text",
                    "id": "requestedByText",
                    "value": "<% !empty(pendingRow.requestedBy) ? (pendingRow.requestedBy.descriptor ?? '') : '' %>",
                    "enabled": false
                  }
                },
                {
                  "type": "column",
                  "columnId": "referenceColumn",
                  "label": "Reference",
                  "cellTemplate": {
                    "type": "text",
                    "id": "referenceText",
                    "value": "<% pendingRow.referenceId ?? '' %>",
                    "enabled": false
                  }
                },
                {
                  "type": "column",
                  "columnId": "openColumn",
                  "label": "Open",
                  "cellTemplate": {
                    "type": "button",
                    "id": "openQueueButton",
                    "action": "AUXILIARY",
                    "label": "ISC Queue",
                    "taskReference": {
                      "taskId": "iscRoleRequestsView"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}
