{
  "id": "iscRoleRequestsHub",
  "securityDomains": [
    "MaintainCOMSAssignableRoles"
  ],
  "endPoints": [],
  "presentation": {
    "pageType": "VIEW",
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ECO-COMS: ISC Role Requests"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "iscHubForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "iscHubSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "iscHubFieldSet",
              "title": "About this page",
              "children": [
                {
                  "type": "richText",
                  "id": "iscHubDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">The ISC review queue for assignable role and AAA role requests. Open a queue below; on the queue page you can switch between request types and statuses.</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "iscHubLinksSection",
          "children": [
            {
              "type": "cardContainer",
              "id": "iscQueueCardContainer",
              "layout": "grid",
              "cards": [
                {
                  "type": "card",
                  "cardId": "IscQueuePillCard"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}
