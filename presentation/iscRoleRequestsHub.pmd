{
  "id": "iscRoleRequestsHub",
  "securityDomains": [
    "MaintainCOMSAssignableRoles"
  ],
  "endPoints": [
    {
      "name": "comsAssignableRoles",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAssignableRoles",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true"
    }
  ],
  "presentation": {
    "title": {
      "type": "title",
      "label": "ISC Role Requests"
    },
    "body": {
      "type": "listDetailHub",
      "label": "ISC Role Requests",
      "items": "<% comsAssignableRoles.data.filter(r => r.status == 'Pending ISC Review') %>",
      "itemVariableName": "request",
      "icon": "wd-icon-checkboxes",
      "navigationTemplate": {
        "icon": "wd-icon-person",
        "label": "<% (request.roleName ?? 'Unknown Role') + ' — ' + (request.shellOrgCode ?? request.application ?? '') %>",
        "task": {
          "taskId": "iscRoleRequestsView"
        }
      },
      "additionalLinks": {
        "title": "Quick Links",
        "links": [
          {
            "label": "View All Requests (Grid)",
            "task": {
              "taskId": "iscRoleRequestsView"
            }
          },
          {
            "label": "ECO-COMS Home",
            "task": {
              "taskId": "home"
            }
          }
        ]
      }
    }
  }
}
