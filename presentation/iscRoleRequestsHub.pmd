{
  "id": "iscRoleRequestsHub",
  "securityDomains": [
    "MaintainCOMSAssignableRoles"
  ],
  "endPoints": [],
  "presentation": {
    "pageType": "VIEW",
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ISC Role Requests"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "iscHubForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "iscHubSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "iscHubFieldSet",
              "title": "ISC Role Request Queue",
              "children": [
                {
                  "type": "richText",
                  "id": "iscHubDesc",
                  "enabled": false,
                  "value": "<span style=\"font-size:11px\">Review and action pending ISC role requests. Use the links below to view requests by type.</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "iscHubLinksSection",
          "children": [
            {
              "type": "button",
              "label": "View All Pending Requests",
              "taskReference": {
                "taskId": "iscRoleRequestsView"
              },
              "action": "PRIMARY"
            },
            {
              "type": "button",
              "label": "Pending AAA Provisioning",
              "taskReference": {
                "taskId": "iscRoleRequestsView",
                "parameters": {
                  "view": "aaa"
                }
              },
              "action": "AUXILIARY"
            },
            {
              "type": "button",
              "label": "Pending Assignable Roles",
              "taskReference": {
                "taskId": "iscRoleRequestsView",
                "parameters": {
                  "view": "assignable"
                }
              },
              "action": "AUXILIARY"
            },
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}
