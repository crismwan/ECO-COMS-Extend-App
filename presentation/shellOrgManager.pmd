{
  "id": "shellOrgManager",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "include": [
    "comsCardGenerator.script"
  ],
  "endPoints": [
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true"
    },
    {
      "name": "shellOrgPatterns",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "existingPatterns"
      }
    },
    {
      "name": "shellOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "customOrganizations"
      }
    },
    {
      "name": "shellRoles",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellAssignableRolesinTenant"
      }
    },
    {
      "name": "allShellOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellOrgs"
      }
    }
  ],
  "presentation": {
    "headerSize": "STANDARD",
    "pageType": "view",
    "title": {
      "type": "title",
      "label": "<% empty(queryParams.appName) ? 'ECO-COMS: Shell Org Manager' : (queryParams.appName ?? '') %>",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "shellOrgManagerForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "navFieldSet",
              "title": "<% queryParams.appName ?? queryParams.appCode ?? '' %>",
              "children": [
                {
                  "type": "button",
                  "id": "backToHomeBtn",
                  "label": "\u2190 Home",
                  "taskReference": {
                    "taskId": "home"
                  },
                  "action": "LINK",
                  "suppressDiscardDialog": true,
                  "visible": "<% empty(queryParams.appCode) %>"
                },
                {
                  "type": "button",
                  "id": "backToApplicationsBtn",
                  "label": "\u2190 Back to Applications",
                  "taskReference": {
                    "taskId": "shellOrgManager"
                  },
                  "action": "LINK",
                  "suppressDiscardDialog": true,
                  "visible": "<% !empty(queryParams.appCode) %>"
                },
                {
                  "type": "richText",
                  "id": "scopeWarning",
                  "enabled": false,
                  "value": "<% empty(queryParams.appCode) ? '<span style=\"display:inline-flex;align-items:center;gap:6px;background:#fef9c3;border:1px solid #fbbf24;border-radius:6px;padding:8px 12px;font-size:13px;color:#92400e\">\u26a0\ufe0f No application selected \u2014 data below reflects all applications. Click Manage on an application to view its shell orgs and URL patterns.</span>' : '<span style=\"display:inline-flex;align-items:center;gap:6px;background:#fef9c3;border:1px solid #fbbf24;border-radius:6px;padding:8px 12px;font-size:13px;color:#92400e\">\u26a0\ufe0f Showing shell orgs and URL patterns for <strong>' + (queryParams.appName ?? queryParams.appCode) + '</strong> only. Go back to view all applications.</span>' %>"
                }
              ],
              "_layout": {
                "density": "high",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              }
            }
          ]
        }
      ]
    },
    "tabs": [
      {
        "type": "section",
        "label": "Application Patterns",
        "children": [
          {
            "type": "fieldSet",
            "id": "appsFieldSet",
            "visible": "<% empty(queryParams.appCode) %>",
            "title": "Applications",
            "children": [
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "appsGrid",
                "rows": "<% comsApplications.data %>",
                "rowVariableName": "app",
                "enabled": false,
                "label": "Applications",
                "autoPaging": true,
                "columns": [
                  {
                    "type": "column",
                    "id": "colAppName",
                    "columnId": "colAppName",
                    "label": "Application ID",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "button",
                      "action": "LINK",
                      "label": "<% app.appId ?? '' %>",
                      "taskReference": {
                        "taskId": "shellOrgManager",
                        "parameterBindings": {
                          "appCode": "<% app.appId %>",
                          "appName": "<% app.name %>"
                        }
                      }
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAppDisplayName",
                    "columnId": "colAppDisplayName",
                    "label": "Application Name",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% app.name ?? '' %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAppActions",
                    "columnId": "colAppActions",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "Manage",
                      "taskReference": {
                        "taskId": "shellOrgManager",
                        "parameterBindings": {
                          "appCode": "<% app.appId %>",
                          "appName": "<% app.name %>"
                        }
                      }
                    }
                  }
                ]
              }
            ],
            "_layout": {
              "density": "medium",
              "alignment": "left",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            }
          },
          {
            "type": "fieldSet",
            "id": "patternsFieldSet",
            "visible": "<% !empty(queryParams.appCode) %>",
            "title": "Shell Org Patterns",
            "children": [
              {
                "type": "button",
                "label": "Add Pattern",
                "taskReference": {
                  "taskId": "newShellOrgPattern"
                },
                "action": "PRIMARY"
              },
              {
                "type": "richText",
                "id": "saveNote",
                "enabled": false,
                "value": "<span style=\"color:#d97706;font-size:11px;font-weight:700\">\u26a0 </span><span style=\"color:#92400e;font-size:11px\"><b>Warning:</b> Changing Status to Inactive does not automatically remove any Workday role assignments referencing this shell organization. Verify in Workday (Get_Assign_User_Based_Security_Groups) that no active role assignment uses this Custom Organization before inactivating.</span>"
              },
              {
                "type": "richText",
                "id": "emptyStateMsg",
                "enabled": false,
                "value": "<span style=\"color:#374151;font-size:12px\">No shell org patterns found for this application. Use the <b>Add Pattern</b> button above to create one.</span>",
                "visible": "<% !empty(queryParams.appCode) && size(shellOrgPatterns.data.filter(p => { p.code.startsWith((queryParams.appCode ?? '') + ':PATTERN') })) == 0 %>"
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "patternsGrid",
                "rows": "<% empty(queryParams.appCode) ? [] : shellOrgPatterns.data.filter(p => { p.code.startsWith(queryParams.appCode + ':PATTERN') }) %>",
                "rowVariableName": "pattern",
                "enabled": false,
                "label": "<% 'Patterns for ' + (queryParams.appName ?? queryParams.appCode ?? '') %>",
                "autoPaging": true,
                "visible": "<% !empty(queryParams.appCode) && size(shellOrgPatterns.data.filter(p => { p.code.startsWith((queryParams.appCode ?? '') + ':PATTERN') })) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colPatternName",
                    "columnId": "colPatternName",
                    "label": "Organization Name",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "instanceList",
                      "view": true,
                      "relatedTask": true,
                      "values": "<% [pattern] %>",
                      "widKey": "workdayID"
                    }
                  },
                  {
                    "type": "column",
                    "id": "colPatternCode",
                    "columnId": "colPatternCode",
                    "label": "Pattern Code",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% pattern.code %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colStatus",
                    "columnId": "colStatus",
                    "label": "Status",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "richText",
                      "value": "<% pattern.cf_active1 == true ? '<span style=\"color:#065f46;font-weight:600;font-size:11px\">\u2713 Active</span>' : '<span style=\"color:#6b7280;font-weight:600;font-size:11px\">\u25cb Inactive</span>' %>"
                    }
                  },
                  {
                    "type": "column",
                    "id": "colPatternManage",
                    "columnId": "colPatternManage",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "<% pattern.cf_active1 == true ? 'Inactivate' : 'Activate' %>",
                      "taskReference": {
                        "taskId": "manageShellOrgStatus",
                        "parameterBindings": {
                          "orgId": "<% pattern.workdayID ?? \"\" %>",
                          "orgCode": "<% pattern.code %>",
                          "orgName": "<% pattern.organizationByName.descriptor ?? pattern.code ?? \"\" %>",
                          "currentStatus": "<% pattern.cf_active1 == true ? 'Active' : 'Inactive' %>"
                        }
                      }
                    }
                  }
                ]
              }
            ],
            "_layout": {
              "density": "medium",
              "alignment": "left",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            }
          },
          {
            "type": "fieldSet",
            "id": "footerFieldSet0",
            "children": [
              {
                "type": "richText",
                "id": "footerText0",
                "enabled": false,
                "value": "<p style=\"text-align:center\"><span style=\"color:#002145;font-size:11px;font-weight:700;font-family:Arial,sans-serif;letter-spacing:2px;\">ECO-COMS</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> \u00b7 </span><span style=\"color:#002145;font-size:11px;font-family:Arial,sans-serif;\">University of British Columbia</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> \u00b7 </span><span style=\"color:#0055B7;font-size:11px;font-family:Arial,sans-serif;font-style:italic;\">Custom Organization Management System</span></p>"
              }
            ],
            "_layout": {
              "density": "medium",
              "alignment": "center",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            }
          }
        ]
      },
      {
        "type": "section",
        "label": "Application Shell Organizations",
        "children": [
          {
            "type": "richText",
            "id": "shellOrgsAppWarning",
            "enabled": false,
            "visible": "<% !empty(queryParams.appCode) %>",
            "value": "<span style=\"color:#d97706;font-size:11px;font-weight:700\">\u26a0 </span><span style=\"color:#92400e;font-size:11px\"><b>Filtered view:</b> You selected <b><% queryParams.appCode ?? '' %></b> from the Application Patterns tab. Only shell organizations matching this application are shown below. <a href=\"javascript:void(0)\" style=\"color:#0055B7\">View all organizations</a> by navigating to Shell Org Manager without an application selected.</span>"
          },
          {
            "type": "button",
            "id": "addNewOrgBtn",
            "label": "Add New Shell Organization",
            "taskReference": {
              "taskId": "newShellOrg"
            },
            "action": "PRIMARY"
          },
          {
            "type": "fieldSet",
            "id": "allShellOrgsFieldSet",
            "visible": "<% empty(queryParams.appCode) %>",
            "title": "All Shell Organizations",
            "children": [
              {
                "type": "richText",
                "id": "allShellOrgsEmptyMsg",
                "enabled": false,
                "value": "<span style=\"color:#374151;font-size:12px\">No shell organizations found.</span>",
                "visible": "<% empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { o.code.startsWith('X:') && !o.code.contains(':PATTERN') })) == 0 %>"
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "allShellOrgsGrid",
                "rows": "<% allShellOrgs.data.filter(o => { o.code.startsWith('X:') && !o.code.contains(':PATTERN') }) %>",
                "rowVariableName": "org",
                "enabled": false,
                "label": "Shell Organizations",
                "autoPaging": true,
                "visible": "<% empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { o.code.startsWith('X:') && !o.code.contains(':PATTERN') })) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colAllOrgName",
                    "columnId": "colAllOrgName",
                    "label": "Organization Name",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "instanceList",
                      "view": true,
                      "relatedTask": true,
                      "values": "<% [org] %>",
                      "widKey": "workdayID"
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAllOrgStatus",
                    "columnId": "colAllOrgStatus",
                    "label": "Status",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "richText",
                      "value": "<% org.cf_active1 == true ? '<span style=\"color:#065f46;font-weight:600;font-size:11px\">\u2713 Active</span>' : '<span style=\"color:#6b7280;font-weight:600;font-size:11px\">\u25cb Inactive</span>' %>"
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAllOrgManage",
                    "columnId": "colAllOrgManage",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "Manage",
                      "taskReference": {
                        "taskId": "manageShellOrgStatus",
                        "parameterBindings": {
                          "orgId": "<% org.workdayID ?? \"\" %>",
                          "orgCode": "<% org.code %>",
                          "orgName": "<% org.organizationByName.descriptor ?? org.code ?? \"\" %>",
                          "currentStatus": "<% org.cf_active1 == true ? 'Active' : 'Inactive' %>"
                        }
                      }
                    }
                  }
                ]
              }
            ],
            "_layout": {
              "density": "medium",
              "alignment": "left",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            }
          },
          {
            "type": "fieldSet",
            "id": "filteredShellOrgsFieldSet",
            "visible": "<% !empty(queryParams.appCode) %>",
            "title": "<% 'Shell Organizations \u2014 ' + (queryParams.appName ?? queryParams.appCode ?? '') %>",
            "children": [
              {
                "type": "richText",
                "id": "filteredShellOrgsEmptyMsg",
                "enabled": false,
                "value": "<span style=\"color:#374151;font-size:12px\">No shell organizations found for this application code.</span>",
                "visible": "<% !empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { o.code.startsWith((queryParams.appCode ?? '') + ':') && !o.code.contains(':PATTERN') })) == 0 %>"
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "filteredShellOrgsGrid",
                "rows": "<% empty(queryParams.appCode) ? [] : allShellOrgs.data.filter(o => { o.code.startsWith(queryParams.appCode + ':') && !o.code.contains(':PATTERN') }) %>",
                "rowVariableName": "org",
                "enabled": false,
                "label": "<% 'Shell Organizations for ' + (queryParams.appName ?? queryParams.appCode ?? '') %>",
                "autoPaging": true,
                "visible": "<% !empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { o.code.startsWith((queryParams.appCode ?? '') + ':') && !o.code.contains(':PATTERN') })) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colFiltOrgName",
                    "columnId": "colFiltOrgName",
                    "label": "Organization Name",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "instanceList",
                      "view": true,
                      "relatedTask": true,
                      "values": "<% [org] %>",
                      "widKey": "workdayID"
                    }
                  },
                  {
                    "type": "column",
                    "id": "colFiltOrgStatus",
                    "columnId": "colFiltOrgStatus",
                    "label": "Status",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "richText",
                      "value": "<% org.cf_active1 == true ? '<span style=\"color:#065f46;font-weight:600;font-size:11px\">\u2713 Active</span>' : '<span style=\"color:#6b7280;font-weight:600;font-size:11px\">\u25cb Inactive</span>' %>"
                    }
                  },
                  {
                    "type": "column",
                    "id": "colFiltOrgManage",
                    "columnId": "colFiltOrgManage",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "Manage",
                      "taskReference": {
                        "taskId": "manageShellOrgStatus",
                        "parameterBindings": {
                          "orgId": "<% org.workdayID ?? \"\" %>",
                          "orgCode": "<% org.code %>",
                          "orgName": "<% org.organizationByName.descriptor ?? org.code ?? \"\" %>",
                          "currentStatus": "<% org.cf_active1 == true ? 'Active' : 'Inactive' %>"
                        }
                      }
                    }
                  }
                ]
              }
            ],
            "_layout": {
              "density": "medium",
              "alignment": "left",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            }
          },
          {
            "type": "fieldSet",
            "id": "footerFieldSet1",
            "children": [
              {
                "type": "richText",
                "id": "footerText1",
                "enabled": false,
                "value": "<p style=\"text-align:center\"><span style=\"color:#002145;font-size:11px;font-weight:700;font-family:Arial,sans-serif;letter-spacing:2px;\">ECO-COMS</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> \u00b7 </span><span style=\"color:#002145;font-size:11px;font-family:Arial,sans-serif;\">University of British Columbia</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> \u00b7 </span><span style=\"color:#0055B7;font-size:11px;font-family:Arial,sans-serif;font-style:italic;\">Custom Organization Management System</span></p>"
              }
            ],
            "_layout": {
              "density": "medium",
              "alignment": "center",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            }
          }
        ]
      },
      {
        "type": "section",
        "label": "Manage Role Assignments",
        "children": [
          {
            "type": "fieldSet",
            "id": "roleAssignmentsFieldSet",
            "title": "Shell Role Assignments",
            "children": [
              {
                "type": "richText",
                "id": "roleAssignmentsNote",
                "enabled": false,
                "value": "<span style=\"color:#374151;font-size:12px\">Each row represents one role and its shell organization assignments. The <b>Organizations</b> column lists all shell orgs this role is assigned to<% !empty(queryParams.appCode) ? ' for the selected application' : '' %>.</span>"
              },
              {
                "type": "richText",
                "id": "rolesEmptyMsg",
                "enabled": false,
                "value": "<span style=\"color:#374151;font-size:12px\">No shell role assignments found<% !empty(queryParams.appCode) ? ' for ' + (queryParams.appName ?? queryParams.appCode) : '' %>.</span>",
                "visible": "<% size(shellRoles.data.filter(r => { r.roleAssignments != null && size(r.roleAssignments.filter(ra => { ra.organization != null && ra.organization.descriptor.startsWith(empty(queryParams.appCode) ? 'X:' : queryParams.appCode) })) > 0 })) == 0 %>"
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "roleAssignmentsGrid",
                "rows": "<% shellRoles.data.filter(r => { r.roleAssignments != null && size(r.roleAssignments.filter(ra => { ra.organization != null && ra.organization.descriptor.startsWith(empty(queryParams.appCode) ? 'X:' : queryParams.appCode) })) > 0 }) %>",
                "rowVariableName": "r",
                "enabled": false,
                "label": "Role Assignments",
                "autoPaging": true,
                "visible": "<% size(shellRoles.data.filter(r => { r.roleAssignments != null && size(r.roleAssignments.filter(ra => { ra.organization != null && ra.organization.descriptor.startsWith(empty(queryParams.appCode) ? 'X:' : queryParams.appCode) })) > 0 })) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colRoleName",
                    "columnId": "colRoleName",
                    "label": "Role",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% r.role.descriptor ?? '' %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colOrgTypes",
                    "columnId": "colOrgTypes",
                    "label": "Enabled Org Types",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% r.enabledForOrganizationTypes != null ? r.enabledForOrganizationTypes.map(t => { t.descriptor }).join(', ') : '\u2014' %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAssignmentOrgs",
                    "columnId": "colAssignmentOrgs",
                    "label": "Organizations",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% r.roleAssignments != null ? r.roleAssignments.filter(ra => { ra.organization != null && ra.organization.descriptor.startsWith(empty(queryParams.appCode) ? 'X:' : queryParams.appCode) }).map(ra => { ra.organization.descriptor }).join('; ') : '\u2014' %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAssignmentCount",
                    "columnId": "colAssignmentCount",
                    "label": "# Assignments",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% r.roleAssignments != null ? size(r.roleAssignments.filter(ra => { ra.organization != null && ra.organization.descriptor.startsWith(empty(queryParams.appCode) ? 'X:' : queryParams.appCode) })) : 0 %>",
                      "enabled": false
                    }
                  }
                ]
              }
            ],
            "_layout": {
              "density": "medium",
              "alignment": "left",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            }
          },
          {
            "type": "fieldSet",
            "id": "footerFieldSet3",
            "children": [
              {
                "type": "richText",
                "id": "footerText3",
                "enabled": false,
                "value": "<p style=\"text-align:center\"><span style=\"color:#002145;font-size:11px;font-weight:700;font-family:Arial,sans-serif;letter-spacing:2px;\">ECO-COMS</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> \u00b7 </span><span style=\"color:#002145;font-size:11px;font-family:Arial,sans-serif;\">University of British Columbia</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> \u00b7 </span><span style=\"color:#0055B7;font-size:11px;font-family:Arial,sans-serif;font-style:italic;\">Custom Organization Management System</span></p>"
              }
            ],
            "_layout": {
              "density": "medium",
              "alignment": "center",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            }
          }
        ]
      }
    ]
  }
}