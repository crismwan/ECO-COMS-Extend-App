{
  "id": "shellOrgManager",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "include": [
    "comsCardGenerator.script"
  ],
  "endPoints": [
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true"
    },
    {
      "name": "shellOrgPatterns",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "existingPatterns"
      }
    }
  ],
  "presentation": {
    "headerSize": "STANDARD",
    "pageType": "view",
    "title": {
      "type": "title",
      "label": "ECO-COMS: Shell Org Manager",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "shellOrgManagerForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK"
            },
            {
              "type": "button",
              "label": "Add Pattern",
              "taskReference": {
                "taskId": "newShellOrgPattern"
              },
              "action": "PRIMARY"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "appSelectorSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "appSelectorFieldSet",
              "title": "Select Application",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "fixed",
                "labelPosition": "side_align_left"
              },
              "children": [
                {
                  "type": "dropdown",
                  "id": "selectedApplicationId",
                  "label": "Application",
                  "helpText": "Select an application to view and manage its shell org patterns.",
                  "instanceListLoopTag": {
                    "id": "selectedApplicationIdList",
                    "type": "instanceLoop",
                    "templateInstance": {
                      "id": "<% app.id %>",
                      "descriptor": "<% app.appId %>"
                    },
                    "on": "<% comsApplications.data %>",
                    "as": "app"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "contextCardSection",
          "children": [
            {
              "type": "cardContainer",
              "id": "contextCardContainer",
              "layout": "grid",
              "visible": "<% !empty(selectedApplicationId.value) %>",
              "cards": [
                {
                  "type": "card",
                  "cardId": "AppContextCard",
                  "parameters": {
                    "info": "<% comsCardGenerator.appContextInfo(empty(selectedApplicationId.value) ? null : comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] }).size() > 0 ? comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] })[0].appId : null) %>"
                  }
                },
                {
                  "type": "card",
                  "cardId": "StatusGuideCard",
                  "parameters": {
                    "info": "<% comsCardGenerator.statusGuideInfo('Active') %>"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "patternsSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "patternsFieldSet",
              "visible": "<% !empty(selectedApplicationId.value) %>",
              "title": "Shell Org Patterns",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "saveNote",
                  "enabled": false,
                  "value": "<span style=\"color:#d97706;font-size:11px;font-weight:700\">⚠ </span><span style=\"color:#92400e;font-size:11px\"><b>Warning:</b> Changing Status to Inactive does not automatically remove any Workday role assignments referencing this shell organization. Verify in Workday (Get_Assign_User_Based_Security_Groups) that no active role assignment uses this Custom Organization before inactivating.</span>"
                },
                {
                  "type": "richText",
                  "id": "emptyStateMsg",
                  "enabled": false,
                  "value": "<span style=\"color:#374151;font-size:12px\">No shell org patterns found for this application. Use the <b>Add Pattern</b> button above to create one.</span>",
                  "visible": "<% !empty(selectedApplicationId.value) && size(shellOrgPatterns.data.filter(p => { let appCode = comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] }).size() > 0 ? comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] })[0].appId : ''; p.code.startsWith(appCode + ':PATTERN') })) == 0 %>"
                },
                {
                  "type": "grid",
                  "gridType": "LIST",
                  "multiViewStylingEnabled": true,
                  "id": "patternsGrid",
                  "rows": "<% let appCode = empty(selectedApplicationId.value) ? '' : (comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] }).size() > 0 ? comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] })[0].appId : ''); shellOrgPatterns.data.filter(p => { p.code.startsWith(appCode + ':PATTERN') }) %>",
                  "rowVariableName": "pattern",
                  "enabled": false,
                  "label": "Shell Org Patterns",
                  "autoPaging": true,
                  "visible": "<% !empty(selectedApplicationId.value) && size(shellOrgPatterns.data.filter(p => { let appCode = comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] }).size() > 0 ? comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] })[0].appId : ''; p.code.startsWith(appCode + ':PATTERN') })) > 0 %>",
                  "columns": [
                    {
                      "type": "column",
                      "id": "colPatternName",
                      "columnId": "colPatternName",
                      "label": "Organization Name",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% pattern.organizationByName.descriptor %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colPatternCode",
                      "columnId": "colPatternCode",
                      "label": "Pattern Code",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% pattern.code %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colStatus",
                      "columnId": "colStatus",
                      "label": "Status",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "richText",
                        "value": "<% pattern.cf_active1 == true ? '<span style=\"color:#065f46;font-weight:600;font-size:11px\">✓ Active</span>' : '<span style=\"color:#6b7280;font-weight:600;font-size:11px\">○ Inactive</span>' %>"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "noAppSection",
          "children": [
            {
              "type": "richText",
              "id": "selectAppPrompt",
              "visible": "<% empty(selectedApplicationId.value) %>",
              "enabled": false,
              "value": "<span style=\"color:#374151;font-size:12px\">Select an application above to view its shell org patterns.</span>"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}
