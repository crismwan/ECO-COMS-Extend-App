{
  "id": "shellOrgManager",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "endPoints": [
    {
      "name": "orgSubtypes",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "orgSubtypes"
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "shellRoles",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellAssignableRolesinTenant",
        "parameters": {
          "types": "<% let ts = (allShellOrgs.data ?? []).map(o => { (o.type1 ?? []).size() > 0 ? o.type1[0].id : '' }).filter(t => { t != '' }).distinct(); ts.size() > 0 ? ts.join(',') : 'none' %>"
        }
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "allShellOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellOrgs",
        "parameters": {
          "subtypes": "<% (orgSubtypes.data ?? []).filter(r => { empty(r.subtype) ? false : (r.subtype.descriptor == 'X:META' || r.subtype.descriptor == 'X:SHELL') }).map(r => { r.subtype.id }).join(',') %>"
        }
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications?limit=100",
      "authType": "sso",
      "isCollection": true,
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    }
  ],
  "presentation": {
    "headerSize": "HIDDEN",
    "pageType": "VIEW",
    "body": {
      "type": "basicFormLayout",
      "id": "shellOrgManagerForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "titleBannerSection",
          "children": [
            {
              "type": "richText",
              "id": "titleBannerRichText",
              "enabled": false,
              "value": "<% '<span style=\"color:#0055B3;font-size:24px\"><b>' + (empty(queryParams.appName) ? 'ECO-COMS: Shell Org Manager' : ('ECO-COMS: Shell Org Manager – ' + queryParams.appName)).replace('<', '&lt;') + '</b></span>' + '<br><span style=\"color:#374151;font-size:13px\">Shell organizations, patterns and role assignments for one application.</span>' %>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "navFieldSet",
              "title": "",
              "children": [
                {
                  "type": "button",
                  "id": "backToHomeBtn",
                  "label": "← Home",
                  "taskReference": {
                    "taskId": "home"
                  },
                  "action": "LINK",
                  "suppressDiscardDialog": true
                }
              ]
            },
            {
              "type": "cardContainer",
              "id": "appBarCardContainer",
              "layout": "masonry",
              "dynamicCards": {
                "on": "<% comsAppIndex.barCards(allShellOrgs.data, comsApplications.data, (queryParams.appCode ?? ''), (queryParams.family ?? ''), (empty(queryParams.appCode) ? '' : comsPatterns.summary(comsApplications.data, queryParams.appCode))) %>",
                "as": "barCard",
                "template": {
                  "cardId": "<% barCard.cardId %>",
                  "parameters": "<% barCard.params %>"
                }
              }
            }
          ]
        }
      ]
    },
    "tabs": [
      {
        "type": "section",
        "label": "Summary",
        "children": [
          {
            "type": "cardContainer",
            "id": "summaryCardContainer",
            "layout": "masonry",
            "cards": [
              {
                "type": "card",
                "cardId": "QuickShellOrgManagerCard",
                "parameters": "<% { 'mark': ((queryParams.quick ?? '') == 'active') ? 'y' : '', 'b_appCode': (queryParams.appCode ?? ''), 'b_appName': (queryParams.appName ?? ''), 'b_family': (queryParams.family ?? ''), 'b_orgType': (queryParams.orgType ?? ''), 'b_quick': ((queryParams.quick ?? '') == 'active' ? '' : 'active'), 'title': 'Active', 'subtitle': (empty(queryParams.appCode) ? 'All applications' : queryParams.appCode), 'countText': '' + size((allShellOrgs.data ?? []).filter(o => { (empty(queryParams.appCode) || (o.code ?? '').startsWith(queryParams.appCode + ':')) && !(o.code ?? '').contains(':PATTERN') }).filter(o => { o.cf_active1 == true })) + (size((allShellOrgs.data ?? []).filter(o => { (empty(queryParams.appCode) || (o.code ?? '').startsWith(queryParams.appCode + ':')) && !(o.code ?? '').contains(':PATTERN') }).filter(o => { o.cf_active1 == true })) == 1 ? ' shell organization' : ' shell organizations') } %>"
              },
              {
                "type": "card",
                "cardId": "QuickShellOrgManagerCard",
                "parameters": "<% { 'mark': ((queryParams.quick ?? '') == 'inactive') ? 'y' : '', 'b_appCode': (queryParams.appCode ?? ''), 'b_appName': (queryParams.appName ?? ''), 'b_family': (queryParams.family ?? ''), 'b_orgType': (queryParams.orgType ?? ''), 'b_quick': ((queryParams.quick ?? '') == 'inactive' ? '' : 'inactive'), 'title': 'Inactive', 'subtitle': (empty(queryParams.appCode) ? 'All applications' : queryParams.appCode), 'countText': '' + size((allShellOrgs.data ?? []).filter(o => { (empty(queryParams.appCode) || (o.code ?? '').startsWith(queryParams.appCode + ':')) && !(o.code ?? '').contains(':PATTERN') }).filter(o => { o.cf_active1 != true })) + (size((allShellOrgs.data ?? []).filter(o => { (empty(queryParams.appCode) || (o.code ?? '').startsWith(queryParams.appCode + ':')) && !(o.code ?? '').contains(':PATTERN') }).filter(o => { o.cf_active1 != true })) == 1 ? ' shell organization' : ' shell organizations') } %>"
              },
              {
                "type": "card",
                "cardId": "QuickShellOrgManagerCard",
                "parameters": "<% { 'mark': ((queryParams.quick ?? '') == 'patterns') ? 'y' : '', 'b_appCode': (queryParams.appCode ?? ''), 'b_appName': (queryParams.appName ?? ''), 'b_family': (queryParams.family ?? ''), 'b_orgType': (queryParams.orgType ?? ''), 'b_quick': ((queryParams.quick ?? '') == 'patterns' ? '' : 'patterns'), 'title': 'Patterns', 'subtitle': (empty(queryParams.appCode) ? 'All applications' : queryParams.appCode), 'countText': '' + size((allShellOrgs.data ?? []).filter(o => { (empty(queryParams.appCode) || (o.code ?? '').startsWith(queryParams.appCode + ':PATTERN')) && (o.code ?? '').contains(':PATTERN') })) + (size((allShellOrgs.data ?? []).filter(o => { (empty(queryParams.appCode) || (o.code ?? '').startsWith(queryParams.appCode + ':PATTERN')) && (o.code ?? '').contains(':PATTERN') })) == 1 ? ' pattern' : ' patterns') } %>"
              },
              {
                "type": "card",
                "cardId": "ShellOrgQuickActionsCard"
              },
              {
                "type": "card",
                "cardId": "ShellOrgStatusChart",
                "parameters": "<% { 'activeCount': size((allShellOrgs.data ?? []).filter(o => { (empty(queryParams.appCode) || (o.code ?? '').startsWith(queryParams.appCode + ':')) && !(o.code ?? '').contains(':PATTERN') }).filter(o => { o.cf_active1 == true })), 'inactiveCount': size((allShellOrgs.data ?? []).filter(o => { (empty(queryParams.appCode) || (o.code ?? '').startsWith(queryParams.appCode + ':')) && !(o.code ?? '').contains(':PATTERN') }).filter(o => { o.cf_active1 != true })) } %>"
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "label": "Application Patterns",
        "children": [
          {
            "type": "fieldSet",
            "id": "patternsAboutFieldSet",
            "title": "About This Tab",
            "children": [
              {
                "type": "richText",
                "id": "patternsAboutRichText",
                "enabled": false,
                "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">A <b>pattern</b> is a Custom Organization (subtype X:SHELL) whose code follows its application's own format: <b>&lt;application&gt;:&lt;prefix&gt;:&lt;field&gt;:&lt;field&gt;…</b>. Each application sets its prefixes and fields; <b>*</b> means any. Roles assigned on a pattern apply to everything it matches. Only applications with a pattern format appear below: use <b>Manage</b> to see an application's patterns and <b>Add Pattern</b> to create one. Patterns can be inactivated but not deleted.</span>"
              }
            ],
            "collapsible": true,
            "initializeCollapsed": true
          },
          {
            "type": "fieldSet",
            "id": "appsFieldSet",
            "visible": "<% empty(queryParams.appCode) %>",
            "title": "Applications",
            "children": [
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "appsGrid",
                "rows": "<% comsAppIndex.appIds(allShellOrgs.data, comsApplications.data).map(appCode => { {'appCode': appCode} }) %>",
                "rowVariableName": "app",
                "enabled": false,
                "label": "Applications",
                "autoPaging": true,
                "columns": [
                  {
                    "type": "column",
                    "columnId": "colAppId",
                    "label": "Application ID",
                    "cellTemplate": {
                      "type": "button",
                      "id": "appIdLinkButton",
                      "action": "LINK",
                      "label": "<% app.appCode ?? '' %>",
                      "suppressDiscardDialog": true,
                      "taskReference": {
                        "taskId": "shellOrgManager",
                        "parameterBindings": {
                          "appCode": "<% app.appCode %>",
                          "appName": "<% app.appCode %>"
                        }
                      }
                    },
                    "excel": {
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "columnId": "colAppTitle",
                    "label": "Name",
                    "cellTemplate": {
                      "type": "text",
                      "id": "appTitleText",
                      "enabled": false,
                      "value": "<% (comsPatterns.recordFor(comsApplications.data, app.appCode) ?? {'name': ''}).name ?? '' %>"
                    }
                  },
                  {
                    "type": "column",
                    "columnId": "colAppFormat",
                    "label": "Pattern Format",
                    "cellTemplate": {
                      "type": "text",
                      "id": "appFormatText",
                      "enabled": false,
                      "value": "<% (empty(comsPatterns.recordFor(comsApplications.data, app.appCode)) ? 'No pattern yet' : comsPatterns.summary(comsApplications.data, app.appCode)) %>"
                    }
                  },
                  {
                    "type": "column",
                    "columnId": "colAppAction",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "id": "appActionButton",
                      "label": "Manage",
                      "action": "AUXILIARY",
                      "suppressDiscardDialog": true,
                      "taskReference": {
                        "taskId": "shellOrgManager",
                        "parameterBindings": {
                          "appCode": "<% app.appCode %>",
                          "appName": "<% app.appCode %>"
                        }
                      }
                    },
                    "excel": {
                      "enabled": false
                    }
                  }
                ],
                "excelExportEnabled": true
              }
            ]
          },
          {
            "type": "fieldSet",
            "id": "patternsFieldSet",
            "visible": "<% !empty(queryParams.appCode) %>",
            "title": "Shell Org Patterns",
            "children": [
              {
                "type": "button",
                "id": "addPatternBtn",
                "label": "Add Pattern",
                "taskReference": {
                  "taskId": "newSchemaPattern",
                  "parameterBindings": {
                    "appCode": "<% queryParams.appCode ?? '' %>"
                  }
                },
                "action": "PRIMARY",
                "render": "<% (comsApplications.data ?? []).filter(a => { a.appId == (queryParams.appCode ?? '') && a.active != false }).size() > 0 %>"
              },
              {
                "type": "button",
                "id": "setupPatternBtn",
                "label": "Set Up Pattern Format",
                "action": "AUXILIARY",
                "render": "<% !empty(queryParams.appCode) && (comsApplications.data ?? []).filter(a => { a.appId == (queryParams.appCode ?? '') }).size() == 0 %>",
                "taskReference": {
                  "taskId": "editAppPattern"
                }
              },
              {
                "type": "richText",
                "id": "saveNote",
                "enabled": false,
                "value": "<span style=\"color:#d97706;font-size:12px;font-weight:700\">⚠ </span><span style=\"color:#92400e;font-size:12px\"><b>Warning:</b> Changing Status to Inactive does not automatically remove any Workday role assignments referencing this shell organization. Verify in Workday (Get_Assign_User_Based_Security_Groups) that no active role assignment uses this Custom Organization before inactivating.</span>"
              },
              {
                "type": "text",
                "id": "patternsEmptyText",
                "enabled": false,
                "label": "ⓘ Nothing to show",
                "visible": "<% !empty(queryParams.appCode) && size((empty(queryParams.appCode) ? [] : ((queryParams.appCode == 'X:CLW') ? (allShellOrgs.data ?? []).filter(p => { (p.code ?? '').contains(':PATTERN:') }).filter(p => { p.code.startsWith((queryParams.appCode ?? '') + ':PATTERN') }) : (allShellOrgs.data ?? []).filter(o => { ((comsApplications.data ?? []).filter(a => { a.appId == (queryParams.appCode ?? '') }).map(a => { a.namePrefix ?? '' }).join(',')).split(',').filter(pf => { !empty(pf) && (o.code ?? '').startsWith((queryParams.appCode ?? '') + ':' + pf + ':') }).size() > 0 })))) == 0 %>",
                "value": "<% (comsApplications.data ?? []).filter(a => { a.appId == (queryParams.appCode ?? '') }).size() == 0 ? 'No pattern format is set up for this application yet. Use Set Up Pattern Format above first, then add patterns.' : ((comsApplications.data ?? []).filter(a => { a.appId == (queryParams.appCode ?? '') && a.active != false }).size() == 0 ? 'The pattern format for this application is inactive. Reactivate it in Maintain Application Pattern to add patterns.' : 'No shell org patterns found for this application. Use the Add Pattern button above to create one.') %>"
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "patternsGrid",
                "rows": "<% (empty(queryParams.appCode) ? [] : ((queryParams.appCode == 'X:CLW') ? (allShellOrgs.data ?? []).filter(p => { (p.code ?? '').contains(':PATTERN:') }).filter(p => { p.code.startsWith((queryParams.appCode ?? '') + ':PATTERN') }) : (allShellOrgs.data ?? []).filter(o => { ((comsApplications.data ?? []).filter(a => { a.appId == (queryParams.appCode ?? '') }).map(a => { a.namePrefix ?? '' }).join(',')).split(',').filter(pf => { !empty(pf) && (o.code ?? '').startsWith((queryParams.appCode ?? '') + ':' + pf + ':') }).size() > 0 }))) %>",
                "rowVariableName": "pattern",
                "enabled": false,
                "label": "<% 'Patterns for ' + (queryParams.appName ?? queryParams.appCode ?? '') %>",
                "autoPaging": true,
                "visible": "<% !empty(queryParams.appCode) && size((empty(queryParams.appCode) ? [] : ((queryParams.appCode == 'X:CLW') ? (allShellOrgs.data ?? []).filter(p => { (p.code ?? '').contains(':PATTERN:') }).filter(p => { p.code.startsWith((queryParams.appCode ?? '') + ':PATTERN') }) : (allShellOrgs.data ?? []).filter(o => { ((comsApplications.data ?? []).filter(a => { a.appId == (queryParams.appCode ?? '') }).map(a => { a.namePrefix ?? '' }).join(',')).split(',').filter(pf => { !empty(pf) && (o.code ?? '').startsWith((queryParams.appCode ?? '') + ':' + pf + ':') }).size() > 0 })))) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colPatternName",
                    "columnId": "colPatternName",
                    "label": "Organization Name",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "instanceList",
                      "view": true,
                      "relatedTask": true,
                      "instanceList": [
                        {
                          "descriptor": "<% pattern.organizationByName.descriptor ?? pattern.code %>",
                          "wid": "<% pattern.workdayID %>"
                        }
                      ]
                    }
                  },
                  {
                    "type": "column",
                    "id": "colPatternCode",
                    "columnId": "colPatternCode",
                    "label": "Pattern Code",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% pattern.code %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colStatus",
                    "columnId": "colStatus",
                    "label": "Status",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "richText",
                      "value": "<% pattern.cf_active1 == true ? '<span style=\"color:#065f46;font-weight:600;font-size:12px\">✓ Active</span>' : '<span style=\"color:#6b7280;font-weight:600;font-size:12px\">○ Inactive</span>' %>"
                    }
                  },
                  {
                    "type": "column",
                    "id": "colPatternManage",
                    "columnId": "colPatternManage",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "<% pattern.cf_active1 == true ? 'Inactivate' : 'Activate' %>",
                      "taskReference": {
                        "taskId": "manageShellOrgStatus",
                        "parameterBindings": {
                          "orgId": "<% pattern.workdayID ?? \"\" %>",
                          "orgCode": "<% pattern.code %>",
                          "orgName": "<% pattern.organizationByName.descriptor ?? pattern.code ?? \"\" %>",
                          "currentStatus": "<% pattern.cf_active1 == true ? 'Active' : 'Inactive' %>",
                          "effectiveDate": "<% date:now().format(\"yyyy-MM-dd\") %>",
                          "patternName": "<% pattern.code %>",
                          "orgType": "<% queryParams.orgType ?? '' %>",
                          "comsAppId": "<% queryParams.appCode ?? '' %>"
                        }
                      }
                    },
                    "excel": {
                      "enabled": false
                    }
                  }
                ],
                "excelExportEnabled": true
              }
            ]
          },
          {
            "type": "fieldSet",
            "id": "footerFieldSet0",
            "children": [
              {
                "type": "richText",
                "id": "footerText0",
                "enabled": false,
                "value": "<p style=\"text-align:center\"><span style=\"color:#002145;font-size:12px;font-weight:700;font-family:Arial,sans-serif;letter-spacing:2px;\">ECO-COMS</span><span style=\"color:#6b7280;font-size:12px;font-family:Arial,sans-serif;\"> · </span><span style=\"color:#0055B7;font-size:12px;font-family:Arial,sans-serif;font-style:italic;\">Custom Organization Management System</span></p>"
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "label": "Application Shell Organizations",
        "children": [
          {
            "type": "fieldSet",
            "id": "shellOrgsAboutFieldSet",
            "title": "About This Tab",
            "children": [
              {
                "type": "richText",
                "id": "shellOrgsAboutRichText",
                "enabled": false,
                "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">A <b>shell organization</b> is a Custom Organization (type = the application code, for example X:CLW) that exists only so roles can be assigned on it. It holds no workers. <b>Status</b> shows whether it can still be used: inactivating one stops new assignments but does <b>not</b> remove existing role assignments, so check the Manage Role Assignments tab first.</span>"
              }
            ],
            "collapsible": true,
            "initializeCollapsed": true
          },
          {
            "type": "richText",
            "id": "shellOrgsAppWarning",
            "enabled": false,
            "visible": "<% !empty(queryParams.appCode) %>",
            "value": "<span style=\"color:#d97706;font-size:12px;font-weight:700\">⚠ </span><span style=\"color:#92400e;font-size:12px\"><b>Filtered view:</b> Narrowed to <b><% queryParams.appCode ?? '' %></b>: only its shell organizations are shown below. Use ✕ All applications above to see every organization.</span>"
          },
          {
            "type": "button",
            "id": "addNewOrgBtn",
            "label": "Add New Shell Organization",
            "taskReference": {
              "taskId": "createShellOrgWizard"
            },
            "action": "PRIMARY"
          },
          {
            "type": "fieldSet",
            "id": "allShellOrgsFieldSet",
            "visible": "<% empty(queryParams.appCode) %>",
            "title": "All Shell Organizations",
            "children": [
              {
                "type": "text",
                "id": "allShellOrgsEmptyMsg",
                "enabled": false,
                "label": "ⓘ Nothing to show",
                "visible": "<% empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { !o.code.contains(':PATTERN') })) == 0 %>",
                "value": "No shell organizations found."
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "allShellOrgsGrid",
                "rows": "<% (queryParams.quick ?? '') == 'patterns' ? (allShellOrgs.data ?? []).filter(o => { (o.code ?? '').contains(':PATTERN') && (empty(queryParams.appCode) || (o.code ?? '').startsWith(queryParams.appCode + ':PATTERN')) }) : (list:flatten([(allShellOrgs.data.filter(o => { !o.code.contains(':PATTERN') })).filter(o => { o.cf_active1 == true }), (allShellOrgs.data.filter(o => { !o.code.contains(':PATTERN') })).filter(o => { o.cf_active1 != true })])).filter(o => { (queryParams.quick ?? '') == 'active' ? o.cf_active1 == true : ((queryParams.quick ?? '') == 'inactive' ? o.cf_active1 != true : true) }) %>",
                "rowVariableName": "org",
                "enabled": false,
                "label": "Shell Organizations",
                "autoPaging": true,
                "visible": "<% empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { !o.code.contains(':PATTERN') })) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colAllOrgName",
                    "columnId": "colAllOrgName",
                    "label": "Organization Name",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "instanceList",
                      "view": true,
                      "relatedTask": true,
                      "instanceList": [
                        {
                          "descriptor": "<% org.organizationByName.descriptor ?? org.code %>",
                          "wid": "<% org.workdayID %>"
                        }
                      ]
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAllOrgStatus",
                    "columnId": "colAllOrgStatus",
                    "label": "Status",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "richText",
                      "value": "<% org.cf_active1 == true ? '<span style=\"color:#065f46;font-weight:600;font-size:12px\">✓ Active</span>' : '<span style=\"color:#6b7280;font-weight:600;font-size:12px\">○ Inactive</span>' %>"
                    }
                  },
                  {
                    "type": "column",
                    "columnId": "colAllOrgDetails",
                    "label": "Details",
                    "excel": {
                      "enabled": false
                    },
                    "cellTemplate": {
                      "type": "button",
                      "id": "colAllOrgDetailsButton",
                      "label": "Details",
                      "action": "AUXILIARY",
                      "taskReference": {
                        "taskId": "shellOrgDetail",
                        "parameterBindings": {
                          "orgId": "<% org.workdayID ?? '' %>",
                          "orgCode": "<% org.code ?? '' %>",
                          "orgName": "<% org.organizationByName.descriptor ?? org.code ?? '' %>",
                          "appCode": "<% queryParams.appCode ?? '' %>",
                          "appName": "<% queryParams.appName ?? '' %>"
                        }
                      }
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAllOrgManage",
                    "columnId": "colAllOrgManage",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "Manage",
                      "taskReference": {
                        "taskId": "manageShellOrgStatus",
                        "parameterBindings": {
                          "orgId": "<% org.workdayID ?? \"\" %>",
                          "orgCode": "<% org.code %>",
                          "orgName": "<% org.organizationByName.descriptor ?? org.code ?? \"\" %>",
                          "currentStatus": "<% org.cf_active1 == true ? 'Active' : 'Inactive' %>",
                          "effectiveDate": "<% date:now().format(\"yyyy-MM-dd\") %>",
                          "patternName": "<% org.code %>",
                          "orgType": "<% queryParams.orgType ?? '' %>",
                          "comsAppId": "<% queryParams.appCode ?? '' %>"
                        }
                      }
                    },
                    "excel": {
                      "enabled": false
                    }
                  }
                ],
                "excelExportEnabled": true
              }
            ]
          },
          {
            "type": "fieldSet",
            "id": "filteredShellOrgsFieldSet",
            "visible": "<% !empty(queryParams.appCode) %>",
            "title": "<% 'Shell Organizations — ' + (queryParams.appName ?? queryParams.appCode ?? '') %>",
            "children": [
              {
                "type": "text",
                "id": "filteredShellOrgsEmptyMsg",
                "enabled": false,
                "label": "ⓘ Nothing to show",
                "visible": "<% !empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { o.code.startsWith((queryParams.appCode ?? '') + ':') && !o.code.contains(':PATTERN') })) == 0 %>",
                "value": "No shell organizations found for this application code."
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "filteredShellOrgsGrid",
                "rows": "<% (queryParams.quick ?? '') == 'patterns' ? (allShellOrgs.data ?? []).filter(o => { (o.code ?? '').contains(':PATTERN') && (empty(queryParams.appCode) || (o.code ?? '').startsWith(queryParams.appCode + ':PATTERN')) }) : (list:flatten([(empty(queryParams.appCode) ? [] : allShellOrgs.data.filter(o => { o.code.startsWith(queryParams.appCode + ':') && !o.code.contains(':PATTERN') })).filter(o => { o.cf_active1 == true }), (empty(queryParams.appCode) ? [] : allShellOrgs.data.filter(o => { o.code.startsWith(queryParams.appCode + ':') && !o.code.contains(':PATTERN') })).filter(o => { o.cf_active1 != true })])).filter(o => { (queryParams.quick ?? '') == 'active' ? o.cf_active1 == true : ((queryParams.quick ?? '') == 'inactive' ? o.cf_active1 != true : true) }) %>",
                "rowVariableName": "org",
                "enabled": false,
                "label": "<% 'Shell Organizations for ' + (queryParams.appName ?? queryParams.appCode ?? '') %>",
                "autoPaging": true,
                "visible": "<% !empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { o.code.startsWith((queryParams.appCode ?? '') + ':') && !o.code.contains(':PATTERN') })) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colFiltOrgName",
                    "columnId": "colFiltOrgName",
                    "label": "Organization Name",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "instanceList",
                      "view": true,
                      "relatedTask": true,
                      "instanceList": [
                        {
                          "descriptor": "<% org.organizationByName.descriptor ?? org.code %>",
                          "wid": "<% org.workdayID %>"
                        }
                      ]
                    }
                  },
                  {
                    "type": "column",
                    "id": "colFiltOrgStatus",
                    "columnId": "colFiltOrgStatus",
                    "label": "Status",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "richText",
                      "value": "<% org.cf_active1 == true ? '<span style=\"color:#065f46;font-weight:600;font-size:12px\">✓ Active</span>' : '<span style=\"color:#6b7280;font-weight:600;font-size:12px\">○ Inactive</span>' %>"
                    }
                  },
                  {
                    "type": "column",
                    "columnId": "colFiltOrgDetails",
                    "label": "Details",
                    "excel": {
                      "enabled": false
                    },
                    "cellTemplate": {
                      "type": "button",
                      "id": "colFiltOrgDetailsButton",
                      "label": "Details",
                      "action": "AUXILIARY",
                      "taskReference": {
                        "taskId": "shellOrgDetail",
                        "parameterBindings": {
                          "orgId": "<% org.workdayID ?? '' %>",
                          "orgCode": "<% org.code ?? '' %>",
                          "orgName": "<% org.organizationByName.descriptor ?? org.code ?? '' %>",
                          "appCode": "<% queryParams.appCode ?? '' %>",
                          "appName": "<% queryParams.appName ?? '' %>"
                        }
                      }
                    }
                  },
                  {
                    "type": "column",
                    "id": "colFiltOrgManage",
                    "columnId": "colFiltOrgManage",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "Manage",
                      "taskReference": {
                        "taskId": "manageShellOrgStatus",
                        "parameterBindings": {
                          "orgId": "<% org.workdayID ?? \"\" %>",
                          "orgCode": "<% org.code %>",
                          "orgName": "<% org.organizationByName.descriptor ?? org.code ?? \"\" %>",
                          "currentStatus": "<% org.cf_active1 == true ? 'Active' : 'Inactive' %>",
                          "effectiveDate": "<% date:now().format(\"yyyy-MM-dd\") %>",
                          "patternName": "<% org.code %>",
                          "orgType": "<% queryParams.orgType ?? '' %>",
                          "comsAppId": "<% queryParams.appCode ?? '' %>"
                        }
                      }
                    },
                    "excel": {
                      "enabled": false
                    }
                  }
                ],
                "excelExportEnabled": true
              }
            ]
          },
          {
            "type": "fieldSet",
            "id": "footerFieldSet1",
            "children": [
              {
                "type": "richText",
                "id": "footerText1",
                "enabled": false,
                "value": "<p style=\"text-align:center\"><span style=\"color:#002145;font-size:12px;font-weight:700;font-family:Arial,sans-serif;letter-spacing:2px;\">ECO-COMS</span><span style=\"color:#6b7280;font-size:12px;font-family:Arial,sans-serif;\"> · </span><span style=\"color:#0055B7;font-size:12px;font-family:Arial,sans-serif;font-style:italic;\">Custom Organization Management System</span></p>"
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "label": "Manage Role Assignments",
        "children": [
          {
            "type": "fieldSet",
            "id": "rolesAboutFieldSet",
            "title": "About This Tab",
            "children": [
              {
                "type": "richText",
                "id": "roleAssignmentsNote",
                "enabled": false,
                "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Each row is one <b>role</b> assigned on one <b>shell organization</b>. <b>Positions</b> are the positions that hold the role; <b>Workers</b> are the people currently in those positions, so a vacant position shows no worker. Use the row's action to add or remove positions; every change is written to the Audit Log<% !empty(queryParams.appCode) ? '. Showing the selected application only' : '' %>.</span>"
              }
            ],
            "collapsible": true,
            "initializeCollapsed": true
          },
          {
            "type": "fieldSet",
            "id": "roleAssignmentsFieldSet",
            "title": "Shell Role Assignments",
            "children": [
              {
                "type": "text",
                "id": "rolesEmptyText",
                "enabled": false,
                "label": "ⓘ Nothing to show",
                "visible": "<% size(list:flatten((shellRoles.data ?? []).map(r => { (r.roleAssignments ?? []).filter(ra => { ra.organization != null && (empty(queryParams.appCode) ? true : (ra.organization.descriptor == queryParams.appCode || ra.organization.descriptor.startsWith(queryParams.appCode + ':') || ra.organization.descriptor.startsWith(queryParams.appCode + ' '))) }).map(ra => { { 'role': r.role, 'org': ra.organization, 'positions': ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions ?? [], 'workers': ra.workersAssigned ?? [] } }) }))) == 0 %>",
                "value": ""
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "roleAssignmentsGrid",
                "rows": "<% list:flatten((shellRoles.data ?? []).map(r => { (r.roleAssignments ?? []).filter(ra => { ra.organization != null && (empty(queryParams.appCode) ? true : (ra.organization.descriptor == queryParams.appCode || ra.organization.descriptor.startsWith(queryParams.appCode + ':') || ra.organization.descriptor.startsWith(queryParams.appCode + ' '))) }).map(ra => { { 'role': r.role, 'org': ra.organization, 'positions': ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions ?? [], 'workers': ra.workersAssigned ?? [] } }) })) %>",
                "rowVariableName": "ra",
                "label": "Role Assignments",
                "autoPaging": true,
                "visible": "<% size(list:flatten((shellRoles.data ?? []).map(r => { (r.roleAssignments ?? []).filter(ra => { ra.organization != null && (empty(queryParams.appCode) ? true : (ra.organization.descriptor == queryParams.appCode || ra.organization.descriptor.startsWith(queryParams.appCode + ':') || ra.organization.descriptor.startsWith(queryParams.appCode + ' '))) }).map(ra => { { 'role': r.role, 'org': ra.organization, 'positions': ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions ?? [], 'workers': ra.workersAssigned ?? [] } }) }))) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colRoleName",
                    "columnId": "colRoleName",
                    "label": "Role",
                    "cellTemplate": {
                      "type": "instanceList",
                      "id": "colRoleNameInstanceList",
                      "view": true,
                      "relatedTask": true,
                      "enabled": false,
                      "values": "<% ra.role != null ? [ra.role] : [] %>",
                      "widKey": "id"
                    },
                    "sortableAndFilterable": "true"
                  },
                  {
                    "type": "column",
                    "id": "colAssignmentOrg",
                    "columnId": "colAssignmentOrg",
                    "label": "Organization",
                    "cellTemplate": {
                      "type": "instanceList",
                      "id": "colAssignmentOrgInstanceList",
                      "view": true,
                      "relatedTask": true,
                      "enabled": false,
                      "values": "<% ra.org != null ? [ra.org] : [] %>",
                      "widKey": "id"
                    },
                    "sortableAndFilterable": "true"
                  },
                  {
                    "type": "column",
                    "id": "colPositions",
                    "columnId": "colPositions",
                    "label": "Positions",
                    "cellTemplate": {
                      "type": "instanceList",
                      "id": "colPositionsInstanceList",
                      "view": true,
                      "relatedTask": true,
                      "enabled": false,
                      "values": "<% ra.positions %>",
                      "widKey": "id"
                    },
                    "sortableAndFilterable": "true"
                  },
                  {
                    "type": "column",
                    "id": "colWorkers",
                    "columnId": "colWorkers",
                    "label": "Workers",
                    "cellTemplate": {
                      "type": "instanceList",
                      "id": "colWorkersInstanceList",
                      "view": true,
                      "relatedTask": true,
                      "enabled": false,
                      "values": "<% ra.workers %>",
                      "widKey": "id"
                    },
                    "sortableAndFilterable": "true"
                  },
                  {
                    "type": "column",
                    "id": "colRoleManage",
                    "columnId": "colRoleManage",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "Manage",
                      "taskReference": {
                        "taskId": "editRoleAssignment",
                        "parameterBindings": {
                          "roleId": "<% ra.role.id ?? '' %>",
                          "roleName": "<% ra.role.descriptor ?? '' %>",
                          "orgId": "<% ra.org.id ?? '' %>",
                          "orgName": "<% ra.org.descriptor ?? '' %>",
                          "appCode": "<% queryParams.appCode ?? '' %>",
                          "appName": "<% queryParams.appName ?? '' %>"
                        }
                      }
                    },
                    "excel": {
                      "enabled": false
                    }
                  }
                ],
                "excelExportEnabled": true
              }
            ]
          },
          {
            "type": "fieldSet",
            "id": "footerFieldSet3",
            "children": [
              {
                "type": "richText",
                "id": "footerText3",
                "enabled": false,
                "value": "<p style=\"text-align:center\"><span style=\"color:#002145;font-size:12px;font-weight:700;font-family:Arial,sans-serif;letter-spacing:2px;\">ECO-COMS</span><span style=\"color:#6b7280;font-size:12px;font-family:Arial,sans-serif;\"> · </span><span style=\"color:#0055B7;font-size:12px;font-family:Arial,sans-serif;font-style:italic;\">Custom Organization Management System</span></p>"
              }
            ]
          }
        ]
      }
    ]
  },
  "include": [
    "comsPatterns.script",
    "comsAppIndex.script"
  ]
}
