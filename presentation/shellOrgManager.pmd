{
  "id": "shellOrgManager",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "include": [
    "comsCardGenerator.script"
  ],
  "endPoints": [
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true"
    },
    {
      "name": "shellOrgPatterns",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "existingPatterns"
      }
    }
  ],
  "presentation": {
    "headerSize": "STANDARD",
    "pageType": "view",
    "title": {
      "type": "title",
      "label": "<% empty(queryParams.appName) ? 'ECO-COMS: Shell Org Manager' : (queryParams.appName ?? '') %>",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "shellOrgManagerForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "richText",
              "id": "pageSubtitle",
              "enabled": false,
              "value": "<% empty(queryParams.appCode) ? '<span style=\"color:#6b7280;font-size:12px\">Select an application to manage its shell org patterns.</span>' : '<span style=\"color:#6b7280;font-size:12px\">App ID: ' + (queryParams.appCode ?? '') + '</span>' %>"
            },
            {
              "type": "button",
              "label": "← Back to Applications",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "LINK",
              "visible": "<% !empty(queryParams.appCode) %>"
            },
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK",
              "visible": "<% empty(queryParams.appCode) %>"
            },
            {
              "type": "button",
              "label": "Add Pattern",
              "taskReference": {
                "taskId": "newShellOrgPattern"
              },
              "action": "PRIMARY"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "appsSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "appsFieldSet",
              "visible": "<% empty(queryParams.appCode) %>",
              "title": "Applications",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "grid",
                  "gridType": "LIST",
                  "multiViewStylingEnabled": true,
                  "id": "appsGrid",
                  "rows": "<% comsApplications.data %>",
                  "rowVariableName": "app",
                  "enabled": false,
                  "label": "Applications",
                  "autoPaging": true,
                  "columns": [
                    {
                      "type": "column",
                      "id": "colAppName",
                      "columnId": "colAppName",
                      "label": "Application Name",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% app.name ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colAppActions",
                      "columnId": "colAppActions",
                      "label": "Actions",
                      "cellTemplate": {
                        "type": "button",
                        "action": "AUXILIARY",
                        "label": "View Patterns",
                        "taskReference": {
                          "taskId": "shellOrgManager",
                          "parameterBindings": {
                            "appCode": "<% app.appId %>",
                            "appName": "<% app.name %>"
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "patternsSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "patternsFieldSet",
              "visible": "<% !empty(queryParams.appCode) %>",
              "title": "Shell Org Patterns",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "saveNote",
                  "enabled": false,
                  "value": "<span style=\"color:#d97706;font-size:11px;font-weight:700\">⚠ </span><span style=\"color:#92400e;font-size:11px\"><b>Warning:</b> Changing Status to Inactive does not automatically remove any Workday role assignments referencing this shell organization. Verify in Workday (Get_Assign_User_Based_Security_Groups) that no active role assignment uses this Custom Organization before inactivating.</span>"
                },
                {
                  "type": "richText",
                  "id": "emptyStateMsg",
                  "enabled": false,
                  "value": "<span style=\"color:#374151;font-size:12px\">No shell org patterns found for this application. Use the <b>Add Pattern</b> button above to create one.</span>",
                  "visible": "<% !empty(queryParams.appCode) && size(shellOrgPatterns.data.filter(p => { p.code.startsWith((queryParams.appCode ?? '') + ':PATTERN') })) == 0 %>"
                },
                {
                  "type": "grid",
                  "gridType": "LIST",
                  "multiViewStylingEnabled": true,
                  "id": "patternsGrid",
                  "rows": "<% empty(queryParams.appCode) ? [] : shellOrgPatterns.data.filter(p => { p.code.startsWith(queryParams.appCode + ':PATTERN') }) %>",
                  "rowVariableName": "pattern",
                  "enabled": false,
                  "label": "<% 'Patterns for ' + (queryParams.appName ?? queryParams.appCode ?? '') %>",
                  "autoPaging": true,
                  "visible": "<% !empty(queryParams.appCode) && size(shellOrgPatterns.data.filter(p => { p.code.startsWith((queryParams.appCode ?? '') + ':PATTERN') })) > 0 %>",
                  "columns": [
                    {
                      "type": "column",
                      "id": "colPatternName",
                      "columnId": "colPatternName",
                      "label": "Organization Name",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% pattern.organizationByName.descriptor %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colPatternCode",
                      "columnId": "colPatternCode",
                      "label": "Pattern Code",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% pattern.code %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colStatus",
                      "columnId": "colStatus",
                      "label": "Status",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "richText",
                        "value": "<% pattern.cf_active1 == true ? '<span style=\"color:#065f46;font-weight:600;font-size:11px\">✓ Active</span>' : '<span style=\"color:#6b7280;font-weight:600;font-size:11px\">○ Inactive</span>' %>"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}
