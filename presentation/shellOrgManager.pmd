{
  "id": "shellOrgManager",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "include": [
    "comsCardGenerator.script"
  ],
  "endPoints": [
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true"
    },
    {
      "name": "shellOrgPatterns",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "existingPatterns"
      }
    },
    {
      "name": "shellOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "customOrganizations"
      }
    },
    {
      "name": "shellRoles",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellAssignableRolesinTenant"
      }
    },
    {
      "name": "allShellOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellOrgs"
      }
    }
  ],
  "presentation": {
    "headerSize": "STANDARD",
    "pageType": "view",
    "title": {
      "type": "title",
      "label": "<% empty(queryParams.appName) ? 'ECO-COMS: Shell Org Manager' : (queryParams.appName ?? '') %>",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "shellOrgManagerForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Back to Applications",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "LINK",
              "visible": "<% !empty(queryParams.appCode) %>"
            },
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK",
              "visible": "<% empty(queryParams.appCode) %>"
            },
            {
              "type": "readOnlyText",
              "id": "pageSubtitle",
              "value": "<% empty(queryParams.appCode) ? 'Select an application to manage its shell orgs and patterns.' : (queryParams.appCode ?? '') + (empty(queryParams.appName) ? '' : ' · ' + (queryParams.appName ?? '')) %>"
            }
          ],
          "layout": {
            "density": "medium",
            "alignment": "left",
            "horizontalSizing": "stretch",
            "labelPosition": "top"
          }
        }
      ]
    },
    "tabs": [
      {
        "type": "section",
        "label": "Application Patterns",
        "children": [
          {
            "type": "fieldSet",
            "id": "appsFieldSet",
            "visible": "<% empty(queryParams.appCode) %>",
            "title": "Applications",
            "layout": {
              "density": "medium",
              "alignment": "left",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            },
            "children": [
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "appsGrid",
                "rows": "<% comsApplications.data %>",
                "rowVariableName": "app",
                "enabled": false,
                "label": "Applications",
                "autoPaging": true,
                "columns": [
                  {
                    "type": "column",
                    "id": "colAppName",
                    "columnId": "colAppName",
                    "label": "Application ID",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% app.appId ?? '' %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAppActions",
                    "columnId": "colAppActions",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "Manage",
                      "taskReference": {
                        "taskId": "shellOrgManager",
                        "parameterBindings": {
                          "appCode": "<% app.appId %>",
                          "appName": "<% app.name %>"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "fieldSet",
            "id": "patternsFieldSet",
            "visible": "<% !empty(queryParams.appCode) %>",
            "title": "Shell Org Patterns",
            "layout": {
              "density": "medium",
              "alignment": "left",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            },
            "children": [
              {
                "type": "button",
                "label": "Add Pattern",
                "taskReference": {
                  "taskId": "newShellOrgPattern"
                },
                "action": "PRIMARY"
              },
              {
                "type": "richText",
                "id": "saveNote",
                "enabled": false,
                "value": "<span style=\"color:#d97706;font-size:11px;font-weight:700\">⚠ </span><span style=\"color:#92400e;font-size:11px\"><b>Warning:</b> Changing Status to Inactive does not automatically remove any Workday role assignments referencing this shell organization. Verify in Workday (Get_Assign_User_Based_Security_Groups) that no active role assignment uses this Custom Organization before inactivating.</span>"
              },
              {
                "type": "richText",
                "id": "emptyStateMsg",
                "enabled": false,
                "value": "<span style=\"color:#374151;font-size:12px\">No shell org patterns found for this application. Use the <b>Add Pattern</b> button above to create one.</span>",
                "visible": "<% !empty(queryParams.appCode) && size(shellOrgPatterns.data.filter(p => { p.code.startsWith((queryParams.appCode ?? '') + ':PATTERN') })) == 0 %>"
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "patternsGrid",
                "rows": "<% empty(queryParams.appCode) ? [] : shellOrgPatterns.data.filter(p => { p.code.startsWith(queryParams.appCode + ':PATTERN') }) %>",
                "rowVariableName": "pattern",
                "enabled": false,
                "label": "<% 'Patterns for ' + (queryParams.appName ?? queryParams.appCode ?? '') %>",
                "autoPaging": true,
                "visible": "<% !empty(queryParams.appCode) && size(shellOrgPatterns.data.filter(p => { p.code.startsWith((queryParams.appCode ?? '') + ':PATTERN') })) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colPatternName",
                    "columnId": "colPatternName",
                    "label": "Organization Name",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% pattern.organizationByName.descriptor ?? '' %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colPatternCode",
                    "columnId": "colPatternCode",
                    "label": "Pattern Code",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% pattern.code %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colStatus",
                    "columnId": "colStatus",
                    "label": "Status",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "richText",
                      "value": "<% pattern.cf_active1 == true ? '<span style=\"color:#065f46;font-weight:600;font-size:11px\">✓ Active</span>' : '<span style=\"color:#6b7280;font-weight:600;font-size:11px\">○ Inactive</span>' %>"
                    }
                  },
                  {
                    "type": "column",
                    "id": "colPatternManage",
                    "columnId": "colPatternManage",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "<% pattern.cf_active1 == true ? 'Inactivate' : 'Activate' %>",
                      "taskReference": {
                        "taskId": "manageShellOrgStatus",
                        "parameterBindings": {
                          "orgId": "<% pattern.workdayID %>",
                          "orgCode": "<% pattern.code %>",
                          "orgName": "<% pattern.organizationByName.descriptor ?? pattern.code %>",
                          "currentStatus": "<% pattern.cf_active1 == true ? 'Active' : 'Inactive' %>"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "richText",
            "id": "patternsSelectAppMsg",
            "enabled": false,
            "visible": "<% empty(queryParams.appCode) %>",
            "value": "<span style=\"color:#6b7280;font-size:13px\">Select an application from the list above to view its shell org patterns.</span>"
          },
          {
            "type": "fieldSet",
            "id": "footerFieldSet0",
            "layout": {
              "density": "medium",
              "alignment": "center",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            },
            "children": [
              {
                "type": "richText",
                "id": "footerText0",
                "enabled": false,
                "value": "<p style=\"text-align:center\"><span style=\"color:#002145;font-size:11px;font-weight:700;font-family:Arial,sans-serif;letter-spacing:2px;\">ECO-COMS</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> · </span><span style=\"color:#002145;font-size:11px;font-family:Arial,sans-serif;\">University of British Columbia</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> · </span><span style=\"color:#0055B7;font-size:11px;font-family:Arial,sans-serif;font-style:italic;\">Custom Organization Management System</span></p>"
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "label": "Application Shell Organizations",
        "children": [
          {
            "type": "richText",
            "id": "shellOrgsAppWarning",
            "enabled": false,
            "visible": "<% !empty(queryParams.appCode) %>",
            "value": "<span style=\"color:#d97706;font-size:11px;font-weight:700\">⚠ </span><span style=\"color:#92400e;font-size:11px\"><b>Filtered view:</b> You selected <b><% queryParams.appCode ?? '' %></b> from the Application Patterns tab. Only shell organizations matching this application are shown below. <a href=\"javascript:void(0)\" style=\"color:#0055B7\">View all organizations</a> by navigating to Shell Org Manager without an application selected.</span>"
          },
          {
            "type": "fieldSet",
            "id": "allShellOrgsFieldSet",
            "visible": "<% empty(queryParams.appCode) %>",
            "title": "All Shell Organizations",
            "layout": {
              "density": "medium",
              "alignment": "left",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            },
            "children": [
              {
                "type": "richText",
                "id": "allShellOrgsEmptyMsg",
                "enabled": false,
                "value": "<span style=\"color:#374151;font-size:12px\">No shell organizations found.</span>",
                "visible": "<% empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { o.code.startsWith('X:') && !o.code.contains(':PATTERN') })) == 0 %>"
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "allShellOrgsGrid",
                "rows": "<% allShellOrgs.data.filter(o => { o.code.startsWith('X:') && !o.code.contains(':PATTERN') }) %>",
                "rowVariableName": "org",
                "enabled": false,
                "label": "Shell Organizations",
                "autoPaging": true,
                "visible": "<% empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { o.code.startsWith('X:') && !o.code.contains(':PATTERN') })) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colAllOrgName",
                    "columnId": "colAllOrgName",
                    "label": "Organization Name",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% org.organizationByName.descriptor ?? '' %>",
                      "enabled": false,
                      "relatedActions": [
                        {
                          "label": "Manage Status",
                          "taskReference": {
                            "taskId": "manageShellOrgStatus",
                            "parameterBindings": {
                              "orgId": "<% org.workdayID %>",
                              "orgCode": "<% org.code %>",
                              "orgName": "<% org.organizationByName.descriptor ?? org.code %>",
                              "currentStatus": "<% org.cf_active1 == true ? 'Active' : 'Inactive' %>"
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAllOrgStatus",
                    "columnId": "colAllOrgStatus",
                    "label": "Status",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "richText",
                      "value": "<% org.cf_active1 == true ? '<span style=\"color:#065f46;font-weight:600;font-size:11px\">✓ Active</span>' : '<span style=\"color:#6b7280;font-weight:600;font-size:11px\">○ Inactive</span>' %>"
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAllOrgManage",
                    "columnId": "colAllOrgManage",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "Manage",
                      "taskReference": {
                        "taskId": "manageShellOrgStatus",
                        "parameterBindings": {
                          "orgId": "<% org.workdayID %>",
                          "orgCode": "<% org.code %>",
                          "orgName": "<% org.organizationByName.descriptor ?? org.code %>",
                          "currentStatus": "<% org.cf_active1 == true ? 'Active' : 'Inactive' %>"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "fieldSet",
            "id": "filteredShellOrgsFieldSet",
            "visible": "<% !empty(queryParams.appCode) %>",
            "title": "<% 'Shell Organizations — ' + (queryParams.appName ?? queryParams.appCode ?? '') %>",
            "layout": {
              "density": "medium",
              "alignment": "left",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            },
            "children": [
              {
                "type": "richText",
                "id": "filteredShellOrgsEmptyMsg",
                "enabled": false,
                "value": "<span style=\"color:#374151;font-size:12px\">No shell organizations found for this application code.</span>",
                "visible": "<% !empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { o.code.startsWith((queryParams.appCode ?? '') + ':') && !o.code.contains(':PATTERN') })) == 0 %>"
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "filteredShellOrgsGrid",
                "rows": "<% empty(queryParams.appCode) ? [] : allShellOrgs.data.filter(o => { o.code.startsWith(queryParams.appCode + ':') && !o.code.contains(':PATTERN') }) %>",
                "rowVariableName": "org",
                "enabled": false,
                "label": "<% 'Shell Organizations for ' + (queryParams.appName ?? queryParams.appCode ?? '') %>",
                "autoPaging": true,
                "visible": "<% !empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { o.code.startsWith((queryParams.appCode ?? '') + ':') && !o.code.contains(':PATTERN') })) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colFiltOrgName",
                    "columnId": "colFiltOrgName",
                    "label": "Organization Name",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% org.organizationByName.descriptor ?? '' %>",
                      "enabled": false,
                      "relatedActions": [
                        {
                          "label": "Manage Status",
                          "taskReference": {
                            "taskId": "manageShellOrgStatus",
                            "parameterBindings": {
                              "orgId": "<% org.workdayID %>",
                              "orgCode": "<% org.code %>",
                              "orgName": "<% org.organizationByName.descriptor ?? org.code %>",
                              "currentStatus": "<% org.cf_active1 == true ? 'Active' : 'Inactive' %>"
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "column",
                    "id": "colFiltOrgStatus",
                    "columnId": "colFiltOrgStatus",
                    "label": "Status",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "richText",
                      "value": "<% org.cf_active1 == true ? '<span style=\"color:#065f46;font-weight:600;font-size:11px\">✓ Active</span>' : '<span style=\"color:#6b7280;font-weight:600;font-size:11px\">○ Inactive</span>' %>"
                    }
                  },
                  {
                    "type": "column",
                    "id": "colFiltOrgManage",
                    "columnId": "colFiltOrgManage",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "Manage",
                      "taskReference": {
                        "taskId": "manageShellOrgStatus",
                        "parameterBindings": {
                          "orgId": "<% org.workdayID %>",
                          "orgCode": "<% org.code %>",
                          "orgName": "<% org.organizationByName.descriptor ?? org.code %>",
                          "currentStatus": "<% org.cf_active1 == true ? 'Active' : 'Inactive' %>"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "fieldSet",
            "id": "footerFieldSet1",
            "layout": {
              "density": "medium",
              "alignment": "center",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            },
            "children": [
              {
                "type": "richText",
                "id": "footerText1",
                "enabled": false,
                "value": "<p style=\"text-align:center\"><span style=\"color:#002145;font-size:11px;font-weight:700;font-family:Arial,sans-serif;letter-spacing:2px;\">ECO-COMS</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> · </span><span style=\"color:#002145;font-size:11px;font-family:Arial,sans-serif;\">University of British Columbia</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> · </span><span style=\"color:#0055B7;font-size:11px;font-family:Arial,sans-serif;font-style:italic;\">Custom Organization Management System</span></p>"
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "label": "Add New Organization",
        "children": [
          {
            "type": "richText",
            "id": "addOrgNote",
            "enabled": false,
            "value": "<span style=\"color:#374151;font-size:12px\">Create a new shell organization. The organization name will be auto-generated from the application code and organization code you provide.</span>"
          },
          {
            "type": "button",
            "label": "Add New Shell Organization",
            "taskReference": {
              "taskId": "newShellOrg"
            },
            "action": "PRIMARY"
          },
          {
            "type": "fieldSet",
            "id": "footerFieldSet2",
            "layout": {
              "density": "medium",
              "alignment": "center",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            },
            "children": [
              {
                "type": "richText",
                "id": "footerText2",
                "enabled": false,
                "value": "<p style=\"text-align:center\"><span style=\"color:#002145;font-size:11px;font-weight:700;font-family:Arial,sans-serif;letter-spacing:2px;\">ECO-COMS</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> · </span><span style=\"color:#002145;font-size:11px;font-family:Arial,sans-serif;\">University of British Columbia</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> · </span><span style=\"color:#0055B7;font-size:11px;font-family:Arial,sans-serif;font-style:italic;\">Custom Organization Management System</span></p>"
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "label": "Manage Role Assignments",
        "children": [
          {
            "type": "fieldSet",
            "id": "roleAssignmentsFieldSet",
            "visible": "<% !empty(queryParams.appCode) %>",
            "title": "Shell Role Assignments",
            "layout": {
              "density": "medium",
              "alignment": "left",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            },
            "children": [
              {
                "type": "richText",
                "id": "roleAssignmentsNote",
                "enabled": false,
                "value": "<span style=\"color:#374151;font-size:12px\">Role assignments for shell organizations in this application. Use <b>Manage Positions</b> to add or remove position restrictions from a role assignment.</span>"
              },
              {
                "type": "richText",
                "id": "rolesEmptyMsg",
                "enabled": false,
                "value": "<span style=\"color:#374151;font-size:12px\">No shell role assignments found for this application.</span>",
                "visible": "<% !empty(queryParams.appCode) && size(shellRoles.data.filter(r => { r.roleAssignments != null && size(r.roleAssignments.filter(ra => { ra.organization != null && ra.organization.descriptor.startsWith(queryParams.appCode ?? '') })) > 0 })) == 0 %>"
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "roleAssignmentsGrid",
                "rows": "<% empty(queryParams.appCode) ? [] : shellRoles.data.filter(r => { r.roleAssignments != null && size(r.roleAssignments.filter(ra => { ra.organization != null && ra.organization.descriptor.startsWith(queryParams.appCode ?? '') })) > 0 }) %>",
                "rowVariableName": "roleRow",
                "enabled": false,
                "label": "<% 'Role Assignments for ' + (queryParams.appName ?? queryParams.appCode ?? '') %>",
                "autoPaging": true,
                "visible": "<% !empty(queryParams.appCode) && size(shellRoles.data.filter(r => { r.roleAssignments != null && size(r.roleAssignments.filter(ra => { ra.organization != null && ra.organization.descriptor.startsWith(queryParams.appCode ?? '') })) > 0 })) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colRoleName",
                    "columnId": "colRoleName",
                    "label": "Role",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% roleRow.role.descriptor ?? '' %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colOrgTypes",
                    "columnId": "colOrgTypes",
                    "label": "Enabled Org Types",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% roleRow.enabledForOrganizationTypes != null ? roleRow.enabledForOrganizationTypes.map(t => { t.descriptor }).join(', ') : '' %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAssignmentOrg",
                    "columnId": "colAssignmentOrg",
                    "label": "Organization",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% roleRow.roleAssignments != null ? roleRow.roleAssignments.filter(ra => { ra.organization != null && ra.organization.descriptor.startsWith(queryParams.appCode ?? '') }).map(ra => { ra.organization.descriptor }).join('; ') : '' %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colPositions",
                    "columnId": "colPositions",
                    "label": "Positions",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% roleRow.roleAssignments != null ? roleRow.roleAssignments.filter(ra => { ra.organization != null && ra.organization.descriptor.startsWith(queryParams.appCode ?? '') }).flatMap(ra => { ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions != null ? ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions.map(p => { p.descriptor }) : [] }).join('; ') : '' %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAssignedTo",
                    "columnId": "colAssignedTo",
                    "label": "Assigned To",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% roleRow.roleAssignments != null ? roleRow.roleAssignments.filter(ra => { ra.organization != null && ra.organization.descriptor.startsWith(queryParams.appCode ?? '') }).flatMap(ra => { ra.workersAssigned != null ? ra.workersAssigned.map(w => { w.descriptor }) : [] }).join('; ') : '' %>",
                      "enabled": false
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "richText",
            "id": "rolesSelectAppMsg",
            "enabled": false,
            "visible": "<% empty(queryParams.appCode) %>",
            "value": "<span style=\"color:#6b7280;font-size:13px\">Select an application above to manage its role assignments.</span>"
          },
          {
            "type": "fieldSet",
            "id": "footerFieldSet3",
            "layout": {
              "density": "medium",
              "alignment": "center",
              "horizontalSizing": "stretch",
              "labelPosition": "top"
            },
            "children": [
              {
                "type": "richText",
                "id": "footerText3",
                "enabled": false,
                "value": "<p style=\"text-align:center\"><span style=\"color:#002145;font-size:11px;font-weight:700;font-family:Arial,sans-serif;letter-spacing:2px;\">ECO-COMS</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> · </span><span style=\"color:#002145;font-size:11px;font-family:Arial,sans-serif;\">University of British Columbia</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> · </span><span style=\"color:#0055B7;font-size:11px;font-family:Arial,sans-serif;font-style:italic;\">Custom Organization Management System</span></p>"
              }
            ]
          }
        ]
      }
    ]
  }
}