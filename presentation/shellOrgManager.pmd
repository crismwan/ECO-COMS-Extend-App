{
  "id": "shellOrgManager",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "include": [
    "comsCardGenerator.script"
  ],
  "endPoints": [
    {
      "name": "shellOrgPatterns",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "existingPatterns"
      }
    },
    {
      "name": "shellRoles",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellAssignableRolesinTenant"
      }
    },
    {
      "name": "allShellOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellOrgs"
      }
    }
  ],
  "presentation": {
    "headerSize": "STANDARD",
    "pageType": "VIEW",
    "title": {
      "type": "title",
      "label": "<% empty(queryParams.appName) ? 'ECO-COMS: Shell Org Manager' : (queryParams.appName ?? '') %>",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "shellOrgManagerForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "navFieldSet",
              "title": "<% queryParams.appName ?? queryParams.appCode ?? '' %>",
              "children": [
                {
                  "type": "button",
                  "id": "backToHomeBtn",
                  "label": "← Home",
                  "taskReference": {
                    "taskId": "home"
                  },
                  "action": "LINK",
                  "suppressDiscardDialog": true,
                  "visible": "<% empty(queryParams.appCode) %>"
                },
                {
                  "type": "button",
                  "id": "backToApplicationsBtn",
                  "label": "← Back to Applications",
                  "taskReference": {
                    "taskId": "shellOrgManager"
                  },
                  "action": "LINK",
                  "suppressDiscardDialog": true,
                  "visible": "<% !empty(queryParams.appCode) %>"
                },
                {
                  "type": "richText",
                  "id": "scopeWarning",
                  "enabled": false,
                  "value": "<% empty(queryParams.appCode) ? '<span style=\"display:inline-flex;align-items:center;gap:6px;background:#fef9c3;border:1px solid #fbbf24;border-radius:6px;padding:8px 12px;font-size:13px;color:#92400e\">⚠️ No application selected — data below reflects all applications. Click Manage on an application to view its shell orgs and URL patterns.</span>' : '<span style=\"display:inline-flex;align-items:center;gap:6px;background:#fef9c3;border:1px solid #fbbf24;border-radius:6px;padding:8px 12px;font-size:13px;color:#92400e\">⚠️ Showing shell orgs and URL patterns for <strong>' + (queryParams.appName ?? queryParams.appCode) + '</strong> only. Go back to view all applications.</span>' %>"
                }
              ]
            }
          ]
        }
      ]
    },
    "tabs": [
      {
        "type": "section",
        "label": "Summary",
        "children": [
          {
            "type": "fieldSet",
            "id": "summaryStatsFieldSet",
            "title": "Shell Organization Summary",
            "children": [
              {
                "type": "readOnlyText",
                "id": "summaryActiveCount",
                "label": "Active Orgs",
                "value": "<% size(allShellOrgs.data.filter(o => { o.code.startsWith('X:') && !o.code.contains(':PATTERN') && o.cf_active1 == true })) %>"
              },
              {
                "type": "readOnlyText",
                "id": "summaryInactiveCount",
                "label": "Inactive Orgs",
                "value": "<% size(allShellOrgs.data.filter(o => { o.code.startsWith('X:') && !o.code.contains(':PATTERN') && o.cf_active1 != true })) %>"
              },
              {
                "type": "readOnlyText",
                "id": "summaryPatternCount",
                "label": "Total Patterns",
                "value": "<% size(allShellOrgs.data.filter(o => { o.code.contains(':PATTERN') })) %>"
              }
            ]
          },
          {
            "type": "cardContainer",
            "id": "statusChartContainer",
            "cards": [
              {
                "type": "card",
                "cardId": "ShellOrgStatusChart",
                "parameters": "<% { 'activeCount': size(allShellOrgs.data.filter(o => { o.code.startsWith('X:') && !o.code.contains(':PATTERN') && o.cf_active1 == true })), 'inactiveCount': size(allShellOrgs.data.filter(o => { o.code.startsWith('X:') && !o.code.contains(':PATTERN') && o.cf_active1 != true })), 'totalPatterns': size(allShellOrgs.data.filter(o => { o.code.contains(':PATTERN') })) } %>"
              }
            ]
          },
          {
            "type": "fieldSet",
            "id": "summaryNavFieldSet",
            "title": "Quick Actions",
            "children": [
              {
                "type": "button",
                "label": "Add New Shell Organization",
                "taskReference": {
                  "taskId": "createShellOrgWizard"
                },
                "action": "PRIMARY"
              },
              {
                "type": "button",
                "label": "Add Shell Org Pattern",
                "taskReference": {
                  "taskId": "createShellOrgPatternWizard"
                },
                "action": "AUXILIARY"
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "label": "Application Patterns",
        "children": [
          {
            "type": "fieldSet",
            "id": "appsFieldSet",
            "visible": "<% empty(queryParams.appCode) %>",
            "title": "Applications",
            "children": [
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "appsGrid",
                "rows": "<% (shellOrgPatterns.data ?? []).map(p => { p.code.substringBefore(':PATTERN').substringBefore(':') + ':' + p.code.substringBefore(':PATTERN').substringAfter(':').substringBefore(':') }).distinct().map(appCode => { {'appCode': appCode} }) %>",
                "rowVariableName": "app",
                "enabled": false,
                "label": "Applications",
                "autoPaging": true,
                "columns": [
                  {
                    "type": "column",
                    "id": "colAppName",
                    "columnId": "colAppName",
                    "label": "Application ID",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "button",
                      "action": "LINK",
                      "label": "<% app.appCode ?? '' %>",
                      "taskReference": {
                        "taskId": "shellOrgManager",
                        "parameterBindings": {
                          "appCode": "<% app.appCode %>"
                        }
                      }
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAppActions",
                    "columnId": "colAppActions",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "Manage",
                      "taskReference": {
                        "taskId": "shellOrgManager",
                        "parameterBindings": {
                          "appCode": "<% app.appCode %>"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "fieldSet",
            "id": "patternsFieldSet",
            "visible": "<% !empty(queryParams.appCode) %>",
            "title": "Shell Org Patterns",
            "children": [
              {
                "type": "button",
                "id": "addPatternBtn",
                "label": "Add Pattern",
                "taskReference": {
                  "taskId": "createShellOrgPatternWizard"
                },
                "action": "PRIMARY"
              },
              {
                "type": "richText",
                "id": "saveNote",
                "enabled": false,
                "value": "<span style=\"color:#d97706;font-size:11px;font-weight:700\">⚠ </span><span style=\"color:#92400e;font-size:11px\"><b>Warning:</b> Changing Status to Inactive does not automatically remove any Workday role assignments referencing this shell organization. Verify in Workday (Get_Assign_User_Based_Security_Groups) that no active role assignment uses this Custom Organization before inactivating.</span>"
              },
              {
                "type": "richText",
                "id": "emptyStateMsg",
                "enabled": false,
                "value": "<span style=\"color:#374151;font-size:12px\">No shell org patterns found for this application. Use the <b>Add Pattern</b> button above to create one.</span>",
                "visible": "<% !empty(queryParams.appCode) && size((shellOrgPatterns.data ?? []).filter(p => { p.code.startsWith((queryParams.appCode ?? '') + ':PATTERN') })) == 0 %>"
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "patternsGrid",
                "rows": "<% empty(queryParams.appCode) ? [] : (shellOrgPatterns.data ?? []).filter(p => { p.code.startsWith(queryParams.appCode + ':PATTERN') }) %>",
                "rowVariableName": "pattern",
                "enabled": false,
                "label": "<% 'Patterns for ' + (queryParams.appName ?? queryParams.appCode ?? '') %>",
                "autoPaging": true,
                "visible": "<% !empty(queryParams.appCode) && size((shellOrgPatterns.data ?? []).filter(p => { p.code.startsWith((queryParams.appCode ?? '') + ':PATTERN') })) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colPatternName",
                    "columnId": "colPatternName",
                    "label": "Organization Name",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "instanceList",
                      "view": true,
                      "relatedTask": true,
                      "instanceList": [
                        {
                          "descriptor": "<% pattern.organizationByName.descriptor ?? pattern.code %>",
                          "wid": "<% pattern.workdayID %>"
                        }
                      ]
                    }
                  },
                  {
                    "type": "column",
                    "id": "colPatternCode",
                    "columnId": "colPatternCode",
                    "label": "Pattern Code",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% pattern.code %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colStatus",
                    "columnId": "colStatus",
                    "label": "Status",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "richText",
                      "value": "<% pattern.cf_active1 == true ? '<span style=\"color:#065f46;font-weight:600;font-size:11px\">✓ Active</span>' : '<span style=\"color:#6b7280;font-weight:600;font-size:11px\">○ Inactive</span>' %>"
                    }
                  },
                  {
                    "type": "column",
                    "id": "colPatternManage",
                    "columnId": "colPatternManage",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "<% pattern.cf_active1 == true ? 'Inactivate' : 'Activate' %>",
                      "taskReference": {
                        "taskId": "manageShellOrgStatus",
                        "parameterBindings": {
                          "orgId": "<% pattern.workdayID ?? \"\" %>",
                          "orgCode": "<% pattern.code %>",
                          "orgName": "<% pattern.organizationByName.descriptor ?? pattern.code ?? \"\" %>",
                          "currentStatus": "<% pattern.cf_active1 == true ? 'Active' : 'Inactive' %>",
                          "effectiveDate": "<% date:now().format(\"yyyy-MM-dd\") %>",
                          "patternName": "<% pattern.code %>",
                          "orgType": "<% queryParams.orgType ?? '' %>",
                          "comsAppId": "<% queryParams.appCode ?? '' %>"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "fieldSet",
            "id": "footerFieldSet0",
            "children": [
              {
                "type": "richText",
                "id": "footerText0",
                "enabled": false,
                "value": "<p style=\"text-align:center\"><span style=\"color:#002145;font-size:11px;font-weight:700;font-family:Arial,sans-serif;letter-spacing:2px;\">ECO-COMS</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> · </span><span style=\"color:#0055B7;font-size:11px;font-family:Arial,sans-serif;font-style:italic;\">Custom Organization Management System</span></p>"
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "label": "Application Shell Organizations",
        "children": [
          {
            "type": "richText",
            "id": "shellOrgsAppWarning",
            "enabled": false,
            "visible": "<% !empty(queryParams.appCode) %>",
            "value": "<span style=\"color:#d97706;font-size:11px;font-weight:700\">⚠ </span><span style=\"color:#92400e;font-size:11px\"><b>Filtered view:</b> You selected <b><% queryParams.appCode ?? '' %></b> from the Application Patterns tab. Only shell organizations matching this application are shown below. <a href=\"javascript:void(0)\" style=\"color:#0055B7\">View all organizations</a> by navigating to Shell Org Manager without an application selected.</span>"
          },
          {
            "type": "button",
            "id": "addNewOrgBtn",
            "label": "Add New Shell Organization",
            "taskReference": {
              "taskId": "createShellOrgWizard"
            },
            "action": "PRIMARY"
          },
          {
            "type": "fieldSet",
            "id": "allShellOrgsFieldSet",
            "visible": "<% empty(queryParams.appCode) %>",
            "title": "All Shell Organizations",
            "children": [
              {
                "type": "richText",
                "id": "allShellOrgsEmptyMsg",
                "enabled": false,
                "value": "<span style=\"color:#374151;font-size:12px\">No shell organizations found.</span>",
                "visible": "<% empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { o.code.startsWith('X:') && !o.code.contains(':PATTERN') })) == 0 %>"
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "allShellOrgsGrid",
                "rows": "<% allShellOrgs.data.filter(o => { o.code.startsWith('X:') && !o.code.contains(':PATTERN') }) %>",
                "rowVariableName": "org",
                "enabled": false,
                "label": "Shell Organizations",
                "autoPaging": true,
                "visible": "<% empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { o.code.startsWith('X:') && !o.code.contains(':PATTERN') })) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colAllOrgName",
                    "columnId": "colAllOrgName",
                    "label": "Organization Name",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "instanceList",
                      "view": true,
                      "relatedTask": true,
                      "instanceList": [
                        {
                          "descriptor": "<% org.organizationByName.descriptor ?? org.code %>",
                          "wid": "<% org.workdayID %>"
                        }
                      ]
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAllOrgStatus",
                    "columnId": "colAllOrgStatus",
                    "label": "Status",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "richText",
                      "value": "<% org.cf_active1 == true ? '<span style=\"color:#065f46;font-weight:600;font-size:11px\">✓ Active</span>' : '<span style=\"color:#6b7280;font-weight:600;font-size:11px\">○ Inactive</span>' %>"
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAllOrgManage",
                    "columnId": "colAllOrgManage",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "Manage",
                      "taskReference": {
                        "taskId": "manageShellOrgStatus",
                        "parameterBindings": {
                          "orgId": "<% org.workdayID ?? \"\" %>",
                          "orgCode": "<% org.code %>",
                          "orgName": "<% org.organizationByName.descriptor ?? org.code ?? \"\" %>",
                          "currentStatus": "<% org.cf_active1 == true ? 'Active' : 'Inactive' %>",
                          "effectiveDate": "<% date:now().format(\"yyyy-MM-dd\") %>",
                          "patternName": "<% org.code %>",
                          "orgType": "<% queryParams.orgType ?? '' %>",
                          "comsAppId": "<% queryParams.appCode ?? '' %>"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "fieldSet",
            "id": "filteredShellOrgsFieldSet",
            "visible": "<% !empty(queryParams.appCode) %>",
            "title": "<% 'Shell Organizations — ' + (queryParams.appName ?? queryParams.appCode ?? '') %>",
            "children": [
              {
                "type": "richText",
                "id": "filteredShellOrgsEmptyMsg",
                "enabled": false,
                "value": "<span style=\"color:#374151;font-size:12px\">No shell organizations found for this application code.</span>",
                "visible": "<% !empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { o.code.startsWith((queryParams.appCode ?? '') + ':') && !o.code.contains(':PATTERN') })) == 0 %>"
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "filteredShellOrgsGrid",
                "rows": "<% empty(queryParams.appCode) ? [] : allShellOrgs.data.filter(o => { o.code.startsWith(queryParams.appCode + ':') && !o.code.contains(':PATTERN') }) %>",
                "rowVariableName": "org",
                "enabled": false,
                "label": "<% 'Shell Organizations for ' + (queryParams.appName ?? queryParams.appCode ?? '') %>",
                "autoPaging": true,
                "visible": "<% !empty(queryParams.appCode) && size(allShellOrgs.data.filter(o => { o.code.startsWith((queryParams.appCode ?? '') + ':') && !o.code.contains(':PATTERN') })) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colFiltOrgName",
                    "columnId": "colFiltOrgName",
                    "label": "Organization Name",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "instanceList",
                      "view": true,
                      "relatedTask": true,
                      "instanceList": [
                        {
                          "descriptor": "<% org.organizationByName.descriptor ?? org.code %>",
                          "wid": "<% org.workdayID %>"
                        }
                      ]
                    }
                  },
                  {
                    "type": "column",
                    "id": "colFiltOrgStatus",
                    "columnId": "colFiltOrgStatus",
                    "label": "Status",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "richText",
                      "value": "<% org.cf_active1 == true ? '<span style=\"color:#065f46;font-weight:600;font-size:11px\">✓ Active</span>' : '<span style=\"color:#6b7280;font-weight:600;font-size:11px\">○ Inactive</span>' %>"
                    }
                  },
                  {
                    "type": "column",
                    "id": "colFiltOrgManage",
                    "columnId": "colFiltOrgManage",
                    "label": "Manage",
                    "cellTemplate": {
                      "type": "button",
                      "action": "AUXILIARY",
                      "label": "Manage",
                      "taskReference": {
                        "taskId": "manageShellOrgStatus",
                        "parameterBindings": {
                          "orgId": "<% org.workdayID ?? \"\" %>",
                          "orgCode": "<% org.code %>",
                          "orgName": "<% org.organizationByName.descriptor ?? org.code ?? \"\" %>",
                          "currentStatus": "<% org.cf_active1 == true ? 'Active' : 'Inactive' %>",
                          "effectiveDate": "<% date:now().format(\"yyyy-MM-dd\") %>",
                          "patternName": "<% org.code %>",
                          "orgType": "<% queryParams.orgType ?? '' %>",
                          "comsAppId": "<% queryParams.appCode ?? '' %>"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "fieldSet",
            "id": "footerFieldSet1",
            "children": [
              {
                "type": "richText",
                "id": "footerText1",
                "enabled": false,
                "value": "<p style=\"text-align:center\"><span style=\"color:#002145;font-size:11px;font-weight:700;font-family:Arial,sans-serif;letter-spacing:2px;\">ECO-COMS</span><span style=\"color:#6b7280;font-size:11px;font-family:Arial,sans-serif;\"> · </span><span style=\"color:#0055B7;font-size:11px;font-family:Arial,sans-serif;font-style:italic;\">Custom Organization Management System</span></p>"
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "label": "Manage Role Assignments",
        "children": [
          {
            "type": "fieldSet",
            "id": "roleAssignmentsFieldSet",
            "title": "Shell Role Assignments",
            "children": [
              {
                "type": "richText",
                "id": "roleAssignmentsNote",
                "enabled": false,
                "value": "<span style=\"color:#374151;font-size:12px\">Each row is one role assigned on one shell organization, with the positions and workers it is assigned to<% !empty(queryParams.appCode) ? ' for the selected application' : '' %>.</span>"
              },
              {
                "type": "richText",
                "id": "rolesEmptyMsg",
                "enabled": false,
                "value": "<span style=\"color:#374151;font-size:12px\">No shell role assignments found<% !empty(queryParams.appCode) ? ' for ' + (queryParams.appName ?? queryParams.appCode) : '' %>.</span>",
                "visible": "<% size(list:flatten((shellRoles.data ?? []).map(r => { (r.roleAssignments ?? []).filter(ra => { ra.organization != null && ra.organization.descriptor.startsWith((empty(queryParams.appCode) ? 'X:' : queryParams.appCode)) }).map(ra => { { 'role': r.role, 'org': ra.organization, 'positions': ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions ?? [], 'workers': ra.workersAssigned ?? [] } }) }))) == 0 %>"
              },
              {
                "type": "grid",
                "gridType": "LIST",
                "multiViewStylingEnabled": true,
                "id": "roleAssignmentsGrid",
                "rows": "<% list:flatten((shellRoles.data ?? []).map(r => { (r.roleAssignments ?? []).filter(ra => { ra.organization != null && ra.organization.descriptor.startsWith((empty(queryParams.appCode) ? 'X:' : queryParams.appCode)) }).map(ra => { { 'role': r.role, 'org': ra.organization, 'positions': ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions ?? [], 'workers': ra.workersAssigned ?? [] } }) })) %>",
                "rowVariableName": "ra",
                "enabled": false,
                "label": "Role Assignments",
                "autoPaging": true,
                "visible": "<% size(list:flatten((shellRoles.data ?? []).map(r => { (r.roleAssignments ?? []).filter(ra => { ra.organization != null && ra.organization.descriptor.startsWith((empty(queryParams.appCode) ? 'X:' : queryParams.appCode)) }).map(ra => { { 'role': r.role, 'org': ra.organization, 'positions': ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions ?? [], 'workers': ra.workersAssigned ?? [] } }) }))) > 0 %>",
                "columns": [
                  {
                    "type": "column",
                    "id": "colRoleName",
                    "columnId": "colRoleName",
                    "label": "Role",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% ra.role.descriptor ?? '' %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colAssignmentOrg",
                    "columnId": "colAssignmentOrg",
                    "label": "Organization",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% ra.org.descriptor ?? '' %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colPositions",
                    "columnId": "colPositions",
                    "label": "Positions",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% size(ra.positions) > 0 ? ra.positions.map(p => { p.descriptor }).join('; ') : '—' %>",
                      "enabled": false
                    }
                  },
                  {
                    "type": "column",
                    "id": "colWorkers",
                    "columnId": "colWorkers",
                    "label": "Workers",
                    "sortableAndFilterable": "true",
                    "cellTemplate": {
                      "type": "text",
                      "value": "<% size(ra.workers) > 0 ? ra.workers.map(w => { w.descriptor }).join('; ') : '—' %>",
                      "enabled": false
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "fieldSet",
            "id": "footerFieldSet3",
            "children": [
              {
                "type": "richText",
                "id": "footerText3",
                "enabled": false,
