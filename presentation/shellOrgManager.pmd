{
  "id": "shellOrgManager",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "workday-common",
      "url": "workers/me",
      "authType": "sso"
    },
    {
      "name": "myAssignments",
      "baseUrlType": "workday-app",
      "url": "comsRoleAssignments",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true"
    },
    {
      "name": "shellOrgs",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "<% empty(selectedApplicationId.value) ? '/comsShellOrgRequests?active=true' : '/comsShellOrgRequests?active=true&application=' + selectedApplicationId.value[0] %>",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "exclude": "<% empty(selectedApplicationId.value) %>"
    },
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true"
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "comsShellOrgRequestsPut",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "<% '/comsShellOrgRequests/' + comsShellOrgRequestsPut.id %>",
        "httpMethod": "PUT",
        "authType": "sso",
        "onSend": "<% self.data %>",
        "values": [
          {
            "outboundPath": "status",
            "value": "<% comsShellOrgRequestsPut.status %>"
          }
        ]
      },
      {
        "name": "comsAuditLogsPost",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "comsAuditLogs",
        "httpMethod": "POST",
        "authType": "sso",
        "onSend": "<% return self.data; %>",
        "values": [
          {
            "outboundPath": "worker.id",
            "value": "<% selectedWorker.id %>"
          },
          {
            "outboundPath": "action",
            "value": "INACTIVATE"
          },
          {
            "outboundPath": "application.id",
            "value": "<% selectedApplicationId.value[0] %>"
          },
          {
            "outboundPath": "triggeredBy",
            "value": "<% selectedWorker.descriptor %>"
          },
          {
            "outboundPath": "details",
            "value": "Status changed via Shell Org Manager"
          }
        ]
      }
    ]
  },
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ECO-COMS: Shell Org Manager",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "shellOrgManagerForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK"
            },
            {
              "type": "button",
              "label": "Add Pattern",
              "taskReference": {
                "taskId": "newShellOrgPattern"
              },
              "action": "PRIMARY"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "appSelectorSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "appSelectorFieldSet",
              "title": "Select Application",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "instancePicker",
                  "id": "selectedApplicationId",
                  "label": "Application",
                  "helpText": "Select an application to view and manage its shell org patterns.",
                  "instanceListLoopTag": {
                    "id": "selectedApplicationIdList",
                    "type": "instanceLoop",
                    "templateInstance": {
                      "id": "<% app.id %>",
                      "descriptor": "<% app.appId %>"
                    },
                    "on": "<% comsApplications.data %>",
                    "as": "app"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "contextCardSection",
          "children": [
            {
              "type": "cardContainer",
              "id": "contextCardContainer",
              "layout": "grid",
              "cards": [
                {
                  "type": "card",
                  "cardId": "AppContextCard",
                  "parameters": {
                    "info": "<% comsCardGenerator.appContextInfo(empty(selectedApplicationId.value) ? null : comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] }).size() > 0 ? comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] })[0].appId : null) %>"
                  }
                },
                {
                  "type": "card",
                  "cardId": "StatusGuideCard",
                  "parameters": {
                    "info": "<% comsCardGenerator.statusGuideInfo('Active') %>"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "contentSection",
          "children": [
            {
              "type": "richText",
              "id": "saveNote",
              "enabled": false,
              "value": "<span style=\"color:#d97706;font-size:11px;font-weight:700\">⚠ </span><span style=\"color:#92400e;font-size:11px\"><b>Warning:</b> Changing Status to Inactive does not automatically remove any Workday role assignments referencing this shell organization. Verify in Workday (Get_Assign_User_Based_Security_Groups) that no active role assignment uses this Custom Organization before inactivating.</span>"
            },
            {
              "type": "richText",
              "id": "emptyStateMsg",
              "enabled": false,
              "value": "<span style=\"color:#374151;font-size:12px\">No shell org patterns found for this application. Use the <b>Add Pattern</b> button above to create one.</span>",
              "visible": "<% !empty(selectedApplicationId.value) && size(shellOrgs.data) == 0 %>"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "view"
  },
  "include": [
    "comsCardGenerator.script"
  ]
}