{
  "id": "adminProvisioning",
  "include": [
    "comsValidations.script"
  ],
  "securityDomains": [
    "ManageCOMSAdminProvisioning"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "customOrganizations",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "customOrganizations"
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "comsAssignableRolesCount",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAssignableRoles?limit=1",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ],
      "name": "comsAssignableRolesPage0",
      "url": "/comsAssignableRoles?limit=100&offset=0"
    },
    {
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "name": "comsAssignableRolesPage1",
      "url": "<% let t = comsAssignableRolesCount.total ?? 0; '/comsAssignableRoles?limit=100&offset=' + (t > 100 ? 100 : t) %>"
    },
    {
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "name": "comsAssignableRolesPage2",
      "url": "<% let t = comsAssignableRolesCount.total ?? 0; '/comsAssignableRoles?limit=100&offset=' + (t > 200 ? 200 : t) %>"
    },
    {
      "name": "delSearch",
      "baseUrlType": "workday-wql",
      "url": "<% 'data?query=' + string:pathEncode('SELECT role FROM assignableRoles WHERE roleName contains \\'' + instanceListQuery.replace('\\'', '').replace('\\\\', '') + '\\'') %>",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "deferred": "true",
      "exclude": "<% empty instanceListQuery %>"
    },
    {
      "name": "fuhSearch",
      "baseUrlType": "workday-wql",
      "url": "<% 'data?query=' + string:pathEncode('SELECT workdayID, organization1, code FROM customOrganizations WHERE type1 in (b40d8b016367100175b147f364840000) AND code contains \\'' + instanceListQuery.replace('\\'', '').replace('\\\\', '') + '\\'') %>",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "deferred": "true",
      "exclude": "<% empty instanceListQuery %>"
    },
    {
      "name": "auSearch",
      "baseUrlType": "workday-wql",
      "url": "<% 'data?query=' + string:pathEncode('SELECT workdayID, academicUnit, academicUnitName FROM academicUnits WHERE inactive = false AND academicUnitName contains \\'' + instanceListQuery.replace('\\'', '').replace('\\\\', '') + '\\'') %>",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "deferred": "true",
      "exclude": "<% empty instanceListQuery %>"
    },
    {
      "name": "posSearch",
      "baseUrlType": "workday-wql",
      "url": "<% 'data?query=' + string:pathEncode('SELECT cf_PositionID, workdayID, position_PositionManagement, cf_PositionIsFilled, cf_PositionText FROM allPositions WHERE supervisoryOrganization is not empty AND cf_PositionText contains \\'' + instanceListQuery.replace('\\'', '').replace('\\\\', '') + '\\'') %>",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "deferred": "true",
      "exclude": "<% empty instanceListQuery %>"
    },
    {
      "name": "allAAAroles",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allAAArolesinTenant"
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "postAssignableRole",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "/comsAssignableRoles",
        "httpMethod": "POST",
        "authType": "sso",
        "onSend": "<% self.data %>",
        "values": [
          {
            "outboundPath": "status",
            "value": "Pending ISC Review"
          },
          {
            "outboundPath": "requestedDate",
            "value": "<% date:now().format('yyyy-MM-dd') %>"
          },
          {
            "outboundPath": "requestedBy.id",
            "value": "<% selectedWorker.id %>"
          },
          {
            "outboundPath": "referenceId",
            "value": "<% requestRefHidden.value %>"
          },
          {
            "outboundPath": "active",
            "value": "<% false %>"
          },
          {
            "outboundPath": "shellOrgCode",
            "value": "<% !empty(applicationDropdown.value) ? (applicationDropdown.selectedEntries[0].descriptor ?? '') : '' %>"
          },
          {
            "outboundPath": "shellOrgWid",
            "value": "<% !empty(applicationDropdown.value) ? (applicationDropdown.value[0] ?? '') : '' %>"
          },
          {
            "outboundPath": "enabledForOrganizationTypes",
            "value": "<% !empty(fuhPicker.value) ? (fuhPicker.selectedEntries[0].descriptor ?? '') : (!empty(academicUnitPicker.value) ? (academicUnitPicker.selectedEntries[0].descriptor ?? '') : 'Academic Unit - University of British Columbia') %>"
          },
          {
            "outboundPath": "enabledForWid",
            "value": "<% !empty(fuhPicker.value) ? fuhPicker.value[0] : (!empty(academicUnitPicker.value) ? academicUnitPicker.value[0] : '') %>"
          },
          {
            "outboundPath": "functionalUnitHierarchyWid",
            "value": "<% !empty(fuhPicker.value) ? fuhPicker.value[0] : '' %>"
          },
          {
            "outboundPath": "functionalUnitDescription",
            "value": "<% !empty(fuhPicker.value) ? (fuhPicker.selectedEntries[0].descriptor ?? '') : '' %>"
          },
          {
            "outboundPath": "academicUnitWid",
            "value": "<% !empty(academicUnitPicker.value) ? academicUnitPicker.value[0] : '' %>"
          },
          {
            "outboundPath": "academicUnitDescription",
            "value": "<% !empty(academicUnitPicker.value) ? (academicUnitPicker.selectedEntries[0].descriptor ?? '') : '' %>"
          }
        ],
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ]
      },
      {
        "name": "launchReview",
        "baseUrlType": "orchestration",
        "url": "<% '/StartAAARequestReview/launch?ref=' + requestRefHidden.value %>",
        "httpMethod": "POST",
        "authType": "sso",
        "values": [
          {
            "outboundPath": "ref",
            "value": "<% requestRefHidden.value %>"
          }
        ]
      },
      {
        "name": "postAuditLog",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "/comsAuditLogs",
        "httpMethod": "POST",
        "authType": "sso",
        "values": [
          {
            "outboundPath": "timestamp",
            "value": "<% date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\") %>"
          },
          {
            "outboundPath": "objectType",
            "value": "Assignable Role"
          },
          {
            "outboundPath": "action",
            "value": "REQUEST"
          },
          {
            "outboundPath": "coReferenceId",
            "value": "<% generatedRoleName.value ?? '' %>"
          },
          {
            "outboundPath": "coName",
            "value": "<% !empty(applicationDropdown.value) ? (applicationDropdown.selectedEntries[0].descriptor ?? '') : '' %>"
          },
          {
            "outboundPath": "details",
            "value": "<% 'AAA role request submitted: ' + (generatedRoleName.value ?? '') + ' effective ' + (effectiveDate.value != null ? effectiveDate.value.format('yyyy-MM-dd') : '') %>"
          },
          {
            "outboundPath": "triggeredBy",
            "value": "<% selectedWorker.descriptor %>"
          },
          {
            "outboundPath": "roleName",
            "value": "<% generatedRoleName.value ?? '' %>"
          },
          {
            "outboundPath": "effectiveDate",
            "value": "<% empty(effectiveDate.value) ? null : effectiveDate.value.format('yyyy-MM-dd') %>"
          },
          {
            "outboundPath": "changedByWid",
            "value": "<% selectedWorker.id ?? '' %>"
          },
          {
            "outboundPath": "positionName",
            "value": "<% (positionsList.selectedEntries ?? []).map(p => { p.descriptor }).join(', ') %>"
          },
          {
            "outboundPath": "positionWid",
            "value": "<% (positionsList.value ?? []).join(',') %>"
          }
        ],
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ]
      }
    ]
  },
  "presentation": {
    "headerSize": "HIDDEN",
    "body": {
      "type": "basicFormLayout",
      "id": "adminProvisioningForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "titleBannerSection",
          "children": [
            {
              "type": "richText",
              "id": "titleBannerRichText",
              "enabled": false,
              "value": "<span style=\"color:#0055B3;font-size:24px\"><b>ECO-COMS: Submit AAA Role Request</b></span>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "descSection",
          "children": [
            {
              "type": "button",
              "label": "← AAA Role Requests",
              "taskReference": {
                "taskId": "adminProvisioningView"
              },
              "action": "LINK"
            },
            {
              "type": "button",
              "label": "Withdraw Request",
              "taskReference": {
                "taskId": "deleteAssignableRole",
                "parameterBindings": {
                  "view": "aaa"
                }
              },
              "action": "AUXILIARY"
            },
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "title": "About This Page",
              "children": [
                {
                  "type": "richText",
                  "id": "pageDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Submit and manage your AAA (Organizations and Roles Assignment Administrator) role requests by Application. Review your pending requests or submit a new one for ISC review.</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "pendingSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "pendingRolesSection",
              "children": [
                {
                  "type": "richText",
                  "id": "pendingDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">The following requests are awaiting ISC review. ISC approves or denies them in Workday; you can withdraw your own pending request.</span>"
                },
                {
                  "type": "grid",
                  "gridType": "LIST",
                  "multiViewStylingEnabled": true,
                  "id": "assignableRolesGrid",
                  "rows": "<% list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]).filter(r => { r.status == 'Pending ISC Review' && r.roleName.startsWith('Organizations and Roles Assignment Administrator') && r.requestedBy.id == selectedWorker.id }) %>",
                  "rowVariableName": "role",
                  "enabled": false,
                  "label": "Pending AAA Role Requests",
                  "columns": [
                    {
                      "type": "column",
                      "id": "colOrgApp",
                      "columnId": "colOrgApp",
                      "label": "Organization / Application",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.shellOrgCode ?? role.application ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colRoleName",
                      "columnId": "colRoleName",
                      "label": "Role Name",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.roleName ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colWdRoleName",
                      "columnId": "colWdRoleName",
                      "label": "Generated Workday Role Name",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.workdayRoleId ?? '' %>",
                        "enabled": false
                      },
                      "sortableAndFilterable": "true"
                    },
                    {
                      "type": "column",
                      "id": "colStatus",
                      "columnId": "colStatus",
                      "label": "Status",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "richText",
                        "value": "<% role.status == 'Pending ISC Review' ? '<span style=\"color:#92400e;font-weight:600;font-size:12px\">⏳ Pending ISC Review</span>' : role.status == 'Approved' ? '<span style=\"color:#065f46;font-weight:600;font-size:12px\">✓ Approved</span>' : role.status == 'Denied' ? '<span style=\"color:#991b1b;font-weight:600;font-size:12px\">✗ Denied</span>' : role.status == 'Inactive' ? '<span style=\"color:#6b7280;font-weight:600;font-size:12px\">○ Inactive</span>' : role.status ?? '' %>"
                      }
                    },
                    {
                      "type": "column",
                      "id": "colEnabledFor",
                      "columnId": "colEnabledFor",
                      "label": "Enabled For",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.enabledForOrganizationTypes ?? 'Academic Unit - University of British Columbia' %>",
                        "enabled": false
                      },
                      "sortableAndFilterable": "true"
                    },
                    {
                      "type": "column",
                      "id": "colEffDate",
                      "columnId": "colEffDate",
                      "label": "Effective Date",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.effectiveDate ?? '' %>",
                        "enabled": false
                      },
                      "sortableAndFilterable": "true"
                    },
                    {
                      "type": "column",
                      "id": "colPositions",
                      "columnId": "colPositions",
                      "label": "Positions",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.positions ?? '' %>",
                        "enabled": false
                      },
                      "sortableAndFilterable": "true"
                    },
                    {
                      "type": "column",
                      "id": "colDelegatedRoles",
                      "columnId": "colDelegatedRoles",
                      "label": "Delegated Roles",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.enabledForOrganizationTypes ?? '' %>",
                        "enabled": false
                      },
                      "sortableAndFilterable": "true"
                    },
                    {
                      "type": "column",
                      "id": "colRequestedBy",
                      "columnId": "colRequestedBy",
                      "label": "Requested By",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.requestedBy.descriptor ?? '' %>",
                        "enabled": false
                      },
                      "sortableAndFilterable": "true"
                    },
                    {
                      "type": "column",
                      "id": "colRequestedDate",
                      "columnId": "colRequestedDate",
                      "label": "Requested Date",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.requestedDate ?? '' %>",
                        "enabled": false
                      },
                      "sortableAndFilterable": "true"
                    },
                    {
                      "type": "column",
                      "id": "colActions",
                      "columnId": "colActions",
                      "label": "Actions",
                      "cellTemplate": {
                        "type": "section",
                        "horizontal": true,
                        "children": [
                          {
                            "type": "section",
                            "horizontal": false,
                            "children": [
                              {
                                "type": "button",
                                "action": "AUXILIARY",
                                "label": "Withdraw",
                                "taskReference": {
                                  "taskId": "deleteAssignableRole",
                                  "parameterBindings": {
                                    "roleId": "<% role.id %>",
                                    "roleName": "<% role.roleName %>",
                                    "view": "aaa"
                                  }
                                }
                              }
                            ]
                          }
                        ]
                      },
                      "sortableAndFilterable": "true"
                    }
                  ],
                  "doNotAdd": true,
                  "doNotRemove": true
                }
              ],
              "title": "1. Pending ISC Review"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "newRequestSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "newRoleFieldSet",
              "children": [
                {
                  "type": "richText",
                  "id": "newRoleDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Submit a new AAA role request using the Application below. Once submitted, status will be set to <b>Pending ISC Review</b>.</span><br/><span style=\"color:#374151;font-size:12px\"><b>Functional Unit Hierarchy</b>: Limits where the role applies to one Functional Unit Hierarchy. Pick either an FUH or an Academic Unit, not both. Leave both empty for the whole university (Academic Unit - University of British Columbia).<br/><b>Academic Unit</b>: Limits where the role applies to one Academic Unit. Pick either an Academic Unit or an FUH, not both. Leave both empty for the whole university.<br/><b>Positions</b>: The positions that will hold the role once ISC approves the request. Search by position title or ID (for example P-00010). Vacant positions can be added; the role then applies to whoever fills them.</span>"
                },
                {
                  "type": "dropdown",
                  "id": "applicationDropdown",
                  "label": "Application",
                  "required": true,
                  "helpText": "Select the application for this assignable role.",
                  "values": "<%\n  let appCodes = [];\n  let result = [];\n  for (var org : customOrganizations.data) {\n    let code = org.code;\n    let appCode = code.contains('(') ?\n      code.substringAfter('(').substringBefore(')') :\n      (code.substringAfter(':').contains(':') ?\n        code.substringBefore(':') + ':' + code.substringAfter(':').substringBefore(':') :\n        code);\n    if (!appCodes.contains(appCode)) {\n      appCodes.add(appCode);\n      result.add({'id': org.workdayID, 'descriptor': appCode});\n    }\n  }\n  result;\n%>",
                  "onChange": "<%\n            generatedRoleName.setValue(\n              !empty(self.value) ?\n                !empty(fuhPicker.value) ?\n                  'Organizations and Roles Assignment Administrator (' + self.selectedEntries[0].descriptor + ', Functional Org)' :\n                !empty(academicUnitPicker.value) ?\n                  'Organizations and Roles Assignment Administrator (' + self.selectedEntries[0].descriptor + ', Academic Unit)' :\n                  'Organizations and Roles Assignment Administrator (' + self.selectedEntries[0].descriptor + ')'\n              : ''\n            );\n          %>",
                  "valuesOut": [
                    {
                      "value": "<% !empty(self.value) ? (self.selectedEntries[0].descriptor ?? '') : '' %>",
                      "valueOutBinding": "postAssignableRole.application"
                    }
                  ],
                  "guide": {
                    "type": "guide",
                    "id": "applicationDropdownGuide",
                    "title": "Application",
                    "text": "The application whose Organizations and Roles Assignment Administrator (AAA) role you are requesting. The role name is generated from it."
                  }
                },
                {
                  "type": "text",
                  "id": "generatedRoleName",
                  "label": "Requested AAA Role",
                  "enabled": false,
                  "value": "<% '' %>",
                  "helpText": "Auto-generated based on Application and scope selection. This is the Workday role name that will be requested.",
                  "valuesOut": [
                    {
                      "value": "<% self.value %>",
                      "valueOutBinding": "postAssignableRole.workdayRoleId"
                    },
                    {
                      "value": "<% self.value %>",
                      "valueOutBinding": "postAssignableRole.roleName"
                    }
                  ]
                },
                {
                  "type": "date",
                  "id": "effectiveDate",
                  "label": "Effective Date",
                  "required": true,
                  "helpText": "Date this assignable role becomes effective.",
                  "valuesOut": [
                    {
                      "value": "<% self.value %>",
                      "valueOutBinding": "postAssignableRole.effectiveDate"
                    }
                  ]
                },
                {
                  "type": "instanceList",
                  "id": "fuhPicker",
                  "label": "Functional Unit Hierarchy",
                  "required": false,
                  "values": "<% [] %>",
                  "searchEndPoint": "<% endpoints.fuhSearch %>",
                  "searchResultValues": "<% empty(fuhSearch.data) ? [] : fuhSearch.data.map(o => { {'id': o.workdayID, 'descriptor': o.organization1.descriptor} }) %>",
                  "onChange": "<%\n            if (!empty(self.value) && !empty(academicUnitPicker.value)) {\n              self.setError('Cannot select both Functional Unit Hierarchy and Academic Unit.');\n            } else {\n              self.clearError();\n              academicUnitPicker.clearError();\n            }\n            let appDesc = !empty(applicationDropdown.value) ? applicationDropdown.selectedEntries[0].descriptor : '';\n            enabledForWidBinding.setValue(!empty(self.value) ? self.value[0] : (!empty(academicUnitPicker.value) ? academicUnitPicker.value[0] : ''));\n            enabledForDisplay.setValue(!empty(self.value) ? self.selectedEntries[0].descriptor : (!empty(academicUnitPicker.value) ? academicUnitPicker.selectedEntries[0].descriptor : 'Academic Unit - University of British Columbia'));\n            if (!empty(appDesc)) {\n              generatedRoleName.setValue(\n                !empty(self.value) ?\n                  'Organizations and Roles Assignment Administrator (' + appDesc + ', Functional Org)' :\n                !empty(academicUnitPicker.value) ?\n                  'Organizations and Roles Assignment Administrator (' + appDesc + ', Academic Unit)' :\n                  'Organizations and Roles Assignment Administrator (' + appDesc + ')'\n              );\n            }\n          %>",
                  "multiSelect": false
                },
                {
                  "type": "instanceList",
                  "id": "academicUnitPicker",
                  "label": "Academic Unit",
                  "required": false,
                  "values": "<% [] %>",
                  "searchEndPoint": "<% endpoints.auSearch %>",
                  "searchResultValues": "<% empty(auSearch.data) ? [] : auSearch.data.map(o => { {'id': o.workdayID, 'descriptor': o.academicUnit.descriptor} }) %>",
                  "onChange": "<%\n            if (!empty(self.value) && !empty(fuhPicker.value)) {\n              self.setError('Cannot select both Academic Unit and Functional Unit Hierarchy.');\n            } else {\n              self.clearError();\n              fuhPicker.clearError();\n            }\n            let appDesc = !empty(applicationDropdown.value) ? applicationDropdown.selectedEntries[0].descriptor : '';\n            enabledForWidBinding.setValue(!empty(fuhPicker.value) ? fuhPicker.value[0] : (!empty(self.value) ? self.value[0] : ''));\n            enabledForDisplay.setValue(!empty(fuhPicker.value) ? fuhPicker.selectedEntries[0].descriptor : (!empty(self.value) ? self.selectedEntries[0].descriptor : 'Academic Unit - University of British Columbia'));\n            if (!empty(appDesc)) {\n              generatedRoleName.setValue(\n                !empty(fuhPicker.value) ?\n                  'Organizations and Roles Assignment Administrator (' + appDesc + ', Functional Org)' :\n                !empty(self.value) ?\n                  'Organizations and Roles Assignment Administrator (' + appDesc + ', Academic Unit)' :\n                  'Organizations and Roles Assignment Administrator (' + appDesc + ')'\n              );\n            }\n          %>",
                  "multiSelect": false
                },
                {
                  "type": "text",
                  "id": "enabledForDisplay",
                  "label": "Enabled For",
                  "enabled": false,
                  "value": "<% 'Academic Unit - University of British Columbia' %>"
                },
                {
                  "type": "instanceList",
                  "id": "positionsList",
                  "label": "Positions",
                  "required": false,
                  "multiSelect": true,
                  "values": "<% [] %>",
                  "searchEndPoint": "<% endpoints.posSearch %>",
                  "searchResultValues": "<% empty(posSearch.data) ? [] : posSearch.data.map(o => { {'id': o.workdayID, 'descriptor': !empty(o.position_PositionManagement.descriptor) ? o.position_PositionManagement.descriptor : (!empty(o.cf_PositionText) ? o.cf_PositionText : (!empty(o.cf_PositionID) ? o.cf_PositionID : o.workdayID))} }) %>",
                  "valuesOut": [
                    {
                      "value": "<% self.value.join(',') %>",
                      "valueOutBinding": "postAssignableRole.positions"
                    },
                    {
                      "value": "<% (self.selectedEntries ?? []).map(p => { p.descriptor }).join(', ') %>",
                      "valueOutBinding": "postAssignableRole.positionNames"
                    }
                  ]
                },
                {
                  "type": "hidden",
                  "id": "enabledForWidBinding",
                  "value": "<% '' %>"
                },
                {
                  "type": "hidden",
                  "id": "requestRefHidden",
                  "value": "<% date:now().format('yyyyMMddHHmmssSSS') %>"
                }
              ],
              "title": "2. Submit New AAA Role Request"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "activeNoteSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "activeNoteFieldSet",
              "title": "Before You Submit",
              "children": [
                {
                  "type": "richText",
                  "id": "activeNote",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Submitting sends the request to ISC for review in Workday; nothing changes in Workday until it is approved. The role assignment's Active status is set automatically from whether the selected positions are filled. You can withdraw your own request while it is pending.</span>"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "EDIT",
    "cancelOverride": {
      "taskId": "home"
    }
  },
  "onSubmit": "<%\n  let valid = true;\n  if (empty(applicationDropdown.value)) {\n    applicationDropdown.setError('Application is required.');\n    valid = false;\n  }\n  if (empty(effectiveDate.value)) {\n    effectiveDate.setError('Effective Date is required.');\n    valid = false;\n  }\n  if (!empty(generatedRoleName.value) && comsValidations.isDuplicateAAARole(generatedRoleName.value, allAAAroles.data)) {\n    generatedRoleName.setError(comsValidations.errorDuplicateAAARole(generatedRoleName.value));\n    valid = false;\n  }\n  valid;\n%>"
}
