{
  "id": "adminProvisioningView",
  "securityDomains": [
    "ManageCOMSAdminProvisioning"
  ],
  "endPoints": [
    {
      "name": "comsAssignableRoles",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAssignableRoles",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true"
    }
  ],
  "presentation": {
    "pageType": "view",
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ECO-COMS: Admin Provisioning",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "adminProvisioningViewForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "Submit AAA Role Request",
              "taskReference": {
                "taskId": "adminProvisioning"
              },
              "action": "PRIMARY",
              "tooltip": "Open the form to submit a new AAA role request for ISC review."
            },
            {
              "type": "button",
              "label": "\u2190 Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK",
              "tooltip": "Return to the ECO-COMS home page."
            },
            {
              "type": "button",
              "label": "Maintain",
              "taskReference": {
                "taskId": "assignableRoleManagerMaintain"
              },
              "action": "AUXILIARY",
              "tooltip": "Maintain (approve or deny) a pending AAA role request."
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "descSection",
          "children": [
            {
              "type": "richText",
              "id": "pageDesc",
              "value": "<span style=\"color:#374151;font-size:13px\">Admin Provisioning controls who can manage shell orgs and submit role requests in ECO-COMS for each application. These are <b>AAA (Organizations and Roles Assignment Administrator)</b> roles. To submit a new AAA role request for ISC review, click <b>Submit AAA Role Request</b> above.</span>"
            },
            {
              "type": "richText",
              "id": "pendingNoticeYes",
              "enabled": false,
              "value": "<span style=\"color:#d97706;font-size:11px;font-weight:700\">\u26a0 </span><span style=\"color:#92400e;font-size:11px\">There are AAA role requests currently pending ISC review. Use the <b>Maintain</b> action on a row below to process pending requests.</span>",
              "visible": "<% size(comsAssignableRoles.data.filter(r => r.roleName.startsWith('Organizations and Roles Assignment Administrator') && r.status == 'Pending ISC Review')) > 0 %>"
            },
            {
              "type": "richText",
              "id": "pendingNoticeNo",
              "enabled": false,
              "value": "<span style=\"color:#059669;font-size:11px;font-weight:700\">\u2713 </span><span style=\"color:#065f46;font-size:11px\">There are no AAA role requests pending ISC review.</span>",
              "visible": "<% size(comsAssignableRoles.data.filter(r => r.roleName.startsWith('Organizations and Roles Assignment Administrator') && r.status == 'Pending ISC Review')) == 0 %>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "gridSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "aaaRolesSection",
              "children": [
                {
                  "type": "richText",
                  "id": "emptyStateMsg",
                  "value": "<span style=\"color:#374151;font-size:12px\">There are no AAA role requests to display. Click Submit AAA Role Request above to create one.</span>",
                  "visible": "<% size(comsAssignableRoles.data.filter(r => r.roleName.startsWith('Organizations and Roles Assignment Administrator'))) == 0 %>",
                  "enabled": false
                },
                {
                  "type": "grid",
                  "gridType": "LIST",
                  "multiViewStylingEnabled": true,
                  "id": "aaaRolesGrid",
                  "rows": "<% comsAssignableRoles.data.filter(r => r.roleName.startsWith('Organizations and Roles Assignment Administrator')) %>",
                  "rowVariableName": "role",
                  "enabled": false,
                  "label": "AAA Role Requests",
                  "autoPaging": true,
                  "defaultSortColumnId": "colRequestedDate",
                  "defaultSortOrder": "DESCENDING",
                  "visible": "<% size(comsAssignableRoles.data.filter(r => r.roleName.startsWith('Organizations and Roles Assignment Administrator'))) > 0 %>",
                  "columns": [
                    {
                      "type": "column",
                      "id": "colApplication",
                      "columnId": "colApplication",
                      "label": "Application",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.application ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colRoleName",
                      "columnId": "colRoleName",
                      "label": "Role Name",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.roleName ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colStatus",
                      "columnId": "colStatus",
                      "label": "Status",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "richText",
                        "value": "<% role.status == 'Pending ISC Review' ? '<span style=\"color:#92400e;font-weight:600;font-size:11px\">\u23f3 Pending ISC Review</span>' : role.status == 'Approved' ? '<span style=\"color:#065f46;font-weight:600;font-size:11px\">\u2713 Approved</span>' : role.status == 'Inactive' ? '<span style=\"color:#6b7280;font-weight:600;font-size:11px\">\u25cb Inactive</span>' : role.status ?? '' %>"
                      }
                    },
                    {
                      "type": "column",
                      "id": "colEnabledFor",
                      "columnId": "colEnabledFor",
                      "label": "Enabled For",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.enabledForOrganizationTypes ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colEffDate",
                      "columnId": "colEffDate",
                      "label": "Effective Date",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.effectiveDate ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colRequestedBy",
                      "columnId": "colRequestedBy",
                      "label": "Requested By",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.requestedBy.descriptor ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colRequestedDate",
                      "columnId": "colRequestedDate",
                      "label": "Requested Date",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.requestedDate ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colActions",
                      "columnId": "colActions",
                      "label": "Actions",
                      "cellTemplate": {
                        "type": "section",
                        "horizontal": true,
                        "children": [
                          {
                            "type": "section",
                            "horizontal": false,
                            "children": [
                              {
                                "type": "button",
                                "action": "AUXILIARY",
                                "label": "Maintain",
                                "visible": "<% role.status == 'Pending ISC Review' %>",
                                "tooltip": "Process or update this pending AAA role request.",
                                "taskReference": {
                                  "taskId": "assignableRoleManagerMaintain",
                                  "parameterBindings": {
                                    "roleId": "<% role.id %>",
                                    "roleName": "<% role.roleName %>"
                                  }
                                }
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              ],
              "title": "AAA Role Requests",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              }
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}