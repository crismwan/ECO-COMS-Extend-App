{
  "id": "accessReview",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "include": [
    "comsAccessReview.script"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "shellRoles",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellAssignableRolesinTenant"
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "auditPage0",
      "baseUrlType": "workday-graph",
      "httpMethod": "POST",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ],
      "graphQuery": {
        "queryId": "auditLogsNewest",
        "parameters": {
          "offset": 0
        }
      }
    },
    {
      "name": "auditPage1",
      "baseUrlType": "workday-graph",
      "httpMethod": "POST",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "graphQuery": {
        "queryId": "auditLogsNewest",
        "parameters": {
          "offset": "<% ((!empty(auditPage0.data) && !empty(auditPage0.data.r)) ? (auditPage0.data.r.total ?? 0) : 0) > 100 ? 100 : 0 %>"
        }
      }
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "postReview",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "/comsAuditLogs",
        "httpMethod": "POST",
        "authType": "sso",
        "exclude": "<% stillNeededCheckBox.value != true %>",
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ]
      }
    ]
  },
  "presentation": {
    "pageType": "EDIT",
    "headerSize": "HIDDEN",
    "cancelOverride": {
      "taskId": "home"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "accessReviewForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "titleBannerSection",
          "children": [
            {
              "type": "richText",
              "id": "titleBannerRichText",
              "enabled": false,
              "value": "<span style=\"color:#0055B3;font-size:24px\"><b>ECO-COMS: Access Review</b></span>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "title": "About This Page",
              "children": [
                {
                  "type": "richText",
                  "id": "aboutRichText",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Every position that holds an ECO-COMS shell role in Workday, with when ECO-COMS last changed it and when someone last confirmed it is still needed (from the newest 200 Audit Log records). Tick <b>Still needed</b> on the ones you checked and click <b>OK</b>: each tick is recorded in the Audit Log as a review. To take a role away, use <b>Manage</b> on that row.</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "reviewSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "reviewFieldSet",
              "title": "Role Assignments",
              "children": [
                {
                  "type": "text",
                  "id": "noRowsText",
                  "label": "ⓘ Nothing to show",
                  "enabled": false,
                  "visible": "<% (list:flatten((shellRoles.data ?? []).map(r => { list:flatten((r.roleAssignments ?? []).filter(ra => { ra.organization != null && r.role != null }).map(ra => { (ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions ?? []).map(p => { { 'role': r.role.descriptor ?? '', 'roleWid': r.role.id ?? '', 'org': ra.organization.descriptor ?? '', 'orgWid': ra.organization.id ?? '', 'pos': p.descriptor ?? '', 'posWid': p.id ?? '' } }) })) }))).size() == 0 %>",
                  "value": "No positions hold an ECO-COMS shell role right now."
                },
                {
                  "type": "grid",
                  "id": "accessReviewGrid",
                  "label": "Positions Holding Shell Roles",
                  "rowVariableName": "rv",
                  "rows": "<% list:flatten((shellRoles.data ?? []).map(r => { list:flatten((r.roleAssignments ?? []).filter(ra => { ra.organization != null && r.role != null }).map(ra => { (ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions ?? []).map(p => { { 'role': r.role.descriptor ?? '', 'roleWid': r.role.id ?? '', 'org': ra.organization.descriptor ?? '', 'orgWid': ra.organization.id ?? '', 'pos': p.descriptor ?? '', 'posWid': p.id ?? '' } }) })) })) %>",
                  "doNotAdd": true,
                  "doNotRemove": true,
                  "columns": [
                    {
                      "type": "column",
                      "columnId": "colRole",
                      "label": "Role",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "id": "colRoleText",
                        "enabled": false,
                        "value": "<% rv.role %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colOrg",
                      "label": "Organization",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "id": "colOrgText",
                        "enabled": false,
                        "value": "<% rv.org %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colPosition",
                      "label": "Position",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "id": "colPositionText",
                        "enabled": false,
                        "value": "<% rv.pos %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colChanged",
                      "label": "Last Changed in ECO-COMS",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "id": "colChangedText",
                        "enabled": false,
                        "value": "<% comsAccessReview.lastChanged(list:flatten([((!empty(auditPage0.data) && !empty(auditPage0.data.r)) ? (auditPage0.data.r.data ?? []) : []), ((((!empty(auditPage0.data) && !empty(auditPage0.data.r)) ? (auditPage0.data.r.total ?? 0) : 0) > 100 && !empty(auditPage1.data) && !empty(auditPage1.data.r)) ? (auditPage1.data.r.data ?? []) : [])]), rv.role, rv.posWid, rv.pos) %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colReviewed",
                      "label": "Last Reviewed",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "id": "colReviewedText",
                        "enabled": false,
                        "value": "<% comsAccessReview.lastReviewed(list:flatten([((!empty(auditPage0.data) && !empty(auditPage0.data.r)) ? (auditPage0.data.r.data ?? []) : []), ((((!empty(auditPage0.data) && !empty(auditPage0.data.r)) ? (auditPage0.data.r.total ?? 0) : 0) > 100 && !empty(auditPage1.data) && !empty(auditPage1.data.r)) ? (auditPage1.data.r.data ?? []) : [])]), rv.role, rv.posWid, rv.pos) %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colStillNeeded",
                      "label": "Still Needed",
                      "cellTemplate": {
                        "type": "checkBox",
                        "id": "stillNeededCheckBox",
                        "value": "<% false %>",
                        "valuesOut": [
                          {
                            "value": "<% date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\") %>",
                            "valueOutBinding": "postReview.timestamp"
                          },
                          {
                            "value": "Role Assignment",
                            "valueOutBinding": "postReview.objectType"
                          },
                          {
                            "value": "REVIEW",
                            "valueOutBinding": "postReview.action"
                          },
                          {
                            "value": "<% rv.posWid %>",
                            "valueOutBinding": "postReview.coReferenceId"
                          },
                          {
                            "value": "<% rv.org %>",
                            "valueOutBinding": "postReview.coName"
                          },
                          {
                            "value": "<% rv.role %>",
                            "valueOutBinding": "postReview.roleName"
                          },
                          {
                            "value": "<% rv.roleWid %>",
                            "valueOutBinding": "postReview.roleWid"
                          },
                          {
                            "value": "<% rv.orgWid %>",
                            "valueOutBinding": "postReview.orgWid"
                          },
                          {
                            "value": "<% rv.pos %>",
                            "valueOutBinding": "postReview.positionName"
                          },
                          {
                            "value": "<% rv.posWid %>",
                            "valueOutBinding": "postReview.positionWid"
                          },
                          {
                            "value": "<% date:now().format('yyyy-MM-dd') %>",
                            "valueOutBinding": "postReview.effectiveDate"
                          },
                          {
                            "value": "<% selectedWorker.descriptor ?? '' %>",
                            "valueOutBinding": "postReview.triggeredBy"
                          },
                          {
                            "value": "<% selectedWorker.id ?? '' %>",
                            "valueOutBinding": "postReview.changedByWid"
                          },
                          {
                            "value": "<% 'Access review: ' + rv.pos + ' still needs ' + rv.role + ' on ' + rv.org %>",
                            "valueOutBinding": "postReview.details"
                          }
                        ]
                      },
                      "sortableAndFilterable": "true"
                    },
                    {
                      "type": "column",
                      "columnId": "colManage",
                      "label": "Manage",
                      "cellTemplate": {
                        "type": "button",
                        "id": "manageRoleButton",
                        "label": "Manage",
                        "action": "AUXILIARY",
                        "suppressDiscardDialog": true,
                        "taskReference": {
                          "taskId": "editRoleAssignment",
                          "parameterBindings": {
                            "roleId": "<% rv.roleWid %>",
                            "roleName": "<% rv.role %>",
                            "orgId": "<% rv.orgWid %>",
                            "orgName": "<% rv.org %>"
                          }
                        }
                      }
                    }
                  ],
                  "gridType": "LIST",
                  "multiViewStylingEnabled": true
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}
