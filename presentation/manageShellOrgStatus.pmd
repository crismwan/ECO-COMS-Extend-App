{
  "id": "manageShellOrgStatus",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "endPoints": [],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "triggerManageOrgStatus",
        "baseUrlType": "orchestration",
        "url": "<% '/ManageShellOrgStatus/launch?orgId=' + (queryParams.orgId ?? '') + '&action=' + (queryParams.currentStatus == 'Active' ? 'INACTIVATE' : 'ACTIVATE') + '&orgCode=' + (queryParams.orgCode ?? '') + '&orgName=' + (queryParams.orgName ?? '') %>",
        "authType": "SSO",
        "httpMethod": "POST",
        "onSend": "<% {} %>",
        "headers": [
          {
            "name": "content-type",
            "value": "application/json"
          }
        ],
        "failOnStatusCodes": [
          { "code": 400 },
          { "code": 403 },
          { "code": 404 },
          { "code": 500 }
        ]
      },
      {
        "name": "postAuditLog",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "/comsAuditLogs",
        "httpMethod": "POST",
        "authType": "sso",
        "values": [
          {
            "outboundPath": "timestamp",
            "value": "<% date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\") %>"
          },
          {
            "outboundPath": "objectType",
            "value": "<% queryParams.currentStatus == 'Active' ? 'Inactivate Organization' : 'Activate Organization' %>"
          },
          {
            "outboundPath": "action",
            "value": "<% queryParams.currentStatus == 'Active' ? 'INACTIVATE' : 'ACTIVATE' %>"
          },
          {
            "outboundPath": "coReferenceId",
            "value": "<% queryParams.orgCode ?? '' %>"
          },
          {
            "outboundPath": "coName",
            "value": "<% queryParams.orgName ?? '' %>"
          },
          {
            "outboundPath": "details",
            "value": "<% 'Status changed from ' + (queryParams.currentStatus ?? 'Unknown') + ' to ' + (queryParams.currentStatus == 'Active' ? 'Inactive' : 'Active') %>"
          }
        ],
        "failOnStatusCodes": [
          { "code": 400 },
          { "code": 403 },
          { "code": 500 }
        ]
      }
    ],
    "responseErrorDetail": {
      "errorSummary": "<% error ?? '' %>"
    },
    "successPage": {
      "taskId": "manageShellOrgStatusSuccess"
    }
  },
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "<% 'Change Status: ' + (queryParams.orgCode ?? 'Organization') %>",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "manageStatusForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "layout": {
            "alignment": "left",
            "labelPosition": "top"
          },
          "children": [
            {
              "type": "button",
              "label": "← Shell Org Manager",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "LINK",
              "suppressDiscardDialog": true
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "confirmSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "confirmFieldSet",
              "title": "Confirm Status Change",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "fixed",
                "labelPosition": "side_align_left"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "warningMsg",
                  "enabled": false,
                  "value": "<% queryParams.currentStatus == 'Active' ? '<span style=\"color:#d97706;font-size:11px;font-weight:700\">⚠ </span><span style=\"color:#92400e;font-size:11px\"><b>Warning:</b> Setting this organization to Inactive does not automatically remove any Workday role assignments referencing it. Verify in Workday that no active role assignments use this Custom Organization before proceeding.</span>' : '<span style=\"color:#0055B7;font-size:11px;font-weight:700\">ℹ </span><span style=\"color:#374151;font-size:11px\">This will reactivate the organization and make it available for role assignments again.</span>' %>"
                },
                {
                  "type": "readOnlyText",
                  "id": "orgNameDisplay",
                  "label": "Organization Name",
                  "value": "<% queryParams.orgName ?? '' %>"
                },
                {
                  "type": "readOnlyText",
                  "id": "orgCodeDisplay",
                  "label": "Organization Code",
                  "value": "<% queryParams.orgCode ?? '' %>"
                },
                {
                  "type": "readOnlyText",
                  "id": "currentStatusDisplay",
                  "label": "Current Status",
                  "value": "<% queryParams.currentStatus ?? '' %>"
                },
                {
                  "type": "readOnlyText",
                  "id": "newStatusDisplay",
                  "label": "New Status",
                  "value": "<% queryParams.currentStatus == 'Active' ? 'Inactive' : 'Active' %>"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "edit",
    "standardEditButtonsHidden": false
  }
}
