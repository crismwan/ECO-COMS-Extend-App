{
  "id": "manageShellOrgStatus",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "endPoints": [],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "triggerManageOrgStatus",
        "baseUrlType": "orchestration",
        "url": "<% '/ManageShellOrgStatus/launch?orgId=' + (queryParams.orgId ?? '') + '&action=' + (queryParams.currentStatus == 'Active' ? 'INACTIVATE' : 'ACTIVATE') + '&orgCode=' + (queryParams.orgCode ?? '') + '&orgName=' + (queryParams.orgName ?? '') + '&includeInactive=' + (queryParams.currentStatus == 'Active' ? 'true' : 'false') + '&effectiveDate=' + date:now().format(\"yyyy-MM-dd\") + '&patternName=' + (queryParams.orgCode ?? '') + '&orgType=' + (queryParams.orgType ?? '') + '&comsAppId=' + (queryParams.comsAppId ?? '') %>",
        "authType": "sso",
        "httpMethod": "POST",
        "onSend": "<% {} %>",
        "headers": [
          {
            "name": "content-type",
            "value": "application/json"
          }
        ],
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 404
          },
          {
            "code": 500
          }
        ]
      },
      {
        "name": "postAuditLog",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "/comsAuditLogs",
        "httpMethod": "POST",
        "authType": "sso",
        "values": [
          {
            "outboundPath": "timestamp",
            "value": "<% date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\") %>"
          },
          {
            "outboundPath": "objectType",
            "value": "<% queryParams.currentStatus == 'Active' ? 'Inactivate Organization' : 'Activate Organization' %>"
          },
          {
            "outboundPath": "action",
            "value": "<% queryParams.currentStatus == 'Active' ? 'INACTIVATE' : 'ACTIVATE' %>"
          },
          {
            "outboundPath": "coReferenceId",
            "value": "<% queryParams.orgCode ?? '' %>"
          },
          {
            "outboundPath": "coName",
            "value": "<% queryParams.orgName ?? '' %>"
          },
          {
            "outboundPath": "details",
            "value": "<% 'Status changed from ' + (queryParams.currentStatus ?? 'Unknown') + ' to ' + (queryParams.currentStatus == 'Active' ? 'Inactive' : 'Active') %>"
          }
        ],
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 500
          }
        ]
      }
    ],
    "responseErrorDetail": {
      "errorSummary": "<% error ?? '' %>"
    }
  },
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "<% 'Change Status: ' + (queryParams.orgCode ?? 'Organization') %>",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "manageStatusForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Shell Org Manager",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "LINK",
              "suppressDiscardDialog": true
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "confirmSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "confirmFieldSet",
              "title": "Confirm Status Change",
              "children": [
                {
                  "type": "richText",
                  "id": "warningMsg",
                  "enabled": false,
                  "value": "<% queryParams.currentStatus == 'Active' ? '<span style=\"color:#d97706;font-size:11px;font-weight:700\">⚠ </span><span style=\"color:#92400e;font-size:11px\"><b>Warning:</b> Setting this organization to Inactive does not automatically remove any Workday role assignments referencing it. Verify in Workday that no active role assignments use this Custom Organization before proceeding.</span>' : '<span style=\"color:#0055B7;font-size:11px;font-weight:700\">ℹ </span><span style=\"color:#374151;font-size:11px\">This will reactivate the organization and make it available for role assignments again.</span>' %>"
                },
                {
                  "type": "readOnlyText",
                  "id": "orgNameDisplay",
                  "label": "Organization Name",
                  "value": "<% queryParams.orgName ?? '' %>"
                },
                {
                  "type": "readOnlyText",
                  "id": "orgCodeDisplay",
                  "label": "Organization Code",
                  "value": "<% queryParams.orgCode ?? '' %>"
                },
                {
                  "type": "readOnlyText",
                  "id": "currentStatusDisplay",
                  "label": "Current Status",
                  "value": "<% queryParams.currentStatus ?? '' %>",
                  "guide": {
                    "type": "guide",
                    "id": "guideCurrentStatus",
                    "title": "About Organization Status",
                    "text": "Active organizations are available for role assignments in Workday. Inactive organizations are hidden from selection but existing role assignments are NOT automatically removed — verify in Workday before inactivating."
                  }
                },
                {
                  "type": "readOnlyText",
                  "id": "newStatusDisplay",
                  "label": "New Status",
                  "value": "<% queryParams.currentStatus == 'Active' ? 'Inactive' : 'Active' %>"
                },
                {
                  "type": "richText",
                  "id": "statusImpactNote",
                  "enabled": false,
                  "value": "<% queryParams.currentStatus == 'Active' ? '<span style=\"color:#92400e;font-size:11px\"><b>Impact of Inactivating:</b> The organization will no longer appear in Workday selection lists. Existing role assignments will NOT be removed automatically — you must remove them manually in Workday if needed.</span>' : '<span style=\"color:#065f46;font-size:11px\"><b>Impact of Activating:</b> The organization will become available again for new role assignments in Workday. No existing data will be changed.</span>' %>"
                },
                {
                  "type": "checkBox",
                  "id": "confirmStatusChange",
                  "label": "<% queryParams.currentStatus == 'Active' ? 'I confirm this organization should be inactivated and I have verified no active role assignments depend on it.' : 'I confirm I want to reactivate this organization and make it available for role assignments.' %>",
                  "required": true,
                  "helpText": "You must acknowledge before submitting this status change."
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "EDIT",
    "standardEditButtonsHidden": true,
    "editButtonBar": {
      "buttons": [
        {
          "type": "button",
          "id": "submitStatusChangeButton",
          "label": "<% queryParams.currentStatus == 'Active' ? 'Inactivate Organization' : 'Activate Organization' %>",
          "action": "PRIMARY",
          "taskReference": {
            "taskId": "manageShellOrgStatusSuccess",
            "parameterBindings": {
              "orgCode": "<% queryParams.orgCode ?? '' %>",
              "currentStatus": "<% queryParams.currentStatus ?? '' %>"
            }
          }
        },
        {
          "type": "button",
          "id": "cancelStatusChangeButton",
          "label": "Cancel",
          "action": "AUXILIARY",
          "suppressDiscardDialog": true,
          "taskReference": {
            "taskId": "shellOrgManager"
          }
        }
      ]
    }
  }
}
