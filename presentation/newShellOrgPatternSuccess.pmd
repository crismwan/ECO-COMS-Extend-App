{
  "id": "newShellOrgPatternSuccess",
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "Pattern Created"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "successForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "receiptCardSection",
          "children": [
            {
              "type": "cardContainer",
              "id": "receiptCardContainer",
              "layout": "grid",
              "cards": [
                {
                  "type": "card",
                  "cardId": "ShellOrgPatternReceiptCard",
                  "parameters": "<% { 'patternName': queryParams.patternName ?? '', 'organizationName': queryParams.organizationName ?? '' } %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "successSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "successFieldSet",
              "title": "Pattern Created Successfully",
              "children": [
                {
                  "type": "richText",
                  "id": "successMessage",
                  "enabled": false,
                  "value": "<span style=\"color:#059669;font-size:11px;font-weight:700\">✓ </span><span style=\"color:#065f46;font-size:11px\">The Custom Organization has been created in Workday.</span>"
                },
                {
                  "type": "readOnlyText",
                  "id": "patternNameDisplay",
                  "value": "<% queryParams.patternName ?? '' %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "Add Another Pattern",
              "taskReference": {
                "taskId": "createShellOrgPatternWizard"
              },
              "action": "PRIMARY"
            },
            {
              "type": "button",
              "label": "View in Shell Org Manager",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "AUXILIARY"
            },
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "VIEW"
  }
}
