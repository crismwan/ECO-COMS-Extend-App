{
  "id": "newShellOrgPatternSuccess",
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "auditLogCount",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAuditLogs?limit=1",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ],
      "bestEffort": "true"
    },
    {
      "name": "auditPage0",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "<% let t = auditLogCount.total ?? 0; let start = (t - 100) < 0 ? 0 : (t - 100); let cnt = t - 0 - start; '/comsAuditLogs?limit=' + (cnt > 0 ? cnt : 1) + '&offset=' + (cnt > 0 ? start : t) %>",
      "authType": "sso",
      "isCollection": true,
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "bestEffort": "true"
    }
  ],
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ECO-COMS: Pattern Created"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "successForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "successSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "successFieldSet",
              "title": "Pattern Created Successfully",
              "children": [
                {
                  "type": "richText",
                  "id": "successMessage",
                  "enabled": false,
                  "value": "<span style=\"color:#059669;font-size:12px;font-weight:700\">✓ </span><span style=\"color:#065f46;font-size:12px\">The pattern has been created in Workday.</span>"
                },
                {
                  "type": "readOnlyText",
                  "id": "patternHint",
                  "label": " ",
                  "value": "A record of this change is in the Audit Log. The card below shows your most recent pattern created through ECO-COMS."
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "receiptCardSection",
          "children": [
            {
              "type": "cardContainer",
              "id": "receiptCardContainer",
              "cards": [
                {
                  "type": "card",
                  "cardId": "ShellOrgPatternReceiptCard",
                  "render": "<% size(list:sort((auditPage0.data ?? []).filter(a => { a.objectType == 'Shell Org Pattern' && a.action == 'ADD' && (a.changedByWid ?? '') == (selectedWorker.id ?? '') }), 'timestamp', false)) > 0 %>",
                  "parameters": "<% let mine = list:sort((auditPage0.data ?? []).filter(a => { a.objectType == 'Shell Org Pattern' && a.action == 'ADD' && (a.changedByWid ?? '') == (selectedWorker.id ?? '') }), 'timestamp', false); { 'patternName': size(mine) > 0 ? ((mine[0].coName ?? '') + ' | Effective ' + (mine[0].effectiveDate ?? '') + ' | Created ' + (empty(mine[0].timestamp) ? '' : date:formatDateWithTimeZones(mine[0].timestamp.substring(0, 19).replace('T', ' '), 'UTC', 'yyyy-MM-dd HH:mm:ss', 'America/Los_Angeles', 'yyyy-MM-dd HH:mm z'))) : '' } %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "Add Another Pattern",
              "taskReference": {
                "taskId": "createShellOrgPatternWizard"
              },
              "action": "PRIMARY"
            },
            {
              "type": "button",
              "label": "View in Shell Org Manager",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "AUXILIARY"
            },
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "VIEW"
  }
}
