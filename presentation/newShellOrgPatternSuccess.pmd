{
  "id": "newShellOrgPatternSuccess",
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "Pattern Created"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "successForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "successSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "successFieldSet",
              "children": [
                {
                  "type": "text",
                  "id": "successMessageText",
                  "value": "<% \"Pattern \" + (flowVariables.patternName ?? \"\") + \" has been created successfully.\" %>",
                  "enabled": false
                },
                {
                  "type": "text",
                  "id": "patternNameText",
                  "label": "Pattern Name",
                  "value": "<% flowVariables.patternName ?? \"\" %>",
                  "enabled": false
                },
                {
                  "type": "text",
                  "id": "appCodeText",
                  "label": "Application",
                  "value": "<% flowVariables.comsAppId ?? \"\" %>",
                  "enabled": false
                },
                {
                  "type": "text",
                  "id": "effectiveDateText",
                  "label": "Effective Date",
                  "value": "<% flowVariables.effectiveDate ?? \"\" %>",
                  "enabled": false
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "Add Another Pattern",
              "taskReference": {
                "taskId": "createShellOrgPatternWizard"
              },
              "action": "PRIMARY"
            },
            {
              "type": "button",
              "label": "View in Shell Org Manager",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "AUXILIARY"
            },
            {
              "type": "button",
              "label": "Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "VIEW"
  }
}
