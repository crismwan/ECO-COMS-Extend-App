{
  "id": "newShellOrgPatternSuccess",
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "Pattern Created"
    },
    "body": {
      "type": "section",
      "horizontal": false,
      "children": [
        {
          "type": "readOnlyText",
          "id": "successMessage",
          "value": "The Custom Organization has been created in Workday."
        },
        {
          "type": "readOnlyText",
          "id": "patternNameDisplay",
          "value": "<% flowVariables.patternName ?? '' %>"
        },
        {
          "type": "section",
          "horizontal": true,
          "children": [
            {
              "type": "section",
              "horizontal": false,
              "children": [
                {
                  "type": "button",
                  "label": "Add Another Pattern",
                  "taskReference": {
                    "taskId": "newShellOrgPattern"
                  },
                  "action": "PRIMARY"
                }
              ]
            },
            {
              "type": "section",
              "horizontal": false,
              "children": [
                {
                  "type": "button",
                  "label": "Back to Shell Org Manager",
                  "taskReference": {
                    "taskId": "shellOrgManager"
                  },
                  "action": "AUXILIARY"
                }
              ]
            }
          ],
          "columnWidthRatios": [0.25, 0.25, 0.25, 0.25]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "view"
  }
}