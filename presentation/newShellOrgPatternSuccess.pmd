{
  "id": "newShellOrgPatternSuccess",
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "Pattern Created"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "successForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "successSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "successFieldSet",
              "title": "Pattern Created Successfully",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "successMessage",
                  "enabled": false,
                  "value": "The Custom Organization has been created in Workday."
                },
                {
                  "type": "readOnlyText",
                  "id": "patternNameDisplay",
                  "value": "<% flowVariables.patternName ?? '' %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "section",
              "horizontal": true,
              "columnWidthRatios": [
                0.25,
                0.25,
                0.25,
                0.25
              ],
              "children": [
                {
                  "type": "section",
                  "horizontal": false,
                  "children": [
                    {
                      "type": "button",
                      "label": "Add Another Pattern",
                      "taskReference": {
                        "taskId": "newShellOrgPattern"
                      },
                      "action": "PRIMARY"
                    }
                  ]
                },
                {
                  "type": "section",
                  "horizontal": false,
                  "children": [
                    {
                      "type": "button",
                      "label": "Back to Shell Org Manager",
                      "taskReference": {
                        "taskId": "shellOrgManager"
                      },
                      "action": "AUXILIARY"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "view"
  }
}