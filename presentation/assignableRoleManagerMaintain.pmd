{
  "id": "assignableRoleManagerMaintain",
  "include": [
    "comsValidations.script"
  ],
  "securityDomains": [
    "MaintainCOMSAssignableRoles"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso"
    },
    {
      "name": "selectedRole",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "<% empty(queryParams.roleId) ? '/comsAssignableRoles/none' : '/comsAssignableRoles/' + queryParams.roleId %>",
      "authType": "sso",
      "bestEffort": "true",
      "exclude": "<% empty(queryParams.roleId) %>"
    },
    {
      "name": "allShellRoles",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellAssignableRolesinTenant"
      }
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "approveRole",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "<% '/comsAssignableRoles/' + queryParams.roleId %>",
        "httpMethod": "PUT",
        "authType": "sso",
        "exclude": "<% selectedAction.value != 'Approve' %>",
        "onSend": "<% self.data %>",
        "values": [
          {
            "outboundPath": "status",
            "value": "Approved"
          },
          {
            "outboundPath": "active",
            "value": "<% true %>"
          },
          {
            "outboundPath": "approvedBy.id",
            "value": "<% selectedWorker.id %>"
          },
          {
            "outboundPath": "approvedDate",
            "value": "<% date:now().format('yyyy-MM-dd') %>"
          }
        ],
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ]
      },
      {
        "name": "denyRole",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "<% '/comsAssignableRoles/' + queryParams.roleId %>",
        "httpMethod": "PUT",
        "authType": "sso",
        "exclude": "<% selectedAction.value != 'Deny' %>",
        "onSend": "<% self.data %>",
        "values": [
          {
            "outboundPath": "status",
            "value": "Denied"
          },
          {
            "outboundPath": "active",
            "value": "<% false %>"
          }
        ],
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ]
      },
      {
        "name": "postAuditLog",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "/comsAuditLogs",
        "httpMethod": "POST",
        "authType": "sso",
        "values": [
          {
            "outboundPath": "timestamp",
            "value": "<% date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\") %>"
          },
          {
            "outboundPath": "objectType",
            "value": "COMSAssignableRole"
          },
          {
            "outboundPath": "action",
            "value": "MODIFY"
          },
          {
            "outboundPath": "worker",
            "value": "<% selectedWorker.id %>"
          },
          {
            "outboundPath": "application",
            "value": ""
          },
          {
            "outboundPath": "coReferenceId",
            "value": "<% queryParams.roleId ?? '' %>"
          },
          {
            "outboundPath": "coName",
            "value": "<% roleNameText.value ?? '' %>"
          },
          {
            "outboundPath": "details",
            "value": "<% 'Role approved: ' + (roleNameText.value ?? '') + '. Workday role: ' + (workdayRoleDropdown.value ?? '') %>"
          },
          {
            "outboundPath": "triggeredBy",
            "value": "<% selectedWorker.descriptor %>"
          }
        ],
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ],
        "exclude": "<% selectedAction.value != 'Approve' %>"
      },
      {
        "name": "postAuditLogDeny",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "/comsAuditLogs",
        "httpMethod": "POST",
        "authType": "sso",
        "values": [
          {
            "outboundPath": "timestamp",
            "value": "<% date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\") %>"
          },
          {
            "outboundPath": "objectType",
            "value": "COMSAssignableRole"
          },
          {
            "outboundPath": "action",
            "value": "MODIFY"
          },
          {
            "outboundPath": "worker",
            "value": "<% selectedWorker.id %>"
          },
          {
            "outboundPath": "application",
            "value": ""
          },
          {
            "outboundPath": "coReferenceId",
            "value": "<% queryParams.roleId ?? '' %>"
          },
          {
            "outboundPath": "coName",
            "value": "<% roleNameText.value ?? '' %>"
          },
          {
            "outboundPath": "details",
            "value": "<% 'Role denied: ' + (roleNameText.value ?? '') + '. Reason: ' + (denialReason.value ?? '') %>"
          },
          {
            "outboundPath": "triggeredBy",
            "value": "<% selectedWorker.descriptor %>"
          }
        ],
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ],
        "exclude": "<% selectedAction.value != 'Deny' %>"
      }
    ],
    "responseErrorDetail": {
      "errorSummary": "<% error %>",
      "errors": "<% empty errors ? [] : errors.map(err => { err.error }) %>"
    }
  },
  "presentation": {
    "pageType": "edit",
    "title": {
      "type": "title",
      "label": "ECO-COMS: Maintain Assignable Roles (ISC)"
    },
    "body": {
      "type": "section",
      "horizontal": false,
      "children": [
        {
          "type": "section",
          "horizontal": true,
          "children": [
            {
              "type": "section",
              "horizontal": false,
              "children": [
                {
                  "type": "button",
                  "label": "← Back to Assignable Role Manager",
                  "taskReference": {
                    "taskId": "assignableRoleManager"
                  },
                  "action": "AUXILIARY"
                }
              ]
            }
          ],
          "columnWidthRatios": [
            0.25,
            0.25,
            0.25,
            0.25
          ]
        },
        {
          "type": "fieldSet",
          "id": "actionFieldSet",
          "children": [
            {
              "type": "dropdown",
              "id": "maintainAction",
              "label": "Action",
              "required": true,
              "enabled": true,
              "values": "<% [{'id': 'Approve', 'descriptor': 'Approve'}, {'id': 'Deny', 'descriptor': 'Deny'}] %>",
              "onChange": "<%\n            selectedAction.setValue(self.value);\n            if (self.value == 'Deny' && empty(denialReason.value)) {\n              denialReason.setError('Denial Reason is required when denying a role.');\n            } else {\n              denialReason.clearError();\n            }\n          %>"
            },
            {
              "type": "hidden",
              "id": "selectedAction",
              "value": "<% '' %>"
            },
            {
              "type": "instanceList",
              "id": "workdayRoleDropdown",
              "label": "Workday Assignable Role (required for Approve)",
              "required": false,
              "enabled": true,
              "values": "<% allShellRoles.data.map(r => { {'id': r.role.id, 'descriptor': r.role.descriptor} }) %>",
              "valuesOut": [
                {
                  "value": "<% self.value[0] ?? '' %>",
                  "valueOutBinding": "approveRole.workdayAssignableRole"
                },
                {
                  "value": "<% self.selectedEntries[0].descriptor ?? '' %>",
                  "valueOutBinding": "approveRole.workdayRoleId"
                }
              ]
            },
            {
              "type": "textArea",
              "id": "denialReason",
              "label": "Denial Reason (required for Deny)",
              "required": false,
              "enabled": true,
              "placeholder": "Provide a clear reason for denying this role request.",
              "onChange": "<%\n            if (maintainAction.value == 'Deny' && empty(self.value)) {\n              self.setError('Denial Reason is required when denying a role.');\n            } else {\n              self.clearError();\n            }\n          %>",
              "valuesOut": [
                {
                  "value": "<% self.value %>",
                  "valueOutBinding": "denyRole.denialReason"
                }
              ]
            }
          ],
          "title": "ISC Action",
          "layout": {
            "density": "medium",
            "alignment": "left",
            "horizontalSizing": "fixed",
            "labelPosition": "side_align_left"
          }
        },
        {
          "type": "fieldSet",
          "id": "roleDetailSection",
          "children": [
            {
              "type": "text",
              "id": "roleNameText",
              "label": "Role Name",
              "enabled": false,
              "value": "<% selectedRole.roleName ?? '' %>"
            },
            {
              "type": "text",
              "id": "enabledForText",
              "label": "Enabled For",
              "enabled": false,
              "value": "<% selectedRole.enabledForOrganizationTypes ?? 'Academic Unit - University of British Columbia' %>"
            },
            {
              "type": "text",
              "id": "delegatedRolesText",
              "label": "Delegated Roles",
              "enabled": false,
              "visible": "<% !empty(selectedRole.enabledForOrganizationTypes) && selectedRole.enabledForOrganizationTypes != 'Academic Unit - University of British Columbia' %>",
              "value": "<% selectedRole.enabledForOrganizationTypes ?? '' %>"
            },
            {
              "type": "grid",
              "gridType": "LIST",
              "id": "posGrid",
              "label": "Positions",
              "rows": "<% empty(selectedRole.positionWids) ? (empty(selectedRole.positions) ? [] : positions.data.filter(p => { selectedRole.positions.contains(p.id) })) : positions.data.filter(p => { selectedRole.positionWids.contains(p.id) }) %>",
              "rowVariableName": "pos",
              "enabled": false,
              "columns": [
                {
                  "type": "column",
                  "id": "colPos",
                  "columnId": "colPos",
                  "label": "Position",
                  "cellTemplate": {
                    "type": "text",
                    "value": "<% pos.descriptor %>",
                    "enabled": false
                  }
                }
              ]
            }
          ],
          "title": "Role Details",
          "layout": {
            "density": "medium",
            "alignment": "left",
            "horizontalSizing": "fixed",
            "labelPosition": "side_align_left"
          }
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "richText",
          "enabled": "false",
          "value": "Powered By Workday Extend"
        }
      ]
    }
  },
  "onSubmit": "<%\n  let valid = true;\n  if (empty(maintainAction.value)) {\n    maintainAction.setError('Please select an action.');\n    valid = false;\n  }\n  if (maintainAction.value == 'Approve') {\n    if (empty(workdayRoleDropdown.value)) {\n      workdayRoleDropdown.setError('Please select a Workday Assignable Role to approve.');\n      valid = false;\n    }\n  }\n  if (maintainAction.value == 'Deny') {\n    if (empty(denialReason.value)) {\n      denialReason.setError('Denial Reason is required when denying a role.');\n      valid = false;\n    }\n  }\n  valid;\n%>"
}