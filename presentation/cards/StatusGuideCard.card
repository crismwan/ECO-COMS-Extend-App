{
  "id": "StatusGuideCard",
  "parameters": [
    "info"
  ],
  "header": {
    "title": "<% info.title %>",
    "subtitle": "<% info.subtitle %>",
    "icon": "<% info.icon %>",
    "indicator": {
      "label": "<% info.indicatorLabel %>"
    }
  },
  "body": {
    "type": "simpleCard",
    "value": "<% info.body %>"
  }
}
