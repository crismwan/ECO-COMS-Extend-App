{
  "id": "PendingAgeChart",
  "parameters": [
    "ages",
    "totalText"
  ],
  "header": {
    "title": "Pending Requests by Age",
    "subtitle": "<% totalText ?? \"\" %>",
    "icon": "wd-accent-data-loading"
  },
  "body": {
    "type": "chartCard",
    "chart": {
      "type": "stackedBarChart2",
      "id": "pendingAgeStackedBarChart",
      "data": "<% ages ?? [] %>",
      "dataVariableName": "age",
      "categoryDataSet": {
        "name": "Business days waiting",
        "value": "<% age.age %>"
      },
      "measurementDataSets": [
        {
          "name": "Assignable roles",
          "value": "<% age.assignable %>"
        },
        {
          "name": "AAA roles",
          "value": "<% age.aaa %>"
        }
      ],
      "measurementAxisOptions": {
        "axisTitle": "Requests"
      }
    }
  }
}
