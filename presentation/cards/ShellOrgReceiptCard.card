{
  "id": "ShellOrgReceiptCard",
  "parameters": ["organizationName", "bodyText"],
  "header": {
    "title": "Organization Created Successfully",
    "subtitle": "<% organizationName ?? \"\" %>",
    "indicator": {
      "label": "Created",
      "color": "green"
    }
  },
  "body": {
    "type": "simpleCard",
    "value": "<% bodyText ?? \"\" %>"
  },
  "footer": [
    {
      "label": "View in Shell Org Manager",
      "taskReference": {
        "taskId": "shellOrgManager"
      }
    },
    {
      "label": "Add Another Organization",
      "taskReference": {
        "taskId": "createShellOrgWizard"
      }
    }
  ]
}
