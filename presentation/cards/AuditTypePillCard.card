{
  "id": "AuditTypePillCard",
  "parameters": [
    "period",
    "changeType",
    "by",
    "orgId",
    "orgCode",
    "orgName"
  ],
  "header": {
    "title": "Change Type",
    "icon": "wd-accent-scroll-shield"
  },
  "body": {
    "type": "pillCard",
    "pills": [
      {
        "label": "<% (empty(changeType)) ? \"✓ All types\" : \"All types\" %>",
        "taskReference": {
          "taskId": "auditLogViewer",
          "parameterBindings": {
            "period": "<% period ?? \"\" %>",
            "changeType": "",
            "by": "<% by ?? \"\" %>",
            "orgId": "<% orgId ?? \"\" %>",
            "orgCode": "<% orgCode ?? \"\" %>",
            "orgName": "<% orgName ?? \"\" %>"
          }
        }
      },
      {
        "label": "<% (changeType == \"Shell Org\") ? \"✓ Shell Org\" : \"Shell Org\" %>",
        "taskReference": {
          "taskId": "auditLogViewer",
          "parameterBindings": {
            "period": "<% period ?? \"\" %>",
            "changeType": "Shell Org",
            "by": "<% by ?? \"\" %>",
            "orgId": "<% orgId ?? \"\" %>",
            "orgCode": "<% orgCode ?? \"\" %>",
            "orgName": "<% orgName ?? \"\" %>"
          }
        }
      },
      {
        "label": "<% (changeType == \"Shell Org Pattern\") ? \"✓ Pattern\" : \"Pattern\" %>",
        "taskReference": {
          "taskId": "auditLogViewer",
          "parameterBindings": {
            "period": "<% period ?? \"\" %>",
            "changeType": "Shell Org Pattern",
            "by": "<% by ?? \"\" %>",
            "orgId": "<% orgId ?? \"\" %>",
            "orgCode": "<% orgCode ?? \"\" %>",
            "orgName": "<% orgName ?? \"\" %>"
          }
        }
      },
      {
        "label": "<% (changeType == \"Org Status\") ? \"✓ Org Status\" : \"Org Status\" %>",
        "taskReference": {
          "taskId": "auditLogViewer",
          "parameterBindings": {
            "period": "<% period ?? \"\" %>",
            "changeType": "Org Status",
            "by": "<% by ?? \"\" %>",
            "orgId": "<% orgId ?? \"\" %>",
            "orgCode": "<% orgCode ?? \"\" %>",
            "orgName": "<% orgName ?? \"\" %>"
          }
        }
      },
      {
        "label": "<% (changeType == \"Role Assignment\") ? \"✓ Role Assignment\" : \"Role Assignment\" %>",
        "taskReference": {
          "taskId": "auditLogViewer",
          "parameterBindings": {
            "period": "<% period ?? \"\" %>",
            "changeType": "Role Assignment",
