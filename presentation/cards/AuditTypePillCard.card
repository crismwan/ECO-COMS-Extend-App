            "orgId": "<% orgId ?? \"\" %>",
            "orgCode": "<% orgCode ?? \"\" %>",
            "orgName": "<% orgName ?? \"\" %>"
          }
        }
      },
      {
        "label": "<% (changeType == \"Application Pattern\") ? \"✓ Application Pattern\" : \"Application Pattern\" %>",
        "taskReference": {
