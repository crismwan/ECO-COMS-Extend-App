{
  "id": "ShellOrgPatternReceiptCard",
  "parameters": [
    "patternName"
  ],
  "header": {
    "title": "Custom Organization Pattern Created",
    "icon": "wd-accent-award-medal",
    "indicator": {
      "label": "Created",
      "color": "green"
    }
  },
  "body": {
