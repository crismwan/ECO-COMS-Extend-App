{
  "id": "ShellOrgPatternReceiptCard",
  "parameters": ["patternName", "applicationCode", "effectiveDate"],
  "header": {
    "title": "Pattern Created Successfully",
    "subtitle": "<% patternName ?? '' %>",
    "indicator": {
      "label": "Created",
      "color": "green"
    }
  },
  "body": {
    "type": "simpleCard",
    "value": "<% 'Pattern Name: ' + (patternName ?? '') + ' | Application: ' + (applicationCode ?? '') + ' | Effective Date: ' + (effectiveDate ?? '') %>"
  },
  "footer": [
    {
      "label": "View in Shell Org Manager",
      "taskReference": {
        "taskId": "shellOrgManager"
      }
    },
    {
      "label": "Add Another Pattern",
      "taskReference": {
        "taskId": "createShellOrgPatternWizard"
      }
    }
  ]
}
