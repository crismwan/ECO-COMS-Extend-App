{
  "id": "AppPickCard",
  "parameters": [
    "appId",
    "subtitleText",
    "bodyText",
    "indicatorLabel",
    "indicatorColor"
  ],
  "header": {
    "title": "<% appId ?? \"\" %>",
    "subtitle": "<% subtitleText ?? \"\" %>",
    "icon": "wd-accent-building",
    "indicator": {
      "label": "<% indicatorLabel ?? \"\" %>",
      "color": "<% indicatorColor ?? \"gray\" %>"
    }
  },
  "body": {
    "type": "simpleCard",
    "value": "<% bodyText ?? \"\" %>"
  },
  "footer": [
    {
      "label": "Narrow to this application",
      "taskReference": {
        "taskId": "shellOrgManager",
        "parameterBindings": {
          "appCode": "<% appId ?? \"\" %>",
          "appName": "<% appId ?? \"\" %>"
        }
      }
    }
  ]
}
