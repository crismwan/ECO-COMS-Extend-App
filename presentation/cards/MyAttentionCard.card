{
  "id": "MyAttentionCard",
  "parameters": [
    "requestsText",
    "bulkText"
  ],
  "header": {
    "title": "Needs My Attention",
    "subtitle": "Your own role requests and bulk uploads.",
    "icon": "wd-accent-inbox"
  },
  "body": {
    "type": "simpleCard",
    "value": "<% (requestsText ?? \"\") + \" · \" + (bulkText ?? \"\") %>"
  },
  "footer": [
    {
      "label": "Open My Requests",
      "taskReference": {
        "taskId": "assignableRoleManagerView"
      }
    },
    {
      "label": "Open AAA Requests",
      "taskReference": {
        "taskId": "adminProvisioningView"
      }
    },
    {
      "label": "Open My Bulk Uploads",
      "taskReference": {
        "taskId": "bulkRoleResults"
      }
    }
  ]
}
