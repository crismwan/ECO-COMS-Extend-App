{
  "id": "AuditPeriodPillCard",
  "parameters": [
    "period",
    "changeType",
    "by",
    "orgId",
    "orgCode",
    "orgName"
  ],
  "header": {
    "title": "Time Period",
    "icon": "wd-accent-calendar"
  },
  "body": {
    "type": "pillCard",
    "pills": [
      {
        "label": "<% (empty(period) || period == \"all\") ? \"✓ All time\" : \"All time\" %>",
        "taskReference": {
          "taskId": "auditLogViewer",
          "parameterBindings": {
            "period": "all",
            "changeType": "<% changeType ?? \"\" %>",
            "by": "<% by ?? \"\" %>",
            "orgId": "<% orgId ?? \"\" %>",
            "orgCode": "<% orgCode ?? \"\" %>",
            "orgName": "<% orgName ?? \"\" %>"
          }
        }
      },
      {
        "label": "<% (period == \"24h\") ? \"✓ Last 24 hours\" : \"Last 24 hours\" %>",
        "taskReference": {
          "taskId": "auditLogViewer",
          "parameterBindings": {
            "period": "24h",
            "changeType": "<% changeType ?? \"\" %>",
            "by": "<% by ?? \"\" %>",
            "orgId": "<% orgId ?? \"\" %>",
            "orgCode": "<% orgCode ?? \"\" %>",
            "orgName": "<% orgName ?? \"\" %>"
          }
        }
      },
      {
        "label": "<% (period == \"7d\") ? \"✓ Last 7 days\" : \"Last 7 days\" %>",
        "taskReference": {
          "taskId": "auditLogViewer",
          "parameterBindings": {
            "period": "7d",
            "changeType": "<% changeType ?? \"\" %>",
            "by": "<% by ?? \"\" %>",
            "orgId": "<% orgId ?? \"\" %>",
            "orgCode": "<% orgCode ?? \"\" %>",
            "orgName": "<% orgName ?? \"\" %>"
          }
        }
      },
      {
        "label": "<% (period == \"30d\") ? \"✓ Last 30 days\" : \"Last 30 days\" %>",
        "taskReference": {
          "taskId": "auditLogViewer",
          "parameterBindings": {
            "period": "30d",
            "changeType": "<% changeType ?? \"\" %>",
            "by": "<% by ?? \"\" %>",
            "orgId": "<% orgId ?? \"\" %>",
            "orgCode": "<% orgCode ?? \"\" %>",
            "orgName": "<% orgName ?? \"\" %>"
          }
        }
      }
    ]
  }
}
