{
  "id": "ShellOrgStatusChart",
  "parameters": [
    "activeCount",
    "inactiveCount"
  ],
  "header": {
    "title": "Shell Org Overview",
    "subtitle": "Active vs. inactive shell organizations"
  },
  "body": {
    "type": "chartCard",
    "chart": {
      "type": "donutChart2",
      "data": "<% [{\"status\": \"Active\", \"count\": activeCount ?? 0}, {\"status\": \"Inactive\", \"count\": inactiveCount ?? 0}] %>",
      "dataVariableName": "slice",
      "title": "<% \"\" + ((activeCount ?? 0) + (inactiveCount ?? 0)) + \" organizations\" %>",
      "sliceSizeDataSet": {
        "name": "Count",
        "value": "<% slice[\"count\"] %>"
      },
      "sliceColorDataSet": {
        "name": "Status",
        "value": "<% slice[\"status\"] %>"
      },
      "showPercentLabels": true,
      "animateOnLoad": true
    }
  }
}
