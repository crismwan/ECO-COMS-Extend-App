{
  "id": "deleteAssignableRole",
  "include": [
    "comsValidations.script"
  ],
  "securityDomains": [
    "ManageCOMSAssignableRoles"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "comsAssignableRolesCount",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAssignableRoles?limit=1",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ],
      "name": "comsAssignableRolesPage0",
      "url": "/comsAssignableRoles?limit=100&offset=0"
    },
    {
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "name": "comsAssignableRolesPage1",
      "url": "<% let t = comsAssignableRolesCount.total ?? 0; '/comsAssignableRoles?limit=100&offset=' + (t > 100 ? 100 : t) %>"
    },
    {
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "name": "comsAssignableRolesPage2",
      "url": "<% let t = comsAssignableRolesCount.total ?? 0; '/comsAssignableRoles?limit=100&offset=' + (t > 200 ? 200 : t) %>"
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "cancelReview",
        "baseUrlType": "workday-bp",
        "url": "<% 'events/' + (size((list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]) ?? []).filter(r => { r.id == (queryParams.roleId ?? '') && r.status == 'Pending ISC Review' && !empty(r.requestedBy) && r.requestedBy.id == (selectedWorker.id ?? '') })) > 0 ? ((list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]) ?? []).filter(r => { r.id == (queryParams.roleId ?? '') && r.status == 'Pending ISC Review' && !empty(r.requestedBy) && r.requestedBy.id == (selectedWorker.id ?? '') })[0].reviewEventWid ?? '') : '') + '/cancel' %>",
        "httpMethod": "POST",
        "authType": "sso",
        "values": [
          {
            "outboundPath": "comment",
            "value": "<% 'Withdrawn by the requester in ECO-COMS: ' + (queryParams.roleName ?? '') %>"
          }
        ],
        "exclude": "<% empty((size((list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]) ?? []).filter(r => { r.id == (queryParams.roleId ?? '') && r.status == 'Pending ISC Review' && !empty(r.requestedBy) && r.requestedBy.id == (selectedWorker.id ?? '') })) > 0 ? ((list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]) ?? []).filter(r => { r.id == (queryParams.roleId ?? '') && r.status == 'Pending ISC Review' && !empty(r.requestedBy) && r.requestedBy.id == (selectedWorker.id ?? '') })[0].reviewEventWid ?? '') : '')) %>",
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 404
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ]
      },
      {
        "name": "deleteRole",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "<% '/comsAssignableRoles/' + queryParams.roleId %>",
        "httpMethod": "DELETE",
        "authType": "sso",
        "exclude": "<% empty(queryParams.roleId) || !empty((size((list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]) ?? []).filter(r => { r.id == (queryParams.roleId ?? '') && r.status == 'Pending ISC Review' && !empty(r.requestedBy) && r.requestedBy.id == (selectedWorker.id ?? '') })) > 0 ? ((list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]) ?? []).filter(r => { r.id == (queryParams.roleId ?? '') && r.status == 'Pending ISC Review' && !empty(r.requestedBy) && r.requestedBy.id == (selectedWorker.id ?? '') })[0].reviewEventWid ?? '') : '')) %>",
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ]
      },
      {
        "name": "postAuditLog",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "/comsAuditLogs",
        "httpMethod": "POST",
        "authType": "sso",
        "values": [
          {
            "outboundPath": "timestamp",
            "value": "<% date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\") %>"
          },
          {
            "outboundPath": "objectType",
            "value": "Assignable Role"
          },
          {
            "outboundPath": "action",
            "value": "DELETE"
          },
          {
            "outboundPath": "coReferenceId",
            "value": "<% queryParams.roleId ?? '' %>"
          },
          {
            "outboundPath": "coName",
            "value": "<% selectedRoleDisplay.value ?? '' %>"
          },
          {
            "outboundPath": "details",
            "value": "<% 'Assignable role request withdrawn and deleted (no review event): ' + (selectedRoleDisplay.value ?? '') + ' (id: ' + (queryParams.roleId ?? '') + ')' %>"
          },
          {
            "outboundPath": "triggeredBy",
            "value": "<% selectedWorker.descriptor %>"
          },
          {
            "outboundPath": "roleName",
            "value": "<% selectedRoleDisplay.value ?? '' %>"
          },
          {
            "outboundPath": "changedByWid",
            "value": "<% selectedWorker.id ?? '' %>"
          }
        ],
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ],
        "exclude": "<% empty(queryParams.roleId) || !empty((size((list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]) ?? []).filter(r => { r.id == (queryParams.roleId ?? '') && r.status == 'Pending ISC Review' && !empty(r.requestedBy) && r.requestedBy.id == (selectedWorker.id ?? '') })) > 0 ? ((list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]) ?? []).filter(r => { r.id == (queryParams.roleId ?? '') && r.status == 'Pending ISC Review' && !empty(r.requestedBy) && r.requestedBy.id == (selectedWorker.id ?? '') })[0].reviewEventWid ?? '') : '')) %>"
      }
    ],
    "responseErrorDetail": {
      "errorSummary": "<% error %>",
      "errors": "<% empty errors ? [] : errors.map(err => { err.error }) %>"
    }
  },
  "presentation": {
    "pageType": "EDIT",
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "<% 'ECO-COMS: Withdraw ' + (queryParams.view == 'aaa' ? 'AAA ' : (queryParams.view == 'assignable' ? 'Assignable ' : '')) + 'Role Request' %>"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "deleteForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← My Assignable Role Requests",
              "taskReference": {
                "taskId": "assignableRoleManagerView"
              },
              "action": "LINK",
              "suppressDiscardDialog": true,
              "visible": "<% empty(queryParams.view) || queryParams.view == 'assignable' %>"
            },
            {
              "type": "button",
              "label": "← AAA Role Requests",
              "taskReference": {
                "taskId": "adminProvisioningView"
              },
              "action": "LINK",
              "suppressDiscardDialog": true,
              "visible": "<% queryParams.view == 'aaa' %>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "descSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "title": "About This Page",
              "children": [
                {
                  "type": "richText",
                  "id": "pageDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Select one of your requests that is still Pending ISC Review to withdraw it. Withdrawing cancels its ISC review in Workday; the request is then marked Denied and the change is recorded in the Audit Log.</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "gridSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "pendingRolesFieldSet",
              "title": "<% 'My Pending ' + (queryParams.view == 'aaa' ? 'AAA ' : (queryParams.view == 'assignable' ? 'Assignable ' : '')) + 'Role Requests' %>",
              "children": [
                {
                  "type": "grid",
                  "gridType": "LIST",
                  "multiViewStylingEnabled": true,
                  "id": "pendingRolesGrid",
                  "label": "<% 'My Pending ' + (queryParams.view == 'aaa' ? 'AAA ' : (queryParams.view == 'assignable' ? 'Assignable ' : '')) + 'Role Requests' %>",
                  "rows": "<% (list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]) ?? []).filter(r => { r.status == 'Pending ISC Review' && !empty(r.requestedBy) && r.requestedBy.id == (selectedWorker.id ?? '') && (empty(queryParams.view) || (queryParams.view == 'aaa' ? r.roleName.startsWith('Organizations and Roles Assignment Administrator') : !r.roleName.startsWith('Organizations and Roles Assignment Administrator'))) }) %>",
                  "rowVariableName": "role",
                  "enabled": false,
                  "columns": [
                    {
                      "type": "column",
                      "id": "colSelect",
                      "columnId": "colSelect",
                      "label": "Withdraw",
                      "cellTemplate": {
                        "type": "button",
                        "action": "AUXILIARY",
                        "label": "Select",
                        "taskReference": {
                          "taskId": "deleteAssignableRole",
                          "parameterBindings": {
                            "roleId": "<% role.id %>",
                            "roleName": "<% role.roleName %>",
                            "view": "<% queryParams.view ?? '' %>"
                          }
                        }
                      }
                    },
                    {
                      "type": "column",
                      "id": "colOrgApp",
                      "columnId": "colOrgApp",
                      "label": "Organization / Application",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "id": "colOrgAppText",
                        "enabled": false,
                        "value": "<% role.shellOrgCode ?? role.application ?? '' %>"
                      }
                    },
                    {
                      "type": "column",
                      "id": "colRoleName",
                      "columnId": "colRoleName",
                      "label": "Role Name",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.roleName ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colWdRoleName",
                      "columnId": "colWdRoleName",
                      "label": "Workday Assignable Role",
                      "cellTemplate": {
                        "type": "text",
                        "id": "colWdRoleNameText",
                        "enabled": false,
                        "value": "<% role.workdayRoleId ?? '' %>"
                      }
                    },
                    {
                      "type": "column",
                      "id": "colEnabledFor",
                      "columnId": "colEnabledFor",
                      "label": "Enabled For",
                      "cellTemplate": {
                        "type": "text",
                        "id": "colEnabledForText",
                        "enabled": false,
                        "value": "<% role.enabledForOrganizationTypes ?? 'Academic Unit - University of British Columbia' %>"
                      }
                    },
                    {
                      "type": "column",
                      "id": "colEffDate",
                      "columnId": "colEffDate",
                      "label": "Effective Date",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.effectiveDate ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colPositions",
                      "columnId": "colPositions",
                      "label": "Positions / Delegated Roles",
                      "cellTemplate": {
                        "type": "text",
                        "id": "colPositionsText",
                        "enabled": false,
                        "value": "<% role.positionNames ?? role.positions ?? '' %>"
                      }
                    },
                    {
                      "type": "column",
                      "id": "colRequestedBy",
                      "columnId": "colRequestedBy",
                      "label": "Requested By",
                      "cellTemplate": {
                        "type": "text",
                        "id": "colRequestedByText",
                        "enabled": false,
                        "value": "<% !empty(role.requestedBy) ? (role.requestedBy.descriptor ?? '') : '' %>"
                      }
                    },
                    {
                      "type": "column",
                      "id": "colRequestedDate",
                      "columnId": "colRequestedDate",
                      "label": "Requested Date",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.requestedDate ?? '' %>",
                        "enabled": false
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "confirmSection",
          "children": [
            {
              "type": "richText",
              "id": "confirmDelete",
              "enabled": false,
              "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Select a request from the grid above, tick the confirmation, then click <b>OK</b> to withdraw it.</span>"
            },
            {
              "type": "fieldSet",
              "id": "confirmDeleteSection",
              "visible": "<% !empty(queryParams.roleId) %>",
              "children": [
                {
                  "type": "text",
                  "id": "selectedRoleDisplay",
                  "label": "Request to Withdraw",
                  "enabled": false,
                  "value": "<% queryParams.roleName ?? '' %>"
                },
                {
                  "type": "richText",
                  "id": "deleteWarning",
                  "enabled": false,
                  "value": "<span style=\"color:#dc2626;font-size:12px;font-weight:700\">⚠ </span><span style=\"color:#991b1b;font-size:12px\"><b>Note:</b> The ISC review is cancelled and can't be restarted; submit a new request if you still need the role. A role already created in Workday must be removed there separately.</span>"
                },
                {
                  "type": "checkBox",
                  "id": "confirmDeleteCheckBox",
                  "label": "I confirm I want to withdraw this request.",
                  "required": true,
                  "visible": "<% !empty(queryParams.roleId) %>",
                  "helpText": "You must confirm before the withdrawal can be submitted."
                }
              ],
              "title": "Confirm Withdrawal"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "cancelOverride": {
      "taskId": "home"
    }
  },
  "onSubmit": "<%\n  let valid = true;\n  if (empty(queryParams.roleId)) {\n    valid = false;\n  } else if (size((list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]) ?? []).filter(r => { r.id == (queryParams.roleId ?? '') && r.status == 'Pending ISC Review' && !empty(r.requestedBy) && r.requestedBy.id == (selectedWorker.id ?? '') })) == 0) {\n    confirmDeleteCheckBox.setError('This request is not one of your pending requests, so it can\\'t be withdrawn here.');\n    valid = false;\n  } else if (confirmDeleteCheckBox.value != true) {\n    confirmDeleteCheckBox.setError('Tick the box to confirm the withdrawal.');\n    valid = false;\n  }\n  valid;\n%>"
}
