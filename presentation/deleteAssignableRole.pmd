{
  "id": "deleteAssignableRole",
  "include": [
    "comsValidations.script"
  ],
  "securityDomains": [
    "ManageCOMSAssignableRoles"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso"
    },
    {
      "name": "comsAssignableRoles",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAssignableRoles",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true"
    },
    {
      "name": "positions",
      "baseUrlType": "workday-staffing-v6",
      "url": "jobs",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true"
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "deleteRole",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "<% '/comsAssignableRoles/' + queryParams.roleId %>",
        "httpMethod": "DELETE",
        "authType": "sso",
        "exclude": "<% empty(queryParams.roleId) %>",
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ]
      },
      {
        "name": "postAuditLog",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "/comsAuditLogs",
        "httpMethod": "POST",
        "authType": "sso",
        "values": [
          {
            "outboundPath": "timestamp",
            "value": "<% date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\") %>"
          },
          {
            "outboundPath": "objectType",
            "value": "COMSAssignableRole"
          },
          {
            "outboundPath": "action",
            "value": "DELETE"
          },
          {
            "outboundPath": "worker",
            "value": "<% selectedWorker.id %>"
          },
          {
            "outboundPath": "application",
            "value": ""
          },
          {
            "outboundPath": "coReferenceId",
            "value": "<% queryParams.roleId ?? '' %>"
          },
          {
            "outboundPath": "coName",
            "value": "<% selectedRoleDisplay.value ?? '' %>"
          },
          {
            "outboundPath": "details",
            "value": "<% 'Assignable role deleted: ' + (selectedRoleDisplay.value ?? '') + ' (id: ' + (queryParams.roleId ?? '') + ')' %>"
          },
          {
            "outboundPath": "triggeredBy",
            "value": "<% selectedWorker.descriptor %>"
          }
        ],
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ],
        "exclude": "<% empty(queryParams.roleId) %>"
      }
    ],
    "responseErrorDetail": {
      "errorSummary": "<% error %>",
      "errors": "<% empty errors ? [] : errors.map(err => { err.error }) %>"
    }
  },
  "presentation": {
    "pageType": "edit",
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ECO-COMS: Delete Assignable Role Request"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "deleteForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← My Role Requests",
              "taskReference": {
                "taskId": "assignableRoleManagerView"
              },
              "action": "LINK",
              "suppressDiscardDialog": true,
              "visible": "<% empty(queryParams.view) || queryParams.view == 'assignable' %>"
            },
            {
              "type": "button",
              "label": "← Admin Provisioning",
              "taskReference": {
                "taskId": "adminProvisioningView"
              },
              "action": "LINK",
              "suppressDiscardDialog": true,
              "visible": "<% queryParams.view == 'aaa' %>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "descSection",
          "children": [
            {
              "type": "richText",
              "id": "pageDesc",
              "enabled": false,
              "value": "<span style=\"color:#374151;font-size:13px\">Select a Pending ISC Review role request to delete. Only roles with status Pending ISC Review can be deleted. This action cannot be undone.</span>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "gridSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "pendingRolesFieldSet",
              "title": "Pending Assignable Role Requests",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "grid",
                  "gridType": "LIST",
                  "multiViewStylingEnabled": true,
                  "id": "pendingRolesGrid",
                  "defaultSortColumnId": "colRequestedDate",
                  "defaultSortOrder": "DESCENDING",
                  "label": "Pending Assignable Role Requests",
                  "rows": "<% comsAssignableRoles.data.filter(r => { r.status == 'Pending ISC Review' && (empty(queryParams.view) || (queryParams.view == 'aaa' ? r.roleName.startsWith('Organizations and Roles Assignment Administrator') : !r.roleName.startsWith('Organizations and Roles Assignment Administrator'))) }) %>",
                  "rowVariableName": "role",
                  "enabled": false,
                  "columns": [
                    {
                      "type": "column",
                      "id": "colSelect",
                      "columnId": "colSelect",
                      "label": "Delete",
                      "cellTemplate": {
                        "type": "button",
                        "action": "AUXILIARY",
                        "label": "Select",
                        "taskReference": {
                          "taskId": "deleteAssignableRole",
                          "parameterBindings": {
                            "roleId": "<% role.id %>",
                            "roleName": "<% role.roleName %>",
                            "view": "<% queryParams.view ?? '' %>"
                          }
                        }
                      }
                    },
                    {
                      "type": "column",
                      "id": "colOrgApp",
                      "columnId": "colOrgApp",
                      "label": "Organization / Application",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "instanceList",
                        "view": true,
                        "relatedTask": true,
                        "instanceList": [
                          {
                            "descriptor": "<% role.shellOrgCode ?? role.application ?? '' %>",
                            "wid": "<% role.shellOrgWid ?? '' %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "id": "colRoleName",
                      "columnId": "colRoleName",
                      "label": "Role Name",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.roleName ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colWdRoleName",
                      "columnId": "colWdRoleName",
                      "label": "Workday Assignable Role",
                      "cellTemplate": {
                        "type": "instanceList",
                        "view": true,
                        "relatedTask": true,
                        "instanceList": [
                          {
                            "descriptor": "<% role.workdayRoleId ?? '' %>",
                            "wid": "<% role.workdayAssignableRole ?? '' %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "id": "colEnabledFor",
                      "columnId": "colEnabledFor",
                      "label": "Enabled For",
                      "cellTemplate": {
                        "type": "instanceList",
                        "view": true,
                        "relatedTask": true,
                        "instanceList": [
                          {
                            "descriptor": "<% role.enabledForOrganizationTypes ?? 'Academic Unit - University of British Columbia' %>",
                            "wid": "<% role.enabledForWid ?? '' %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "id": "colEffDate",
                      "columnId": "colEffDate",
                      "label": "Effective Date",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.effectiveDate ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colPositions",
                      "columnId": "colPositions",
                      "label": "Positions / Delegated Roles",
                      "cellTemplate": {
                        "type": "instanceList",
                        "id": "colPositionsList",
                        "view": true,
                        "relatedTask": true,
                        "enabled": false,
                        "values": "<% empty(role.positions) ? [] : positions.data.filter(p => { role.positions.contains(p.id) }) %>",
                        "widKey": "id"
                      }
                    },
                    {
                      "type": "column",
                      "id": "colRequestedBy",
                      "columnId": "colRequestedBy",
                      "label": "Requested By",
                      "cellTemplate": {
                        "type": "instanceList",
                        "view": true,
                        "relatedTask": true,
                        "instanceList": [
                          {
                            "descriptor": "<% role.requestedBy.descriptor ?? '' %>",
                            "wid": "<% role.requestedBy.id ?? '' %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "id": "colRequestedDate",
                      "columnId": "colRequestedDate",
                      "label": "Requested Date",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.requestedDate ?? '' %>",
                        "enabled": false
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "confirmSection",
          "children": [
            {
              "type": "richText",
              "id": "confirmDelete",
              "enabled": false,
              "value": "<span style=\"color:#0055B7;font-size:11px;font-weight:700\">ℹ </span><span style=\"color:#374151;font-size:11px\">Select a role from the grid above, then click <b>OK</b> to permanently delete the request.</span>"
            },
            {
              "type": "fieldSet",
              "id": "confirmDeleteSection",
              "visible": "<% !empty(queryParams.roleId) %>",
              "children": [
                {
                  "type": "text",
                  "id": "selectedRoleDisplay",
                  "label": "Role to Delete",
                  "enabled": false,
                  "value": "<% queryParams.roleName ?? '' %>"
                },
                {
                  "type": "richText",
                  "id": "deleteWarning",
                  "enabled": false,
                  "value": "<span style=\"color:#dc2626;font-size:11px;font-weight:700\">⚠ </span><span style=\"color:#991b1b;font-size:11px\"><b>Warning:</b> This action permanently deletes the selected role request and cannot be undone. Click OK to confirm.</span>"
                }
              ],
              "title": "Confirm Delete",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "fixed",
                "labelPosition": "side_align_left"
              }
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "standardEditButtonsHidden": true
  },
  "onSubmit": "<%\n  let valid = true;\n  if (empty(queryParams.roleId)) {\n    valid = false;\n  }\n  valid;\n%>",
  "onSuccess": {
    "taskReference": {
      "taskId": "deleteAssignableRole"
    }
  }
}