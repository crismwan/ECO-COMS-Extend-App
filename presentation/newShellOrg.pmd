{
  "id": "newShellOrg",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "include": [
    "comsValidations.script"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications?limit=100",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "existingOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "customOrganizations"
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "launchAddShellOrg",
      "baseUrlType": "orchestration",
      "authType": "sso",
      "deferred": "true",
      "url": "<% '/AddShellOrg/launch?comsAppId=' + ac + '&orgType=' + ot + '&orgSubtype=' + st + '&organizationName=' + on + '&organizationCode=' + oc + '&workerId=' + wid + '&effectiveDate=' + ed + '&changedBy=' + cb + '&timestamp=' + ts + '&changedByWid=' + cbw %>"
    },
    {
      "name": "verifyShellOrg",
      "baseUrlType": "workday-wql",
      "url": "<% 'data?limit=' + lim + '&query=SELECT%20workdayID%2C%20code%20FROM%20topLevelOrganizations%20WHERE%20code%20contains%20%27X%3A%27' %>",
      "authType": "sso",
      "deferred": "true"
    }
  ],
  "onSubmit": "<%\n  effectiveDate.clearError();\n  orgSubtypeDropdown.clearError();\n  organizationCode.clearError();\n  selectedApplicationId.clearError();\n  let valid = true;\n  let meta = ((!empty(orgSubtypeDropdown.value)) ? (orgSubtypeDropdown.selectedEntries[0].id == 'X:META') : false);\n  let ac = ((!empty(selectedApplicationId.value)) ? (selectedApplicationId.selectedEntries[0].descriptor ?? '') : '');\n  let oc = (organizationCode.value ?? '').trim();\n  if (empty(orgSubtypeDropdown.value)) {\n    orgSubtypeDropdown.setError('Pick the organization subtype: X:META or X:SHELL.');\n    valid = false;\n  }\n  if (ac == '' && !meta) {\n    selectedApplicationId.setError('Please select an application. Only X:META can be added without one (a new application).');\n    valid = false;\n  }\n  if (oc == '') {\n    organizationCode.setError('Organization Code is required.');\n    valid = false;\n  } else {\n    let codeErr = (ac == '' && meta) ? (!oc.startsWith('X:') ? 'A new application\\'s code starts with X:, e.g. X:NEWAPP.' : (oc.substring(2) == '' || oc.substring(2).contains(':') ? 'Use X: plus one part, e.g. X:NEWAPP.' : (oc.contains(' ') ? 'The code can\\'t contain spaces.' : (oc.upperCase() != oc ? 'Use upper case, e.g. X:NEWAPP.' : '')))) : '';\n    let orgName = ac != '' ? (ac + ':' + oc) : oc;\n    let dupes = (existingOrgs.data ?? []).filter(o => { o.code == orgName });\n    if (codeErr != '') {\n      organizationCode.setError(codeErr);\n      valid = false;\n    } else if (dupes.size() > 0) {\n      let dupeName = (!empty(dupes[0].organizationByName)) ? (dupes[0].organizationByName.descriptor ?? orgName) : orgName;\n      organizationCode.setError('An organization with this code already exists: ' + dupeName);\n      valid = false;\n    }\n  }\n  if (empty(effectiveDate.value)) {\n    effectiveDate.setError('Effective Date is required.');\n    valid = false;\n  } else {\n    if (!comsValidations.isWeekday(effectiveDate.value)) {\n      effectiveDate.setError(comsValidations.errorWeekday());\n      valid = false;\n    } else if (!comsValidations.isCurrentOrFutureYear(effectiveDate.value)) {\n      effectiveDate.setError(comsValidations.errorYear());\n      valid = false;\n    }\n  }\n  if (valid) {\n    let lname = ac != '' ? (ac + ':' + oc) : oc;\n    let lot = ac != '' ? ac : oc;\n    launchAddShellOrg.invoke({'cbw': selectedWorker.id ?? '', 'cb': (selectedWorker.descriptor ?? '').urlEncode(), 'ts': date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\").urlEncode(), 'ac': lot.urlEncode(), 'ot': lot.urlEncode(), 'st': orgSubtypeDropdown.selectedEntries[0].id, 'on': lname.urlEncode(), 'oc': oc.urlEncode(), 'wid': selectedWorker.id ?? '', 'ed': effectiveDate.value.format('yyyy-MM-dd')});\n    let created = (verifyShellOrg.invoke({'lim': '10000'}).data ?? []).filter(o => { o.code == lname }).size() > 0;\n    if (!created) {\n      organizationCode.setError((ac == '' && meta) ? ('Workday rejected this request, so nothing was created. For a new application, check that the organization type ' + oc + ' exists in Workday.') : 'Workday rejected this request, so nothing was created. Check the values and try again.');\n      valid = false;\n    }\n  }\n  valid;\n%>",
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ECO-COMS: Add New Shell Organization",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "newShellOrgForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "button",
              "label": "← Shell Org Manager",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "LINK",
              "suppressDiscardDialog": true
            },
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "children": [
                {
                  "type": "richText",
                  "id": "pageDescription",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Add a new organization to Workday. Pick the subtype, the application and the Organization Code: the name is <b>ApplicationCode:OrganizationCode</b> (e.g. X:CLW:ORG:ANY). For a <b>new application</b>, pick X:META, leave Application blank and enter its code starting with <b>X:</b> (e.g. X:NEWAPP). Its organization type of the same name must already exist in Workday.</span>"
                }
              ],
              "title": "About This Page"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "liveOrgNoticeSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "liveOrgNoticeFieldSet",
              "title": "Before You Submit",
              "children": [
                {
                  "type": "richText",
                  "id": "liveOrgNoticeRichText",
                  "enabled": false,
                  "value": "<span style=\"color:#B45309;font-size:12px;font-weight:700\">⚠ </span><span style=\"color:#374151;font-size:12px\">Submitting creates a live Custom Organization in Workday straight away. It can't be deleted afterwards, only inactivated from Shell Org Manager. Every create is recorded in the Audit Log.</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "formSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "orgFields",
              "children": [
                {
                  "type": "dropdown",
                  "id": "orgSubtypeDropdown",
                  "label": "Organization Subtype",
                  "required": true,
                  "instanceList": [
                    {
                      "id": "X:META",
                      "descriptor": "X:META"
                    },
                    {
                      "id": "X:SHELL",
                      "descriptor": "X:SHELL"
                    }
                  ],
                  "helpText": "X:META for an application's meta organization (e.g. X:CLW), including a new application's. X:SHELL for a shell organization roles are assigned on.",
                  "onChange": "<%\n  self.clearError();\n  organizationCode.clearError();\n  selectedApplicationId.setRequired(!((!empty(orgSubtypeDropdown.value)) ? (orgSubtypeDropdown.selectedEntries[0].id == 'X:META') : false));\n  if (((!empty(orgSubtypeDropdown.value)) ? (orgSubtypeDropdown.selectedEntries[0].id == 'X:META') : false)) { selectedApplicationId.clearError(); }\n  orgNamePreview.setValue(((!empty(selectedApplicationId.value)) ? (selectedApplicationId.selectedEntries[0].descriptor ?? '') : '') != '' ? (((!empty(selectedApplicationId.value)) ? (selectedApplicationId.selectedEntries[0].descriptor ?? '') : '') + ':' + (organizationCode.value ?? '')) : (((!empty(orgSubtypeDropdown.value)) ? (orgSubtypeDropdown.selectedEntries[0].id == 'X:META') : false) ? ((organizationCode.value ?? '') != '' ? (organizationCode.value ?? '') : 'Enter the new application code, e.g. X:NEWAPP') : 'Select an application above'));\n%>"
                },
                {
                  "type": "dropdown",
                  "id": "selectedApplicationId",
                  "label": "Application",
                  "required": "<% !((!empty(orgSubtypeDropdown.value)) ? (orgSubtypeDropdown.selectedEntries[0].id == 'X:META') : false) %>",
                  "values": "<%\n  let appCodes = [];\n  let result = [];\n  for (var org : (existingOrgs.data ?? [])) {\n    let code = org.code;\n    let appCode = code.substringAfter(':').contains(':') ?\n      code.substringBefore(':') + ':' + code.substringAfter(':').substringBefore(':') :\n      code;\n    if (!empty(appCode) && !appCodes.contains(appCode)) {\n      appCodes.add(appCode);\n      result.add({'id': appCode, 'descriptor': appCode});\n    }\n  }\n  result;\n%>",
                  "helpText": "Select the application this organization belongs to. For X:META, leave it blank to add a new application's organization.",
                  "onChange": "<%\n  selectedApplicationId.clearError();\n  organizationCode.clearError();\n  orgNamePreview.setValue(((!empty(selectedApplicationId.value)) ? (selectedApplicationId.selectedEntries[0].descriptor ?? '') : '') != '' ? (((!empty(selectedApplicationId.value)) ? (selectedApplicationId.selectedEntries[0].descriptor ?? '') : '') + ':' + (organizationCode.value ?? '')) : (((!empty(orgSubtypeDropdown.value)) ? (orgSubtypeDropdown.selectedEntries[0].id == 'X:META') : false) ? ((organizationCode.value ?? '') != '' ? (organizationCode.value ?? '') : 'Enter the new application code, e.g. X:NEWAPP') : 'Select an application above'));\n%>"
                },
                {
                  "type": "text",
                  "id": "organizationCode",
                  "label": "Organization Code",
                  "required": true,
                  "helpText": "With an application: the part after it (name = Application:Code). X:META without an application: the new application's code, starting with X: (e.g. X:NEWAPP).",
                  "guide": {
                    "type": "guide",
                    "id": "guideOrgCode",
                    "title": "Organization Code Format",
                    "text": "With an application, enter the part after it: the full name is ApplicationCode:OrganizationCode (e.g. X:CLW:ORG:ANY). For a new application (subtype X:META, no application), enter its code starting with X: (e.g. X:NEWAPP); its organization type of the same name must already exist in Workday. No spaces. Must be unique."
                  },
                  "onChange": "<%\n  self.clearError();\n  orgNamePreview.setValue(((!empty(selectedApplicationId.value)) ? (selectedApplicationId.selectedEntries[0].descriptor ?? '') : '') != '' ? (((!empty(selectedApplicationId.value)) ? (selectedApplicationId.selectedEntries[0].descriptor ?? '') : '') + ':' + (organizationCode.value ?? '')) : (((!empty(orgSubtypeDropdown.value)) ? (orgSubtypeDropdown.selectedEntries[0].id == 'X:META') : false) ? ((organizationCode.value ?? '') != '' ? (organizationCode.value ?? '') : 'Enter the new application code, e.g. X:NEWAPP') : 'Select an application above'));\n%>",
                  "placeholder": "e.g. ORG:ANY, or X:NEWAPP for a new application"
                },
                {
                  "type": "readOnlyText",
                  "id": "orgNamePreview",
                  "label": "Generated Organization Name",
                  "value": "<% ((!empty(selectedApplicationId.value)) ? (selectedApplicationId.selectedEntries[0].descriptor ?? '') : '') != '' ? (((!empty(selectedApplicationId.value)) ? (selectedApplicationId.selectedEntries[0].descriptor ?? '') : '') + ':' + (organizationCode.value ?? '')) : (((!empty(orgSubtypeDropdown.value)) ? (orgSubtypeDropdown.selectedEntries[0].id == 'X:META') : false) ? 'Enter the new application code, e.g. X:NEWAPP' : 'Select an application above') %>"
                },
                {
                  "type": "date",
                  "id": "effectiveDate",
                  "label": "Effective Date",
                  "required": true,
                  "guide": {
                    "type": "guide",
                    "id": "guideEffectiveDate",
                    "title": "Effective Date Rules",
                    "text": "Must be a weekday (Monday to Friday) in this year or next year. Weekends and other years are rejected when you click Next. The organization is available in Workday from this date."
                  },
                  "onChange": "<%\n            if (empty(self.value)) {\n              self.clearError();\n            } else if (!comsValidations.isWeekday(self.value)) {\n              self.setError(comsValidations.errorWeekday());\n            } else if (!comsValidations.isCurrentOrFutureYear(self.value)) {\n              self.setError(comsValidations.errorYear());\n            } else {\n              self.clearError();\n            }\n          %>",
                  "helpText": "A weekday (Monday to Friday) this year or next."
                }
              ],
              "title": "Organization Details"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "EDIT",
    "cancelOverride": {
      "taskId": "shellOrgManager"
    }
  }
}
