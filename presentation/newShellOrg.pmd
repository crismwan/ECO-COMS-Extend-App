{
  "id": "newShellOrg",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso"
    },
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications?active=true",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true"
    },
    {
      "name": "existingOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "customOrganizations"
      }
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "newShellOrgVars",
        "type": "outboundVariable",
        "variableScope": "flow",
        "values": [
          {
            "outboundPath": "comsAppId",
            "value": "<% (!empty(selectedApplicationId.value)) ? (selectedApplicationId.value.id ?? '') : '' %>"
          },
          {
            "outboundPath": "applicationCode",
            "value": "<% (!empty(selectedApplicationId.value)) ? (selectedApplicationId.value.id ?? '') : '' %>"
          },
          {
            "outboundPath": "organizationCode",
            "value": "<% organizationCode.value ?? '' %>"
          },
          {
            "outboundPath": "organizationName",
            "value": "<% (!empty(selectedApplicationId.value)) ? ((selectedApplicationId.value.id ?? '') + ':' + (organizationCode.value ?? '')) : ('' + ':' + (organizationCode.value ?? '')) %>"
          },
          {
            "outboundPath": "workerId",
            "value": "<% selectedWorker.id %>"
          },
          {
            "outboundPath": "effectiveDate",
            "value": "<% effectiveDate.value != null ? effectiveDate.value.format('yyyy-MM-dd') : '' %>"
          }
        ]
      }
    ]
  },
  "onSubmit": "<%\n  let valid = true;\n  if (empty(selectedApplicationId.value)) {\n    selectedApplicationId.setError('Please select an application.');\n    valid = false;\n  }\n  if (empty(effectiveDate.value)) {\n    effectiveDate.setError('Effective Date is required.');\n    valid = false;\n  } else {\n    let d = effectiveDate.value;\n    let y = d.year();\n    if (y < 2026 || y > 2027) {\n      effectiveDate.setError('Effective Date year must be 2026 or 2027.');\n      valid = false;\n    }\n  }\n  valid;\n%>",
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ECO-COMS: Add New Shell Organization",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "newShellOrgForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Shell Org Manager",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "LINK",
              "suppressDiscardDialog": true
            },
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK",
              "suppressDiscardDialog": true
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "children": [
                {
                  "type": "richText",
                  "id": "pageDescription",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:11px;font-weight:700\">ℹ </span><span style=\"color:#374151;font-size:11px\">Add a new Shell Organization to Workday. Select the application and enter the Organization Code. The Organization Name will be auto-generated as <b>ApplicationCode:OrganizationCode</b> (e.g. X:CLW:ORG:ANY).</span>"
                }
              ],
              "title": "About this page"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "warningSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "wizardWarningFieldSet",
              "children": [
                {
                  "type": "richText",
                  "id": "wizardCloseWarning",
                  "enabled": false,
                  "value": "<span style=\"color:#B45309;font-size:11px;font-weight:700\">⚠ Important: </span><span style=\"color:#374151;font-size:11px\">Clicking the wizard’s <b>X (close)</b> button will navigate you to the last page you visited — which may be the Workday home page, taking you out of this app. To safely exit and return to Shell Org Manager, use the <b>← Shell Org Manager</b> button above.</span>"
                }
              ],
              "title": "Navigation Guide"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "formSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "orgFields",
              "children": [
                {
                  "type": "dropdown",
                  "id": "selectedApplicationId",
                  "label": "Application",
                  "required": true,
                  "values": "<% (existingOrgs.data ?? []).filter(org => { !empty(org.code) }).map(org => { { 'appCode': org.code.substringAfter(':').contains(':') ? org.code.substringBefore(':') + ':' + org.code.substringAfter(':').substringBefore(':') : org.code.substringBefore(':') } }).filter(item => { !empty(item.appCode) }).map(item => { item.appCode }).distinct().map(appCode => { { 'id': appCode, 'descriptor': appCode } }) %>",
                  "helpText": "Select the application this shell organization belongs to.",
                  "onChange": "<%\n    let ac = (!empty(self.value)) ? (self.value.id ?? '') : '';\n    let oc = organizationCode.value ?? '';\n    if (!empty(ac) && !empty(oc)) {\n      orgNamePreview.setValue(ac + ':' + oc);\n    } else {\n      orgNamePreview.setValue('Select application and enter code above');\n    }\n  %>"
                },
                {
                  "type": "text",
                  "id": "organizationCode",
                  "label": "Organization Code",
                  "helpText": "The full org name will be ApplicationCode:OrganizationCode.",
                  "guide": {
                    "type": "guide",
                    "id": "guideOrgCode",
                    "title": "Organization Code Format",
                    "text": "Enter the unique suffix for this organization. The system will auto-generate the full name as ApplicationCode:OrganizationCode (e.g. X:CLW:ORG:ANY). Avoid spaces and special characters. Must be unique within the application."
                  },
                  "onChange": "<%\n    let ac = (!empty(selectedApplicationId.value)) ? (selectedApplicationId.value.id ?? '') : '';\n    let oc = self.value ?? '';\n    if (!empty(ac) && !empty(oc)) {\n      orgNamePreview.setValue(ac + ':' + oc);\n      let orgName = ac + ':' + oc;\n      let dupes = (existingOrgs.data ?? []).filter(o => { o.code == orgName });\n      if (dupes.size() > 0) {\n        let dupeName = (!empty(dupes[0].organizationByName)) ? (dupes[0].organizationByName.descriptor ?? orgName) : orgName;\n        self.setError('An organization with this code already exists: ' + dupeName);\n      } else {\n        self.clearError();\n      }\n    } else {\n      orgNamePreview.setValue('Select application and enter code above');\n      self.clearError();\n    }\n  %>"
                },
                {
                  "type": "text",
                  "id": "orgNamePreview",
                  "label": "Generated Organization Name",
                  "value": "Select application and enter code above",
                  "enabled": true
                },
                {
                  "type": "date",
                  "id": "effectiveDate",
                  "label": "Effective Date",
                  "required": true,
                  "guide": {
                    "type": "guide",
                    "id": "guideEffectiveDate",
                    "title": "Effective Date Rules",
                    "text": "Must be a weekday (Monday–Friday) in 2026 or 2027. Weekends and dates outside this range will be rejected. The organization will be available in Workday starting on this date."
                  },
                  "onChange": "<%\n    if (empty(self.value)) {\n      self.clearError();\n    } else {\n      let d = self.value;\n      let y = d.year();\n      if (y < 2026 || y > 2027) {\n        self.setError('Effective Date year must be 2026 or 2027.');\n      } else {\n        self.clearError();\n      }\n    }\n  %>"
                }
              ],
              "title": "Organization Details"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "EDIT",
    "standardEditButtonsHidden": true,
    "cancelOverride": {
      "taskId": "shellOrgManager"
    }
  }
}
