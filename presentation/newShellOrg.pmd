{
  "id": "newShellOrg",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "include": [
    "comsValidations.script"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications?limit=100",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "existingOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "customOrganizations"
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "launchAddShellOrg",
      "baseUrlType": "orchestration",
      "authType": "sso",
      "deferred": "true",
      "url": "<% '/AddShellOrg/launch?comsAppId=' + ac + '&orgType=' + ot + '&organizationName=' + on + '&organizationCode=' + oc + '&workerId=' + wid + '&effectiveDate=' + ed + '&changedBy=' + cb + '&timestamp=' + ts + '&changedByWid=' + cbw %>"
    },
    {
      "name": "verifyShellOrg",
      "baseUrlType": "workday-wql",
      "url": "<% 'data?limit=' + lim + '&query=SELECT%20workdayID%2C%20code%20FROM%20topLevelOrganizations%20WHERE%20code%20contains%20%27X%3A%27' %>",
      "authType": "sso",
      "deferred": "true"
    }
  ],
  "onSubmit": "<%\n  let valid = true;\n  if (empty(selectedApplicationId.value)) {\n    selectedApplicationId.setError('Please select an application.');\n    valid = false;\n  }\n  if (empty(organizationCode.value)) {\n    organizationCode.setError('Organization Code is required.');\n    valid = false;\n  } else if (!empty(selectedApplicationId.value)) {\n    let ac = (!empty(selectedApplicationId.value)) ? (selectedApplicationId.selectedEntries[0].descriptor ?? '') : '';\n    let oc = organizationCode.value ?? '';\n    let orgName = ac + ':' + oc;\n    let dupes = (existingOrgs.data ?? []).filter(o => { o.code == orgName });\n    if (dupes.size() > 0) {\n      let dupeName = (!empty(dupes[0].organizationByName)) ? (dupes[0].organizationByName.descriptor ?? orgName) : orgName;\n      organizationCode.setError('An organization with this code already exists: ' + dupeName);\n      valid = false;\n    }\n  }\n  if (empty(effectiveDate.value)) {\n    effectiveDate.setError('Effective Date is required.');\n    valid = false;\n  } else {\n    if (!comsValidations.isWeekday(effectiveDate.value)) {\n      effectiveDate.setError(comsValidations.errorWeekday());\n      valid = false;\n    } else if (!comsValidations.isCurrentOrFutureYear(effectiveDate.value)) {\n      effectiveDate.setError(comsValidations.errorYear());\n      valid = false;\n    }\n  }\n  if (valid) {\n    let lac = selectedApplicationId.selectedEntries[0].descriptor ?? '';\n    let loc = organizationCode.value ?? '';\n    let lname = lac + ':' + loc;\n    let lot = lac;\n    launchAddShellOrg.invoke({'cbw': selectedWorker.id ?? '', 'cb': (selectedWorker.descriptor ?? '').urlEncode(), 'ts': date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\").urlEncode(), 'ac': lac, 'ot': lot, 'on': lname.urlEncode(), 'oc': loc.urlEncode(), 'wid': selectedWorker.id ?? '', 'ed': effectiveDate.value.format('yyyy-MM-dd')});\n    let created = (verifyShellOrg.invoke({'lim': '10000'}).data ?? []).filter(o => { o.code == lname }).size() > 0;\n    if (!created) {\n      organizationCode.setError('Workday rejected this request, so nothing was created. Check the values and try again.');\n      valid = false;\n    }\n  }\n  valid;\n%>",
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ECO-COMS: Add New Shell Organization",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "newShellOrgForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Shell Org Manager",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "LINK",
              "suppressDiscardDialog": true
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "children": [
                {
                  "type": "richText",
                  "id": "pageDescription",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Add a new Shell Organization to Workday. Select the application and enter the Organization Code. The Organization Name will be auto-generated as <b>ApplicationCode:OrganizationCode</b> (e.g. X:CLW:ORG:ANY).</span>"
                }
              ],
              "title": "About This Page"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "liveOrgNoticeSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "liveOrgNoticeFieldSet",
              "title": "Before You Submit",
              "children": [
                {
                  "type": "richText",
                  "id": "liveOrgNoticeRichText",
                  "enabled": false,
                  "value": "<span style=\"color:#B45309;font-size:12px;font-weight:700\">⚠ </span><span style=\"color:#374151;font-size:12px\">Submitting creates a live Custom Organization in Workday straight away. It can't be deleted afterwards, only inactivated from Shell Org Manager. Every create is recorded in the Audit Log.</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "formSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "orgFields",
              "children": [
                {
                  "type": "dropdown",
                  "id": "selectedApplicationId",
                  "label": "Application",
                  "required": true,
                  "values": "<%\n  let appCodes = [];\n  let result = [];\n  for (var org : (existingOrgs.data ?? [])) {\n    let code = org.code;\n    let appCode = code.substringAfter(':').contains(':') ?\n      code.substringBefore(':') + ':' + code.substringAfter(':').substringBefore(':') :\n      code;\n    if (!empty(appCode) && !appCodes.contains(appCode)) {\n      appCodes.add(appCode);\n      result.add({'id': appCode, 'descriptor': appCode});\n    }\n  }\n  result;\n%>",
                  "helpText": "Select the application this shell organization belongs to.",
                  "onChange": "<%\n  selectedApplicationId.clearError();\n  if (!empty(self.value)) {\n    orgNamePreview.setValue(self.selectedEntries[0].descriptor + ':' + (organizationCode.value ?? ''));\n  } else {\n    orgNamePreview.setValue('Select an application above');\n  }\n%>"
                },
                {
                  "type": "text",
                  "id": "organizationCode",
                  "label": "Organization Code",
                  "required": true,
                  "helpText": "The full org name will be ApplicationCode:OrganizationCode.",
                  "guide": {
                    "type": "guide",
                    "id": "guideOrgCode",
                    "title": "Organization Code Format",
                    "text": "Enter the unique suffix for this organization. The system will auto-generate the full name as ApplicationCode:OrganizationCode (e.g. X:CLW:ORG:ANY). Avoid spaces and special characters. Must be unique within the application."
                  },
                  "onChange": "<%\n  self.clearError();\n  if (!empty(selectedApplicationId.value)) {\n    orgNamePreview.setValue(selectedApplicationId.selectedEntries[0].descriptor + ':' + (self.value ?? ''));\n  } else {\n    orgNamePreview.setValue('Select an application above');\n  }\n%>"
                },
                {
                  "type": "readOnlyText",
                  "id": "orgNamePreview",
                  "label": "Generated Organization Name",
                  "value": "<% !empty(selectedApplicationId.value) ? (selectedApplicationId.selectedEntries[0].descriptor + ':' + (organizationCode.value ?? '')) : 'Select an application above' %>"
                },
                {
                  "type": "date",
                  "id": "effectiveDate",
                  "label": "Effective Date",
                  "required": true,
                  "guide": {
                    "type": "guide",
                    "id": "guideEffectiveDate",
                    "title": "Effective Date Rules",
                    "text": "Must be a weekday (Monday to Friday) in this year or next year. Weekends and other years are rejected when you click Next. The organization is available in Workday from this date."
                  },
                  "onChange": "<%\n            if (empty(self.value)) {\n              self.clearError();\n            } else if (!comsValidations.isWeekday(self.value)) {\n              self.setError(comsValidations.errorWeekday());\n            } else if (!comsValidations.isCurrentOrFutureYear(self.value)) {\n              self.setError(comsValidations.errorYear());\n            } else {\n              self.clearError();\n            }\n          %>"
                }
              ],
              "title": "Organization Details"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "EDIT",
    "cancelOverride": {
      "taskId": "shellOrgManager"
    }
  }
}
