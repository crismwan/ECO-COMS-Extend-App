{
  "id": "newShellOrg",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso"
    },
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications?active=true",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true"
    },
    {
      "name": "existingOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "customOrganizations"
      }
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "newShellOrgVars",
        "type": "outboundVariable",
        "variableScope": "flow",
        "values": [
          {
            "outboundPath": "comsAppId",
            "value": "<% selectedApplicationId.value[0] %>"
          },
          {
            "outboundPath": "applicationCode",
            "value": "<% empty(selectedApplicationId.value) ? '' : (comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] }).size() > 0 ? comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] })[0].appId : '') %>"
          },
          {
            "outboundPath": "organizationCode",
            "value": "<% organizationCode.value ?? '' %>"
          },
          {
            "outboundPath": "organizationName",
            "value": "<% let ac = empty(selectedApplicationId.value) ? '' : (comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] }).size() > 0 ? comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] })[0].appId : ''); let oc = organizationCode.value ?? ''; ac + ':' + oc %>"
          },
          {
            "outboundPath": "workerId",
            "value": "<% selectedWorker.id %>"
          },
          {
            "outboundPath": "effectiveDate",
            "value": "<% effectiveDate.value != null ? effectiveDate.value.format('yyyy-MM-dd') : '' %>"
          }
        ]
      }
    ]
  },
  "onSubmit": "<%\n  let valid = true;\n  if (empty(selectedApplicationId.value)) {\n    selectedApplicationId.setError('Please select an application.');\n    valid = false;\n  }\n  if (empty(organizationCode.value)) {\n    organizationCode.setError('Organization Code is required.');\n    valid = false;\n  }\n  if (empty(effectiveDate.value)) {\n    effectiveDate.setError('Effective Date is required.');\n    valid = false;\n  } else {\n    let d = effectiveDate.value;\n    let dow = d.dayOfWeek();\n    if (dow == 6 || dow == 7) {\n      effectiveDate.setError('Effective Date must be a weekday. Saturdays and Sundays are not allowed.');\n      valid = false;\n    } else {\n      let y = d.year();\n      if (y < 2026 || y > 2027) {\n        effectiveDate.setError('Effective Date year must be 2026 or 2027.');\n        valid = false;\n      }\n    }\n  }\n  valid;\n%>",
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ECO-COMS: Add New Shell Organization",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "newShellOrgForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Shell Org Manager",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "LINK",
              "suppressDiscardDialog": true
            },
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK",
              "suppressDiscardDialog": true
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "children": [
                {
                  "type": "richText",
                  "id": "pageDescription",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:11px;font-weight:700\">ℹ </span><span style=\"color:#374151;font-size:11px\">Add a new Shell Organization to Workday. Select the application and enter the Organization Code. The Organization Name will be auto-generated as <b>ApplicationCode:OrganizationCode</b>.</span>"
                }
              ],
              "title": "About this page",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              }
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "formSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "orgFields",
              "children": [
                {
                  "type": "dropdown",
                  "id": "selectedApplicationId",
                  "label": "Application",
                  "required": true,
                  "instanceListLoopTag": {
                    "id": "selectedApplicationIdList",
                    "type": "instanceLoop",
                    "templateInstance": {
                      "id": "<% app.id %>",
                      "descriptor": "<% app.appId %>"
                    },
                    "on": "<% comsApplications.data %>",
                    "as": "app"
                  },
                  "helpText": "Select the application this shell organization belongs to."
                },
                {
                  "type": "text",
                  "id": "organizationCode",
                  "label": "Organization Code",
                  "required": true,
                  "helpText": "Enter the organization code (e.g. MATH300951). The full org name will be ApplicationCode:OrganizationCode.",
                  "placeholder": "e.g. MATH300951",
                  "onChange": "<%\n    if (!empty(self.value) && !empty(selectedApplicationId.value)) {\n      let ac = comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] }).size() > 0 ? comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] })[0].appId : '';\n      let orgName = ac + ':' + self.value;\n      let dupes = existingOrgs.data.filter(o => { o.code == orgName });\n      if (dupes.size() > 0) {\n        self.setError('An organization with this code already exists: ' + dupes[0].organizationByName.descriptor);\n      } else {\n        self.clearError();\n      }\n    } else {\n      self.clearError();\n    }\n  %>"
                },
                {
                  "type": "readOnlyText",
                  "id": "orgNamePreview",
                  "label": "Generated Organization Name",
                  "value": "<% if (empty(selectedApplicationId.value) || empty(organizationCode.value)) { 'Select application and enter code above' } else { let ac = comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] }).size() > 0 ? comsApplications.data.filter(a => { a.id == selectedApplicationId.value[0] })[0].appId : ''; ac + ':' + (organizationCode.value ?? '') } %>"
                },
                {
                  "type": "date",
                  "id": "effectiveDate",
                  "label": "Effective Date",
                  "required": true,
                  "onChange": "<%\n    if (empty(self.value)) {\n      self.clearError();\n    } else {\n      let d = self.value;\n      let dow = d.dayOfWeek();\n      if (dow == 6 || dow == 7) {\n        self.setError('Effective Date must be a weekday. Saturdays and Sundays are not allowed.');\n      } else {\n        let y = d.year();\n        if (y < 2026 || y > 2027) {\n          self.setError('Effective Date year must be 2026 or 2027.');\n        } else {\n          self.clearError();\n        }\n      }\n    }\n  %>"
                }
              ],
              "title": "Organization Details",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "fixed",
                "labelPosition": "side_align_left"
              }
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "edit",
    "standardEditButtonsHidden": true
  }
}
