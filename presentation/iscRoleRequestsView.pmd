{
  "id": "iscRoleRequestsView",
  "include": [
    "comsValidations.script"
  ],
  "securityDomains": [
    "MaintainCOMSAssignableRoles"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso"
    },
    {
      "name": "comsAssignableRoles",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAssignableRoles",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true"
    },
    {
      "name": "customOrganizations",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "customOrganizations"
      }
    },
    {
      "name": "positions",
      "baseUrlType": "workday-staffing-v6",
      "url": "jobs",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true"
    }
  ],
  "outboundData": {
    "outboundEndPoints": [],
    "responseErrorDetail": {
      "errorSummary": "<% error %>",
      "errors": "<% empty errors ? [] : errors.map(err => { err.error }) %>"
    }
  },
  "presentation": {
    "pageType": "VIEW",
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "<% queryParams.view == 'aaa' ? 'ECO-COMS: Pending AAA Provisioning Requests (ISC)' : queryParams.view == 'assignable' ? 'ECO-COMS: Pending Assignable Role Requests (ISC)' : 'ECO-COMS: All Pending Role Requests (ISC)' %>"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "iscRoleRequestsViewForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "\u2190 ISC Role Requests",
              "taskReference": {
                "taskId": "iscRoleRequestsHub"
              },
              "action": "LINK"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "descSection",
          "children": [
            {
              "type": "richText",
              "id": "pageDesc",
              "enabled": false,
              "value": "<% queryParams.view == 'aaa' ? '<span style=\"color:#374151;font-size:13px\">ISC Security: View pending AAA Provisioning role requests submitted via Admin Provisioning. Click Maintain to approve or deny a request.</span>' : queryParams.view == 'assignable' ? '<span style=\"color:#374151;font-size:13px\">ISC Security: View pending Assignable Role requests submitted via My Role Requests. Click Maintain to approve or deny a request.</span>' : '<span style=\"color:#374151;font-size:13px\">ISC Security: View all pending Assignable Role requests from both Assignable Role Manager and Admin Provisioning. Click Maintain to approve or deny a request.</span>' %>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "gridSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "pendingGridFieldSet",
              "title": "<% queryParams.view == 'aaa' ? 'Pending AAA Provisioning Requests' : queryParams.view == 'assignable' ? 'Pending Assignable Role Requests' : 'All Pending ISC Review Requests' %>",
              "children": [
                {
                  "type": "grid",
                  "gridType": "LIST",
                  "multiViewStylingEnabled": true,
                  "id": "allPendingGrid",
                  "autoPaging": true,
                  "rows": "<% comsAssignableRoles.data.filter(r => { r.status == 'Pending ISC Review' && (empty(queryParams.view) || (queryParams.view == 'aaa' ? r.roleName.startsWith('Organizations and Roles Assignment Administrator') : !r.roleName.startsWith('Organizations and Roles Assignment Administrator'))) }) %>",
                  "rowVariableName": "role",
                  "enabled": false,
                  "label": "<% queryParams.view == 'aaa' ? 'Pending AAA Provisioning Requests' : queryParams.view == 'assignable' ? 'Pending Assignable Role Requests' : 'All Pending ISC Review Requests' %>",
                  "columns": [
                    {
                      "type": "column",
                      "id": "colOrgApp",
                      "columnId": "colOrgApp",
                      "label": "Organization / Application",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "instanceList",
                        "view": false,
                        "instanceList": [
                          {
                            "descriptor": "<% role.shellOrgCode ?? role.application ?? '' %>",
                            "wid": "<% role.shellOrgWid ?? '' %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "id": "colRoleName",
                      "columnId": "colRoleName",
                      "label": "Role Name",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.roleName ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colWdRoleName",
                      "columnId": "colWdRoleName",
                      "label": "Workday Assignable Role",
                      "cellTemplate": {
                        "type": "instanceList",
                        "view": false,
                        "instanceList": [
                          {
                            "descriptor": "<% role.workdayRoleId ?? '' %>",
                            "wid": "<% role.workdayAssignableRole ?? '' %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "id": "colStatus",
                      "columnId": "colStatus",
                      "label": "Status",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "richText",
                        "value": "<% role.status == 'Pending ISC Review' ? '<span style=\"color:#92400e;font-weight:600;font-size:11px\">\u23f3 Pending ISC Review</span>' : role.status == 'Approved' ? '<span style=\"color:#065f46;font-weight:600;font-size:11px\">\u2713 Approved</span>' : role.status == 'Denied' ? '<span style=\"color:#991b1b;font-weight:600;font-size:11px\">\u2717 Denied</span>' : role.status == 'Inactive' ? '<span style=\"color:#6b7280;font-weight:600;font-size:11px\">\u25cb Inactive</span>' : role.status ?? '' %>"
                      }
                    },
                    {
                      "type": "column",
                      "id": "colEnabledFor",
                      "columnId": "colEnabledFor",
                      "label": "Enabled For",
                      "cellTemplate": {
                        "type": "instanceList",
                        "view": false,
                        "instanceList": [
                          {
                            "descriptor": "<% role.enabledForOrganizationTypes ?? 'Academic Unit - University of British Columbia' %>",
                            "wid": "<% role.enabledForWid ?? '' %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "id": "colEffDate",
                      "columnId": "colEffDate",
                      "label": "Effective Date",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.effectiveDate ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colPositions",
                      "columnId": "colPositions",
                      "label": "Positions / Delegated Roles",
                      "cellTemplate": {
                        "type": "instanceList",
                        "id": "colPositionsList",
                        "view": true,
                        "relatedTask": true,
                        "enabled": false,
                        "values": "<% empty(role.positions) ? [] : positions.data.filter(p => { role.positions.contains(p.id) }) %>",
                        "widKey": "id"
                      }
                    },
                    {
                      "type": "column",
                      "id": "colRequestedBy",
                      "columnId": "colRequestedBy",
                      "label": "Requested By",
                      "cellTemplate": {
                        "type": "instanceList",
                        "view": false,
                        "instanceList": [
                          {
                            "descriptor": "<% role.requestedBy.descriptor ?? '' %>",
                            "wid": "<% role.requestedBy.id ?? '' %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "id": "colRequestedDate",
                      "columnId": "colRequestedDate",
                      "label": "Requested Date",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.requestedDate ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colApprovedBy",
                      "columnId": "colApprovedBy",
                      "label": "Approved By",
                      "cellTemplate": {
                        "type": "instanceList",
                        "view": false,
                        "instanceList": [
                          {
                            "descriptor": "<% role.approvedBy.descriptor ?? '' %>",
                            "wid": "<% role.approvedBy.id ?? '' %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "id": "colApprovedDate",
                      "columnId": "colApprovedDate",
                      "label": "Approved Date",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.approvedDate ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colActions",
                      "columnId": "colActions",
                      "label": "Actions",
                      "cellTemplate": {
                        "type": "section",
                        "horizontal": true,
                        "children": [
                          {
                            "type": "section",
                            "horizontal": false,
                            "children": [
                              {
                                "type": "button",
                                "action": "PRIMARY",
                                "label": "Maintain",
                                "taskReference": {
                                  "taskId": "assignableRoleManagerMaintain",
                                  "parameterBindings": {
                                    "roleId": "<% role.id %>",
                                    "orgWid": "<% role.shellOrgWid ?? '' %>"
                                  }
                                }
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
              }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}