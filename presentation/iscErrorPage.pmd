  },
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "Access Restricted"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "iscErrorPageForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "errorSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "errorFieldSet",
              "title": "Access Restricted",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "iscErrorMessage",
                  "enabled": false,
                  "value": "<span style=\"color:#374151;font-size:13px\">This page is only available to ISC Security Administrators. If you have any questions, please raise an Incident Ticket with 'ISC Service Delivery'.</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "\u2190 Back to Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "AUXILIARY"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
