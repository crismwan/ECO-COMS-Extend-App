{
  "id": "assignableRoleManagerView",
  "securityDomains": [
    "ManageCOMSAssignableRoles"
  ],
  "include": [
    "comsRequestStats.script"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "comsAssignableRolesCount",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAssignableRoles?limit=1",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ],
      "name": "comsAssignableRolesPage0",
      "url": "/comsAssignableRoles?limit=100&offset=0"
    },
    {
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "name": "comsAssignableRolesPage1",
      "url": "<% let t = comsAssignableRolesCount.total ?? 0; '/comsAssignableRoles?limit=100&offset=' + (t > 100 ? 100 : t) %>"
    },
    {
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "name": "comsAssignableRolesPage2",
      "url": "<% let t = comsAssignableRolesCount.total ?? 0; '/comsAssignableRoles?limit=100&offset=' + (t > 200 ? 200 : t) %>"
    }
  ],
  "presentation": {
    "pageType": "VIEW",
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ECO-COMS: Assignable Role Manager",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "assignableRoleManagerViewForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK"
            },
            {
              "type": "button",
              "label": "Submit New Request",
              "taskReference": {
                "taskId": "assignableRoleManager"
              },
              "action": "PRIMARY"
            },
            {
              "type": "button",
              "label": "Withdraw Request",
              "taskReference": {
                "taskId": "deleteAssignableRole",
                "parameterBindings": {
                  "view": "assignable"
                }
              },
              "action": "AUXILIARY"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "descSection",
          "children": [
            {
              "type": "richText",
              "id": "pageDesc",
              "enabled": false,
              "value": "<span style=\"color:#374151;font-size:13px\">View your Assignable Role requests and their current status. Each request is reviewed by ISC before becoming active in Workday. To submit a new request, click <b>Submit New Request</b> above.</span>"
            },
            {
              "type": "richText",
              "id": "pendingNoticeYes",
              "enabled": false,
              "value": "<span style=\"color:#d97706;font-size:11px;font-weight:700\">⚠ </span><span style=\"color:#92400e;font-size:11px\">You have requests currently pending ISC review. Open a row's <b>Review Process</b> to see where it is, or use <b>Withdraw Request</b> to withdraw it.</span>",
              "visible": "<% size(list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]).filter(r => !r.roleName.startsWith('Organizations and Roles Assignment Administrator') && r.requestedBy.id == selectedWorker.id && r.status == 'Pending ISC Review')) > 0 %>"
            },
            {
              "type": "richText",
              "id": "pendingNoticeNo",
              "enabled": false,
              "value": "<span style=\"color:#059669;font-size:11px;font-weight:700\">✓ </span><span style=\"color:#065f46;font-size:11px\">You have no requests pending ISC review.</span>",
              "visible": "<% size(list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]).filter(r => !r.roleName.startsWith('Organizations and Roles Assignment Administrator') && r.requestedBy.id == selectedWorker.id && r.status == 'Pending ISC Review')) == 0 %>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "summaryCardsSection",
          "children": [
            {
              "type": "cardContainer",
              "id": "myRequestsCardContainer",
              "layout": "grid",
              "cards": [
                {
                  "type": "card",
                  "cardId": "CountCard",
                  "parameters": "<% { 'title': 'Pending', 'subtitle': 'Waiting for ISC review', 'countText': '' + comsRequestStats.countStatus((list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]) ?? []).filter(r => { !comsRequestStats.isAaa(r) && (!empty(r.requestedBy) ? r.requestedBy.id : '') == (selectedWorker.id ?? '') }), 'Pending ISC Review') + ' pending' } %>"
                },
                {
                  "type": "card",
                  "cardId": "CountCard",
                  "parameters": "<% { 'title': 'Approved', 'subtitle': 'Created in Workday', 'countText': '' + comsRequestStats.countStatus((list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]) ?? []).filter(r => { !comsRequestStats.isAaa(r) && (!empty(r.requestedBy) ? r.requestedBy.id : '') == (selectedWorker.id ?? '') }), 'Approved') + ' approved' } %>"
                },
                {
                  "type": "card",
                  "cardId": "CountCard",
                  "parameters": "<% { 'title': 'Denied', 'subtitle': 'Denied or withdrawn', 'countText': '' + comsRequestStats.countStatus((list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]) ?? []).filter(r => { !comsRequestStats.isAaa(r) && (!empty(r.requestedBy) ? r.requestedBy.id : '') == (selectedWorker.id ?? '') }), 'Denied') + ' denied' } %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "gridSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "pendingRolesSection",
              "children": [
                {
                  "type": "richText",
                  "id": "emptyStateMsg",
                  "value": "<span style=\"color:#374151;font-size:12px\">You have no Assignable Role requests. Click Submit New Request above to get started.</span>",
                  "visible": "<% size(list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]).filter(r => !r.roleName.startsWith('Organizations and Roles Assignment Administrator') && r.requestedBy.id == selectedWorker.id)) == 0 %>",
                  "enabled": false
                },
                {
                  "type": "grid",
                  "gridType": "LIST",
                  "multiViewStylingEnabled": true,
                  "id": "assignableRolesGrid",
                  "rows": "<% list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]).filter(r => !r.roleName.startsWith('Organizations and Roles Assignment Administrator') && r.requestedBy.id == selectedWorker.id) %>",
                  "rowVariableName": "role",
                  "enabled": false,
                  "label": "Assignable Role Requests",
                  "autoPaging": true,
                  "visible": "<% size(list:flatten([comsAssignableRolesPage0.data ?? [], comsAssignableRolesPage1.data ?? [], comsAssignableRolesPage2.data ?? []]).filter(r => !r.roleName.startsWith('Organizations and Roles Assignment Administrator') && r.requestedBy.id == selectedWorker.id)) > 0 %>",
                  "columns": [
                    {
                      "type": "column",
                      "id": "colOrgApp",
                      "columnId": "colOrgApp",
                      "label": "Organization / Application",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.shellOrgCode ?? role.application ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colRoleName",
                      "columnId": "colRoleName",
                      "label": "Role Name",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.roleName ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colWdRoleName",
                      "columnId": "colWdRoleName",
                      "label": "Generated Workday Role Name",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.workdayRoleId ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colStatus",
                      "columnId": "colStatus",
                      "label": "Status",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "richText",
                        "value": "<% role.status == 'Pending ISC Review' ? '<span style=\"color:#92400e;font-weight:600;font-size:11px\">⏳ Pending ISC Review</span>' : role.status == 'Approved' ? '<span style=\"color:#065f46;font-weight:600;font-size:11px\">✓ Approved</span>' : role.status == 'Denied' ? '<span style=\"color:#991b1b;font-weight:600;font-size:11px\">✗ Denied</span>' : role.status == 'Inactive' ? '<span style=\"color:#6b7280;font-weight:600;font-size:11px\">○ Inactive</span>' : role.status ?? '' %>"
                      }
                    },
                    {
                      "type": "column",
                      "id": "colEffDate",
                      "columnId": "colEffDate",
                      "label": "Effective Date",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.effectiveDate ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colRequestedDate",
                      "columnId": "colRequestedDate",
                      "label": "Requested Date",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "value": "<% role.requestedDate ?? '' %>",
                        "enabled": false
                      }
                    },
                    {
                      "type": "column",
                      "id": "colActions",
                      "columnId": "colActions",
                      "label": "Review",
                      "cellTemplate": {
                        "type": "fieldSet",
                        "id": "reviewActionFieldSet",
                        "children": [
                          {
                            "type": "instanceList",
                            "id": "reviewEventInstanceList",
                            "widKey": "id",
                            "view": true,
                            "relatedTask": true,
                            "visible": "<% !empty(role.reviewEventWid) %>",
                            "values": "<% !empty(role.reviewEventWid) ? [{'id': role.reviewEventWid, 'descriptor': 'Review Process'}] : [] %>"
                          }
                        ]
                      },
                      "excel": {
                        "enabled": false
                      }
                    }
                  ],
                  "excelExportEnabled": true
                }
              ],
              "title": "My Assignable Role Requests"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}
