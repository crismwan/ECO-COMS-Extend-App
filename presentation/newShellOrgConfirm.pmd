{
  "id": "newShellOrgConfirm",
  "endPoints": [],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "triggerAddShellOrg",
        "baseUrlType": "orchestration",
        "url": "<% '/AddShellOrg/launch?comsAppId=' + (flowVariables.comsAppId ?? '') + '&organizationName=' + (flowVariables.organizationName ?? '') + '&organizationCode=' + (flowVariables.organizationCode ?? '') + '&workerId=' + (flowVariables.workerId ?? '') + '&effectiveDate=' + (flowVariables.effectiveDate ?? '') %>",
        "authType": "sso",
        "httpMethod": "POST",
        "onSend": "<% {} %>",
        "headers": [
          {
            "name": "content-type",
            "value": "application/json"
          }
        ],
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 404
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ]
      }
    ],
    "responseErrorDetail": {
      "errorSummary": "<% error ?? '' %>"
    }
  },
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "Confirm: Add Shell Organization"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "confirmForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Back to Add Organization",
              "taskReference": {
                "taskId": "newShellOrg"
              },
              "action": "LINK",
              "suppressDiscardDialog": true
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "confirmSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "confirmFieldSet",
              "title": "Confirm New Shell Organization",
              "children": [
                {
                  "type": "fileUploader",
                  "id": "supportingDocUploader",
                  "label": "Attach Supporting Document (Optional)",
                  "compact": true,
                  "required": false,
                  "singular": true,
                  "maxFileSize": "5242880",
                  "fileTypes": "pdf,doc,docx,jpg,png",
                  "helpText": "Optionally attach an approval email or supporting document for audit purposes.",
                  "guide": {
                    "type": "guide",
                    "id": "guideSupportingDoc",
                    "title": "Supporting Document",
                    "text": "Attach an optional PDF, Word doc, or image (max 5MB) as a record of the request authorization. Accepted types: pdf, doc, docx, jpg, png."
                  }
                },
                {
                  "type": "text",
                  "id": "hiddenOrgName",
                  "label": "Organization Name",
                  "enabled": false,
                  "value": "<% flowVariables.organizationName %>",
                  "valuesOut": [
                    {
                      "value": "<% self.value %>",
                      "valueOutBinding": "triggerAddShellOrg.organizationName"
                    }
                  ]
                },
                {
                  "type": "richText",
                  "id": "confirmHelp",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:11px;font-weight:700\">ℹ </span><span style=\"color:#374151;font-size:11px\">Please confirm the new Shell Organization below. This will create a new Custom Organization in Workday via the orchestration.</span>"
                },
                {
                  "type": "text",
                  "label": "Organization Name",
                  "enabled": false,
                  "value": "<% flowVariables.organizationName %>"
                },
                {
                  "type": "text",
                  "label": "Organization Code",
                  "enabled": false,
                  "value": "<% flowVariables.organizationCode %>"
                },
                {
                  "type": "text",
                  "label": "Application",
                  "enabled": false,
                  "value": "<% flowVariables.applicationCode %>"
                },
                {
                  "type": "text",
                  "label": "Effective Date",
                  "enabled": false,
                  "value": "<% flowVariables.effectiveDate %>"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "EDIT",
    "standardEditButtonsHidden": true,
    "cancelOverride": {
      "taskId": "shellOrgManager"
    }
  }
}
