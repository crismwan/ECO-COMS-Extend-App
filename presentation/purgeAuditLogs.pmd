{
  "id": "purgeAuditLogs",
  "securityDomains": [
    "ViewCOMSAuditLog"
  ],
  "endPoints": [
    {
      "name": "allAuditLogs",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAuditLogs?limit=100",
      "authType": "sso",
      "failOnStatusCodes": [
        400,
        403,
        404,
        500
      ]
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "deleteAuditLog",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "<% '/comsAuditLogs/' + auditIdText.value %>",
        "httpMethod": "DELETE",
        "authType": "sso"
      }
    ],
    "responseErrorDetail": {
      "errorSummary": "<% error %>",
      "errors": "<% empty errors ? [] : errors.map(err => { err.error }) %>"
    }
  },
  "presentation": {
    "pageType": "EDIT",
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "Purge Audit Log (temporary)",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "purgeAuditLogsForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "purgeSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "purgeFieldSet",
              "title": "Delete all audit records",
              "children": [
                {
                  "type": "text",
                  "id": "recordCountText",
                  "label": "Records to delete",
                  "enabled": false,
                  "value": "<% '' + size(allAuditLogs.data ?? []) %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "purgeGridSection",
          "children": [
            {
              "type": "grid",
              "id": "auditLogsGrid",
              "label": "Audit records (remove rows, then OK)",
              "rows": "<% allAuditLogs.data ?? [] %>",
              "rowVariableName": "logRow",
              "doNotAdd": true,
              "deleteEndPoint": "deleteAuditLog",
              "columns": [
                {
                  "type": "column",
                  "columnId": "idColumn",
                  "label": "Id",
                  "cellTemplate": {
                    "type": "text",
                    "id": "auditIdText",
                    "value": "<% logRow.id ?? '' %>",
                    "enabled": false
                  }
                },
                {
                  "type": "column",
                  "columnId": "typeColumn",
                  "label": "Type",
                  "cellTemplate": {
                    "type": "text",
                    "id": "auditTypeText",
                    "value": "<% (logRow.objectType ?? '') + ' ' + (logRow.action ?? '') %>",
                    "enabled": false
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "cancelOverride": {
      "taskId": "auditLogViewer"
    }
  }
}