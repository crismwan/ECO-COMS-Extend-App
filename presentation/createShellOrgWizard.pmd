{
  "id": "createShellOrgWizard",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "endPoints": [],
  "presentation": {
    "body": {
      "type": "editWizard",
      "title": "ECO-COMS Shell Organization Manager",
      "subtitle": "Create New Shell Organization",
      "summarySettings": {
        "enabled": true,
        "label": "Review & Submit"
      },
      "editTasks": [
        {
          "label": "Organization Details",
          "task": {
            "taskId": "newShellOrg"
          }
        }
      ],
      "conclusion": {
        "task": {
          "taskId": "newShellOrgSuccess",
          "parameters": {
            "organizationName": "<% (!empty(selectedApplicationId.value)) ? ((selectedApplicationId.value.id ?? '') + ':' + (organizationCode.value ?? '')) : (organizationCode.value ?? '') %>",
            "organizationCode": "<% organizationCode.value ?? '' %>"
          }
        },
        "render": true
      }
    }
  }
}
