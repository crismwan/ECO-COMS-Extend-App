{
  "id": "createShellOrgWizard",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "endPoints": [],
  "presentation": {
    "body": {
      "type": "editWizard",
      "title": "ECO-COMS Shell Organization Manager",
      "subtitle": "Create New Shell Organization",
      "summarySettings": {
        "enabled": true,
        "label": "Review & Submit"
      },
      "editTasks": [
        {
          "label": "Organization Details",
          "task": {
            "taskId": "newShellOrg"
          }
        },
        {
          "label": "Confirm & Submit",
          "task": {
            "taskId": "newShellOrgConfirm"
          }
        }
      ],
      "conclusion": {
        "task": {
          "taskId": "newShellOrgSuccess"
        },
        "render": true
      }
    }
  }
}
