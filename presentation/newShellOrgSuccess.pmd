{
  "id": "newShellOrgSuccess",
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "Shell Organization Created"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "successForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "receiptCardSection",
          "children": [
            {
              "type": "cardContainer",
              "id": "receiptCardContainer",
              "layout": "grid",
              "cards": [
                {
                  "type": "card",
                  "cardId": "ShellOrgReceiptCard",
                  "parameters": "<% { 'organizationName': flowVariables.organizationName ?? '', 'organizationCode': flowVariables.organizationCode ?? '' } %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "successSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "successFieldSet",
              "title": "Organization Created Successfully",
              "children": [
                {
                  "type": "richText",
                  "id": "successMessage",
                  "enabled": false,
                  "value": "<span style=\"color:#059669;font-size:11px;font-weight:700\">✓ </span><span style=\"color:#065f46;font-size:11px\">The Shell Organization has been created in Workday.</span>"
                },
                {
                  "type": "readOnlyText",
                  "id": "orgNameDisplay",
                  "label": "Organization Name",
                  "value": "<% flowVariables.organizationName ?? '' %>"
                },
                {
                  "type": "readOnlyText",
                  "id": "orgCodeDisplay",
                  "label": "Organization Code",
                  "value": "<% flowVariables.organizationCode ?? '' %>"
                },
                {
                  "type": "readOnlyText",
                  "id": "copyHint",
                  "label": " ",
                  "value": "Use the organization code above to reference this org in downstream tasks."
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "Add Another Organization",
              "taskReference": {
                "taskId": "createShellOrgWizard"
              },
              "action": "PRIMARY"
            },
            {
              "type": "button",
              "label": "View in Shell Org Manager",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "AUXILIARY"
            },
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "VIEW"
  }
}
