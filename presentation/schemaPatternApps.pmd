{
  "id": "schemaPatternApps",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "include": [
    "comsPatterns.script"
  ],
  "endPoints": [
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications?limit=100",
      "authType": "sso",
      "isCollection": true,
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    }
  ],
  "presentation": {
    "headerSize": "HIDDEN",
    "body": {
      "type": "basicFormLayout",
      "id": "schemaPatternAppsForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "titleBannerSection",
          "children": [
            {
              "type": "richText",
              "id": "titleBannerRichText",
              "enabled": false,
              "value": "<span style=\"color:#0055B3;font-size:24px\"><b>ECO-COMS: Add Shell Org Pattern</b></span>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "button",
              "id": "backButton",
              "label": "← Shell Org Manager",
              "action": "LINK",
              "taskReference": {
                "taskId": "shellOrgManager"
              }
            },
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "title": "About This Page",
              "children": [
                {
                  "type": "richText",
                  "id": "aboutRichText",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Choose the application to add a shell org pattern for. Each application has its own pattern format (shown below); <b>Add Pattern</b> opens a form with that application's fields.</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "pickSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "pickFieldSet",
              "title": "Choose an Application",
              "children": [
                {
                  "type": "grid",
                  "id": "appPickGrid",
                  "rowVariableName": "pa",
                  "label": "Applications",
                  "rows": "<% (comsApplications.data ?? []).filter(x => { !empty(x.patternSchema) }).map(x => { x.appId }).distinct().sort().map(a => { {'appCode': a} }) %>",
                  "columns": [
                    {
                      "type": "column",
                      "columnId": "colAppId",
                      "label": "Application ID",
                      "cellTemplate": {
                        "type": "button",
                        "id": "appIdLinkButton",
                        "action": "LINK",
                        "label": "<% pa.appCode ?? '' %>",
                        "suppressDiscardDialog": true,
                        "taskReference": {
                          "taskId": "newSchemaPattern",
                          "parameterBindings": {
                            "appCode": "<% pa.appCode %>"
                          }
                        }
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colAppTitle",
                      "label": "Name",
                      "cellTemplate": {
                        "type": "text",
                        "id": "appTitleText",
                        "enabled": false,
                        "value": "<% (comsPatterns.recordFor(comsApplications.data, pa.appCode) ?? {'name': ''}).name ?? '' %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colAppFormat",
                      "label": "Pattern Format",
                      "cellTemplate": {
                        "type": "text",
                        "id": "appFormatText",
                        "enabled": false,
                        "value": "<% comsPatterns.summary(comsApplications.data, pa.appCode) %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colAppAction",
                      "label": "Add Pattern",
                      "cellTemplate": {
                        "type": "button",
                        "id": "appActionButton",
                        "label": "Add Pattern",
                        "action": "AUXILIARY",
                        "suppressDiscardDialog": true,
                        "taskReference": {
                          "taskId": "newSchemaPattern",
                          "parameterBindings": {
                            "appCode": "<% pa.appCode %>"
                          }
                        }
                      }
                    }
                  ],
                  "gridType": "LIST",
                  "multiViewStylingEnabled": true,
                  "autoPaging": true,
                  "excelExportEnabled": true
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "VIEW"
  }
}
