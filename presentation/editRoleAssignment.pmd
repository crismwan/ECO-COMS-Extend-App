{
  "id": "editRoleAssignment",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "endPoints": [
    {
      "name": "shellRoles",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "wqlQuery": {
        "queryId": "allShellAssignableRolesinTenant"
      }
    },
    {
      "name": "posSearch",
      "baseUrlType": "workday-wql",
      "url": "<% 'data?query=' + string:pathEncode('SELECT cf_PositionID, workdayID, position_PositionManagement, cf_PositionIsFilled, cf_PositionText FROM allPositions WHERE supervisoryOrganization is not empty AND cf_PositionText contains \\'' + instanceListQuery + '\\'') %>",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "deferred": "true",
      "exclude": "<% empty instanceListQuery %>"
    },
    {
      "name": "launchAssignRole",
      "baseUrlType": "orchestration",
      "authType": "sso",
      "deferred": "true",
      "url": "<% '/AssignRolePositions/launch?roleId=' + rid + '&roleName=' + rn + '&orgId=' + oid + '&orgName=' + on + '&positionId=' + pid + '&positionIdType=' + pt + '&positionName=' + pn + '&mode=' + md + '&effectiveDate=' + ed %>"
    },
    {
      "name": "verifyRoleAudit",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "<% '/comsAuditLogs?limit=' + lim %>",
      "authType": "sso",
      "deferred": "true"
    }
  ],
  "onSubmit": "<%\n  let valid = true;\n  let adds = positionsToAddInstanceList.selectedEntries ?? [];\n  let removes = positionsToRemoveInstanceList.selectedEntries ?? [];\n  if (size(adds) + size(removes) == 0) {\n    positionsToAddInstanceList.setError('Select at least one position to add or remove.');\n    valid = false;\n  }\n  if (empty(effectiveDate.value)) {\n    effectiveDate.setError('Effective Date is required.');\n    valid = false;\n  }\n  if (valid) {\n    let ed = effectiveDate.value.format('yyyy-MM-dd');\n    let before = verifyRoleAudit.invoke({'lim': '1'}).total ?? 0;\n    let count = 0;\n    for (var p : adds) {\n      launchAssignRole.invoke({'rid': queryParams.roleId ?? '', 'rn': (queryParams.roleName ?? '').urlEncode(), 'oid': queryParams.orgId ?? '', 'on': (queryParams.orgName ?? '').urlEncode(), 'pid': p.id, 'pn': (p.descriptor ?? '').urlEncode(), 'md': 'ADD', 'pt': 'Position_ID', 'ed': ed});\n      count = count + 1;\n    }\n    for (var p : removes) {\n      launchAssignRole.invoke({'rid': queryParams.roleId ?? '', 'rn': (queryParams.roleName ?? '').urlEncode(), 'oid': queryParams.orgId ?? '', 'on': (queryParams.orgName ?? '').urlEncode(), 'pid': p.id, 'pn': (p.descriptor ?? '').urlEncode(), 'md': 'REMOVE', 'pt': 'WID', 'ed': ed});\n      count = count + 1;\n    }\n    let after = verifyRoleAudit.invoke({'lim': '1'}).total ?? 0;\n    if (after - before < count) {\n      positionsToAddInstanceList.setError('Workday rejected ' + (count - (after - before)) + ' of ' + count + ' changes. Check the role assignment in Workday and try again.');\n      valid = false;\n    }\n  }\n  valid;\n%>",
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "<% 'Manage Role Assignment: ' + (queryParams.roleName ?? 'Role') %>",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "editRoleAssignmentForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Shell Org Manager",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "LINK",
              "suppressDiscardDialog": true
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "title": "About this page",
              "children": [
                {
                  "type": "richText",
                  "id": "aboutText",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:11px;font-weight:700\">ℹ </span><span style=\"color:#374151;font-size:11px\">Hover a role, organization or position for its related actions. Use Change Positions to add or remove positions; changes run through the Workday Assign Roles business process and are not rescindable.</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "currentAssignmentSection",
          "children": [
            {
              "type": "grid",
              "id": "currentAssignmentGrid",
              "label": "Current Assignment",
              "readOnly": true,
              "rows": "<% list:flatten((shellRoles.data ?? []).filter(r => { r.role.id == (queryParams.roleId ?? '') }).map(r => { (r.roleAssignments ?? []).filter(ra => { ra.organization != null && ra.organization.id == (queryParams.orgId ?? '') }).map(ra => { { 'role': r.role, 'org': ra.organization, 'positions': ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions ?? [] } }) })) %>",
              "rowVariableName": "ra",
              "columns": [
                {
                  "type": "column",
                  "id": "currentRoleName",
                  "columnId": "currentRoleName",
                  "label": "Role",
                  "cellTemplate": {
                    "type": "instanceList",
                    "id": "currentRoleNameInstanceList",
                    "view": true,
                    "relatedTask": true,
                    "enabled": false,
                    "values": "<% ra.role != null ? [ra.role] : [] %>",
                    "widKey": "id"
                  }
                },
                {
                  "type": "column",
                  "id": "currentAssignmentOrg",
                  "columnId": "currentAssignmentOrg",
                  "label": "Organization",
                  "cellTemplate": {
                    "type": "instanceList",
                    "id": "currentAssignmentOrgInstanceList",
                    "view": true,
                    "relatedTask": true,
                    "enabled": false,
                    "values": "<% ra.org != null ? [ra.org] : [] %>",
                    "widKey": "id"
                  }
                },
                {
                  "type": "column",
                  "id": "currentPositions",
                  "columnId": "currentPositions",
                  "label": "Current Positions",
                  "cellTemplate": {
                    "type": "instanceList",
                    "id": "currentPositionsInstanceList",
                    "view": true,
                    "relatedTask": true,
                    "enabled": false,
                    "values": "<% ra.positions %>",
                    "widKey": "id"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "assignmentSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "assignmentFieldSet",
              "title": "Change Positions",
              "children": [
                {
                  "type": "instanceList",
                  "id": "positionsToAddInstanceList",
                  "label": "Positions to Add",
                  "required": false,
                  "multiSelect": true,
                  "values": "<% [] %>",
                  "searchEndPoint": "<% endpoints.posSearch %>",
                  "searchResultValues": "<% empty(posSearch.data) ? [] : posSearch.data.filter(o => { !empty(o.cf_PositionID) }).map(o => { {'id': o.cf_PositionID, 'descriptor': !empty(o.position_PositionManagement.descriptor) ? o.position_PositionManagement.descriptor : (!empty(o.cf_PositionText) ? o.cf_PositionText : o.cf_PositionID)} }) %>",
                  "helpText": "Search by position name or ID. Each selected position is added to this role on this organization."
                },
                {
                  "type": "instanceList",
                  "id": "positionsToRemoveInstanceList",
                  "label": "Positions to Remove",
                  "multiSelect": true,
                  "required": false,
                  "values": "<% list:flatten(list:flatten((shellRoles.data ?? []).filter(r => { r.role.id == (queryParams.roleId ?? '') }).map(r => { (r.roleAssignments ?? []).filter(ra => { ra.organization != null && ra.organization.id == (queryParams.orgId ?? '') }).map(ra => { ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions ?? [] }) }))).map(p => { {'id': p.id, 'descriptor': p.descriptor} }) %>",
                  "helpText": "Pick from the positions currently assigned."
                },
                {
                  "type": "date",
                  "id": "effectiveDate",
                  "label": "Effective Date",
                  "required": true,
                  "helpText": "The date the change takes effect in Workday.",
                  "onChange": "<% effectiveDate.clearError(); %>"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "EDIT",
    "cancelOverride": {
      "taskId": "shellOrgManager"
    }
  }
}