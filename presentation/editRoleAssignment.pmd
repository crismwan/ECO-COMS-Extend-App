{
  "id": "editRoleAssignment",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "shellRoles",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "wqlQuery": {
        "queryId": "allShellAssignableRolesinTenant"
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "posSearch",
      "baseUrlType": "workday-wql",
      "url": "<% 'data?limit=50&query=' + string:pathEncode('SELECT cf_PositionID, workdayID, position_PositionManagement, cf_PositionIsFilled, cf_PositionText FROM allPositions WHERE supervisoryOrganization is not empty AND cf_PositionText contains \\'' + instanceListQuery.replace('\\'', '').replace('\\\\', '') + '\\'') %>",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "deferred": "true",
      "exclude": "<% empty instanceListQuery %>"
    },
    {
      "name": "launchAssignRole",
      "baseUrlType": "orchestration",
      "authType": "sso",
      "deferred": "true",
      "url": "<% '/IORC_0037_XFD_SEC_Assign_Remove_Role_Positions/launch?roleId=' + rid + '&roleName=' + rn + '&orgId=' + oid + '&orgName=' + on + '&positionId=' + pid + '&positionIdType=' + pt + '&positionName=' + pn + '&mode=' + md + '&effectiveDate=' + ed + '&changedBy=' + cb + '&timestamp=' + ts + '&changedByWid=' + cbw + '&positionWid=' + pwid %>"
    },
    {
      "name": "verifyRoleAudit",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "<% '/comsAuditLogs?limit=' + lim %>",
      "authType": "sso",
      "deferred": "true"
    },
    {
      "name": "posWidLookup",
      "baseUrlType": "workday-wql",
      "url": "<% 'data?limit=10&query=' + q %>",
      "authType": "sso",
      "deferred": "true"
    },
    {
      "name": "posTreeRoot",
      "baseUrlType": "workday-staffing-v6",
      "url": "values/jobChangesGroup/supervisoryOrganization/",
      "authType": "sso",
      "bestEffort": "true"
    },
    {
      "name": "posTreeNode",
      "baseUrlType": "workday-staffing-v6",
      "url": "<% h + '?limit=100&offset=' + o %>",
      "authType": "sso",
      "deferred": "true"
    },
    {
      "name": "posTreeOrgPositions",
      "baseUrlType": "workday-wql",
      "url": "<% 'data?limit=200&query=' + string:pathEncode('SELECT cf_PositionID, workdayID, position_PositionManagement, cf_PositionText FROM allPositions WHERE supervisoryOrganization in (\\'' + org.replace('\\'', '').replace('\\\\', '') + '\\')') %>",
      "authType": "sso",
      "deferred": "true"
    }
  ],
  "onSubmit": "<%\n  effectiveDate.clearError();\n  positionsToAddInstanceList.clearError();\n  let valid = true;\n  let adds = positionsToAddInstanceList.selectedEntries ?? [];\n  let removes = positionsToRemoveInstanceList.selectedEntries ?? [];\n  if (size(adds) + size(removes) == 0) {\n    positionsToAddInstanceList.setError('Select at least one position to add or remove.');\n    valid = false;\n  }\n  if (empty(effectiveDate.value)) {\n    effectiveDate.setError('Effective Date is required.');\n    valid = false;\n  }\n  if (valid) {\n    let ed = effectiveDate.value.format('yyyy-MM-dd');\n    let before = verifyRoleAudit.invoke({'lim': '1'}).total ?? 0;\n    let count = 0;\n    for (var p : adds) {\n      let pw = posWidLookup.invoke({'q': string:pathEncode('SELECT workdayID FROM allPositions WHERE cf_PositionID = \\'' + p.id + '\\'')}).data ?? [];\n      let pwid = size(pw) > 0 ? (pw[0].workdayID ?? '') : '';\n      launchAssignRole.invoke({'pwid': pwid, 'cbw': selectedWorker.id ?? '', 'cb': (selectedWorker.descriptor ?? '').urlEncode(), 'ts': date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\").urlEncode(), 'rid': queryParams.roleId ?? '', 'rn': (queryParams.roleName ?? '').urlEncode(), 'oid': queryParams.orgId ?? '', 'on': (queryParams.orgName ?? '').urlEncode(), 'pid': p.id, 'pn': (p.descriptor ?? '').urlEncode(), 'md': 'ADD', 'pt': 'Position_ID', 'ed': ed});\n      count = count + 1;\n    }\n    for (var p : removes) {\n      launchAssignRole.invoke({'pwid': p.id, 'cbw': selectedWorker.id ?? '', 'cb': (selectedWorker.descriptor ?? '').urlEncode(), 'ts': date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\").urlEncode(), 'rid': queryParams.roleId ?? '', 'rn': (queryParams.roleName ?? '').urlEncode(), 'oid': queryParams.orgId ?? '', 'on': (queryParams.orgName ?? '').urlEncode(), 'pid': p.id, 'pn': (p.descriptor ?? '').urlEncode(), 'md': 'REMOVE', 'pt': 'WID', 'ed': ed});\n      count = count + 1;\n    }\n    let after = verifyRoleAudit.invoke({'lim': '1'}).total ?? 0;\n    if (after - before < count) {\n      positionsToAddInstanceList.setError('Workday rejected ' + (count - (after - before)) + ' of ' + count + ' changes. Check the role assignment in Workday and try again.');\n      valid = false;\n    }\n  }\n  valid;\n%>",
  "presentation": {
    "headerSize": "HIDDEN",
    "body": {
      "type": "basicFormLayout",
      "id": "editRoleAssignmentForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "titleBannerSection",
          "children": [
            {
              "type": "richText",
              "id": "titleBannerRichText",
              "enabled": false,
              "value": "<% '<span style=\"color:#0055B3;font-size:24px\"><b>' + ('ECO-COMS: Manage Role Assignment – ' + (queryParams.roleName ?? 'Role')).replace('<', '&lt;') + '</b></span>' %>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "button",
              "label": "← Shell Org Manager",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "LINK",
              "suppressDiscardDialog": true
            },
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "title": "About This Page",
              "children": [
                {
                  "type": "richText",
                  "id": "aboutText",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Current role assignment is shown below (related actions are on the Shell Org Manager grid). Use Change Positions to add or remove positions; changes run through the Workday Assign Roles business process and are not rescindable.</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "currentAssignmentSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "currentAssignmentFieldSet",
              "title": "Current Assignment",
              "children": [
                {
                  "type": "instanceList",
                  "id": "currentRoleNameInstanceList",
                  "label": "Role",
                  "view": true,
                  "relatedTask": true,
                  "enabled": false,
                  "widKey": "id",
                  "values": "<% [] %>",
                  "multiSelect": true,
                  "selectedValuesAndDescriptors": "<% let cur = list:flatten((shellRoles.data ?? []).filter(r => { r.role.id == (queryParams.roleId ?? '') }).map(r => { (r.roleAssignments ?? []).filter(ra => { ra.organization != null && ra.organization.id == (queryParams.orgId ?? '') }).map(ra => { { 'role': r.role, 'org': ra.organization, 'positions': ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions ?? [] } }) })); empty(cur) ? [] : (cur[0].role != null ? [cur[0].role] : []).map(i => { {'id': i.id, 'descriptor': i.descriptor} }) %>"
                },
                {
                  "type": "instanceList",
                  "id": "currentAssignmentOrgInstanceList",
                  "label": "Organization",
                  "view": true,
                  "relatedTask": true,
                  "enabled": false,
                  "widKey": "id",
                  "values": "<% [] %>",
                  "multiSelect": true,
                  "selectedValuesAndDescriptors": "<% let cur = list:flatten((shellRoles.data ?? []).filter(r => { r.role.id == (queryParams.roleId ?? '') }).map(r => { (r.roleAssignments ?? []).filter(ra => { ra.organization != null && ra.organization.id == (queryParams.orgId ?? '') }).map(ra => { { 'role': r.role, 'org': ra.organization, 'positions': ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions ?? [] } }) })); empty(cur) ? [] : (cur[0].org != null ? [cur[0].org] : []).map(i => { {'id': i.id, 'descriptor': i.descriptor} }) %>"
                },
                {
                  "type": "instanceList",
                  "id": "currentPositionsInstanceList",
                  "label": "Current Positions",
                  "view": true,
                  "relatedTask": true,
                  "enabled": false,
                  "widKey": "id",
                  "values": "<% [] %>",
                  "multiSelect": true,
                  "selectedValuesAndDescriptors": "<% let cur = list:flatten((shellRoles.data ?? []).filter(r => { r.role.id == (queryParams.roleId ?? '') }).map(r => { (r.roleAssignments ?? []).filter(ra => { ra.organization != null && ra.organization.id == (queryParams.orgId ?? '') }).map(ra => { { 'role': r.role, 'org': ra.organization, 'positions': ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions ?? [] } }) })); empty(cur) ? [] : (cur[0].positions).map(i => { {'id': i.id, 'descriptor': i.descriptor} }) %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "assignmentSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "assignmentFieldSet",
              "title": "Change Positions",
              "children": [
                {
                  "type": "instanceList",
                  "id": "positionsToAddInstanceList",
                  "label": "Positions to Add",
                  "required": false,
                  "multiSelect": true,
                  "values": "<% (posTreeRoot.data ?? []).filter(r => { r.descriptor == 'My Favorites' || r.descriptor == 'My Organizations' || r.descriptor == 'Supervisory Organizations by Manager' || r.descriptor == 'Supervisory Organization' }).map(r => { {'id': r.id, 'descriptor': r.descriptor} }) %>",
                  "searchEndPoint": "<% endpoints.posSearch %>",
                  "searchResultValues": "<% empty(posSearch.data) ? [] : posSearch.data.filter(o => { !empty(o.cf_PositionID) }).map(o => { {'id': o.cf_PositionID, 'descriptor': !empty(o.position_PositionManagement.descriptor) ? o.position_PositionManagement.descriptor : (!empty(o.cf_PositionText) ? o.cf_PositionText : o.cf_PositionID)} }) %>",
                  "helpText": "Click to browse by supervisory organization, or type a position name or ID. Each selected position is added to this role on this organization. Shows the first 50 matches; type more of the title or ID to narrow.",
                  "dynamicMonikerLevels": "<%\n  const sel = self.promptSelections;\n  const roots = posTreeRoot.data ?? [];\n  const i = roots.map(r => { r.id }).indexOf(sel[0]);\n  const href = i < 0 ? '' : (roots[i].href ?? '');\n  const byManager = i < 0 ? false : roots[i].descriptor == 'Supervisory Organizations by Manager';\n  if (sel.size() == 1 || (byManager && sel.size() == 2)) {\n    const node = sel.size() == 1 ? href : (href + '/' + sel[1]);\n    const first = posTreeNode.invoke({'h': node, 'o': '0'});\n    const more = (first.total ?? 0) > 100 ? (posTreeNode.invoke({'h': node, 'o': '100'}).data ?? []) : [];\n    return [list:flatten([first.data ?? [], more]).map(o => { {'id': o.id, 'descriptor': o.descriptor} }), true];\n  }\n  const ps = posTreeOrgPositions.invoke({'org': sel[sel.size() - 1]}).data ?? [];\n  return [ps.filter(o => { !empty(o.cf_PositionID) }).map(o => { {'id': o.cf_PositionID, 'descriptor': !empty(o.position_PositionManagement.descriptor) ? o.position_PositionManagement.descriptor : (!empty(o.cf_PositionText) ? o.cf_PositionText : o.cf_PositionID)} }), false];\n%>",
                  "onChange": "<% self.clearError(); %>"
                },
                {
                  "type": "instanceList",
                  "id": "positionsToRemoveInstanceList",
                  "label": "Positions to Remove",
                  "multiSelect": true,
                  "required": false,
                  "values": "<% list:flatten(list:flatten((shellRoles.data ?? []).filter(r => { r.role.id == (queryParams.roleId ?? '') }).map(r => { (r.roleAssignments ?? []).filter(ra => { ra.organization != null && ra.organization.id == (queryParams.orgId ?? '') }).map(ra => { ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions ?? [] }) }))).map(p => { {'id': p.id, 'descriptor': p.descriptor} }) %>",
                  "helpText": "Pick from the positions currently assigned.",
                  "onChange": "<% positionsToAddInstanceList.clearError(); %>"
                },
                {
                  "type": "date",
                  "id": "effectiveDate",
                  "label": "Effective Date",
                  "required": true,
                  "helpText": "The date the change takes effect in Workday.",
                  "onChange": "<% effectiveDate.clearError(); %>"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "EDIT",
    "cancelOverride": {
      "taskId": "shellOrgManager",
      "parameterBindings": {
        "appCode": "<% queryParams.appCode ?? '' %>",
        "appName": "<% queryParams.appName ?? '' %>"
      }
    }
  },
  "outboundData": {
    "outboundEndPoints": [
      {
        "type": "outboundVariable",
        "name": "roleAssignmentFlowVars",
        "variableScope": "flow",
        "values": [
          {
            "outboundPath": "roleId",
            "value": "<% queryParams.roleId ?? '' %>"
          },
          {
            "outboundPath": "roleName",
            "value": "<% queryParams.roleName ?? '' %>"
          },
          {
            "outboundPath": "orgId",
            "value": "<% queryParams.orgId ?? '' %>"
          },
          {
            "outboundPath": "orgName",
            "value": "<% queryParams.orgName ?? '' %>"
          },
          {
            "outboundPath": "appCode",
            "value": "<% queryParams.appCode ?? '' %>"
          },
          {
            "outboundPath": "appName",
            "value": "<% queryParams.appName ?? '' %>"
          },
          {
            "outboundPath": "added",
            "value": "<% (positionsToAddInstanceList.selectedEntries ?? []).map(p => { p.descriptor ?? p.id }).join(', ') %>"
          },
          {
            "outboundPath": "removed",
            "value": "<% (positionsToRemoveInstanceList.selectedEntries ?? []).map(p => { p.descriptor ?? p.id }).join(', ') %>"
          },
          {
            "outboundPath": "effectiveDate",
            "value": "<% empty(effectiveDate.value) ? '' : effectiveDate.value.format('yyyy-MM-dd') %>"
          }
        ]
      }
    ]
  }
}
