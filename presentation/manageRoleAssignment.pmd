{
  "id": "manageRoleAssignment",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "endPoints": [
    {
      "name": "shellRoles",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "wqlQuery": {
        "queryId": "allShellAssignableRolesinTenant"
      }
    }
  ],
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "<% 'Role Assignment: ' + (queryParams.roleName ?? 'Role') %>",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "manageRoleAssignmentForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Shell Org Manager",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "LINK",
              "suppressDiscardDialog": true
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "title": "About this page",
              "children": [
                {
                  "type": "richText",
                  "id": "aboutText",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:11px;font-weight:700\">ℹ </span><span style=\"color:#374151;font-size:11px\">This role's assignment on this shell organization. Hover a value for its related actions. Use <b>Add or Remove Positions</b> to change who holds the role.</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "assignmentSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "assignmentFieldSet",
              "title": "Role Assignment",
              "children": [
                {
                  "type": "instanceList",
                  "id": "roleInstanceList",
                  "label": "Role",
                  "view": true,
                  "relatedTask": true,
                  "instanceList": [
                    {
                      "descriptor": "<% queryParams.roleName ?? '' %>",
                      "wid": "<% queryParams.roleId ?? '' %>"
                    }
                  ]
                },
                {
                  "type": "instanceList",
                  "id": "orgInstanceList",
                  "label": "Organization",
                  "view": true,
                  "relatedTask": true,
                  "instanceList": [
                    {
                      "descriptor": "<% queryParams.orgName ?? '' %>",
                      "wid": "<% queryParams.orgId ?? '' %>"
                    }
                  ]
                },
                {
                  "type": "instanceList",
                  "id": "currentPositionsInstanceList",
                  "label": "Current Positions",
                  "view": true,
                  "relatedTask": true,
                  "values": "<% list:flatten(list:flatten((shellRoles.data ?? []).filter(r => { r.role.id == (queryParams.roleId ?? '') }).map(r => { (r.roleAssignments ?? []).filter(ra => { ra.organization != null && ra.organization.id == (queryParams.orgId ?? '') }).map(ra => { ra.cf_ZCF_EE_RoleAssignedToAsPositionRestrictions ?? [] }) }))) %>",
                  "widKey": "id"
                },
                {
                  "type": "instanceList",
                  "id": "workersInstanceList",
                  "label": "Workers",
                  "view": true,
                  "relatedTask": true,
                  "values": "<% list:flatten(list:flatten((shellRoles.data ?? []).filter(r => { r.role.id == (queryParams.roleId ?? '') }).map(r => { (r.roleAssignments ?? []).filter(ra => { ra.organization != null && ra.organization.id == (queryParams.orgId ?? '') }).map(ra => { ra.workersAssigned ?? [] }) }))) %>",
                  "widKey": "id"
                },
                {
                  "type": "button",
                  "id": "editPositionsButton",
                  "label": "Add or Remove Positions",
                  "action": "PRIMARY",
                  "taskReference": {
                    "taskId": "editRoleAssignment",
                    "parameterBindings": {
                      "roleId": "<% queryParams.roleId ?? '' %>",
                      "roleName": "<% queryParams.roleName ?? '' %>",
                      "orgId": "<% queryParams.orgId ?? '' %>",
                      "orgName": "<% queryParams.orgName ?? '' %>"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "VIEW"
  }
}