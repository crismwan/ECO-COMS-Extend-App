{
  "id": "createShellOrgPatternWizard",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "endPoints": [],
  "presentation": {
    "body": {
      "type": "editWizard",
      "title": "ECO-COMS Shell Organization Manager",
      "subtitle": "Add New Shell Org Pattern",
      "summarySettings": {
        "enabled": true,
        "label": "Review & Submit"
      },
      "editTasks": [
        {
          "label": "Pattern Details",
          "task": {
            "taskId": "newShellOrgPattern"
          }
        }
      ],
      "conclusion": {
        "task": {
          "taskId": "newShellOrgPatternSuccess",
          "parameters": {
            "patternName": "<% let ac = (!empty(selectedApplicationId.value)) ? (selectedApplicationId.value.descriptor ?? '') : ''; ac + ':PATTERN:' + (attribute1.value ?? '*') + ':' + (attribute2.value ?? '*') + ':' + (attribute3.value ?? '*') + ':' + (attribute5.value ?? '*') %>",
            "organizationName": "<% (!empty(selectedApplicationId.value)) ? (selectedApplicationId.value.descriptor ?? '') : '' %>"
          }
        },
        "render": true
      }
    }
  }
}
