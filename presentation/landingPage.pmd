{
  "id": "landingPage",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "presentation": {
    "headerSize": "VPS_DEFAULT",
    "title": {
      "type": "title",
      "label": "Home",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "landingPageForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "shellOrgCardSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "shellOrgCard",
              "layout": {
                "density": "low",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "shellOrgTitle",
                  "enabled": false,
                  "value": "<b>&#9632; Shell Org Manager</b> &nbsp;<span style=\"color:#888;font-size:11px\">SHELL ORGANIZATIONS</span>"
                },
                {
                  "type": "richText",
                  "id": "shellOrgDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:12px\">View and manage shell org patterns for your assigned application.</span>"
                },
                {
                  "type": "button",
                  "id": "addPatternBtn",
                  "label": "Add Pattern",
                  "taskReference": {
                    "taskId": "newShellOrgPattern"
                  },
                  "action": "AUXILIARY"
                },
                {
                  "type": "button",
                  "id": "shellOrgManagerBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "shellOrgManager"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "myRoleRequestsCardSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "myRoleRequestsCard",
              "layout": {
                "density": "low",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "myRoleRequestsTitle",
                  "enabled": false,
                  "value": "<b>&#9670; My Role Requests</b> &nbsp;<span style=\"color:#888;font-size:11px\">ASSIGNABLE ROLES</span>"
                },
                {
                  "type": "richText",
                  "id": "myRoleRequestsDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:12px\">View the status of your pending and approved role requests.</span>"
                },
                {
                  "type": "button",
                  "id": "submitNewRequestBtn",
                  "label": "Submit New",
                  "taskReference": {
                    "taskId": "assignableRoleManager"
                  },
                  "action": "AUXILIARY"
                },
                {
                  "type": "button",
                  "id": "myRoleRequestsBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "assignableRoleManagerView"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "adminProvisioningCardSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "adminProvisioningCard",
              "layout": {
                "density": "low",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "adminProvisioningTitle",
                  "enabled": false,
                  "value": "<b>&#9650; Admin Provisioning</b> &nbsp;<span style=\"color:#888;font-size:11px\">ADMINISTRATION</span>"
                },
                {
                  "type": "richText",
                  "id": "adminProvisioningDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:12px\">Submit or review AAA provisioning requests for each application.</span>"
                },
                {
                  "type": "button",
                  "id": "submitAaaRequestBtn",
                  "label": "Submit AAA",
                  "taskReference": {
                    "taskId": "adminProvisioning"
                  },
                  "action": "AUXILIARY"
                },
                {
                  "type": "button",
                  "id": "adminProvisioningBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "adminProvisioningView"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "pendingIscCardSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "pendingIscCard",
              "layout": {
                "density": "low",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "pendingIscTitle",
                  "enabled": false,
                  "value": "<b>&#9658; Pending ISC Requests</b> &nbsp;<span style=\"color:#888;font-size:11px\">ADMINISTRATION</span>"
                },
                {
                  "type": "richText",
                  "id": "pendingIscDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:12px\">Review and process pending assignable role requests across ECO-COMS.</span>"
                },
                {
                  "type": "button",
                  "id": "pendingIscRequestsBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "iscRoleRequestsView"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "auditLogCardSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "auditLogCard",
              "layout": {
                "density": "low",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "auditLogTitle",
                  "enabled": false,
                  "value": "<b>&#9658; Audit Log</b> &nbsp;<span style=\"color:#888;font-size:11px\">ADMINISTRATION</span>"
                },
                {
                  "type": "richText",
                  "id": "auditLogDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:12px\">Review the history of all ECO-COMS changes, actions, and events.</span>"
                },
                {
                  "type": "button",
                  "id": "auditLogBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "auditLogViewer"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "view"
  }
}
