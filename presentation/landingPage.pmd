{
  "id": "landingPage",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "presentation": {
    "headerSize": "VPS_DEFAULT",
    "title": {
      "type": "title",
      "label": "Home",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "landingPageForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "shellOrgsSectionHeader",
          "children": [
            {
              "type": "fieldSet",
              "id": "shellOrgsSectionLabel",
              "title": "SHELL ORGANIZATIONS",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": []
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "shellOrgCardSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "shellOrgCard",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "shellOrgTitle",
                  "enabled": false,
                  "value": "<span style=\"display:inline-flex;align-items:center;gap:8px\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#0055B7\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M3 9h18M9 21V9\"/></svg><b style=\"font-size:14px\">Shell Org Manager</b></span>"
                },
                {
                  "type": "richText",
                  "id": "shellOrgDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:13px\">View and manage shell org patterns for your assigned application.</span>"
                },
                {
                  "type": "button",
                  "id": "addPatternBtn",
                  "label": "Add Pattern",
                  "taskReference": {
                    "taskId": "newShellOrgPattern"
                  },
                  "action": "AUXILIARY"
                },
                {
                  "type": "button",
                  "id": "shellOrgManagerBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "shellOrgManager"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
