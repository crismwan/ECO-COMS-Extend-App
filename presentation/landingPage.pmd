                {
                  "type": "richText",
                  "id": "myRoleRequestsTitle",
                  "enabled": false,
                  "value": "<span style=\"display:inline-flex;align-items:center;gap:8px\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#0055B7\" stroke-width=\"2\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg><b style=\"font-size:14px\">My Role Requests</b></span>"
                },
                {
                  "type": "richText",
                  "id": "myRoleRequestsDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:13px\">View the status of your pending and approved role requests.</span>"
