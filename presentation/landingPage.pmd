{
  "id": "landingPage",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "presentation": {
    "headerSize": "VPS_DEFAULT",
    "title": {
      "type": "title",
      "label": "Home",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "landingPageForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "topRow",
          "layout": {
            "numberOfColumns": "TWO_COLUMNS"
          },
          "children": [
            {
              "type": "fieldSet",
              "id": "shellOrgCard",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "shellOrgTitle",
                  "enabled": false,
                  "value": "<b>&#9632; Shell Org Manager</b>"
                },
                {
                  "type": "richText",
                  "id": "shellOrgCategory",
                  "enabled": false,
                  "value": "<span style=\"color:#888;font-size:11px;text-transform:uppercase;letter-spacing:1px\">Shell Organizations</span>"
                },
                {
                  "type": "richText",
                  "id": "shellOrgDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:13px\">View and manage shell org patterns for your assigned application.</span>"
                },
                {
                  "type": "button",
                  "id": "addPatternBtn",
                  "label": "Add Pattern",
                  "taskReference": {
                    "taskId": "newShellOrgPattern"
                  },
                  "action": "AUXILIARY"
                },
                {
                  "type": "button",
                  "id": "shellOrgManagerBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "shellOrgManager"
                  },
                  "action": "PRIMARY"
                }
              ]
            },
            {
              "type": "fieldSet",
              "id": "myRoleRequestsCard",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "myRoleRequestsTitle",
                  "enabled": false,
                  "value": "<b>&#9670; My Role Requests</b>"
                },
                {
                  "type": "richText",
                  "id": "myRoleRequestsCategory",
                  "enabled": false,
                  "value": "<span style=\"color:#888;font-size:11px;text-transform:uppercase;letter-spacing:1px\">Assignable Roles</span>"
                },
                {
                  "type": "richText",
                  "id": "myRoleRequestsDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:13px\">View the status of your pending and approved role requests.</span>"
                },
                {
                  "type": "button",
                  "id": "submitNewRequestBtn",
                  "label": "Submit New",
                  "taskReference": {
                    "taskId": "assignableRoleManager"
                  },
                  "action": "AUXILIARY"
                },
                {
                  "type": "button",
                  "id": "myRoleRequestsBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "assignableRoleManagerView"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "middleRow",
          "layout": {
            "numberOfColumns": "TWO_COLUMNS"
          },
          "children": [
            {
              "type": "fieldSet",
              "id": "adminProvisioningCard",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "adminProvisioningTitle",
                  "enabled": false,
                  "value": "<b>&#9650; Admin Provisioning</b>"
                },
                {
                  "type": "richText",
                  "id": "adminProvisioningCategory",
                  "enabled": false,
                  "value": "<span style=\"color:#888;font-size:11px;text-transform:uppercase;letter-spacing:1px\">Administration</span>"
                },
                {
                  "type": "richText",
                  "id": "adminProvisioningDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:13px\">Manage AAA role provisioning. Submit or review AAA requests for each application.</span>"
                },
                {
                  "type": "button",
                  "id": "submitAaaRequestBtn",
                  "label": "Submit AAA",
                  "taskReference": {
                    "taskId": "adminProvisioning"
                  },
                  "action": "AUXILIARY"
                },
                {
                  "type": "button",
                  "id": "adminProvisioningBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "adminProvisioningView"
                  },
                  "action": "PRIMARY"
                }
              ]
            },
            {
              "type": "fieldSet",
              "id": "pendingIscCard",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "pendingIscTitle",
                  "enabled": false,
                  "value": "<b>&#9658; Pending ISC Requests</b>"
                },
                {
                  "type": "richText",
                  "id": "pendingIscCategory",
                  "enabled": false,
                  "value": "<span style=\"color:#888;font-size:11px;text-transform:uppercase;letter-spacing:1px\">Administration</span>"
                },
                {
                  "type": "richText",
                  "id": "pendingIscDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:13px\">Review and process all pending assignable role requests across ECO-COMS.</span>"
                },
                {
                  "type": "button",
                  "id": "pendingIscRequestsBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "iscRoleRequestsView"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "bottomRow",
          "layout": {
            "numberOfColumns": "TWO_COLUMNS"
          },
          "children": [
            {
              "type": "fieldSet",
              "id": "auditLogCard",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "auditLogTitle",
                  "enabled": false,
                  "value": "<b>&#9658; Audit Log</b>"
                },
                {
                  "type": "richText",
                  "id": "auditLogCategory",
                  "enabled": false,
                  "value": "<span style=\"color:#888;font-size:11px;text-transform:uppercase;letter-spacing:1px\">Administration</span>"
                },
                {
                  "type": "richText",
                  "id": "auditLogDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:13px\">Review the history of all ECO-COMS changes, actions, and events.</span>"
                },
                {
                  "type": "button",
                  "id": "auditLogBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "auditLogViewer"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "view"
  }
}
