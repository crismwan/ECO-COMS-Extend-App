{
  "id": "landingPage",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "presentation": {
    "headerSize": "VPS_DEFAULT",
    "title": {
      "type": "title",
      "label": "Role-Based Access Control (RBAC) Solution",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "landingPageForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "topCardsSection",
          "children": [
            {
              "type": "cardContainer",
              "id": "topCardContainer",
              "cards": [
                {
                  "type": "card",
                  "cardId": "ShellOrgCard"
                },
                {
                  "type": "card",
                  "cardId": "MyRoleRequestsCard"
                },
                {
                  "type": "card",
                  "cardId": "AdminProvisioningCard"
                }
              ],
              "layout": "grid"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "bottomCardsSection",
          "children": [
            {
              "type": "cardContainer",
              "id": "bottomCardContainer",
              "cards": [
                {
                  "type": "card",
                  "cardId": "PendingIscCard"
                },
                {
                  "type": "card",
                  "cardId": "AuditLogCard"
                }
              ],
              "layout": "grid"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "VIEW"
  }
}