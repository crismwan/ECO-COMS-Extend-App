{
  "id": "hubLanding",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "include": [
    "comsRequestStats.script",
    "comsAuditFilters.script"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "bulkUploadCount",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsBulkUploads?limit=1",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "bulkUploadPage0",
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "url": "<% let t = bulkUploadCount.total ?? 0; let start = (t - 100) < 0 ? 0 : (t - 100); let cnt = t - start; '/comsBulkUploads?limit=' + (cnt > 0 ? cnt : 1) + '&offset=' + (cnt > 0 ? start : t) %>"
    },
    {
      "name": "pendingRequestsCount",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAssignableRoles?limit=1",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ],
      "name": "pendingRequestsPage0",
      "url": "/comsAssignableRoles?limit=100&offset=0"
    },
    {
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "name": "pendingRequestsPage1",
      "url": "<% let t = pendingRequestsCount.total ?? 0; '/comsAssignableRoles?limit=100&offset=' + (t > 100 ? 100 : t) %>"
    },
    {
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "name": "pendingRequestsPage2",
      "url": "<% let t = pendingRequestsCount.total ?? 0; '/comsAssignableRoles?limit=100&offset=' + (t > 200 ? 200 : t) %>"
    },
    {
      "name": "allShellOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellOrgs"
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "auditLogCount",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAuditLogs?limit=1",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ],
      "bestEffort": "true"
    },
    {
      "name": "auditPage0",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "<% let t = auditLogCount.total ?? 0; let start = (t - 100) < 0 ? 0 : (t - 100); let cnt = t - 0 - start; '/comsAuditLogs?limit=' + (cnt > 0 ? cnt : 1) + '&offset=' + (cnt > 0 ? start : t) %>",
      "authType": "sso",
      "isCollection": true,
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "bestEffort": "true"
    }
  ],
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ECO-COMS: RBAC Hub"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "hubLandingForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "dashboardSection",
          "children": [
            {
              "type": "cardContainer",
              "id": "dashboardCardContainer",
              "layout": "grid",
              "cards": [
                {
                  "type": "card",
                  "cardId": "MyAttentionCard",
                  "parameters": "<% { 'requestsText': comsRequestStats.myRequestsText(list:flatten([pendingRequestsPage0.data ?? [], pendingRequestsPage1.data ?? [], pendingRequestsPage2.data ?? []]), selectedWorker.id ?? ''), 'bulkText': (size((bulkUploadPage0.data ?? []).filter(u => { (u.uploadedByWid ?? '') == (selectedWorker.id ?? '') }).filter(u => { ['Uploaded', 'Queued', 'Running'].contains(u.status ?? '') })) > 0 ? ('' + size((bulkUploadPage0.data ?? []).filter(u => { (u.uploadedByWid ?? '') == (selectedWorker.id ?? '') }).filter(u => { ['Uploaded', 'Queued', 'Running'].contains(u.status ?? '') })) + ' bulk upload(s) still running') : 'No bulk uploads running') + (size((bulkUploadPage0.data ?? []).filter(u => { (u.uploadedByWid ?? '') == (selectedWorker.id ?? '') }).filter(u => { (u.status ?? '') == 'Rejected' })) > 0 ? (' · ' + size((bulkUploadPage0.data ?? []).filter(u => { (u.uploadedByWid ?? '') == (selectedWorker.id ?? '') }).filter(u => { (u.status ?? '') == 'Rejected' })) + ' rejected (over 200 rows)') : '') } %>"
                },
                {
                  "type": "card",
                  "cardId": "PendingIscCard",
                  "parameters": "<% { 'countText': '' + comsRequestStats.countPending(list:flatten([pendingRequestsPage0.data ?? [], pendingRequestsPage1.data ?? [], pendingRequestsPage2.data ?? []]) ?? []) + ' pending · ' + comsRequestStats.countOverdue(list:flatten([pendingRequestsPage0.data ?? [], pendingRequestsPage1.data ?? [], pendingRequestsPage2.data ?? []]) ?? []) + ' overdue' } %>"
                },
                {
                  "type": "card",
                  "cardId": "ShellOrgCard",
                  "parameters": "<% { 'countText': '' + size((allShellOrgs.data ?? []).filter(o => { (o.code ?? '').startsWith('X:') && !(o.code ?? '').contains(':PATTERN') && o.cf_active1 == true })) + ' active shell organizations' } %>"
                },
                {
                  "type": "card",
                  "cardId": "AuditLogCard",
                  "parameters": "<% { 'countText': '' + size(comsAuditFilters.filterLogs(auditPage0.data ?? [], '24h', '')) + ' changes in the last 24 hours' } %>"
                },
                {
                  "type": "card",
                  "cardId": "ShellOrgStatusChart",
                  "parameters": "<% { 'activeCount': size((allShellOrgs.data ?? []).filter(o => { (o.code ?? '').startsWith('X:') && !(o.code ?? '').contains(':PATTERN') && o.cf_active1 == true })), 'inactiveCount': size((allShellOrgs.data ?? []).filter(o => { (o.code ?? '').startsWith('X:') && !(o.code ?? '').contains(':PATTERN') && o.cf_active1 != true })), 'totalPatterns': size((allShellOrgs.data ?? []).filter(o => { (o.code ?? '').contains(':PATTERN') })) } %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "shellOrgSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "shellOrgFieldSet",
              "title": "Shell Organizations",
              "children": [
                {
                  "type": "richText",
                  "id": "shellOrgDesc",
                  "enabled": false,
                  "value": "<% '<span style=\"color:#374151;font-size:12px\">Manage Custom Organizations (Shell Orgs) used for RBAC role assignments in Workday. Add new organizations, manage patterns, and view or update organization status.</span>' %>"
                },
                {
                  "type": "button",
                  "id": "addShellOrgButton",
                  "label": "Add Shell Org",
                  "action": "AUXILIARY",
                  "taskReference": {
                    "taskId": "createShellOrgWizard"
                  }
                },
                {
                  "type": "button",
                  "id": "addPatternButton",
                  "label": "Add Pattern",
                  "action": "AUXILIARY",
                  "taskReference": {
                    "taskId": "createShellOrgPatternWizard"
                  }
                },
                {
                  "type": "button",
                  "id": "openShellOrgManagerButton",
                  "label": "Open Manager",
                  "action": "PRIMARY",
                  "taskReference": {
                    "taskId": "shellOrgManager"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "bulkSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "bulkFieldSet",
              "title": "Bulk Role Changes",
              "children": [
                {
                  "type": "richText",
                  "id": "bulkDesc",
                  "enabled": false,
                  "value": "<% '<span style=\"color:#374151;font-size:12px\">Add or remove many positions on shell organization roles from one CSV file. Validate first, then run it for real.</span>' %>"
                },
                {
                  "type": "button",
                  "id": "bulkTemplateButton",
                  "label": "Download Template",
                  "action": "AUXILIARY",
                  "taskReference": {
                    "taskId": "bulkRoleTemplate"
                  }
                },
                {
                  "type": "button",
                  "id": "bulkUploadButton",
                  "label": "Upload File",
                  "action": "PRIMARY",
                  "taskReference": {
                    "taskId": "bulkRoleChanges"
                  }
                },
                {
                  "type": "button",
                  "id": "bulkResultsButton",
                  "label": "View Results",
                  "action": "AUXILIARY",
                  "taskReference": {
                    "taskId": "bulkRoleResults"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "assignableRoleSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "assignableRoleFieldSet",
              "title": "Assignable Roles",
              "children": [
                {
                  "type": "richText",
                  "id": "assignableRoleDesc",
                  "enabled": false,
                  "value": "<% '<span style=\"color:#374151;font-size:12px\">Submit requests for new Assignable Roles or view existing role requests and their current status.</span>' %>"
                },
                {
                  "type": "button",
                  "id": "submitNewRoleButton",
                  "label": "Submit New Request",
                  "action": "AUXILIARY",
                  "taskReference": {
                    "taskId": "assignableRoleManager"
                  }
                },
                {
                  "type": "button",
                  "id": "viewRoleRequestsButton",
                  "label": "View Requests",
                  "action": "PRIMARY",
                  "taskReference": {
                    "taskId": "assignableRoleManagerView"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "adminSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "adminFieldSet",
              "title": "Administration",
              "children": [
                {
                  "type": "richText",
                  "id": "adminDesc",
                  "enabled": false,
                  "value": "<% '<span style=\"color:#374151;font-size:12px\">Administrative tools for AAA role provisioning, ISC role request management, and audit log review.</span>' %>"
                },
                {
                  "type": "button",
                  "id": "submitAaaButton",
                  "label": "Submit AAA Role",
                  "action": "AUXILIARY",
                  "taskReference": {
                    "taskId": "adminProvisioning"
                  }
                },
                {
                  "type": "button",
                  "id": "viewPendingIscButton",
                  "label": "View Pending ISC Requests",
                  "action": "PRIMARY",
                  "taskReference": {
                    "taskId": "iscRoleRequestsHub"
                  }
                },
                {
                  "type": "button",
                  "id": "viewAuditLogButton",
                  "label": "View Audit Log",
                  "action": "PRIMARY",
                  "taskReference": {
                    "taskId": "auditLogViewer"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "VIEW"
  }
}
