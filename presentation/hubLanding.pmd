{
  "id": "hubLanding",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "presentation": {
    "headerSize": "VPS_DEFAULT",
    "title": {
      "type": "title",
      "label": "ECO-COMS",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "hubLandingForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "shellOrgsSectionHeader",
          "children": [
            {
              "type": "fieldSet",
              "id": "shellOrgsSectionLabel",
              "title": "SHELL ORGANIZATIONS",
              "layout": {
                "density": "compact",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": []
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "shellOrgCardSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "shellOrgCard",
              "title": "🏢  Shell Org Manager",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "shellOrgDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:13px\">View and manage shell org patterns for your assigned application.</span>"
                },
                {
                  "type": "button",
                  "id": "addPatternBtn",
                  "label": "Add Pattern",
                  "taskReference": {
                    "taskId": "newShellOrgPattern"
                  },
                  "action": "AUXILIARY"
                },
                {
                  "type": "button",
                  "id": "shellOrgManagerBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "shellOrgManager"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "assignableRolesSectionHeader",
          "children": [
            {
              "type": "fieldSet",
              "id": "assignableRolesSectionLabel",
              "title": "ASSIGNABLE ROLES",
              "layout": {
                "density": "compact",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": []
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "myRoleRequestsCardSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "myRoleRequestsCard",
              "title": "👥  My Role Requests",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "myRoleRequestsDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:13px\">View the status of your pending and approved role requests.</span>"
                },
                {
                  "type": "button",
                  "id": "submitNewRequestBtn",
                  "label": "Submit New",
                  "taskReference": {
                    "taskId": "assignableRoleManager"
                  },
                  "action": "AUXILIARY"
                },
                {
                  "type": "button",
                  "id": "myRoleRequestsBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "assignableRoleManagerView"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "administrationSectionHeader",
          "children": [
            {
              "type": "fieldSet",
              "id": "administrationSectionLabel",
              "title": "ADMINISTRATION",
              "layout": {
                "density": "compact",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": []
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "adminProvisioningCardSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "adminProvisioningCard",
              "title": "🛡️  Admin Provisioning",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "adminProvisioningDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:13px\">Manage AAA role provisioning. Submit or review AAA requests for each application.</span>"
                },
                {
                  "type": "button",
                  "id": "submitAaaRequestBtn",
                  "label": "Submit AAA",
                  "taskReference": {
                    "taskId": "adminProvisioning"
                  },
                  "action": "AUXILIARY"
                },
                {
                  "type": "button",
                  "id": "adminProvisioningBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "adminProvisioningView"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "pendingIscCardSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "pendingIscCard",
              "title": "✅  Pending ISC Requests",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "pendingIscDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:13px\">Review and process all pending assignable role requests across ECO-COMS.</span>"
                },
                {
                  "type": "button",
                  "id": "pendingIscRequestsBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "iscRoleRequestsView"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "auditLogCardSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "auditLogCard",
              "title": "📄  Audit Log",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "auditLogDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#64748b;font-size:13px\">Review the history of all ECO-COMS changes, actions, and events.</span>"
                },
                {
                  "type": "button",
                  "id": "auditLogBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "auditLogViewer"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "view"
  }
}
