{
  "id": "hubLanding",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "presentation": {
    "headerSize": "VPS_DEFAULT",
    "title": {
      "type": "title",
      "label": "ECO-COMS",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "hubLandingForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "shellOrgLayoutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "shellOrgSection",
              "title": "Shell Org Manager",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "shellOrgDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#374151;font-size:13px\">View and manage shell org patterns for your assigned application. You can add new Custom Organizations and inactivate existing ones. You will only see patterns for the application you are provisioned to manage.</span>"
                },
                {
                  "type": "button",
                  "id": "shellOrgManagerBtn",
                  "label": "Shell Org Manager",
                  "taskReference": {
                    "taskId": "shellOrgManager"
                  },
                  "action": "PRIMARY",
                  "tooltip": "View and manage shell org patterns for your application."
                },
                {
                  "type": "button",
                  "id": "addPatternBtn",
                  "label": "Add Pattern",
                  "taskReference": {
                    "taskId": "newShellOrgPattern"
                  },
                  "action": "AUXILIARY",
                  "tooltip": "Create a new shell org pattern for your application."
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "assignableRoleLayoutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "assignableRoleSection",
              "title": "Assignable Role Manager",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "assignableRoleDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#374151;font-size:13px\">Submit a new Assignable Role request for a Custom Organization. Each request goes to ISC for review before it becomes active in Workday. You can also view the status of your pending and approved requests.</span>"
                },
                {
                  "type": "button",
                  "id": "myRoleRequestsBtn",
                  "label": "My Role Requests",
                  "taskReference": {
                    "taskId": "assignableRoleManagerView"
                  },
                  "action": "PRIMARY",
                  "tooltip": "View the status of your Assignable Role requests."
                },
                {
                  "type": "button",
                  "id": "submitNewRequestBtn",
                  "label": "Submit New Request",
                  "taskReference": {
                    "taskId": "assignableRoleManager"
                  },
                  "action": "AUXILIARY",
                  "tooltip": "Submit a new Assignable Role request for ISC review."
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "adminLayoutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "adminSection",
              "title": "Admin Provisioning",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "adminDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#374151;font-size:13px\">Admin Provisioning controls which users can manage shell orgs and submit role requests for each application. Submit a new AAA role request or view all provisioned roles.</span>"
                },
                {
                  "type": "button",
                  "id": "adminProvisioningBtn",
                  "label": "Admin Provisioning",
                  "taskReference": {
                    "taskId": "adminProvisioningView"
                  },
                  "action": "PRIMARY",
                  "tooltip": "View and manage AAA role provisioning for all applications."
                },
                {
                  "type": "button",
                  "id": "submitAaaRequestBtn",
                  "label": "Submit AAA Role Request",
                  "taskReference": {
                    "taskId": "adminProvisioning"
                  },
                  "action": "AUXILIARY",
                  "tooltip": "Submit a new AAA role request for ISC review."
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "iscOnlyLayoutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "iscOnlySection",
              "title": "ISC Only",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "iscOnlyDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#374151;font-size:13px\">ISC Security staff: review and process all pending Assignable Role requests from across ECO-COMS.</span>"
                },
                {
                  "type": "button",
                  "id": "pendingIscRequestsBtn",
                  "label": "Pending ISC Requests",
                  "taskReference": {
                    "taskId": "iscRoleRequestsView"
                  },
                  "action": "PRIMARY",
                  "tooltip": "View all role requests currently pending ISC review."
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "auditLogLayoutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "auditLogSection",
              "title": "Audit Log",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "auditLogDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#374151;font-size:13px\">View the history of all ECO-COMS changes and events. Use the Audit Log to review who made changes, when they were made, and what was affected.</span>"
                },
                {
                  "type": "button",
                  "id": "auditLogBtn",
                  "label": "Audit Log",
                  "taskReference": {
                    "taskId": "auditLogViewer"
                  },
                  "action": "PRIMARY",
                  "tooltip": "View the history of all ECO-COMS changes and events."
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "view"
  }
}