{
  "id": "hubLanding",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "presentation": {
    "headerSize": "VPS_DEFAULT",
    "title": {
      "type": "title",
      "label": "ECO-COMS",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "hubLandingForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "hubContentSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "shellOrgSection",
              "collapsible": true,
              "collapsed": false,
              "title": "Shell Org Manager",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "shellOrgDesc",
                  "enabled": false,
                  "value": "View and manage shell org patterns for your assigned application. You can add new Custom Organizations and inactivate existing ones. You will only see patterns for the application you are provisioned to manage."
                },
                {
                  "type": "section",
                  "horizontal": true,
                  "columnWidthRatios": [
                    0.5,
                    0.5
                  ],
                  "children": [
                    {
                      "type": "section",
                      "horizontal": false,
                      "children": [
                        {
                          "type": "button",
                          "label": "Shell Org Manager",
                          "taskReference": {
                            "taskId": "shellOrgManager"
                          },
                          "action": "PRIMARY",
                          "tooltip": "View and manage shell org patterns for your application."
                        }
                      ]
                    },
                    {
                      "type": "section",
                      "horizontal": false,
                      "children": [
                        {
                          "type": "button",
                          "label": "Add Pattern",
                          "taskReference": {
                            "taskId": "newShellOrgPattern"
                          },
                          "action": "AUXILIARY",
                          "tooltip": "Create a new shell org pattern for your application."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "fieldSet",
              "id": "assignableRoleSection",
              "collapsible": true,
              "collapsed": false,
              "title": "Assignable Role Manager",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "assignableRoleDesc",
                  "enabled": false,
                  "value": "Submit a new Assignable Role request for a Custom Organization. Each request goes to ISC for review before it becomes active in Workday. You can also view the status of your pending and approved requests."
                },
                {
                  "type": "section",
                  "horizontal": true,
                  "columnWidthRatios": [
                    0.34,
                    0.33,
                    0.33
                  ],
                  "children": [
                    {
                      "type": "section",
                      "horizontal": false,
                      "children": [
                        {
                          "type": "button",
                          "label": "My Role Requests",
                          "taskReference": {
                            "taskId": "assignableRoleManagerView"
                          },
                          "action": "PRIMARY",
                          "tooltip": "View the status of your Assignable Role requests."
                        }
                      ]
                    },
                    {
                      "type": "section",
                      "horizontal": false,
                      "children": [
                        {
                          "type": "button",
                          "label": "Submit New Request",
                          "taskReference": {
                            "taskId": "assignableRoleManager"
                          },
                          "action": "AUXILIARY",
                          "tooltip": "Submit a new Assignable Role request for ISC review."
                        }
                      ]
                    },
                    {
                      "type": "section",
                      "horizontal": false,
                      "children": [
                        {
                          "type": "button",
                          "label": "Pending ISC Requests",
                          "taskReference": {
                            "taskId": "iscRoleRequestsView"
                          },
                          "action": "AUXILIARY",
                          "tooltip": "View all role requests currently pending ISC review."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "fieldSet",
              "id": "adminSection",
              "collapsible": true,
              "collapsed": false,
              "title": "Administration \u2014 ISC Only",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "adminDesc",
                  "enabled": false,
                  "value": "Admin Provisioning controls which users can manage shell orgs and submit role requests for each application. ISC can submit AAA role requests and review pending requests here."
                },
                {
                  "type": "section",
                  "horizontal": true,
                  "columnWidthRatios": [
                    0.34,
                    0.33,
                    0.33
                  ],
                  "children": [
                    {
                      "type": "section",
                      "horizontal": false,
                      "children": [
                        {
                          "type": "button",
                          "label": "Admin Provisioning",
                          "taskReference": {
                            "taskId": "adminProvisioningView"
                          },
                          "action": "PRIMARY",
                          "tooltip": "View and manage AAA role provisioning for all applications."
                        }
                      ]
                    },
                    {
                      "type": "section",
                      "horizontal": false,
                      "children": [
                        {
                          "type": "button",
                          "label": "Submit AAA Request",
                          "taskReference": {
                            "taskId": "adminProvisioning"
                          },
                          "action": "AUXILIARY",
                          "tooltip": "Submit a new AAA role request for ISC review."
                        }
                      ]
                    },
                    {
                      "type": "section",
                      "horizontal": false,
                      "children": [
                        {
                          "type": "button",
                          "label": "Pending ISC Requests",
                          "taskReference": {
                            "taskId": "iscRoleRequestsView"
                          },
                          "action": "AUXILIARY",
                          "tooltip": "View all role requests currently pending ISC review."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "fieldSet",
              "id": "auditLogSection",
              "collapsible": true,
              "collapsed": false,
              "title": "Audit Log",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "auditLogDesc",
                  "enabled": false,
                  "value": "View the history of all ECO-COMS changes and events. Use the Audit Log to review who made changes, when they were made, and what was affected."
                },
                {
                  "type": "section",
                  "horizontal": true,
                  "columnWidthRatios": [
                    1
                  ],
                  "children": [
                    {
                      "type": "section",
                      "horizontal": false,
                      "children": [
                        {
                          "type": "button",
                          "label": "Audit Log",
                          "taskReference": {
                            "taskId": "auditLogViewer"
                          },
                          "action": "PRIMARY",
                          "tooltip": "View the history of all ECO-COMS changes and events."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "view"
  }
}