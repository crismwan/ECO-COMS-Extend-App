{
  "id": "hubLanding",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "presentation": {
    "headerSize": "VPS_DEFAULT",
    "title": {
      "type": "title",
      "label": "ECO-COMS",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "hubLandingForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "shellOrgsGroupSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "shellOrgsGroup",
              "title": "Shell Organizations",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "shellOrgDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#374151;font-size:13px\"><b>Shell Org Manager</b> — View and manage shell org patterns for your assigned application. Add new Custom Organizations or inactivate existing ones.</span>"
                },
                {
                  "type": "button",
                  "id": "addPatternBtn",
                  "label": "Add Pattern",
                  "taskReference": {
                    "taskId": "newShellOrgPattern"
                  },
                  "action": "AUXILIARY"
                },
                {
                  "type": "button",
                  "id": "shellOrgManagerBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "shellOrgManager"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "assignableRolesGroupSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "assignableRolesGroup",
              "title": "Assignable Roles",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "myRoleRequestsDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#374151;font-size:13px\"><b>My Role Requests</b> — View the status of your Assignable Role requests submitted for ISC review.</span>"
                },
                {
                  "type": "button",
                  "id": "submitNewRequestBtn",
                  "label": "Submit New",
                  "taskReference": {
                    "taskId": "assignableRoleManager"
                  },
                  "action": "AUXILIARY"
                },
                {
                  "type": "button",
                  "id": "myRoleRequestsBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "assignableRoleManagerView"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "administrationGroupSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "adminProvisioningGroup",
              "title": "Administration",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "adminProvisioningDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#374151;font-size:13px\"><b>Admin Provisioning</b> — Controls which users can manage shell orgs and submit role requests. Submit AAA role requests or view all provisioned roles.</span>"
                },
                {
                  "type": "button",
                  "id": "submitAaaRequestBtn",
                  "label": "Submit AAA",
                  "taskReference": {
                    "taskId": "adminProvisioning"
                  },
                  "action": "AUXILIARY"
                },
                {
                  "type": "button",
                  "id": "adminProvisioningBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "adminProvisioningView"
                  },
                  "action": "PRIMARY"
                },
                {
                  "type": "richText",
                  "id": "pendingIscDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#374151;font-size:13px\"><b>Pending ISC Requests</b> — ISC Security staff: review and process all pending Assignable Role requests from across ECO-COMS.</span>"
                },
                {
                  "type": "button",
                  "id": "pendingIscRequestsBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "iscRoleRequestsView"
                  },
                  "action": "PRIMARY"
                },
                {
                  "type": "richText",
                  "id": "auditLogDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#374151;font-size:13px\"><b>Audit Log</b> — View the history of all ECO-COMS changes and events. Review who made changes, when, and what was affected.</span>"
                },
                {
                  "type": "button",
                  "id": "auditLogBtn",
                  "label": "Open",
                  "taskReference": {
                    "taskId": "auditLogViewer"
                  },
                  "action": "PRIMARY"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "view"
  }
}
