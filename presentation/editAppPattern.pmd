{
  "id": "editAppPattern",
  "securityDomains": [
    "ManageCOMSApplicationSetup"
  ],
  "include": [
    "comsAppSetup.script"
  ],
  "endPoints": [
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications?limit=100",
      "authType": "sso",
      "isCollection": true,
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "existingOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "customOrganizations"
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "postApplication",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "/comsApplications",
        "httpMethod": "POST",
        "authType": "sso",
        "exclude": "<% !empty(queryParams.recordId) %>",
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ],
        "values": [
          {
            "outboundPath": "appId",
            "value": "<% (empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id) %>"
          },
          {
            "outboundPath": "name",
            "value": "<% (appNameText.value ?? '').trim() %>"
          },
          {
            "outboundPath": "orgType",
            "value": "<% (empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id) %>"
          },
          {
            "outboundPath": "orgSubtype",
            "value": "X:SHELL"
          },
          {
            "outboundPath": "namePrefix",
            "value": "<% comsAppSetup.prefixesOf((formatText.value ?? '')).join(',') %>"
          },
          {
            "outboundPath": "patternSchema",
            "value": "<% comsAppSetup.schemaJson((empty(queryParams.recordId) ? (empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id) : (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'appId': ''}).appId), (formatText.value ?? ''), (exampleText.value ?? ''), comsApplications.data, comsAppSetup.recordById(comsApplications.data, queryParams.recordId)) %>"
          },
          {
            "outboundPath": "active",
            "value": "<% appActiveCheckBox.value == true %>"
          }
        ]
      },
      {
        "name": "patchApplication",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "<% '/comsApplications/' + (queryParams.recordId ?? '') %>",
        "httpMethod": "PATCH",
        "authType": "sso",
        "exclude": "<% empty(queryParams.recordId) %>",
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 404
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ],
        "values": [
          {
            "outboundPath": "namePrefix",
            "value": "<% comsAppSetup.prefixesOf((formatText.value ?? '')).join(',') %>"
          },
          {
            "outboundPath": "patternSchema",
            "value": "<% comsAppSetup.schemaJson((empty(queryParams.recordId) ? (empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id) : (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'appId': ''}).appId), (formatText.value ?? ''), (exampleText.value ?? ''), comsApplications.data, comsAppSetup.recordById(comsApplications.data, queryParams.recordId)) %>"
          },
          {
            "outboundPath": "active",
            "value": "<% appActiveCheckBox.value == true %>"
          }
        ]
      },
      {
        "name": "postAudit",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "/comsAuditLogs",
        "httpMethod": "POST",
        "authType": "sso",
        "failOnStatusCodes": [
          {
            "code": 400
          },
          {
            "code": 403
          },
          {
            "code": 429
          },
          {
            "code": 500
          }
        ],
        "values": [
          {
            "outboundPath": "timestamp",
            "value": "<% date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\") %>"
          },
          {
            "outboundPath": "objectType",
            "value": "Application Pattern"
          },
          {
            "outboundPath": "action",
            "value": "<% empty(queryParams.recordId) ? 'ADD' : 'UPDATE' %>"
          },
          {
            "outboundPath": "coReferenceId",
            "value": "<% (empty(queryParams.recordId) ? (empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id) : (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'appId': ''}).appId) %>"
          },
          {
            "outboundPath": "coName",
            "value": "<% (empty(queryParams.recordId) ? (empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id) : (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'appId': ''}).appId) %>"
          },
          {
            "outboundPath": "triggeredBy",
            "value": "<% selectedWorker.descriptor ?? '' %>"
          },
          {
            "outboundPath": "changedByWid",
            "value": "<% selectedWorker.id ?? '' %>"
          },
          {
            "outboundPath": "details",
            "value": "<% 'Pattern format for ' + (empty(queryParams.recordId) ? (empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id) : (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'appId': ''}).appId) + ': ' + (formatText.value ?? '').trim() + ' (example ' + (exampleText.value ?? '').trim() + ')' + (appActiveCheckBox.value == true ? '' : ', inactive') %>"
          }
        ]
      }
    ]
  },
  "onSubmit": "<%\n  appIdDropdown.clearError();\n  appNameText.clearError();\n  formatText.clearError();\n  exampleText.clearError();\n  let valid = true;\n  let e1 = comsAppSetup.appIdError((empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id), comsApplications.data, empty(queryParams.recordId));\n  if (e1 != '') { appIdDropdown.setError(e1); valid = false; }\n  let e2 = empty(queryParams.recordId) ? comsAppSetup.nameError((appNameText.value ?? '').trim()) : '';\n  if (e2 != '') { appNameText.setError(e2); valid = false; }\n  let e3 = comsAppSetup.formatError((formatText.value ?? ''));\n  if (e3 != '') { formatText.setError(e3); valid = false; }\n  let e4 = comsAppSetup.exampleError((empty(queryParams.recordId) ? (empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id) : (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'appId': ''}).appId), (exampleText.value ?? ''), (formatText.value ?? ''), comsApplications.data, comsAppSetup.recordById(comsApplications.data, queryParams.recordId));\n  if (e4 != '') { exampleText.setError(e4); valid = false; }\n  valid;\n%>",
  "presentation": {
    "pageType": "EDIT",
    "headerSize": "HIDDEN",
    "cancelOverride": {
      "taskId": "appPatternSetup"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "editAppPatternForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "titleBannerSection",
          "children": [
            {
              "type": "richText",
              "id": "titleBannerRichText",
              "enabled": false,
              "value": "<% '<span style=\"color:#0055B3;font-size:24px\"><b>' + (empty(queryParams.recordId) ? 'ECO-COMS: Add Application' : ('ECO-COMS: Edit Pattern Format · ' + (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'appId': ''}).appId)).replace('<', '&lt;') + '</b></span>' %>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "button",
              "id": "appPatternsBackButton",
              "label": "← Application Patterns",
              "action": "LINK",
              "suppressDiscardDialog": true,
              "taskReference": {
                "taskId": "appPatternSetup"
              }
            },
            {
              "type": "button",
              "id": "shellOrgManagerBackButton",
              "label": "← Shell Org Manager",
              "action": "LINK",
              "suppressDiscardDialog": true,
              "taskReference": {
                "taskId": "shellOrgManager"
              }
            },
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "title": "About This Page",
              "children": [
                {
                  "type": "richText",
                  "id": "aboutRichText",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Write the format as on the list: the prefixes, a colon, then the fields in order, e.g. <b>CP: Subject, Course</b> (several prefixes: <b>COMM / PRIV: Role Name</b>). The example is a full pattern name with one value per field, e.g. <b>X:BPMS(AOC):CP:MECH_V:1*</b>; use * for any. <b>Copy from</b> fills both from another application. A field keeps its rules (allowed characters, hint) from a field of the same name; a new field name gets the Role Name rules. Existing patterns keep their names. An <b>inactive</b> application takes no new patterns.</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "appSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "appFieldSet",
              "title": "Application",
              "children": [
                {
                  "type": "text",
                  "id": "appIdShownText",
                  "label": "Application ID",
                  "enabled": false,
                  "visible": "<% !empty(queryParams.recordId) %>",
                  "value": "<% (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'appId': ''}).appId ?? '' %>"
                },
                {
                  "type": "dropdown",
                  "id": "appIdDropdown",
                  "label": "Application ID",
                  "visible": "<% empty(queryParams.recordId) %>",
                  "required": true,
                  "helpText": "Applications in Workday that aren't set up here yet.",
                  "values": "<% comsAppSetup.newAppOptions(existingOrgs.data, comsApplications.data) %>",
                  "onChange": "<%\n  let e = comsAppSetup.appIdError((empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id), comsApplications.data, empty(queryParams.recordId));\n  if (e != '') { self.setError(e); } else { self.clearError(); }\n  let ee = comsAppSetup.exampleError((empty(queryParams.recordId) ? (empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id) : (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'appId': ''}).appId), (exampleText.value ?? ''), (formatText.value ?? ''), comsApplications.data, comsAppSetup.recordById(comsApplications.data, queryParams.recordId)); if (ee != '') { exampleText.setError(ee); } else { exampleText.clearError(); }\n%>"
                },
                {
                  "type": "richText",
                  "id": "missingAppRichText",
                  "enabled": false,
                  "render": "<% empty(queryParams.recordId) %>",
                  "value": "<span style=\"color:#B45309;font-size:12px;font-weight:700\">⚠ Application not in the list? </span><span style=\"color:#374151;font-size:12px\">The list shows applications that already have an organization in Workday and no pattern format here yet. For a new application, first set it up in Workday:<br><b>1.</b> An organization type named after the application ID (e.g. <b>X:NEWAPP</b>), added by the Workday configuration team.<br><b>2.</b> Its organization: <b>Create Custom Organization</b> with that type, code <b>X:NEWAPP</b> and organization subtype <b>X:META</b>.<br>Then reopen <b>Add Application</b> and pick it. (Add Shell Org adds organizations under an application that already exists, so it can't create this one.)</span>"
                },
                {
                  "type": "text",
                  "id": "appNameText",
                  "label": "Name",
                  "required": "<% empty(queryParams.recordId) %>",
                  "enabled": "<% empty(queryParams.recordId) %>",
                  "value": "<% (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'name': ''}).name ?? '' %>",
                  "onChange": "<%\n  let e = comsAppSetup.nameError((self.value ?? '').trim());\n  if (e != '') { self.setError(e); } else { self.clearError(); }\n%>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "formatSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "formatFieldSet",
              "title": "Pattern Format",
              "children": [
                {
                  "type": "checkBox",
                  "id": "appActiveCheckBox",
                  "label": "Active",
                  "helpText": "Untick to stop new patterns for this application (existing ones stay). Inactive applications are hidden from Add Pattern.",
                  "value": "<% (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'active': true}).active != false %>"
                },
                {
                  "type": "dropdown",
                  "id": "copyFromDropdown",
                  "label": "Copy from",
                  "helpText": "Fills the format and example from another application. You can still change them.",
                  "values": "<% comsAppSetup.copyOptions(comsApplications.data, (empty(queryParams.recordId) ? (empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id) : (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'appId': ''}).appId)) %>",
                  "onChange": "<%\n  if (!empty(self.value)) {\n    formatText.setValue(comsAppSetup.summary(comsAppSetup.recordById(comsApplications.data, copyFromDropdown.selectedEntries[0].id)));\n    exampleText.setValue(comsAppSetup.exampleFor((empty(queryParams.recordId) ? (empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id) : (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'appId': ''}).appId), comsAppSetup.recordById(comsApplications.data, copyFromDropdown.selectedEntries[0].id)));\n  }\n  let ef = comsAppSetup.formatError((formatText.value ?? '')); if (ef != '') { formatText.setError(ef); } else { formatText.clearError(); }\n  let ee = comsAppSetup.exampleError((empty(queryParams.recordId) ? (empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id) : (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'appId': ''}).appId), (exampleText.value ?? ''), (formatText.value ?? ''), comsApplications.data, comsAppSetup.recordById(comsApplications.data, queryParams.recordId)); if (ee != '') { exampleText.setError(ee); } else { exampleText.clearError(); }\n%>"
                },
                {
                  "type": "text",
                  "id": "formatText",
                  "label": "Pattern Format",
                  "required": true,
                  "placeholder": "e.g. CP: Subject, Course",
                  "value": "<% comsAppSetup.summary(comsAppSetup.recordById(comsApplications.data, queryParams.recordId)) %>",
                  "onChange": "<%\n  let ef = comsAppSetup.formatError((formatText.value ?? '')); if (ef != '') { formatText.setError(ef); } else { formatText.clearError(); }\n  let ee = comsAppSetup.exampleError((empty(queryParams.recordId) ? (empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id) : (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'appId': ''}).appId), (exampleText.value ?? ''), (formatText.value ?? ''), comsApplications.data, comsAppSetup.recordById(comsApplications.data, queryParams.recordId)); if (ee != '') { exampleText.setError(ee); } else { exampleText.clearError(); }\n%>"
                },
                {
                  "type": "text",
                  "id": "exampleText",
                  "label": "Example",
                  "required": true,
                  "placeholder": "e.g. X:BPMS(AOC):CP:MECH_V:1*",
                  "value": "<% let r = comsAppSetup.recordById(comsApplications.data, queryParams.recordId); empty(r) ? '' : comsAppSetup.exampleName(r.appId, r) %>",
                  "onChange": "<%\n  let ee = comsAppSetup.exampleError((empty(queryParams.recordId) ? (empty(appIdDropdown.value) ? '' : appIdDropdown.selectedEntries[0].id) : (comsAppSetup.recordById(comsApplications.data, queryParams.recordId) ?? {'appId': ''}).appId), (exampleText.value ?? ''), (formatText.value ?? ''), comsApplications.data, comsAppSetup.recordById(comsApplications.data, queryParams.recordId)); if (ee != '') { exampleText.setError(ee); } else { exampleText.clearError(); }\n%>"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}
