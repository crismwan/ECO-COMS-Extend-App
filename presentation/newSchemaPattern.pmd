                  "label": "<% comsPatterns.fieldLabel(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), 6) %>",
                  "visible": "<% comsPatterns.fieldCount(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) > 6 %>",
                  "placeholder": "<% comsPatterns.fieldCount(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) > 6 ? ('e.g. ' + comsPatterns.schemaFor(comsApplications.data, queryParams.appCode).fields[6].example) : '' %>",
                  "onChange": "<%\n  let s = comsPatterns.schemaFor(comsApplications.data, queryParams.appCode);\n  let err = comsPatterns.checkField(s, 6, self.value);\n  if (err != '') { self.setError(err); } else { self.clearError(); }\n  let pn = comsPatterns.buildName((queryParams.appCode ?? ''), (comsPatterns.prefixCount(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) > 1 ? (empty(prefixDropdown.value) ? '' : prefixDropdown.selectedEntries[0].id) : comsPatterns.firstPrefix(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode))), comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), [patternField1Text.value, patternField2Text.value, patternField3Text.value, patternField4Text.value, patternField5Text.value, patternField6Text.value, patternField7Text.value]);\n  patternPreviewText.setValue(pn);\n  if (err == '' && (existingOrgs.data ?? []).filter(o => { o.code == pn }).size() > 0) {\n    self.setError('A pattern with this name already exists: ' + pn);\n  }\n%>"
                },
                {
                  "type": "date",
                  "id": "effectiveDate",
                  "label": "Effective Date",
                  "required": true,
                  "onChange": "<%\n  if (empty(self.value)) { self.clearError(); }\n  else if (!comsValidations.isWeekday(self.value)) { self.setError(comsValidations.errorWeekday()); }\n  else if (!comsValidations.isCurrentOrFutureYear(self.value)) { self.setError(comsValidations.errorYear()); }\n  else { self.clearError(); }\n%>"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "EDIT"
  }
}
