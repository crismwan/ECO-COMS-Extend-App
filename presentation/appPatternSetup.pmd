{
  "id": "appPatternSetup",
  "securityDomains": [
    "ManageCOMSApplicationSetup"
  ],
  "include": [
    "comsAppSetup.script"
  ],
  "endPoints": [
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications?limit=100",
      "authType": "sso",
      "isCollection": true,
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    }
  ],
  "presentation": {
    "pageType": "VIEW",
    "headerSize": "HIDDEN",
    "body": {
      "type": "basicFormLayout",
      "id": "appPatternSetupForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "titleBannerSection",
          "children": [
            {
              "type": "richText",
              "id": "titleBannerRichText",
              "enabled": false,
              "value": "<span style=\"color:#0055B3;font-size:24px\"><b>ECO-COMS: Application Patterns</b></span><br><span style=\"color:#374151;font-size:13px\">Each application&#39;s pattern format: the prefixes and fields the Add Shell Org Pattern form uses.</span>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "button",
              "id": "shellOrgManagerButton",
              "label": "← Shell Org Manager",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "LINK"
            },
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK"
            },
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "title": "About This Page",
              "children": [
                {
                  "type": "richText",
                  "id": "aboutRichText",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Each application's shell org pattern format: its prefixes and its fields. The <b>Add Shell Org Pattern</b> form reads these, so a change here shows up there straight away. <b>Edit</b> changes an application's format; <b>Add Application</b> sets up one that isn't listed yet. Existing patterns keep their names; a new format only applies to new patterns.</span>"
                }
              ],
              "collapsible": true,
              "initializeCollapsed": true
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "appsSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "appsFieldSet",
              "title": "Applications",
              "children": [
                {
                  "type": "button",
                  "id": "addApplicationButton",
                  "label": "Add Application",
                  "action": "PRIMARY",
                  "taskReference": {
                    "taskId": "editAppPattern"
                  }
                },
                {
                  "type": "grid",
                  "id": "appPatternsGrid",
                  "label": "Application Pattern Formats",
                  "rowVariableName": "ap",
                  "readOnly": true,
                  "rows": "<% list:sort((comsApplications.data ?? []).filter(a => { !empty(a.appId) }), 'appId', true) %>",
                  "columns": [
                    {
                      "type": "column",
                      "columnId": "colAppId",
                      "label": "Application ID",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "id": "colAppIdText",
                        "enabled": false,
                        "value": "<% ap.appId ?? '' %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colAppName",
                      "label": "Name",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "id": "colAppNameText",
                        "enabled": false,
                        "value": "<% ap.name ?? '' %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colFormat",
                      "label": "Pattern Format",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "id": "colFormatText",
                        "enabled": false,
                        "value": "<% comsAppSetup.summary(ap) %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colExample",
                      "label": "Example",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "id": "colExampleText",
                        "enabled": false,
                        "value": "<% comsAppSetup.exampleOf(ap.appId, ap) %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colActive",
                      "label": "Status",
                      "sortableAndFilterable": "true",
                      "cellTemplate": {
                        "type": "text",
                        "id": "colActiveText",
                        "enabled": false,
                        "value": "<% ap.active == false ? 'Inactive' : 'Active' %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colEdit",
                      "label": "Edit",
                      "cellTemplate": {
                        "type": "button",
                        "id": "editAppButton",
                        "label": "Edit",
                        "action": "AUXILIARY",
                        "taskReference": {
                          "taskId": "editAppPattern",
                          "parameterBindings": {
                            "recordId": "<% ap.id %>"
                          }
                        }
                      },
                      "excel": {
                        "enabled": false
                      }
                    }
                  ],
                  "gridType": "LIST",
                  "multiViewStylingEnabled": true,
                  "autoPaging": true,
                  "excelExportEnabled": true
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}
