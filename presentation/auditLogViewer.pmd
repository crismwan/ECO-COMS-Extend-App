{
  "id": "auditLogViewer",
  "securityDomains": [
    "ViewCOMSAuditLog"
  ],
  "endPoints": [
    {
      "name": "auditLogs",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAuditLogs",
      "authType": "sso",
      "isCollection": true
    }
  ],
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ECO-COMS: Audit Log Viewer",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "auditLogViewerForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "children": [
                {
                  "type": "richText",
                  "id": "pageDescriptionText",
                  "value": "<span style=\"color:#374151;font-size:12px\">Log of every change made through ECO-COMS: shell orgs and patterns added, org status changes, role position assignments, and assignable role requests, approvals and deletions. A record is written only when Workday accepts the change. Newest first.</span>",
                  "enabled": false
                }
              ],
              "title": "About this page"
            }
          ]
        }
      ]
    },
    "tabs": [
      {
        "type": "section",
        "label": "Audit Log",
        "children": [
          {
            "type": "grid",
            "gridType": "LIST",
            "multiViewStylingEnabled": true,
            "id": "AuditLogGrid",
            "autoPaging": true,
            "rows": "<% list:sort(auditLogs.data ?? [], 'timestamp', false) %>",
            "rowVariableName": "logEntry",
            "enabled": false,
            "label": "Audit Log",
            "columns": [
              {
                "type": "column",
                "id": "columnTimestamp",
                "columnId": "columnTimestamp",
                "label": "Timestamp",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.timestamp ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnChangeType",
                "columnId": "columnChangeType",
                "label": "Change Type",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.objectType ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnAction",
                "columnId": "columnAction",
                "label": "Action",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.action ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnOrganization",
                "columnId": "columnOrganization",
                "label": "Organization",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.coName ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnRole",
                "columnId": "columnRole",
                "label": "Role",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.roleName ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnPosition",
                "columnId": "columnPosition",
                "label": "Position",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.positionName ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnEffectiveDate",
                "columnId": "columnEffectiveDate",
                "label": "Effective Date",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.effectiveDate ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnChangedBy",
                "columnId": "columnChangedBy",
                "label": "Changed By",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.triggeredBy ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnDetails",
                "columnId": "columnDetails",
                "label": "Details",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.details ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              }
            ]
          },
          {
            "type": "richText",
            "id": "exportNote",
            "enabled": false,
            "value": "<span style=\"color:#0055B7;font-size:11px;font-weight:700\">ℹ </span><span style=\"color:#374151;font-size:11px\">Use the grid’s built-in export action to download these results as CSV for compliance reporting.</span>"
          }
        ]
      }
    ],
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "VIEW"
  }
}