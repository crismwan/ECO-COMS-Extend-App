{
  "id": "auditLogViewer",
  "securityDomains": [
    "ViewCOMSAuditLog"
  ],
  "include": [
    "comsAuditFilters.script"
  ],
  "endPoints": [
    {
      "name": "auditLogCount",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAuditLogs?limit=1",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "auditPage0",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "<% let t = auditLogCount.total ?? 0; let start = (t - 100) < 0 ? 0 : (t - 100); let cnt = t - 0 - start; '/comsAuditLogs?limit=' + (cnt > 0 ? cnt : 1) + '&offset=' + (cnt > 0 ? start : t) %>",
      "authType": "sso",
      "isCollection": true,
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "auditPage1",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "<% let t = auditLogCount.total ?? 0; let start = (t - 200) < 0 ? 0 : (t - 200); let cnt = t - 100 - start; '/comsAuditLogs?limit=' + (cnt > 0 ? cnt : 1) + '&offset=' + (cnt > 0 ? start : t) %>",
      "authType": "sso",
      "isCollection": true,
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ]
    },
    {
      "name": "auditPage2",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "<% let t = auditLogCount.total ?? 0; let start = (t - 300) < 0 ? 0 : (t - 300); let cnt = t - 200 - start; '/comsAuditLogs?limit=' + (cnt > 0 ? cnt : 1) + '&offset=' + (cnt > 0 ? start : t) %>",
      "authType": "sso",
      "isCollection": true,
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ]
    },
    {
      "name": "auditPage3",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "<% let t = auditLogCount.total ?? 0; let start = (t - 400) < 0 ? 0 : (t - 400); let cnt = t - 300 - start; '/comsAuditLogs?limit=' + (cnt > 0 ? cnt : 1) + '&offset=' + (cnt > 0 ? start : t) %>",
      "authType": "sso",
      "isCollection": true,
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ]
    },
    {
      "name": "auditPage4",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "<% let t = auditLogCount.total ?? 0; let start = (t - 500) < 0 ? 0 : (t - 500); let cnt = t - 400 - start; '/comsAuditLogs?limit=' + (cnt > 0 ? cnt : 1) + '&offset=' + (cnt > 0 ? start : t) %>",
      "authType": "sso",
      "isCollection": true,
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ]
    },
    {
      "name": "allShellOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellOrgs"
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "shellRoles",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellAssignableRolesinTenant"
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "aaaRoles",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allAAArolesinTenant"
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    }
  ],
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ECO-COMS: Audit Log Viewer",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "auditLogViewerForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "children": [
                {
                  "type": "richText",
                  "id": "pageDescriptionText",
                  "value": "<span style=\"color:#374151;font-size:12px\">Every change made through ECO-COMS: shell orgs and patterns added, org status changes, role position assignments, and assignable role requests, approvals and denials. A record is written only after Workday accepts the change. Newest first. Use the buttons below to narrow the list, and the grid's export action to download what is shown. The page loads the newest 500 records.</span>",
                  "enabled": false
                }
              ],
              "title": "About This Page"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "auditFilterSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "auditShowFieldSet",
              "title": "Show",
              "children": [
                {
                  "type": "text",
                  "id": "auditCountText",
                  "label": "Showing",
                  "enabled": false,
                  "value": "<% '' + size(comsAuditFilters.filterLogs(list:flatten([auditPage0.data ?? [], auditPage1.data ?? [], auditPage2.data ?? [], auditPage3.data ?? [], auditPage4.data ?? []]), queryParams.period ?? '', queryParams.changeType ?? '')) + ' of ' + (auditLogCount.total ?? 0) + ' records (' + comsAuditFilters.periodLabel(queryParams.period ?? '') + (empty(queryParams.changeType) ? '' : ', ' + queryParams.changeType) + ')' + ((auditLogCount.total ?? 0) > 500 ? '. Only the newest 500 are loaded.' : '') %>"
                }
              ]
            },
            {
              "type": "cardContainer",
              "id": "auditFilterCardContainer",
              "layout": "grid",
              "cards": [
                {
                  "type": "card",
                  "cardId": "AuditPeriodPillCard",
                  "parameters": "<% { 'period': queryParams.period ?? '', 'changeType': queryParams.changeType ?? '' } %>"
                },
                {
                  "type": "card",
                  "cardId": "AuditTypePillCard",
                  "parameters": "<% { 'period': queryParams.period ?? '', 'changeType': queryParams.changeType ?? '' } %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "auditChartSection",
          "children": [
            {
              "type": "cardContainer",
              "id": "auditChartCardContainer",
              "cards": [
                {
                  "type": "card",
                  "cardId": "AuditActionChart",
                  "parameters": "<% let f = comsAuditFilters.filterLogs(list:flatten([auditPage0.data ?? [], auditPage1.data ?? [], auditPage2.data ?? [], auditPage3.data ?? [], auditPage4.data ?? []]), queryParams.period ?? '', queryParams.changeType ?? ''); { 'addCount': comsAuditFilters.countAction(f, 'ADD'), 'inactivateCount': comsAuditFilters.countAction(f, 'INACTIVATE'), 'reactivateCount': comsAuditFilters.countAction(f, 'REACTIVATE'), 'assignCount': comsAuditFilters.countAction(f, 'ASSIGN POSITION'), 'removeCount': comsAuditFilters.countAction(f, 'REMOVE POSITION'), 'requestCount': comsAuditFilters.countAction(f, 'REQUEST'), 'approveCount': comsAuditFilters.countAction(f, 'APPROVE'), 'denyCount': comsAuditFilters.countAction(f, 'DENY'), 'deleteCount': comsAuditFilters.countAction(f, 'DELETE'), 'totalText': '' + size(f) + ' records, ' + comsAuditFilters.periodLabel(queryParams.period ?? '') } %>"
                }
              ]
            }
          ]
        }
      ]
    },
    "tabs": [
      {
        "type": "section",
        "label": "Audit Log",
        "children": [
          {
            "type": "grid",
            "gridType": "LIST",
            "multiViewStylingEnabled": true,
            "id": "AuditLogGrid",
            "autoPaging": true,
            "rows": "<% let logs = comsAuditFilters.filterLogs(list:flatten([auditPage0.data ?? [], auditPage1.data ?? [], auditPage2.data ?? [], auditPage3.data ?? [], auditPage4.data ?? []]), queryParams.period ?? '', queryParams.changeType ?? ''); let codes = logs.filter(e => { empty(e.orgWid) && !empty(e.coName) }).map(e => { e.coName }); let names = logs.filter(e => { empty(e.roleWid) && !empty(e.roleName) }).map(e => { e.roleName }); let orgs = size(codes) == 0 ? [] : (allShellOrgs.data ?? []).filter(o => { !empty(o.organizationByName) && codes.contains(o.code) }).map(o => { { 'code': o.code, 'id': o.organizationByName.id } }); let roles = size(names) == 0 ? [] : list:flatten([shellRoles.data ?? [], aaaRoles.data ?? []]).filter(r => { !empty(r.role) && names.contains(r.role.descriptor) }).map(r => { { 'name': r.role.descriptor, 'id': r.role.id } }); list:sort(logs, 'timestamp', false).map(e => { let om = empty(e.orgWid) ? orgs.filter(o => { o.code == (e.coName ?? '') }) : []; let rm = empty(e.roleWid) ? roles.filter(r => { r.name == (e.roleName ?? '') }) : []; { 'timestamp': e.timestamp ?? '', 'objectType': e.objectType ?? '', 'action': e.action ?? '', 'coName': e.coName ?? '', 'roleName': e.roleName ?? '', 'positionName': e.positionName ?? '', 'effectiveDate': e.effectiveDate ?? '', 'triggeredBy': e.triggeredBy ?? '', 'details': e.details ?? '', 'changedByWid': e.changedByWid ?? '', 'positionWid': e.positionWid ?? '', 'orgWid': !empty(e.orgWid) ? e.orgWid : (size(om) > 0 ? om[0].id : ''), 'roleWid': !empty(e.roleWid) ? e.roleWid : (size(rm) > 0 ? rm[0].id : '') } }) %>",
            "rowVariableName": "logEntry",
            "enabled": false,
            "label": "<% 'Audit Log (' + size(comsAuditFilters.filterLogs(list:flatten([auditPage0.data ?? [], auditPage1.data ?? [], auditPage2.data ?? [], auditPage3.data ?? [], auditPage4.data ?? []]), queryParams.period ?? '', queryParams.changeType ?? '')) + ')' %>",
            "columns": [
              {
                "type": "column",
                "id": "columnTimestamp",
                "columnId": "columnTimestamp",
                "label": "Timestamp",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% (logEntry.timestamp ?? '').replace('T', ' ').replace('Z', ' UTC') %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnChangeType",
                "columnId": "columnChangeType",
                "label": "Change Type",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.objectType ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnAction",
                "columnId": "columnAction",
                "label": "Action",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.action ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnOrganization",
                "columnId": "columnOrganization",
                "label": "Organization",
                "cellTemplate": {
                  "type": "fieldSet",
                  "id": "organizationFieldSet",
                  "children": [
                    {
                      "type": "instanceList",
                      "id": "organizationInstanceList",
                      "view": true,
                      "relatedTask": true,
                      "enabled": false,
                      "visible": "<% !empty(logEntry.orgWid) %>",
                      "values": "<% empty(logEntry.orgWid) ? [] : [{'id': logEntry.orgWid, 'descriptor': logEntry.coName ?? ''}] %>",
                      "widKey": "id"
                    },
                    {
                      "type": "text",
                      "id": "organizationText",
                      "enabled": false,
                      "visible": "<% empty(logEntry.orgWid) %>",
                      "value": "<% logEntry.coName ?? '' %>"
                    }
                  ]
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnRole",
                "columnId": "columnRole",
                "label": "Role",
                "cellTemplate": {
                  "type": "fieldSet",
                  "id": "roleFieldSet",
                  "children": [
                    {
                      "type": "instanceList",
                      "id": "roleInstanceList",
                      "view": true,
                      "relatedTask": true,
                      "enabled": false,
                      "visible": "<% !empty(logEntry.roleWid) %>",
                      "values": "<% empty(logEntry.roleWid) ? [] : [{'id': logEntry.roleWid, 'descriptor': logEntry.roleName ?? ''}] %>",
                      "widKey": "id"
                    },
                    {
                      "type": "text",
                      "id": "roleText",
                      "enabled": false,
                      "visible": "<% empty(logEntry.roleWid) %>",
                      "value": "<% logEntry.roleName ?? '' %>"
                    }
                  ]
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnPosition",
                "columnId": "columnPosition",
                "label": "Position",
                "cellTemplate": {
                  "type": "fieldSet",
                  "id": "positionFieldSet",
                  "children": [
                    {
                      "type": "instanceList",
                      "id": "positionInstanceList",
                      "view": true,
                      "relatedTask": true,
                      "enabled": false,
                      "visible": "<% !empty(logEntry.positionWid) %>",
                      "values": "<% empty(logEntry.positionWid) ? [] : logEntry.positionWid.splitByRegex(',').map((pid, i) => { { 'id': pid.trim(), 'descriptor': (!empty(logEntry.positionName) && logEntry.positionName.splitByRegex(', (?=P-[0-9])').size() > i) ? logEntry.positionName.splitByRegex(', (?=P-[0-9])')[i] : pid.trim() } }) %>",
                      "widKey": "id",
                      "multiSelect": true
                    },
                    {
                      "type": "text",
                      "id": "positionText",
                      "enabled": false,
                      "visible": "<% empty(logEntry.positionWid) %>",
                      "value": "<% logEntry.positionName ?? '' %>"
                    }
                  ]
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnEffectiveDate",
                "columnId": "columnEffectiveDate",
                "label": "Effective Date",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.effectiveDate ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnChangedBy",
                "columnId": "columnChangedBy",
                "label": "Changed By",
                "cellTemplate": {
                  "type": "fieldSet",
                  "id": "changedByFieldSet",
                  "children": [
                    {
                      "type": "instanceList",
                      "id": "changedByInstanceList",
                      "view": true,
                      "relatedTask": true,
                      "enabled": false,
                      "visible": "<% !empty(logEntry.changedByWid) %>",
                      "values": "<% empty(logEntry.changedByWid) ? [] : [{'id': logEntry.changedByWid, 'descriptor': logEntry.triggeredBy ?? ''}] %>",
                      "widKey": "id"
                    },
                    {
                      "type": "text",
                      "id": "changedByText",
                      "enabled": false,
                      "visible": "<% empty(logEntry.changedByWid) %>",
                      "value": "<% logEntry.triggeredBy ?? '' %>"
                    }
                  ]
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnDetails",
                "columnId": "columnDetails",
                "label": "Details",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.details ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              }
            ],
            "excelExportEnabled": true
          },
          {
            "type": "richText",
            "id": "exportNote",
            "enabled": false,
            "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Use the grid’s built-in export action to download these results as CSV for compliance reporting.</span>"
          }
        ]
      }
    ],
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "VIEW"
  }
}
