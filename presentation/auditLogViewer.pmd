{
  "id": "auditLogViewer",
  "securityDomains": [
    "ViewCOMSAuditLog"
  ],
  "endPoints": [
    {
      "name": "auditLogs",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAuditLogs",
      "authType": "sso",
      "isCollection": true
    }
  ],
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ECO-COMS: Audit Log Viewer",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "auditLogViewerForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "children": [
                {
                  "type": "richText",
                  "id": "pageDescriptionText",
                  "value": "<span style=\"color:#374151;font-size:12px\">Immutable, searchable log of every COMS-initiated Custom Organization change. Records are created automatically when shell organizations or patterns are added, and when their status is changed. Records cannot be deleted.</span>",
                  "enabled": false
                }
              ],
              "title": "About this page"
            }
          ]
        }
      ]
    },
    "tabs": [
      {
        "type": "section",
        "label": "Audit Log",
        "children": [
          {
            "type": "grid",
            "gridType": "LIST",
            "multiViewStylingEnabled": true,
            "id": "AuditLogGrid",
            "autoPaging": true,
            "rows": "<% auditLogs.data %>",
            "rowVariableName": "logEntry",
            "enabled": false,
            "label": "Audit Log",
            "columns": [
              {
                "type": "column",
                "id": "columnTimestamp",
                "columnId": "columnTimestamp",
                "label": "Timestamp",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.timestamp ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnObjectType",
                "columnId": "columnObjectType",
                "label": "Object Type",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.objectType ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnAction",
                "columnId": "columnAction",
                "label": "Action",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.action ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnCoReferenceId",
                "columnId": "columnCoReferenceId",
                "label": "CO Reference ID",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.coReferenceId ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnCoName",
                "columnId": "columnCoName",
                "label": "CO Name",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.coName ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnWorker",
                "columnId": "columnWorker",
                "label": "Worker",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% !empty(logEntry.worker) ? (logEntry.worker.descriptor ?? '') : '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnApplication",
                "columnId": "columnApplication",
                "label": "Application",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% !empty(logEntry.application) ? (logEntry.application.descriptor ?? '') : '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnTriggeredBy",
                "columnId": "columnTriggeredBy",
                "label": "Triggered By",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.triggeredBy ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnDetails",
                "columnId": "columnDetails",
                "label": "Details",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.details ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              }
            ]
          },
          {
            "type": "richText",
            "id": "exportNote",
            "enabled": false,
            "value": "<span style=\"color:#0055B7;font-size:11px;font-weight:700\">ℹ </span><span style=\"color:#374151;font-size:11px\">Use the grid’s built-in export action to download these results as CSV for compliance reporting.</span>"
          }
        ]
      }
    ],
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "VIEW"
  }
}
