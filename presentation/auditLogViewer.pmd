{
  "id": "auditLogViewer",
  "securityDomains": [
    "ViewCOMSAuditLog"
  ],
  "endPoints": [
    {
      "name": "auditLogs",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsAuditLogs",
      "authType": "sso",
      "isCollection": true
    },
    {
      "name": "allShellOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellOrgs"
      }
    },
    {
      "name": "shellRoles",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellAssignableRolesinTenant"
      }
    }
  ],
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "ECO-COMS: Audit Log Viewer",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "auditLogViewerForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "label": "← Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "children": [
                {
                  "type": "richText",
                  "id": "pageDescriptionText",
                  "value": "<span style=\"color:#374151;font-size:12px\">Log of every change made through ECO-COMS: shell orgs and patterns added, org status changes, role position assignments, and assignable role requests, approvals and deletions. A record is written only when Workday accepts the change. Newest first.</span>",
                  "enabled": false
                }
              ],
              "title": "About this page"
            }
          ]
        }
      ]
    },
    "tabs": [
      {
        "type": "section",
        "label": "Audit Log",
        "children": [
          {
            "type": "grid",
            "gridType": "LIST",
            "multiViewStylingEnabled": true,
            "id": "AuditLogGrid",
            "autoPaging": true,
            "rows": "<% let logs = auditLogs.data ?? []; let codes = logs.filter(e => { empty(e.orgWid) && !empty(e.coName) }).map(e => { e.coName }); let names = logs.filter(e => { empty(e.roleWid) && !empty(e.roleName) }).map(e => { e.roleName }); let orgs = size(codes) == 0 ? [] : (allShellOrgs.data ?? []).filter(o => { !empty(o.organizationByName) && codes.contains(o.code) }).map(o => { { 'code': o.code, 'id': o.organizationByName.id } }); let roles = size(names) == 0 ? [] : (shellRoles.data ?? []).filter(r => { !empty(r.role) && names.contains(r.role.descriptor) }).map(r => { { 'name': r.role.descriptor, 'id': r.role.id } }); list:sort(logs, 'timestamp', false).map(e => { let om = empty(e.orgWid) ? orgs.filter(o => { o.code == (e.coName ?? '') }) : []; let rm = empty(e.roleWid) ? roles.filter(r => { r.name == (e.roleName ?? '') }) : []; { 'timestamp': e.timestamp ?? '', 'objectType': e.objectType ?? '', 'action': e.action ?? '', 'coName': e.coName ?? '', 'roleName': e.roleName ?? '', 'positionName': e.positionName ?? '', 'effectiveDate': e.effectiveDate ?? '', 'triggeredBy': e.triggeredBy ?? '', 'details': e.details ?? '', 'changedByWid': e.changedByWid ?? '', 'positionWid': e.positionWid ?? '', 'orgWid': !empty(e.orgWid) ? e.orgWid : (size(om) > 0 ? om[0].id : ''), 'roleWid': !empty(e.roleWid) ? e.roleWid : (size(rm) > 0 ? rm[0].id : '') } }) %>",
            "rowVariableName": "logEntry",
            "enabled": false,
            "label": "Audit Log",
            "columns": [
              {
                "type": "column",
                "id": "columnTimestamp",
                "columnId": "columnTimestamp",
                "label": "Timestamp",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.timestamp ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnChangeType",
                "columnId": "columnChangeType",
                "label": "Change Type",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.objectType ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnAction",
                "columnId": "columnAction",
                "label": "Action",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.action ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnOrganization",
                "columnId": "columnOrganization",
                "label": "Organization",
                "cellTemplate": {
                  "type": "fieldSet",
                  "id": "organizationFieldSet",
                  "children": [
                    {
                      "type": "instanceList",
                      "id": "organizationInstanceList",
                      "view": true,
                      "relatedTask": true,
                      "enabled": false,
                      "visible": "<% !empty(logEntry.orgWid) %>",
                      "values": "<% empty(logEntry.orgWid) ? [] : [{'id': logEntry.orgWid, 'descriptor': logEntry.coName ?? ''}] %>",
                      "widKey": "id"
                    },
                    {
                      "type": "text",
                      "id": "organizationText",
                      "enabled": false,
                      "visible": "<% empty(logEntry.orgWid) %>",
                      "value": "<% logEntry.coName ?? '' %>"
                    }
                  ]
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnRole",
                "columnId": "columnRole",
                "label": "Role",
                "cellTemplate": {
                  "type": "fieldSet",
                  "id": "roleFieldSet",
                  "children": [
                    {
                      "type": "instanceList",
                      "id": "roleInstanceList",
                      "view": true,
                      "relatedTask": true,
                      "enabled": false,
                      "visible": "<% !empty(logEntry.roleWid) %>",
                      "values": "<% empty(logEntry.roleWid) ? [] : [{'id': logEntry.roleWid, 'descriptor': logEntry.roleName ?? ''}] %>",
                      "widKey": "id"
                    },
                    {
                      "type": "text",
                      "id": "roleText",
                      "enabled": false,
                      "visible": "<% empty(logEntry.roleWid) %>",
                      "value": "<% logEntry.roleName ?? '' %>"
                    }
                  ]
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnPosition",
                "columnId": "columnPosition",
                "label": "Position",
                "cellTemplate": {
                  "type": "fieldSet",
                  "id": "positionFieldSet",
                  "children": [
                    {
                      "type": "instanceList",
                      "id": "positionInstanceList",
                      "view": true,
                      "relatedTask": true,
                      "enabled": false,
                      "visible": "<% !empty(logEntry.positionWid) %>",
                      "values": "<% empty(logEntry.positionWid) ? [] : [{'id': logEntry.positionWid, 'descriptor': logEntry.positionName ?? ''}] %>",
                      "widKey": "id"
                    },
                    {
                      "type": "text",
                      "id": "positionText",
                      "enabled": false,
                      "visible": "<% empty(logEntry.positionWid) %>",
                      "value": "<% logEntry.positionName ?? '' %>"
                    }
                  ]
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnEffectiveDate",
                "columnId": "columnEffectiveDate",
                "label": "Effective Date",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.effectiveDate ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnChangedBy",
                "columnId": "columnChangedBy",
                "label": "Changed By",
                "cellTemplate": {
                  "type": "fieldSet",
                  "id": "changedByFieldSet",
                  "children": [
                    {
                      "type": "instanceList",
                      "id": "changedByInstanceList",
                      "view": true,
                      "relatedTask": true,
                      "enabled": false,
                      "visible": "<% !empty(logEntry.changedByWid) %>",
                      "values": "<% empty(logEntry.changedByWid) ? [] : [{'id': logEntry.changedByWid, 'descriptor': logEntry.triggeredBy ?? ''}] %>",
                      "widKey": "id"
                    },
                    {
                      "type": "text",
                      "id": "changedByText",
                      "enabled": false,
                      "visible": "<% empty(logEntry.changedByWid) %>",
                      "value": "<% logEntry.triggeredBy ?? '' %>"
                    }
                  ]
                },
                "sortableAndFilterable": "true"
              },
              {
                "type": "column",
                "id": "columnDetails",
                "columnId": "columnDetails",
                "label": "Details",
                "cellTemplate": {
                  "type": "text",
                  "value": "<% logEntry.details ?? '' %>",
                  "enabled": false
                },
                "sortableAndFilterable": "true"
              }
            ]
          },
          {
            "type": "richText",
            "id": "exportNote",
            "enabled": false,
            "value": "<span style=\"color:#0055B7;font-size:11px;font-weight:700\">ℹ </span><span style=\"color:#374151;font-size:11px\">Use the grid’s built-in export action to download these results as CSV for compliance reporting.</span>"
          }
        ]
      }
    ],
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "pageType": "VIEW"
  }
}