{
  "id": "manageRolePositions",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "endPoints": [],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "updateRolePositions",
        "baseUrlType": "BUSINESS-OBJECT",
        "url": "<% '/roleAssignments/' + (queryParams.roleId ?? '') %>",
        "authType": "sso",
        "httpMethod": "PATCH",
        "onSend": "<% {} %>",
        "headers": [
          {
            "name": "content-type",
            "value": "application/json"
          }
        ],
        "values": [
          {
            "outboundPath": "cf_ZCF_EE_RoleAssignedToAsPositionRestrictions",
            "value": "<% [] %>"
          }
        ],
        "failOnStatusCodes": [
          { "code": 400 },
          { "code": 403 },
          { "code": 404 },
          { "code": 500 }
        ]
      }
    ],
    "responseErrorDetail": {
      "errorSummary": "<% error ?? '' %>"
    },
    "successPage": {
      "taskId": "shellOrgManager",
      "parameterBindings": {
        "appCode": "<% queryParams.appCode %>",
        "appName": "<% queryParams.appName %>"
      }
    }
  },
  "presentation": {
    "headerSize": "STANDARD",
    "pageType": "edit",
    "standardEditButtonsHidden": false,
    "title": {
      "type": "title",
      "label": "<% 'Manage Positions: ' + (queryParams.roleName ?? 'Role Assignment') %>",
      "enabled": true
    },
    "body": {
      "type": "basicFormLayout",
      "id": "manageRolePositionsForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "section",
              "id": "navBarSection",
              "horizontal": false,
              "layout": {
                "density": "high",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "button",
                  "id": "backToShellOrgManagerBtn",
                  "label": "← Shell Org Manager",
                  "taskReference": {
                    "taskId": "shellOrgManager",
                    "parameterBindings": {
                      "appCode": "<% queryParams.appCode %>",
                      "appName": "<% queryParams.appName %>"
                    }
                  },
                  "action": "LINK",
                  "suppressDiscardDialog": true
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "detailsSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "assignmentDetailsFieldSet",
              "title": "Role Assignment Details",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "fixed",
                "labelPosition": "side_align_left"
              },
              "children": [
                {
                  "type": "readOnlyText",
                  "id": "roleNameDisplay",
                  "label": "Role",
                  "value": "<% queryParams.roleName ?? '' %>"
                },
                {
                  "type": "readOnlyText",
                  "id": "orgDescriptorDisplay",
                  "label": "Organization",
                  "value": "<% queryParams.orgDescriptor ?? '' %>"
                },
                {
                  "type": "readOnlyText",
                  "id": "appDisplay",
                  "label": "Application",
                  "value": "<% !empty(queryParams.appName) ? queryParams.appName : (!empty(queryParams.appCode) ? queryParams.appCode : 'All Applications') %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "positionsSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "positionsFieldSet",
              "title": "Position Restrictions",
              "layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              },
              "children": [
                {
                  "type": "richText",
                  "id": "positionsNote",
                  "enabled": false,
                  "value": "<span style=\"color:#374151;font-size:12px\">Position restrictions limit this role assignment to specific positions. When no positions are set, the assignment applies to all positions within the organization.</span>"
                },
                {
                  "type": "richText",
                  "id": "pendingNote",
                  "enabled": false,
                  "value": "<span style=\"color:#d97706;font-size:11px;font-weight:700\">⚠ </span><span style=\"color:#92400e;font-size:11px\"><b>Backend pending:</b> The position update endpoint (<code>/roleAssignments/{roleId}</code> PATCH) is not yet implemented. Saving will have no effect until the backend is wired up. This form is ready for integration.</span>"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}
