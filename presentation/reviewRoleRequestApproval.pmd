{
  "id": "reviewRoleRequestApproval",
  "securityDomains": [
    "MaintainCOMSAssignableRoles"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 404
        },
        {
          "code": 500
        }
      ]
    },
    {
      "name": "bpEvent",
      "baseUrlType": "workday-bp",
      "url": "<% 'events/' + queryParams.eventId %>",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 404
        },
        {
          "code": 500
        }
      ]
    },
    {
      "name": "request",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "<% '/comsAssignableRoles/' + bpEvent.for.id %>",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 404
        },
        {
          "code": 500
        }
      ]
    },
    {
      "name": "positions",
      "baseUrlType": "workday-staffing-v6",
      "url": "jobs?limit=100",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 404
        },
        {
          "code": 500
        }
      ],
      "isCollection": true,
      "bestEffort": "true"
    }
  ],
  "presentation": {
    "pageType": "VIEW",
    "title": {
      "type": "title",
      "label": "Review COMS Assignable Role Request"
    },
    "headerSize": "STANDARD",
    "body": {
      "type": "basicFormLayout",
      "id": "reviewForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "progressSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "progressFieldSet",
              "title": "Step 2 of 5: Approve / Deny",
              "children": [
                {
                  "type": "richText",
                  "id": "progressRichText",
                  "enabled": false,
                  "value": "<% '<span style=\"font-size:12px\"><span style=\"color:#6B7280\">1. Role Details</span> &nbsp;→&nbsp; <span style=\"font-weight:700;color:#0055B7\">2. Approve / Deny</span> &nbsp;→&nbsp; <span style=\"color:#6B7280\">3. Add Assignable Role</span> &nbsp;→&nbsp; <span style=\"color:#6B7280\">4. Create Role-Based Security Group</span> &nbsp;→&nbsp; <span style=\"color:#6B7280\">5. Link Workday Role</span></span>' %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "approvalHelpSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "approvalHelpFieldSet",
              "title": "What happens next",
              "children": [
                {
                  "type": "richText",
                  "id": "approvalHelpRichText",
                  "enabled": false,
                  "value": "<% '<span style=\"color:#374151;font-size:13px\">ⓘ Approve sends the request to the To Dos (Add Assignable Role, Create Role-Based Security Group), then Link Workday Role. Deny ends the process and marks the request Denied.</span>' %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "detailSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "roleDetailFieldSet",
              "title": "Role Request Details",
              "children": [
                {
                  "type": "text",
                  "id": "roleNameText",
                  "label": "Role Name",
                  "enabled": false,
                  "value": "<% request.roleName ?? '' %>"
                },
                {
                  "type": "text",
                  "id": "applicationText",
                  "label": "Application / Organization",
                  "enabled": false,
                  "value": "<% request.shellOrgCode ?? (request.application ?? '') %>"
                },
                {
                  "type": "text",
                  "id": "enabledForText",
                  "label": "Enabled For",
                  "enabled": false,
                  "value": "<% request.enabledForOrganizationTypes ?? '' %>"
                },
                {
                  "type": "text",
                  "id": "positionsText",
                  "label": "Positions",
                  "enabled": false,
                  "value": "<% empty(request.positionWids) ? (request.positions ?? '') : (positions.data ?? []).filter(p => { request.positionWids.contains(p.id) }).map(p => { p.descriptor }).join(', ') %>"
                },
                {
                  "type": "text",
                  "id": "requestedByText",
                  "label": "Requested By",
                  "enabled": false,
                  "value": "<% !empty(request.requestedBy) ? (request.requestedBy.descriptor ?? '') : '' %>"
                },
                {
                  "type": "text",
                  "id": "requestedDateText",
                  "label": "Requested Date",
                  "enabled": false,
                  "value": "<% request.requestedDate ?? '' %>"
                },
                {
                  "type": "text",
                  "id": "effectiveDateText",
                  "label": "Effective Date",
                  "enabled": false,
                  "value": "<% request.effectiveDate ?? '' %>"
                },
                {
                  "type": "text",
                  "id": "statusText",
                  "label": "Status",
                  "enabled": false,
                  "value": "<% request.status ?? '' %>"
                },
                {
                  "type": "text",
                  "id": "securityGroupText",
                  "label": "Security Group",
                  "enabled": false,
                  "value": "<% request.securityGroupName ?? '' %>"
                },
                {
                  "type": "text",
                  "id": "notesText",
                  "label": "Notes",
                  "enabled": false,
                  "value": "<% request.notes ?? '' %>"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}