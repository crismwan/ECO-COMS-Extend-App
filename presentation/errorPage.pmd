{
  "id": "errorPage",
  "endPoints": [],
  "presentation": {
    "headerSize": "STANDARD",
    "title": {
      "type": "title",
      "label": "Something went wrong"
    },
    "body": {
      "type": "basicFormLayout",
      "id": "errorPageForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "errorSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "errorFieldSet",
              "title": "Error Details",
              "children": [
                {
                  "type": "text",
                  "id": "errorSummary401",
                  "enabled": false,
                  "visible": "<% queryParams.errorCode == '401' %>",
                  "label": "⚠ Error 401 — Unauthorized",
                  "value": "We couldn't verify your identity, or you don't have access to this page. If you believe you should have access to ECO-COMS, contact your COMS Administrator."
                },
                {
                  "type": "text",
                  "id": "errorSummary403",
                  "enabled": false,
                  "visible": "<% queryParams.errorCode == '403' %>",
                  "label": "⚠ Error 403 — Permission Denied",
                  "value": "You don't have permission to manage this application's shell organizations. COMS access is scoped per application. Contact your COMS Administrator to request access."
                },
                {
                  "type": "text",
                  "id": "errorSummary404",
                  "enabled": false,
                  "visible": "<% queryParams.errorCode == '404' %>",
                  "label": "⚠ Error 404 — Page Not Found",
                  "value": "We couldn't find the page you're looking for. It may have been moved or the link may be incorrect."
                },
                {
                  "type": "text",
                  "id": "errorSummaryDefault",
                  "enabled": false,
                  "visible": "<% empty(queryParams.errorCode) || (queryParams.errorCode != '401' && queryParams.errorCode != '403' && queryParams.errorCode != '404') %>",
                  "label": "⚠ Unexpected Error",
                  "value": "Something went wrong. Please try again, or contact your COMS Administrator if the problem persists."
                }
              ],
              "_layout": {
                "density": "medium",
                "alignment": "left",
                "horizontalSizing": "stretch",
                "labelPosition": "top"
              }
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "button",
              "id": "homeButton",
              "label": "← Go to Home",
              "taskReference": {
                "taskId": "home"
              },
              "action": "LINK"
            },
            {
              "type": "button",
              "id": "shellOrgManagerButton",
              "label": "← Shell Org Manager",
              "taskReference": {
                "taskId": "shellOrgManager"
              },
              "action": "LINK"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}
