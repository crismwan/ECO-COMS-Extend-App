{
  "id": "errorPage",
  "endPoints": [],
  "presentation": {
    "headerSize": "HIDDEN",
    "body": {
      "type": "basicFormLayout",
      "id": "errorPageForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "titleBannerSection",
          "children": [
            {
              "type": "richText",
              "id": "titleBannerRichText",
              "enabled": false,
              "value": "<span style=\"color:#0055B3;font-size:24px\"><b>ECO-COMS: Something went wrong</b></span>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "errorSection",
          "children": [
            {
              "type": "fieldSet",
              "id": "errorFieldSet",
              "title": "Error Details",
              "children": [
                {
                  "type": "text",
                  "id": "errorSummary401",
                  "enabled": false,
                  "visible": "<% queryParams.errorCode == '401' %>",
                  "label": "⚠ Error 401 — Unauthorized",
                  "value": "We couldn't verify your identity, or you don't have access to this page. If you believe you should have access to ECO-COMS, contact your COMS Administrator."
                },
                {
                  "type": "text",
                  "id": "errorSummary403",
                  "enabled": false,
                  "visible": "<% queryParams.errorCode == '403' %>",
                  "label": "⚠ Error 403 — Permission Denied",
                  "value": "You don't have permission for this page. ECO-COMS access is granted per area (shell organizations, role requests, ISC review, Audit Log) through Workday security groups. If you need access, raise a ticket from the ECO-COMS home page: Resources → Submit a Helpdesk Ticket, and name the page you were opening."
                },
                {
                  "type": "text",
                  "id": "errorSummary404",
                  "enabled": false,
                  "visible": "<% queryParams.errorCode == '404' %>",
                  "label": "⚠ Error 404 — Page Not Found",
                  "value": "We couldn't find the page you're looking for. It may have been moved or the link may be incorrect. Try one of the pages below."
                },
                {
                  "type": "text",
                  "id": "errorSummaryDefault",
                  "enabled": false,
                  "visible": "<% empty(queryParams.errorCode) || (queryParams.errorCode != '401' && queryParams.errorCode != '403' && queryParams.errorCode != '404') %>",
                  "label": "⚠ Unexpected Error",
                  "value": "Something went wrong. Please try again, or contact your COMS Administrator if the problem persists."
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "navSection",
          "children": [
            {
              "type": "cardContainer",
              "id": "errorLinksCardContainer",
              "layout": "grid",
              "cards": [
                {
                  "type": "card",
                  "cardId": "ErrorStartAgainCard"
                },
                {
                  "type": "card",
                  "cardId": "ErrorOtherPagesCard",
                  "render": "<% queryParams.errorCode == '404' %>"
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    }
  }
}
