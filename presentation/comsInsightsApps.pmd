{
  "id": "comsInsightsApps",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "include": [
    "comsRequestStats.script",
    "comsAuditFilters.script",
    "comsInsights.script"
  ],
  "endPoints": [
    {
      "name": "requestPage0",
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "url": "/comsAssignableRoles?limit=100&offset=0"
    },
    {
      "name": "requestPage1",
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "url": "/comsAssignableRoles?limit=100&offset=100"
    },
    {
      "name": "requestPage2",
      "baseUrlType": "BUSINESS-OBJECT",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "url": "/comsAssignableRoles?limit=100&offset=200"
    },
    {
      "name": "allShellOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "allShellOrgs"
      },
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications?limit=100",
      "authType": "sso",
      "isCollection": true,
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ]
    }
  ],
  "presentation": {
    "pageType": "VIEW",
    "body": {
      "type": "basicFormLayout",
      "id": "comsInsightsAppsForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "titleBannerSection",
          "children": [
            {
              "type": "richText",
              "id": "titleBannerRichText",
              "enabled": false,
              "value": "<span style=\"color:#0055B3;font-size:24px\"><b>ECO-COMS: Applications at a Glance</b></span><br><span style=\"color:#374151;font-size:13px\">Shell orgs, patterns and role requests for each application.</span>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "button",
              "label": "← Insights",
              "taskReference": {
                "taskId": "comsInsights"
              },
              "action": "LINK",
              "suppressDiscardDialog": true
            },
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "title": "About This Page",
              "children": [
                {
                  "type": "richText",
                  "id": "aboutDesc",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Per application: active and inactive shell organizations, patterns, and role requests by status (up to 300 requests). Select an <b>Application ID</b> to open it in Shell Org Manager.</span>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "appsSection",
          "children": [
            {
              "type": "grid",
              "id": "appInsightsGrid",
              "label": "Applications at a Glance",
              "rows": "<% comsInsights.appRows(list:flatten([requestPage0.data ?? [], requestPage1.data ?? [], requestPage2.data ?? []]), (allShellOrgs.data ?? []), comsApplications.data ?? []) %>",
              "rowVariableName": "appRow",
              "columns": [
                {
                  "type": "column",
                  "columnId": "appCodeColumn",
                  "label": "Application ID",
                  "cellTemplate": {
                    "type": "button",
                    "id": "appCodeButton",
                    "action": "LINK",
                    "label": "<% appRow.code %>",
                    "taskReference": {
                      "taskId": "shellOrgManager",
                      "parameterBindings": {
                        "appCode": "<% appRow.code %>",
                        "appName": "<% appRow.name %>"
                      }
                    }
                  },
                  "excel": {
                    "enabled": false
                  }
                },
                {
                  "type": "column",
                  "columnId": "appNameColumn",
                  "label": "Name",
                  "cellTemplate": {
                    "type": "text",
                    "id": "appNameText",
                    "value": "<% appRow.name %>",
                    "enabled": false
                  },
                  "sortableAndFilterable": "true"
                },
                {
                  "type": "column",
                  "columnId": "shellActiveColumn",
                  "label": "Active Shell Orgs",
                  "cellTemplate": {
                    "type": "number",
                    "id": "shellActiveNumber",
                    "value": "<% appRow.shellActive %>",
                    "enabled": false
                  },
                  "sortableAndFilterable": "true"
                },
                {
                  "type": "column",
                  "columnId": "shellInactiveColumn",
                  "label": "Inactive Shell Orgs",
                  "cellTemplate": {
                    "type": "number",
                    "id": "shellInactiveNumber",
                    "value": "<% appRow.shellInactive %>",
                    "enabled": false
                  },
                  "sortableAndFilterable": "true"
                },
                {
                  "type": "column",
                  "columnId": "patternsColumn",
                  "label": "Patterns",
                  "cellTemplate": {
                    "type": "number",
                    "id": "patternsNumber",
                    "value": "<% appRow.patterns %>",
                    "enabled": false
                  },
                  "sortableAndFilterable": "true"
                },
                {
                  "type": "column",
                  "columnId": "pendingColumn",
                  "label": "Pending Requests",
                  "cellTemplate": {
                    "type": "number",
                    "id": "pendingNumber",
                    "value": "<% appRow.pending %>",
                    "enabled": false
                  },
                  "sortableAndFilterable": "true"
                },
                {
                  "type": "column",
                  "columnId": "approvedColumn",
                  "label": "Approved",
                  "cellTemplate": {
                    "type": "number",
                    "id": "approvedNumber",
                    "value": "<% appRow.approved %>",
                    "enabled": false
                  },
                  "sortableAndFilterable": "true"
                },
                {
                  "type": "column",
                  "columnId": "deniedColumn",
                  "label": "Denied",
                  "cellTemplate": {
                    "type": "number",
                    "id": "deniedNumber",
                    "value": "<% appRow.denied %>",
                    "enabled": false
                  },
                  "sortableAndFilterable": "true"
                },
                {
                  "type": "column",
                  "columnId": "lastRequestColumn",
                  "label": "Last Request",
                  "cellTemplate": {
                    "type": "text",
                    "id": "lastRequestText",
                    "value": "<% appRow.lastRequest %>",
                    "enabled": false
                  },
                  "sortableAndFilterable": "true"
                }
              ],
              "gridType": "LIST",
              "multiViewStylingEnabled": true,
              "autoPaging": true,
              "excelExportEnabled": true
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "ecoComsFooter"
        }
      ]
    },
    "headerSize": "HIDDEN"
  }
}
