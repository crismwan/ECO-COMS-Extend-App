{
  "id": "newSchemaPattern",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "include": [
    "comsValidations.script",
    "comsPatterns.script"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications?limit=100",
      "authType": "sso",
      "isCollection": true,
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "existingOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 500
        }
      ],
      "wqlQuery": {
        "queryId": "customOrganizations"
      }
    },
    {
      "name": "launchAddShellOrgPattern",
      "baseUrlType": "orchestration",
      "authType": "sso",
      "deferred": "true",
      "url": "<% '/IORC_0037_XFD_SEC_Create_Pattern_Shell_Org/launch?comsAppId=' + aid + '&patternName=' + pn + '&workerId=' + wid + '&attribute1=' + a1 + '&attribute2=' + a2 + '&attribute3=' + a3 + '&attribute4=' + a4 + '&attribute5=' + a5 + '&effectiveDate=' + ed + '&changedBy=' + cb + '&timestamp=' + ts + '&changedByWid=' + cbw %>"
    },
    {
      "name": "auCodes",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "academicUnitCodes"
      },
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "exclude": "<% !comsPatterns.needsUnits(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) %>"
    },
    {
      "name": "wdLookup",
      "baseUrlType": "workday-wql",
      "authType": "sso",
      "deferred": "true",
      "url": "<% 'data?limit=' + lim + '&query=' + string:pathEncode(q) %>"
    },
    {
      "name": "wdYears",
      "baseUrlType": "workday-wql",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "url": "data?limit=1000&query=SELECT%20academicYear%2C%20startDate%20FROM%20academicYears%20ORDER%20BY%20startDate",
      "exclude": "<% !comsPatterns.needsPeriods(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) %>"
    },
    {
      "name": "verifyPattern",
      "baseUrlType": "workday-wql",
      "authType": "sso",
      "deferred": "true",
      "url": "<% 'data?limit=' + lim + '&query=SELECT%20workdayID%2C%20code%20FROM%20topLevelOrganizations%20WHERE%20code%20contains%20%27X%3A%27' %>"
    }
  ],
  "onSubmit": "<%\n  let s = comsPatterns.schemaFor(comsApplications.data, queryParams.appCode);\n  let u = (auCodes.data ?? []).map(u => { u.academicUnitCode ?? '' });\n  let valid = true;\n  prefixDropdown.clearError();\n  effectiveDate.clearError();\n  patternField1Text.clearError();\n  patternField2Text.clearError();\n  patternField3Text.clearError();\n  patternField4Text.clearError();\n  patternField5Text.clearError();\n  patternField6Text.clearError();\n  patternField7Text.clearError();\n  if (empty(queryParams.appCode) || empty(s)) {\n    valid = false;\n  } else {\n    if (comsPatterns.prefixCount(s) > 1 && empty(prefixDropdown.value)) {\n      prefixDropdown.setError('Pick a pattern prefix.');\n      valid = false;\n    }\n  let v0 = patternField1Text.value;\n  let q0 = comsPatterns.fieldQuery(s, 0, v0, u);\n  let t0 = 0 - 1;\n  let d0 = [];\n  if (q0 != '') { let r0 = wdLookup.invoke({'q': q0, 'lim': '50'}); t0 = r0.total ?? (0 - 1); d0 = r0.data ?? []; }\n  let e0 = comsPatterns.fieldError(s, 0, v0, u, t0, d0);\n    if (e0 != '') { patternField1Text.setError(e0); valid = false; }\n  let v1 = patternField2Text.value;\n  let q1 = comsPatterns.fieldQuery(s, 1, v1, u);\n  let t1 = 0 - 1;\n  let d1 = [];\n  if (q1 != '') { let r1 = wdLookup.invoke({'q': q1, 'lim': '50'}); t1 = r1.total ?? (0 - 1); d1 = r1.data ?? []; }\n  let e1 = comsPatterns.fieldError(s, 1, v1, u, t1, d1);\n    if (e1 != '') { patternField2Text.setError(e1); valid = false; }\n  let v2 = patternField3Text.value;\n  let q2 = comsPatterns.fieldQuery(s, 2, v2, u);\n  let t2 = 0 - 1;\n  let d2 = [];\n  if (q2 != '') { let r2 = wdLookup.invoke({'q': q2, 'lim': '50'}); t2 = r2.total ?? (0 - 1); d2 = r2.data ?? []; }\n  let e2 = comsPatterns.fieldError(s, 2, v2, u, t2, d2);\n    if (e2 != '') { patternField3Text.setError(e2); valid = false; }\n  let v3 = patternField4Text.value;\n  let q3 = comsPatterns.fieldQuery(s, 3, v3, u);\n  let t3 = 0 - 1;\n  let d3 = [];\n  if (q3 != '') { let r3 = wdLookup.invoke({'q': q3, 'lim': '50'}); t3 = r3.total ?? (0 - 1); d3 = r3.data ?? []; }\n  let e3 = comsPatterns.fieldError(s, 3, v3, u, t3, d3);\n    if (e3 != '') { patternField4Text.setError(e3); valid = false; }\n  let v4 = patternField5Text.value;\n  let q4 = comsPatterns.fieldQuery(s, 4, v4, u);\n  let t4 = 0 - 1;\n  let d4 = [];\n  if (q4 != '') { let r4 = wdLookup.invoke({'q': q4, 'lim': '50'}); t4 = r4.total ?? (0 - 1); d4 = r4.data ?? []; }\n  let e4 = comsPatterns.fieldError(s, 4, v4, u, t4, d4);\n    if (e4 != '') { patternField5Text.setError(e4); valid = false; }\n  let v5 = patternField6Text.value;\n  let q5 = comsPatterns.fieldQuery(s, 5, v5, u);\n  let t5 = 0 - 1;\n  let d5 = [];\n  if (q5 != '') { let r5 = wdLookup.invoke({'q': q5, 'lim': '50'}); t5 = r5.total ?? (0 - 1); d5 = r5.data ?? []; }\n  let e5 = comsPatterns.fieldError(s, 5, v5, u, t5, d5);\n    if (e5 != '') { patternField6Text.setError(e5); valid = false; }\n  let v6 = patternField7Text.value;\n  let q6 = comsPatterns.fieldQuery(s, 6, v6, u);\n  let t6 = 0 - 1;\n  let d6 = [];\n  if (q6 != '') { let r6 = wdLookup.invoke({'q': q6, 'lim': '50'}); t6 = r6.total ?? (0 - 1); d6 = r6.data ?? []; }\n  let e6 = comsPatterns.fieldError(s, 6, v6, u, t6, d6);\n    if (e6 != '') { patternField7Text.setError(e6); valid = false; }\n  }\n  if (empty(effectiveDate.value)) {\n    effectiveDate.setError('Effective Date is required.');\n    valid = false;\n  } else if (!comsValidations.isWeekday(effectiveDate.value)) {\n    effectiveDate.setError(comsValidations.errorWeekday());\n    valid = false;\n  } else if (!comsValidations.isCurrentOrFutureYear(effectiveDate.value)) {\n    effectiveDate.setError(comsValidations.errorYear());\n    valid = false;\n  }\n  if (valid) {\n    let dupName = comsPatterns.buildName((queryParams.appCode ?? ''), (comsPatterns.prefixCount(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) > 1 ? (empty(prefixDropdown.value) ? '' : prefixDropdown.selectedEntries[0].id) : comsPatterns.firstPrefix(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode))), comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), [patternField1Text.value, patternField2Text.value, patternField3Text.value, patternField4Text.value, patternField5Text.value, patternField6Text.value, patternField7Text.value]);\n    if ((existingOrgs.data ?? []).filter(o => { o.code == dupName }).size() > 0) {\n      patternField1Text.setError('A pattern with this name already exists: ' + dupName);\n      valid = false;\n    }\n  }\n  if (valid) {\n    let rec = comsPatterns.recordFor(comsApplications.data, queryParams.appCode);\n    let pn = comsPatterns.buildName((queryParams.appCode ?? ''), (comsPatterns.prefixCount(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) > 1 ? (empty(prefixDropdown.value) ? '' : prefixDropdown.selectedEntries[0].id) : comsPatterns.firstPrefix(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode))), comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), [patternField1Text.value, patternField2Text.value, patternField3Text.value, patternField4Text.value, patternField5Text.value, patternField6Text.value, patternField7Text.value]);\n    let v = [patternField1Text.value, patternField2Text.value, patternField3Text.value, patternField4Text.value, patternField5Text.value, patternField6Text.value, patternField7Text.value];\n    launchAddShellOrgPattern.invoke({'cbw': selectedWorker.id ?? '', 'cb': (selectedWorker.descriptor ?? '').urlEncode(), 'ts': date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\").urlEncode(), 'aid': rec.id, 'pn': pn.urlEncode(), 'wid': selectedWorker.id ?? '', 'a1': comsPatterns.cell(v[0]).urlEncode(), 'a2': comsPatterns.cell(v[1]).urlEncode(), 'a3': comsPatterns.cell(v[2]).urlEncode(), 'a4': comsPatterns.cell(v[3]).urlEncode(), 'a5': comsPatterns.cell(v[4]).urlEncode(), 'ed': effectiveDate.value.format('yyyy-MM-dd')});\n    let created = (verifyPattern.invoke({'lim': '10000'}).data ?? []).filter(o => { o.code == pn }).size() > 0;\n    if (!created) {\n      patternField1Text.setError('Workday rejected this request, so nothing was created. Check the values and try again.');\n      valid = false;\n    }\n  }\n  valid;\n%>",
  "presentation": {
    "headerSize": "HIDDEN",
    "cancelOverride": {
      "taskId": "shellOrgManager"
    },
    "standardEditButtonsHidden": "<% empty(queryParams.appCode) || empty(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) || ((comsPatterns.recordFor(comsApplications.data, queryParams.appCode) ?? {'active': true}).active == false) %>",
    "body": {
      "type": "basicFormLayout",
      "id": "schemaPatternForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "titleBannerSection",
          "children": [
            {
              "type": "richText",
              "id": "titleBannerRichText",
              "enabled": false,
              "value": "<% '<span style=\"color:#0055B3;font-size:24px\"><b>' + (empty(queryParams.appCode) ? 'ECO-COMS: Add Shell Org Pattern' : ('ECO-COMS: Add Shell Org Pattern · ' + queryParams.appCode)).replace('<', '&lt;') + '</b></span>' + '<br><span style=\"color:#374151;font-size:13px\">Add a shell org pattern in the format the application uses.</span>' %>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "button",
              "id": "backButton",
              "label": "← Shell Org Manager",
              "action": "LINK",
              "suppressDiscardDialog": true,
              "taskReference": {
                "taskId": "shellOrgManager"
              }
            },
            {
              "type": "button",
              "id": "changeAppButton",
              "label": "Choose another application",
              "action": "LINK",
              "suppressDiscardDialog": true,
              "render": "<% !empty(queryParams.appCode) %>",
              "taskReference": {
                "taskId": "schemaPatternApps"
              }
            },
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "title": "About This Page",
              "children": [
                {
                  "type": "richText",
                  "id": "aboutRichText",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Create a shell org pattern for any application. Each application has its own pattern format: a prefix and its own fields (e.g. Subject and Course for Assessment Outcomes, one Role Name for most tools). The form below shows that application's fields, checks each value as you type, and builds the name as <b>APPLICATION:PREFIX:field:field</b>. A blank field becomes * (any). Submitting creates a live organization (subtype X:SHELL) in Workday; it can be inactivated later but not deleted.</span>"
                }
              ],
              "collapsible": true,
              "initializeCollapsed": true
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "pickSection",
          "render": "<% empty(queryParams.appCode) %>",
          "children": [
            {
              "type": "fieldSet",
              "id": "pickFieldSet",
              "title": "Choose an Application",
              "children": [
                {
                  "type": "text",
                  "id": "pickText",
                  "label": "Application",
                  "enabled": false,
                  "value": "<% 'No application chosen yet.' %>"
                },
                {
                  "type": "button",
                  "id": "pickAppButton",
                  "label": "Choose an Application",
                  "action": "PRIMARY",
                  "suppressDiscardDialog": true,
                  "taskReference": {
                    "taskId": "schemaPatternApps"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "inactiveSection",
          "render": "<% !empty(queryParams.appCode) && ((comsPatterns.recordFor(comsApplications.data, queryParams.appCode) ?? {'active': true}).active == false) %>",
          "children": [
            {
              "type": "fieldSet",
              "id": "inactiveFieldSet",
              "title": "Application Inactive",
              "children": [
                {
                  "type": "text",
                  "id": "inactiveText",
                  "label": "Status",
                  "enabled": false,
                  "value": "<% (queryParams.appCode ?? '') + ' is inactive, so it takes no new patterns. Reactivate it on Maintain Application Pattern (Edit, Active) to add one.' %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "noSchemaSection",
          "render": "<% !empty(queryParams.appCode) && empty(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) && !((comsPatterns.recordFor(comsApplications.data, queryParams.appCode) ?? {'active': true}).active == false) %>",
          "children": [
            {
              "type": "fieldSet",
              "id": "noSchemaFieldSet",
              "title": "No Pattern Format",
              "children": [
                {
                  "type": "text",
                  "id": "noSchemaText",
                  "label": "Pattern Format",
                  "enabled": false,
                  "value": "<% 'No pattern format is set up for ' + (queryParams.appCode ?? '') + ' yet. Add it to the application record (patternSchema), then come back.' %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "formSection",
          "render": "<% !empty(queryParams.appCode) && !empty(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) && !((comsPatterns.recordFor(comsApplications.data, queryParams.appCode) ?? {'active': true}).active == false) %>",
          "children": [
            {
              "type": "fieldSet",
              "id": "patternDetailsFieldSet",
              "title": "Pattern Details",
              "children": [
                {
                  "type": "text",
                  "id": "applicationText",
                  "label": "Application",
                  "enabled": false,
                  "value": "<% (queryParams.appCode ?? '') + ' · ' + ((comsPatterns.recordFor(comsApplications.data, queryParams.appCode) ?? {'name': ''}).name ?? '') %>"
                },
                {
                  "type": "text",
                  "id": "formatGuideText",
                  "label": "Format",
                  "enabled": false,
                  "value": "<% comsPatterns.formatGuide(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) %>"
                },
                {
                  "type": "dropdown",
                  "id": "prefixDropdown",
                  "label": "Pattern Prefix",
                  "values": "<% comsPatterns.prefixOptions(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) %>",
                  "visible": "<% comsPatterns.prefixCount(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) > 1 %>",
                  "onChange": "<%\n  self.clearError();\n  let s = comsPatterns.schemaFor(comsApplications.data, queryParams.appCode);\n  let u = (auCodes.data ?? []).map(u => { u.academicUnitCode ?? '' });\n  let v0 = patternField1Text.value;\n  let q0 = comsPatterns.fieldQuery(s, 0, v0, u);\n  let t0 = 0 - 1;\n  let d0 = [];\n  if (q0 != '') { let r0 = wdLookup.invoke({'q': q0, 'lim': '50'}); t0 = r0.total ?? (0 - 1); d0 = r0.data ?? []; }\n  let e0 = comsPatterns.fieldError(s, 0, v0, u, t0, d0);\n  if (e0 != '') { patternField1Text.setError(e0); } else { patternField1Text.clearError(); }\n  let v1 = patternField2Text.value;\n  let q1 = comsPatterns.fieldQuery(s, 1, v1, u);\n  let t1 = 0 - 1;\n  let d1 = [];\n  if (q1 != '') { let r1 = wdLookup.invoke({'q': q1, 'lim': '50'}); t1 = r1.total ?? (0 - 1); d1 = r1.data ?? []; }\n  let e1 = comsPatterns.fieldError(s, 1, v1, u, t1, d1);\n  if (e1 != '') { patternField2Text.setError(e1); } else { patternField2Text.clearError(); }\n  let v2 = patternField3Text.value;\n  let q2 = comsPatterns.fieldQuery(s, 2, v2, u);\n  let t2 = 0 - 1;\n  let d2 = [];\n  if (q2 != '') { let r2 = wdLookup.invoke({'q': q2, 'lim': '50'}); t2 = r2.total ?? (0 - 1); d2 = r2.data ?? []; }\n  let e2 = comsPatterns.fieldError(s, 2, v2, u, t2, d2);\n  if (e2 != '') { patternField3Text.setError(e2); } else { patternField3Text.clearError(); }\n  let v3 = patternField4Text.value;\n  let q3 = comsPatterns.fieldQuery(s, 3, v3, u);\n  let t3 = 0 - 1;\n  let d3 = [];\n  if (q3 != '') { let r3 = wdLookup.invoke({'q': q3, 'lim': '50'}); t3 = r3.total ?? (0 - 1); d3 = r3.data ?? []; }\n  let e3 = comsPatterns.fieldError(s, 3, v3, u, t3, d3);\n  if (e3 != '') { patternField4Text.setError(e3); } else { patternField4Text.clearError(); }\n  let v4 = patternField5Text.value;\n  let q4 = comsPatterns.fieldQuery(s, 4, v4, u);\n  let t4 = 0 - 1;\n  let d4 = [];\n  if (q4 != '') { let r4 = wdLookup.invoke({'q': q4, 'lim': '50'}); t4 = r4.total ?? (0 - 1); d4 = r4.data ?? []; }\n  let e4 = comsPatterns.fieldError(s, 4, v4, u, t4, d4);\n  if (e4 != '') { patternField5Text.setError(e4); } else { patternField5Text.clearError(); }\n  let v5 = patternField6Text.value;\n  let q5 = comsPatterns.fieldQuery(s, 5, v5, u);\n  let t5 = 0 - 1;\n  let d5 = [];\n  if (q5 != '') { let r5 = wdLookup.invoke({'q': q5, 'lim': '50'}); t5 = r5.total ?? (0 - 1); d5 = r5.data ?? []; }\n  let e5 = comsPatterns.fieldError(s, 5, v5, u, t5, d5);\n  if (e5 != '') { patternField6Text.setError(e5); } else { patternField6Text.clearError(); }\n  let v6 = patternField7Text.value;\n  let q6 = comsPatterns.fieldQuery(s, 6, v6, u);\n  let t6 = 0 - 1;\n  let d6 = [];\n  if (q6 != '') { let r6 = wdLookup.invoke({'q': q6, 'lim': '50'}); t6 = r6.total ?? (0 - 1); d6 = r6.data ?? []; }\n  let e6 = comsPatterns.fieldError(s, 6, v6, u, t6, d6);\n  if (e6 != '') { patternField7Text.setError(e6); } else { patternField7Text.clearError(); }\n  patternPreviewText.setValue(comsPatterns.buildName((queryParams.appCode ?? ''), (comsPatterns.prefixCount(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) > 1 ? (empty(prefixDropdown.value) ? '' : prefixDropdown.selectedEntries[0].id) : comsPatterns.firstPrefix(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode))), comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), [patternField1Text.value, patternField2Text.value, patternField3Text.value, patternField4Text.value, patternField5Text.value, patternField6Text.value, patternField7Text.value]));\n%>"
                },
                {
                  "type": "readOnlyText",
                  "id": "patternPreviewText",
                  "label": "Pattern Name Preview",
                  "value": "<% comsPatterns.buildName((queryParams.appCode ?? ''), comsPatterns.prefixCount(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) > 1 ? '' : comsPatterns.firstPrefix(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)), comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), ['', '', '', '', '', '', '']) %>"
                }
              ]
            },
            {
              "type": "fieldSet",
              "id": "patternFieldsFieldSet",
              "title": "Pattern Fields",
              "children": [
                {
                  "type": "instanceList",
                  "id": "patternField1FindInstanceList",
                  "multiSelect": false,
                  "label": "<% comsPatterns.fieldLabel(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), 0) %>",
                  "visible": "<% comsPatterns.pickerKind(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), 0) != '' %>",
                  "helpText": "Click to browse, or type a code or name to search Workday (type * for the wildcards). The value it puts in the name shows below.",
                  "values": "<% comsPatterns.rootFolders(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), 0, (auCodes.data ?? []), wdYears.data ?? []) %>",
