{
  "id": "newSchemaPattern",
  "securityDomains": [
    "ManageCOMSShellOrgs"
  ],
  "include": [
    "comsValidations.script",
    "comsPatterns.script"
  ],
  "endPoints": [
    {
      "name": "selectedWorker",
      "baseUrlType": "COMMON",
      "url": "/workers/me",
      "authType": "sso",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "comsApplications",
      "baseUrlType": "BUSINESS-OBJECT",
      "url": "/comsApplications?limit=100",
      "authType": "sso",
      "isCollection": true,
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 429
        }
      ]
    },
    {
      "name": "existingOrgs",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 400
        },
        {
          "code": 403
        },
        {
          "code": 500
        }
      ],
      "wqlQuery": {
        "queryId": "customOrganizations"
      }
    },
    {
      "name": "launchAddShellOrgPattern",
      "baseUrlType": "orchestration",
      "authType": "sso",
      "deferred": "true",
      "url": "<% '/IORC_0037_XFD_SEC_Create_Pattern_Shell_Org/launch?comsAppId=' + aid + '&patternName=' + pn + '&workerId=' + wid + '&attribute1=' + a1 + '&attribute2=' + a2 + '&attribute3=' + a3 + '&attribute4=' + a4 + '&attribute5=' + a5 + '&effectiveDate=' + ed + '&changedBy=' + cb + '&timestamp=' + ts + '&changedByWid=' + cbw %>"
    },
    {
      "name": "auCodes",
      "baseUrlType": "workday-wql",
      "url": "data",
      "authType": "sso",
      "bestEffort": "true",
      "wqlQuery": {
        "queryId": "academicUnitCodes"
      },
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "exclude": "<% !comsPatterns.needsUnits(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) %>"
    },
    {
      "name": "wdLookup",
      "baseUrlType": "workday-wql",
      "authType": "sso",
      "deferred": "true",
      "url": "<% 'data?limit=' + lim + '&query=' + string:pathEncode(q) %>"
    },
    {
      "name": "wdYears",
      "baseUrlType": "workday-wql",
      "authType": "sso",
      "bestEffort": "true",
      "failOnStatusCodes": [
        {
          "code": 429
        }
      ],
      "url": "data?limit=1000&query=SELECT%20academicYear%2C%20startDate%20FROM%20academicYears%20ORDER%20BY%20startDate",
      "exclude": "<% !comsPatterns.needsPeriods(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) %>"
    },
    {
      "name": "verifyPattern",
      "baseUrlType": "workday-wql",
      "authType": "sso",
      "deferred": "true",
      "url": "<% 'data?limit=' + lim + '&query=SELECT%20workdayID%2C%20code%20FROM%20topLevelOrganizations%20WHERE%20code%20contains%20%27X%3A%27' %>"
    }
  ],
  "onSubmit": "<%\n  let s = comsPatterns.schemaFor(comsApplications.data, queryParams.appCode);\n  let u = (auCodes.data ?? []).map(u => { u.academicUnitCode ?? '' });\n  let valid = true;\n  prefixDropdown.clearError();\n  effectiveDate.clearError();\n  patternField1Text.clearError();\n  patternField1FindInstanceList.clearError();\n  patternField2Text.clearError();\n  patternField2FindInstanceList.clearError();\n  patternField3Text.clearError();\n  patternField3FindInstanceList.clearError();\n  patternField4Text.clearError();\n  patternField4FindInstanceList.clearError();\n  patternField5Text.clearError();\n  patternField5FindInstanceList.clearError();\n  patternField6Text.clearError();\n  patternField6FindInstanceList.clearError();\n  patternField7Text.clearError();\n  patternField7FindInstanceList.clearError();\n  if (empty(queryParams.appCode) || empty(s)) {\n    valid = false;\n  } else {\n    if (comsPatterns.prefixCount(s) > 1 && empty(prefixDropdown.value)) {\n      prefixDropdown.setError('Pick a pattern prefix.');\n      valid = false;\n    }\n  let vs = [patternField1Text.value, patternField2Text.value, patternField3Text.value, patternField4Text.value, patternField5Text.value, patternField6Text.value, patternField7Text.value];\n  let qs = vs.map((v, j) => { comsPatterns.fieldQuery(s, j, v, u) });\n  let rs = qs.map(q => { q == '' ? null : wdLookup.invoke({'q': q, 'lim': '50'}) });\n  let es = comsPatterns.fieldErrors(s, vs, u, rs);\n  let te = comsPatterns.textErrors(s, es);\n  let fe = comsPatterns.findErrors(s, es);\n    if (te[0] != '') { patternField1Text.setError(te[0]); } else { patternField1Text.clearError(); }\n    if (fe[0] != '') { patternField1FindInstanceList.setError(fe[0]); } else { patternField1FindInstanceList.clearError(); }\n    if (te[1] != '') { patternField2Text.setError(te[1]); } else { patternField2Text.clearError(); }\n    if (fe[1] != '') { patternField2FindInstanceList.setError(fe[1]); } else { patternField2FindInstanceList.clearError(); }\n    if (te[2] != '') { patternField3Text.setError(te[2]); } else { patternField3Text.clearError(); }\n    if (fe[2] != '') { patternField3FindInstanceList.setError(fe[2]); } else { patternField3FindInstanceList.clearError(); }\n    if (te[3] != '') { patternField4Text.setError(te[3]); } else { patternField4Text.clearError(); }\n    if (fe[3] != '') { patternField4FindInstanceList.setError(fe[3]); } else { patternField4FindInstanceList.clearError(); }\n    if (te[4] != '') { patternField5Text.setError(te[4]); } else { patternField5Text.clearError(); }\n    if (fe[4] != '') { patternField5FindInstanceList.setError(fe[4]); } else { patternField5FindInstanceList.clearError(); }\n    if (te[5] != '') { patternField6Text.setError(te[5]); } else { patternField6Text.clearError(); }\n    if (fe[5] != '') { patternField6FindInstanceList.setError(fe[5]); } else { patternField6FindInstanceList.clearError(); }\n    if (te[6] != '') { patternField7Text.setError(te[6]); } else { patternField7Text.clearError(); }\n    if (fe[6] != '') { patternField7FindInstanceList.setError(fe[6]); } else { patternField7FindInstanceList.clearError(); }\n    if (es.filter(e => { e != '' }).size() > 0) { valid = false; }\n  }\n  if (empty(effectiveDate.value)) {\n    effectiveDate.setError('Effective Date is required.');\n    valid = false;\n  } else if (!comsValidations.isWeekday(effectiveDate.value)) {\n    effectiveDate.setError(comsValidations.errorWeekday());\n    valid = false;\n  } else if (!comsValidations.isCurrentOrFutureYear(effectiveDate.value)) {\n    effectiveDate.setError(comsValidations.errorYear());\n    valid = false;\n  }\n  if (valid) {\n    let dupName = comsPatterns.buildName((queryParams.appCode ?? ''), (comsPatterns.prefixCount(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) > 1 ? (empty(prefixDropdown.value) ? '' : prefixDropdown.selectedEntries[0].id) : comsPatterns.firstPrefix(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode))), comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), [patternField1Text.value, patternField2Text.value, patternField3Text.value, patternField4Text.value, patternField5Text.value, patternField6Text.value, patternField7Text.value]);\n    if ((existingOrgs.data ?? []).filter(o => { o.code == dupName }).size() > 0) {\n      if (comsPatterns.pickerKind(s, 0) == '') { patternField1Text.setError('A pattern with this name already exists: ' + dupName); } else { patternField1FindInstanceList.setError('A pattern with this name already exists: ' + dupName); }\n      valid = false;\n    }\n  }\n  if (valid) {\n    let rec = comsPatterns.recordFor(comsApplications.data, queryParams.appCode);\n    let pn = comsPatterns.buildName((queryParams.appCode ?? ''), (comsPatterns.prefixCount(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) > 1 ? (empty(prefixDropdown.value) ? '' : prefixDropdown.selectedEntries[0].id) : comsPatterns.firstPrefix(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode))), comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), [patternField1Text.value, patternField2Text.value, patternField3Text.value, patternField4Text.value, patternField5Text.value, patternField6Text.value, patternField7Text.value]);\n    let v = [patternField1Text.value, patternField2Text.value, patternField3Text.value, patternField4Text.value, patternField5Text.value, patternField6Text.value, patternField7Text.value];\n    launchAddShellOrgPattern.invoke({'cbw': selectedWorker.id ?? '', 'cb': (selectedWorker.descriptor ?? '').urlEncode(), 'ts': date:now().format(\"yyyy-MM-dd'T'HH:mm:ss'Z'\").urlEncode(), 'aid': rec.id, 'pn': pn.urlEncode(), 'wid': selectedWorker.id ?? '', 'a1': comsPatterns.cell(v[0]).urlEncode(), 'a2': comsPatterns.cell(v[1]).urlEncode(), 'a3': comsPatterns.cell(v[2]).urlEncode(), 'a4': comsPatterns.cell(v[3]).urlEncode(), 'a5': comsPatterns.cell(v[4]).urlEncode(), 'ed': effectiveDate.value.format('yyyy-MM-dd')});\n    let created = (verifyPattern.invoke({'lim': '10000'}).data ?? []).filter(o => { o.code == pn }).size() > 0;\n    if (!created) {\n      if (comsPatterns.pickerKind(s, 0) == '') { patternField1Text.setError('Workday rejected this request, so nothing was created. Check the values and try again.'); } else { patternField1FindInstanceList.setError('Workday rejected this request, so nothing was created. Check the values and try again.'); }\n      valid = false;\n    }\n  }\n  valid;\n%>",
  "presentation": {
    "headerSize": "HIDDEN",
    "cancelOverride": {
      "taskId": "shellOrgManager"
    },
    "standardEditButtonsHidden": "<% empty(queryParams.appCode) || empty(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) || ((comsPatterns.recordFor(comsApplications.data, queryParams.appCode) ?? {'active': true}).active == false) %>",
    "body": {
      "type": "basicFormLayout",
      "id": "schemaPatternForm",
      "sections": [
        {
          "type": "layoutSection",
          "id": "titleBannerSection",
          "children": [
            {
              "type": "richText",
              "id": "titleBannerRichText",
              "enabled": false,
              "value": "<% '<span style=\"color:#0055B3;font-size:24px\"><b>' + (empty(queryParams.appCode) ? 'ECO-COMS: Add Shell Org Pattern' : ('ECO-COMS: Add Shell Org Pattern · ' + queryParams.appCode)).replace('<', '&lt;') + '</b></span>' + '<br><span style=\"color:#374151;font-size:13px\">Add a shell org pattern in the format the application uses.</span>' %>"
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "aboutSection",
          "children": [
            {
              "type": "button",
              "id": "backButton",
              "label": "← Shell Org Manager",
              "action": "LINK",
              "suppressDiscardDialog": true,
              "taskReference": {
                "taskId": "shellOrgManager"
              }
            },
            {
              "type": "button",
              "id": "changeAppButton",
              "label": "Choose another application",
              "action": "LINK",
              "suppressDiscardDialog": true,
              "render": "<% !empty(queryParams.appCode) %>",
              "taskReference": {
                "taskId": "schemaPatternApps"
              }
            },
            {
              "type": "fieldSet",
              "id": "aboutFieldSet",
              "title": "About This Page",
              "children": [
                {
                  "type": "richText",
                  "id": "aboutRichText",
                  "enabled": false,
                  "value": "<span style=\"color:#0055B7;font-size:12px;font-weight:700\">ⓘ </span><span style=\"color:#374151;font-size:12px\">Create a shell org pattern for any application. Each application has its own pattern format: a prefix and its own fields (e.g. Subject and Course for Assessment Outcomes, one Role Name for most tools). The form below shows that application's fields, checks each value as you type, and builds the name as <b>APPLICATION:PREFIX:field:field</b>. A blank field becomes * (any). Submitting creates a live organization (subtype X:SHELL) in Workday; it can be inactivated later but not deleted.</span>"
                }
              ],
              "collapsible": true,
              "initializeCollapsed": true
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "pickSection",
          "render": "<% empty(queryParams.appCode) %>",
          "children": [
            {
              "type": "fieldSet",
              "id": "pickFieldSet",
              "title": "Choose an Application",
              "children": [
                {
                  "type": "text",
                  "id": "pickText",
                  "label": "Application",
                  "enabled": false,
                  "value": "<% 'No application chosen yet.' %>"
                },
                {
                  "type": "button",
                  "id": "pickAppButton",
                  "label": "Choose an Application",
                  "action": "PRIMARY",
                  "suppressDiscardDialog": true,
                  "taskReference": {
                    "taskId": "schemaPatternApps"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "inactiveSection",
          "render": "<% !empty(queryParams.appCode) && ((comsPatterns.recordFor(comsApplications.data, queryParams.appCode) ?? {'active': true}).active == false) %>",
          "children": [
            {
              "type": "fieldSet",
              "id": "inactiveFieldSet",
              "title": "Application Inactive",
              "children": [
                {
                  "type": "text",
                  "id": "inactiveText",
                  "label": "Status",
                  "enabled": false,
                  "value": "<% (queryParams.appCode ?? '') + ' is inactive, so it takes no new patterns. Reactivate it on Maintain Application Pattern (Edit, Active) to add one.' %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "noSchemaSection",
          "render": "<% !empty(queryParams.appCode) && empty(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) && !((comsPatterns.recordFor(comsApplications.data, queryParams.appCode) ?? {'active': true}).active == false) %>",
          "children": [
            {
              "type": "fieldSet",
              "id": "noSchemaFieldSet",
              "title": "No Pattern Format",
              "children": [
                {
                  "type": "text",
                  "id": "noSchemaText",
                  "label": "Pattern Format",
                  "enabled": false,
                  "value": "<% 'No pattern format is set up for ' + (queryParams.appCode ?? '') + ' yet. Add it to the application record (patternSchema), then come back.' %>"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutSection",
          "id": "formSection",
          "render": "<% !empty(queryParams.appCode) && !empty(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) && !((comsPatterns.recordFor(comsApplications.data, queryParams.appCode) ?? {'active': true}).active == false) %>",
          "children": [
            {
              "type": "fieldSet",
              "id": "patternDetailsFieldSet",
              "title": "Pattern Details",
              "children": [
                {
                  "type": "text",
                  "id": "applicationText",
                  "label": "Application",
                  "enabled": false,
                  "value": "<% (queryParams.appCode ?? '') + ' · ' + ((comsPatterns.recordFor(comsApplications.data, queryParams.appCode) ?? {'name': ''}).name ?? '') %>"
                },
                {
                  "type": "text",
                  "id": "formatGuideText",
                  "label": "Format",
                  "enabled": false,
                  "value": "<% comsPatterns.formatGuide(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) %>"
                },
                {
                  "type": "dropdown",
                  "id": "prefixDropdown",
                  "label": "Pattern Prefix",
                  "values": "<% comsPatterns.prefixOptions(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) %>",
                  "visible": "<% comsPatterns.prefixCount(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) > 1 %>",
                  "onChange": "<%\n  self.clearError();\n  let s = comsPatterns.schemaFor(comsApplications.data, queryParams.appCode);\n  let u = (auCodes.data ?? []).map(u => { u.academicUnitCode ?? '' });\n  let vs = [patternField1Text.value, patternField2Text.value, patternField3Text.value, patternField4Text.value, patternField5Text.value, patternField6Text.value, patternField7Text.value];\n  let qs = vs.map((v, j) => { comsPatterns.fieldQuery(s, j, v, u) });\n  let rs = qs.map(q => { q == '' ? null : wdLookup.invoke({'q': q, 'lim': '50'}) });\n  let es = comsPatterns.fieldErrors(s, vs, u, rs);\n  let te = comsPatterns.textErrors(s, es);\n  let fe = comsPatterns.findErrors(s, es);\n  if (te[0] != '') { patternField1Text.setError(te[0]); } else { patternField1Text.clearError(); }\n  if (fe[0] != '') { patternField1FindInstanceList.setError(fe[0]); } else { patternField1FindInstanceList.clearError(); }\n  if (te[1] != '') { patternField2Text.setError(te[1]); } else { patternField2Text.clearError(); }\n  if (fe[1] != '') { patternField2FindInstanceList.setError(fe[1]); } else { patternField2FindInstanceList.clearError(); }\n  if (te[2] != '') { patternField3Text.setError(te[2]); } else { patternField3Text.clearError(); }\n  if (fe[2] != '') { patternField3FindInstanceList.setError(fe[2]); } else { patternField3FindInstanceList.clearError(); }\n  if (te[3] != '') { patternField4Text.setError(te[3]); } else { patternField4Text.clearError(); }\n  if (fe[3] != '') { patternField4FindInstanceList.setError(fe[3]); } else { patternField4FindInstanceList.clearError(); }\n  if (te[4] != '') { patternField5Text.setError(te[4]); } else { patternField5Text.clearError(); }\n  if (fe[4] != '') { patternField5FindInstanceList.setError(fe[4]); } else { patternField5FindInstanceList.clearError(); }\n  if (te[5] != '') { patternField6Text.setError(te[5]); } else { patternField6Text.clearError(); }\n  if (fe[5] != '') { patternField6FindInstanceList.setError(fe[5]); } else { patternField6FindInstanceList.clearError(); }\n  if (te[6] != '') { patternField7Text.setError(te[6]); } else { patternField7Text.clearError(); }\n  if (fe[6] != '') { patternField7FindInstanceList.setError(fe[6]); } else { patternField7FindInstanceList.clearError(); }\n  patternPreviewText.setValue(comsPatterns.buildName((queryParams.appCode ?? ''), (comsPatterns.prefixCount(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) > 1 ? (empty(prefixDropdown.value) ? '' : prefixDropdown.selectedEntries[0].id) : comsPatterns.firstPrefix(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode))), comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), [patternField1Text.value, patternField2Text.value, patternField3Text.value, patternField4Text.value, patternField5Text.value, patternField6Text.value, patternField7Text.value]));\n%>"
                },
                {
                  "type": "readOnlyText",
                  "id": "patternPreviewText",
                  "label": "Pattern Name Preview",
                  "value": "<% comsPatterns.buildName((queryParams.appCode ?? ''), comsPatterns.prefixCount(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)) > 1 ? '' : comsPatterns.firstPrefix(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode)), comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), ['', '', '', '', '', '', '']) %>"
                }
              ]
            },
            {
              "type": "fieldSet",
              "id": "patternFieldsFieldSet",
              "title": "Pattern Fields",
              "children": [
                {
                  "type": "instanceList",
                  "id": "patternField1FindInstanceList",
                  "multiSelect": false,
                  "label": "<% comsPatterns.fieldLabel(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), 0) %>",
                  "visible": "<% comsPatterns.pickerKind(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), 0) != '' %>",
                  "helpText": "Click to browse, or type a code or name to search Workday (type * for the wildcards). Leave empty for any.",
                  "values": "<% comsPatterns.rootFolders(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), 0, (auCodes.data ?? []), wdYears.data ?? []) %>",
                  "dynamicMonikerLevels": "<%\n  const sel = self.promptSelections;\n  const q = comsPatterns.levelWql(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), 0, sel[0]);\n  const rows = q == '' ? [] : (wdLookup.invoke({'q': q, 'lim': '2000'}).data ?? []);\n  const leaves = comsPatterns.levelRows(comsPatterns.schemaFor(comsApplications.data, queryParams.appCode), 0, sel[0], (auCodes.data ?? []), rows);\n  return [leaves, false];\n%>",
