  "fieldSets": {
    "roleName": [
      {
        "fieldLabel": "Role Name",
        "regex": "\\*|[A-Z0-9][A-Z0-9_-]{0,29}\\*?",
        "hint": "Capital letters, digits, _ or - (up to 30), optionally ending in * (e.g. ANY, SAUDER). Leave blank for any (*).",
        "example": "ANY",
        "blankIsWildcard": true
      }
    ],
    "roleNameWithSubUnit": [
      {
        "fieldLabel": "Role Name",
        "regex": "\\*|[A-Z0-9][A-Z0-9_-]{0,29}\\*?",
        "hint": "Capital letters, digits, _ or - (up to 30), optionally ending in * (e.g. ANY, SAUDER). Leave blank for any (*).",
        "example": "ANY",
        "blankIsWildcard": true
      },
      {
        "fieldLabel": "Sub-unit",
        "regex": "[A-Z0-9][A-Z0-9_-]{0,29}",
        "hint": "Optional second level under the first (e.g. HUMANITIES101 under ARTS, GEOO under SAO): capital letters, digits, _ or -, up to 30. Leave blank to stop at the first level.",
        "example": "HUMANITIES101",
        "blankIsWildcard": false,
        "optionalField": true
      }
    ]
