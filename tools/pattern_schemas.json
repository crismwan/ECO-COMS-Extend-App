        {"fieldLabel": "Course", "regex": "\\*|[0-9]{1,2}\\*|[0-9]{3}[A-Z]?", "hint": "A course number (e.g. 100, 100A) or a start followed by * (e.g. 1* for every 100-level course). Leave blank for any course.", "example": "1*", "blankIsWildcard": true}
      ],
      "examples": [{"values": ["MECH_V", "1*"], "name": "X:BPMS(AOC):CP:MECH_V:1*"}],
      "invalid": [{"values": ["MECH_V", "*7*"], "why": "wildcard in the middle of the course"}, {"values": ["mech_v", "100"], "why": "lower case"}, {"values": ["", "100"], "why": "subject is required"}]
