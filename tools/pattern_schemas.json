{
  "_about": "Pattern schemas per application, from Requirements/Application Patterns.xlsx (received 2026-11-02). A pattern name is <appId>:<prefix>:<field1>:...:<fieldN>. Each field: fieldLabel, regex (validate:match, whole value), hint, example, blankIsWildcard (blank becomes *). X:CLW (Clockwork) uses the same form since 2026-11-02: its five columns (Academic Unit, Subject, Course, Section, Academic Period) give the same names as its existing patterns. Judgement calls: X:BPMS(ASMT) prefix ORG (sheet says ORD, its example and Workday use ORG); X:OAM (sheet heading says X:OAMS, its example and Workday use X:OAM); X:SET and X:PHA have no organization type in Workday yet, so creating their patterns is refused until those types exist. Since 2026-11-07 a field may carry a rule (ruleType, ruleLength, ruleValues, ruleOption) that writes its regex, and a Workday check (lookup academicUnitCode: the value must be an active academic unit's Code, WQL academicUnits.academicUnitCode); Clockwork's Academic Unit uses it. Subject is checked by format because the tenant has no course-subject data source. Since 2026-11-06 a field may be optionalField (only trailing ones): left blank, it is dropped from the name (X:BPMS(ASMT):ORG:ELI and :ORG:ARTS:HUMANITIES101 in one format); X:BPMS(ADHC) also takes prefix ORG (its 12 ORG:SAO:... organizations).",
  "applications": [
    {
      "appId": "X:CLW",
      "name": "Clockwork",
      "prefixes": [
        "PATTERN"
      ],
      "fields": [
        {
          "fieldLabel": "Academic Unit",
          "regex": "\\*|[A-Z0-9-]{2,7}",
          "hint": "2 to 7 capital letters or digits, or any of -. Leave blank for any.",
          "example": "MATH",
          "blankIsWildcard": true,
          "lookup": "academicUnitCode"
        },
        {
          "fieldLabel": "Subject",
          "regex": "\\*|[A-Z]{2,4}(_[A-Z])?",
          "hint": "2 to 4 capital letters, optional _ and a campus letter (e.g. PHYS_V). Leave blank for any subject.",
          "example": "PHYS_V",
          "blankIsWildcard": true
        },
        {
          "fieldLabel": "Course",
          "regex": "\\*|[0-9]{1,2}\\*|[0-9]{3}[A-Z]?",
          "hint": "A course number (e.g. 100, 100A) or a start followed by * (e.g. 1* for every 100-level course). Leave blank for any course.",
          "example": "100",
          "blankIsWildcard": true
        },
        {
          "fieldLabel": "Section",
          "regex": "\\*|[A-Z0-9_]{1,6}",
          "hint": "A section code: capital letters, digits or _, up to 6 (e.g. 101, L1A, A_900). Leave blank for any section.",
          "example": "101",
          "blankIsWildcard": true
        },
        {
          "fieldLabel": "Academic Period",
          "regex": "\\*|20[0-9]{2}(S|W|W1|W2)?|\\*(S|W1|W2)",
          "hint": "A year (2024), a session (2024W, 2024S) or a term (2024W1, 2024W2), or *W1 / *W2 / *S for that term every year. Leave blank for any period.",
          "example": "2024W1",
          "blankIsWildcard": true
        }
      ],
      "examples": [
        {
          "values": [
            "PHAS",
            "",
            "",
            "",
            ""
          ],
          "name": "X:CLW:PATTERN:PHAS:*:*:*:*"
        },
        {
          "values": [
            "",
            "PHYS_V",
            "1*",
            "",
            ""
          ],
          "name": "X:CLW:PATTERN:*:PHYS_V:1*:*:*"
        },
        {
          "values": [
            "",
            "PHYS_V",
            "100",
            "101",
            "2024W1"
          ],
          "name": "X:CLW:PATTERN:*:PHYS_V:100:101:2024W1"
        },
        {
          "values": [
            "",
            "PHYS_V",
            "",
            "",
            "*W1"
          ],
          "name": "X:CLW:PATTERN:*:PHYS_V:*:*:*W1"
        },
        {
          "values": [
            "MATH",
            "MATH_V",
            "303",
            "951",
            "2026W1"
          ],
          "name": "X:CLW:PATTERN:MATH:MATH_V:303:951:2026W1"
        }
      ],
      "invalid": [
        {
          "values": [
            "",
            "ZZYY_H ",
            "*7* ",
            "",
            ""
          ],
          "why": "CLW-SO-00013: trailing spaces and a wildcard in the middle of the course"
        },
        {
          "values": [
            "",
            "phys_v",
            "",
            "",
            ""
          ],
          "why": "lower case"
        },
        {
          "values": [
            "",
            "PHYS_V",
            "",
            "",
            "2024W3"
          ],
          "why": "no such term"
        }
      ]
    },
