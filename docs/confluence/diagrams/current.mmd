    A1([Need a shell org, pattern<br/>or role holder]) --> A2[Clockwork: Appian COMS form<br/>one pattern shape]
    A1 --> A3[Other apps: raise an<br/>ISC ticket]
  end
  subgraph ISC["ISC"]
    I1[Read the ticket, create the<br/>custom organization or role<br/>by hand in Workday]
  end
  subgraph WD["Workday (source of truth)"]
    W1[(Custom organizations,<br/>assignable roles,<br/>role assignments)]
  end
  subgraph AU["AccessUBC"]
    X1[Extract shell roles] 
    X2[Ad hoc assignments<br/>outside Workday]
  end
  APP[Target application<br/>turns roles into grants]
  A2 --> W1
  A3 --> I1 --> W1
  W1 -->|existing extract| X1 --> APP
  X2 --> APP
